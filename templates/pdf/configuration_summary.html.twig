              {% elseif legN <= 3 %}
                {% set legPositions = [1, legN] %}
              {% elseif legN == 4 %}
                {% set legPositions = [1, 3, 4] %}
              {% else %}
                {% set legPositions = [1, 3, 5] %}
              {% endif %}
              <table style="width: {{ groupW }}px; border-collapse: collapse; margin-top: -9px;">
                <tr>
                  {% for i in 1..legN %}
                    <td style="width: 66px; border:0; padding:0; text-align:center; vertical-align:top;">
                      {% if i in legPositions and leg_base64 %}
                        <img src="{{ leg_base64 }}" style="width:34px; height:90px; object-fit:fill; display:block; margin:0 auto;">
                      {% endif %}
                    </td>
                  {% endfor %}
                </tr>
              </table>
            {% endif %}

          </div>
        {% if groupNeedRotate %}
          </div>{# /inner absolute div #}
        {% endif %}
        </div>{# /group-cell or outer rotation container #}
      {% endfor %}

    {% endif %}
  </div>
  </div>
</body>
</html>