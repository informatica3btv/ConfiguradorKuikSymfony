  {% set sizeCategoryLabels = sizeCategoryLabels ?? {} %}
  {% set categoryOrder = categoryOrder ?? ['Sin categoría'] %}

  {% if products is defined and products is not empty %}
  <div style="margin-top:10px; page-break-inside:avoid;">
    {#<h3>{{ 'pdf_summary.products.title'|trans }}</h3>#}
    <table style="width:100%; border-collapse:collapse; font-size:11px;">
      <thead>
        <tr>
          <th style="background:#CCEFFB; padding:7px 8px; text-align:right; border:1px solid #99DFF7; width:10%;">{{ 'pdf_summary.products.units'|trans }}</th>
          <th style="background:#CCEFFB; padding:7px 8px; text-align:left; border:1px solid #99DFF7; width:50%;">{{ 'pdf_summary.products.concept'|trans }}</th>
          <th style="background:#CCEFFB; padding:7px 8px; text-align:right; border:1px solid #99DFF7; width:20%;">{{ 'pdf_summary.products.unit_price'|trans }}</th>
          <th style="background:#CCEFFB; padding:7px 8px; text-align:right; border:1px solid #99DFF7; width:20%;">{{ 'pdf_summary.products.total'|trans }}</th>
        </tr>
      </thead>
      <tbody>
        {% set grandTotal = 0 %}
        {% for category in categoryOrder %}
        {% set isUncategorized = category == 'Sin categoría' %}

        {% if not isUncategorized %}
          {% set catTotal = 0 %}
          {% set catItems = [] %}
          {% for size, product in products %}
            {% if (sizeCategoryLabels[size] ?? 'Sin categoría') == category %}
              {% set info  = productInfo[size] ?? null %}
              {% set count = sizeCounts[size] ?? 0 %}
              {% if product and info and info.PrecioVenta is defined and info.PrecioVenta is not iterable %}
                {% set priceStr = info.PrecioVenta|replace({'.': '', ',': '.'}) %}
                {% set catTotal = catTotal + (priceStr * count) %}
              {% endif %}
              {% set catItems = catItems|merge([{ 'count': count, 'label': macros.conceptLabel(size, count, info) }]) %}
            {% endif %}
          {% endfor %}
          {% set grandTotal = grandTotal + catTotal %}
          <tr>
            <td style="padding:6px 8px; border:1px solid #99DFF7; text-align:right;">1</td>
            <td style="padding:6px 8px; border:1px solid #99DFF7;">
              <div style="font-weight:900;">{{ category }}</div>
              <ul style="margin:4px 0 0; padding-left:14px; font-weight:400; color:#6b7280; font-size:10px;">
                {% for item in catItems %}
                  <li>{{ item.count }} x {{ item.label|trim }}</li>
                {% endfor %}
              </ul>
            </td>
            <td style="padding:6px 8px; border:1px solid #99DFF7; text-align:right; color:#6b7280;">—</td>
            <td style="padding:6px 8px; border:1px solid #99DFF7; text-align:right; font-weight:900;">{{ catTotal|number_format(2, ',', '.') }} €</td>
          </tr>
        {% else %}
        {% for size, product in products %}
          {% if (sizeCategoryLabels[size] ?? 'Sin categoría') == category %}
          {% set info  = productInfo[size] ?? null %}
          {% set count = sizeCounts[size] ?? 0 %}
          <tr>
            <td style="padding:6px 8px; border:1px solid #99DFF7; text-align:right;">{{ count }}</td>
            <td style="padding:6px 8px; border:1px solid #99DFF7;">{{ macros.conceptLabel(size, count, info)|trim }}</td>
            {% if product %}
              {% if info and info.PrecioVenta is defined and info.PrecioVenta is not iterable %}
                {% set priceStr = info.PrecioVenta|replace({'.': '', ',': '.'}) %}
                {% set lineTotal = priceStr * count %}
                {% set grandTotal = grandTotal + lineTotal %}
                <td style="padding:6px 8px; border:1px solid #99DFF7; text-align:right;">{{ info.PrecioVenta }} €</td>
                <td style="padding:6px 8px; border:1px solid #99DFF7; text-align:right; font-weight:900;">{{ lineTotal|number_format(2, ',', '.') }} €</td>
              {% else %}
                <td colspan="2" style="padding:6px 8px; border:1px solid #99DFF7; text-align:right; color:#6b7280;">—</td>
              {% endif %}
            {% else %}
              <td colspan="2" style="padding:6px 8px; border:1px solid #99DFF7; color:#6b7280;">{{ 'pdf_summary.products.no_reference'|trans }}</td>
            {% endif %}
          </tr>
          {% endif %}
        {% endfor %}
        {% endif %}
        {% endfor %}
        {% set instalacionPrecio = p._instalacion_precio ?? 0 %}
        {% if instalacionPrecio > 0 %}
        {% set grandTotal = grandTotal + instalacionPrecio %}
        <tr>
          <td style="padding:6px 8px; border:1px solid #99DFF7; text-align:right;">1</td>
          <td style="padding:6px 8px; border:1px solid #99DFF7;">{{ 'pdf_summary.concept.installation_of'|trans }} {{ columnsAll|length }} {{ 'pdf_summary.concept.columns'|trans }}</td>
          <td style="padding:6px 8px; border:1px solid #99DFF7; text-align:right;">{{ instalacionPrecio|number_format(2, ',', '.') }} €</td>
          <td style="padding:6px 8px; border:1px solid #99DFF7; text-align:right; font-weight:900;">{{ instalacionPrecio|number_format(2, ',', '.') }} €</td>
        </tr>
        {% endif %}

        {% set manualLines = p._manualLines ?? [] %}
        {% for line in manualLines %}
          {% set lineUds    = line.uds ?? 0 %}
          {% set linePrecio = line.precio ?? 0 %}
          {% set lineTotal  = lineUds * linePrecio %}
          {% set grandTotal = grandTotal + lineTotal %}
          <tr>
            <td style="padding:6px 8px; border:1px solid #99DFF7; text-align:right;">{{ lineUds }}</td>
            <td style="padding:6px 8px; border:1px solid #99DFF7;">{{ line.descripcion ?? '' }}</td>
            <td style="padding:6px 8px; border:1px solid #99DFF7; text-align:right;">{{ linePrecio|number_format(2, ',', '.') }} €</td>
            <td style="padding:6px 8px; border:1px solid #99DFF7; text-align:right; font-weight:900;">{{ lineTotal|number_format(2, ',', '.') }} €</td>
          </tr>
        {% endfor %}
      </tbody>
      {% set instalacionIva    = p._instalacion_iva ?? false %}
      {% set descuento         = p._descuento ?? 0 %}
      {% set subtotalBase      = grandTotal %}
      {% set totalAntesDesc    = instalacionIva ? subtotalBase * 1.21 : subtotalBase %}
      {% set descuentoImporte  = subtotalBase * descuento / 100 %}
      {% set totalFinal        = instalacionIva ? (subtotalBase - descuentoImporte) * 1.21 : (subtotalBase - descuentoImporte) %}
      <tfoot>
        {% if instalacionIva %}
        <tr>
          <td colspan="3" style="padding:7px 8px; text-align:right; border-top:1px solid #99DFF7; color:#6b7280;">{{ 'pdf_summary.totals.subtotal'|trans }}</td>
          <td style="padding:7px 8px; text-align:right; border-top:1px solid #99DFF7; color:#6b7280;">{{ subtotalBase|number_format(2, ',', '.') }} €</td>
        </tr>
        <tr>
          <td colspan="3" style="padding:7px 8px; text-align:right; color:#6b7280;">{{ 'pdf_summary.totals.vat'|trans }} (21%)</td>
          <td style="padding:7px 8px; text-align:right; color:#6b7280;">{{ (subtotalBase * 0.21)|number_format(2, ',', '.') }} €</td>
        </tr>
        {% endif %}
        {% if descuento > 0 %}
        <tr>
          <td colspan="3" style="padding:7px 8px; font-weight:900; text-align:right; border-top:2px solid #00AFEA;">{{ 'pdf_summary.totals.total'|trans }}{{ instalacionIva ? (' ' ~ ('pdf_summary.totals.vat_included'|trans)) : '' }}</td>
          <td style="padding:7px 8px; font-weight:900; text-align:right; border-top:2px solid #00AFEA;">{{ totalAntesDesc|number_format(2, ',', '.') }} €</td>
        </tr>
        <tr>
          <td colspan="3" style="padding:7px 8px; font-weight:900; text-align:right;">{{ 'pdf_summary.totals.discount'|trans }} ({{ descuento % 1 == 0 ? descuento|number_format(0) : descuento|number_format(1) }}%)</td>
          <td style="padding:7px 8px; font-weight:900; text-align:right;">−{{ descuentoImporte|number_format(2, ',', '.') }} €</td>
        </tr>
        <tr>
          <td colspan="3" style="padding:7px 8px; font-weight:900; text-align:right; border-top:2px solid #00AFEA;">{{ 'pdf_summary.totals.total_with_discount'|trans }}{{ instalacionIva ? (' ' ~ ('pdf_summary.totals.vat_included'|trans)) : '' }}</td>
          <td style="padding:7px 8px; font-weight:900; text-align:right; border-top:2px solid #00AFEA;">{{ totalFinal|number_format(2, ',', '.') }} €</td>
        </tr>
        {% else %}
        <tr>
          <td colspan="3" style="padding:7px 8px; font-weight:900; text-align:right; border-top:2px solid #00AFEA;">{{ 'pdf_summary.totals.total'|trans }}{{ instalacionIva ? (' ' ~ ('pdf_summary.totals.vat_included'|trans)) : '' }}</td>
          <td style="padding:7px 8px; font-weight:900; text-align:right; border-top:2px solid #00AFEA;">{{ totalAntesDesc|number_format(2, ',', '.') }} €</td>
        </tr>
        {% endif %}
      </tfoot>
    </table>
  </div>
  {% endif %}

  <div style="margin-top:50px; page-break-inside:avoid;">
    <table style="width:100%; border-collapse:collapse; font-size:11px;">
