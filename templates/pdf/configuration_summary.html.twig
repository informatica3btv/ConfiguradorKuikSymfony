    {% else %}

      {% set doorIndex = 0 %}

      {% for groupCols in groups %}
        {% if groupCols is not iterable %}{% set groupCols = [] %}{% endif %}

        {% set n = groupCols|length %}
        {% set isLastGroup = loop.index == groups|length %}
        {% set mbBlockWPdf = (isLastGroup and mbRows > 0 and mbCols > 0) ? (mbCols * mbCellW|round + 12) : 0 %}
        {% set groupW = n > 0 ? (n * 60 + (n - 1) * 5) : 0 %}
        {% set totalW = groupW + mbBlockWPdf %}
        {% set groupNeedRotate = n > 11 %}
        {#
          Estimated rendered height of the support-wrap block:
            col-card borders (top+bottom 12px) + col-body height + padding-bottom:100px + margin:20px + legs/arms ~48px
        #}
        {% set estGroupH = previewHeightPx|round + 260 %}
        {#
          After rotate(-90deg) around center:
            visual width  = estGroupH  (original height)
            visual height = groupW     (original width)
          Element must be centered inside the outer box (estGroupH × groupW).
          offset = (groupW - estGroupH) / 2  →  left = -offset, top = offset
        #}
        {% set rotMargin = 60 %}
        {% set rotOffset = ((groupW - estGroupH) / 2)|round + rotMargin %}

        <div class="group-height-label">{{ 'pdf_summary.config.column_height'|trans }}: {{ groupHeightLabelPdf }}</div>
