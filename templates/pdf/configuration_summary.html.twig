{# ============================================================
   PDF / Documento técnico (sin precios) — con AGRUPACIONES (groups)
   ✅ FIX: que la vista previa se meta en la pág 1 si cabe
   ✅ FIX: patas en PDF (TABLE)
   ✅ FIX: brazos/patas derecha alineados (ancho explícito por grupo)
   ✅ NUEVO: 2 agrupaciones por fila si caben (GRID con TABLE)
   ✅ FIX: SIEMPRE dibuja puertas (también cuando NO hay brazos)
   ✅ FIX: imágenes locales para Dompdf en servidor Debian
   ✅ NUEVO: dibujar metacrilato en preview PDF
   ============================================================ #}

{% set pxPerH = 1.6 %}

{% macro conceptLabel(size, count, info) %}
  {%- if size starts with 'columna_' %}{{ 'pdf_summary.concept.column'|trans }} H{{ size|replace({'columna_': ''}) }}
  {%- elseif size == 'columna' %}{{ 'pdf_summary.concept.column'|trans }}
  {%- elseif size == 'control' %}{{ 'pdf_summary.concept.peripherals'|trans }}
  {%- elseif size == 'bandeja' %}{{ 'pdf_summary.concept.intermediate_tray'|trans }}
  {%- elseif size starts with 'lateral_' %}{{ 'pdf_summary.concept.side_panel_pair'|trans }} H{{ size|replace({'lateral_': ''}) }}
  {%- elseif size == 'lateral' %}{{ 'pdf_summary.concept.side_panel_pair'|trans }}
  {%- elseif size starts with 'mailbox_col_' %}
    {%- set _mbParts = size|replace({'mailbox_col_': ''})|split('_') -%}
    {{ 'pdf_summary.concept.mailbox'|trans }} {{ _mbParts[0] == '1' ? ('pdf_summary.concept.electronic'|trans) : ('pdf_summary.concept.mechanical'|trans) }}{{ _mbParts[1] == '1' ? (' ' ~ ('pdf_summary.concept.with_card_reader'|trans)) : (' ' ~ ('pdf_summary.concept.without_card_reader'|trans)) }}
  {%- elseif size starts with 'brazo_' %}{{ 'pdf_summary.concept.arms'|trans }} H{{ size|replace({'brazo_': ''}) }}
  {%- elseif size starts with 'pata_' %}{{ 'pdf_summary.concept.legs'|trans }} ({{ size|replace({'pata_': ''}) }} {{ 'pdf_summary.concept.col_abbr'|trans }}.)
  {%- elseif size == 'instalacion_ref' %}{{ 'pdf_summary.concept.installation'|trans }}
  {%- elseif size == 'color_door' %}{{ 'pdf_summary.config.door_color'|trans }}{{ (info._ral ?? null) ? (' (' ~ info._ral ~ ')') : '' }}
  {%- elseif size == 'color_body' %}{{ 'pdf_summary.config.body_color'|trans }}{{ (info._ral ?? null) ? (' (' ~ info._ral ~ ')') : '' }}
  {%- elseif size == 'placa' %}{{ 'pdf_summary.concept.plate'|trans }}
  {%- elseif size == 'colgador' %}{{ 'pdf_summary.concept.hanger'|trans }}
  {%- elseif size == 'buzon_group' %}{{ 'pdf_summary.concept.mailboxes_group'|trans }}
  {%- elseif size == 'envolvente_buzon' %}{{ 'pdf_summary.concept.mailbox_enclosure'|trans }} ({{ info._rango ?? '' }}) — {{ info._metros ?? count }} m
  {%- elseif size starts with 'tejado_' %}{{ 'pdf_summary.concept.roof'|trans }} {{ size|replace({'tejado_': ''}) }} {{ 'pdf_summary.concept.col_abbr'|trans }}.
  {%- elseif size ends with '_meth' %}{{ 'pdf_summary.concept.door_of'|trans }} H{{ size|replace({'_meth': ''}) }} + {{ 'pdf_summary.concept.methacrylate'|trans }}
  {%- else %}{{ 'pdf_summary.concept.door_of'|trans }} H{{ size }}{% endif -%}
{% endmacro %}

{% import _self as macros %}

{# Detect max columns in any group to decide orientation #}
{% set maxGroupSize = 0 %}
{% set groupsForSize = payload.groups ?? [] %}
{% if groupsForSize is empty %}
  {% set groupsForSize = [payload.columns ?? []] %}
{% endif %}
{% for g in groupsForSize %}
  {% if g|length > maxGroupSize %}{% set maxGroupSize = g|length %}{% endif %}
{% endfor %}
{% set useLandscape = maxGroupSize > 9 %}

{# Available content width: landscape ~1079px, portrait ~750px (A4 minus 44px padding) #}
{% set pageContentW = useLandscape ? 1079 : 750 %}
{% set colGap = 5 %}
{% set colWCalc = maxGroupSize > 0 ? ((pageContentW - (maxGroupSize - 1) * colGap) / maxGroupSize)|round(0, 'floor') : 75 %}
{% set colW = colWCalc < 75 ? colWCalc : 75 %}

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <style>
    /* ===== Paleta de marca Kuik (Pantone 2995C — Light Blue) ===== */
    /* Base: #00AFEA · tintas: 80% #33BFEE · 60% #66CFF2 · 40% #99DFF7 · 20% #CCEFFB */

    @page { size: A4 portrait; margin: 0; }
    body{ font-family: DejaVu Sans, Arial, sans-serif; font-size:12px; color:#0b1220; }
    .page{ padding: 18px 22px; }

    /* Header */
    .head{
      border-bottom: 2px solid #00AFEA;
      padding-bottom: 10px;
      margin-bottom: 14px;
    }
    .brand{ font-size: 16px; font-weight: 900; margin:0; color:#003b73; }
    .doc-title{ font-size: 18px; font-weight: 900; margin: 2px 0 0; }
    .meta{ margin-top: 6px; font-size: 11px; color:#6b7280; }

    .row{ font-size:0; margin-top: 10px; }
    .col{ display:inline-block; vertical-align: top; font-size:12px; }
    .col-50{ width:49%; }
    .col-50 + .col-50{ margin-left:2%; }

    .card{
      border:1px solid #99DFF7;
      border-radius:10px;
      padding:10px;
      margin-bottom: 10px;
      background:#fff;
      page-break-inside: avoid;
    }

    .card-preview{
      padding:25px;
      margin-bottom: 10px;
      background:#fff;
      page-break-inside: auto;
      padding-bottom: 20px;
    }

    .card h3{
      margin:0 0 8px;
      padding-bottom:6px;
      font-size: 12px;
      font-weight: 900;
      color:#003b73;
      border-bottom: 1px solid #CCEFFB;
    }
    .muted{ color:#6b7280; font-size:11px; }

    table{ width:100%; border-collapse: collapse; font-size: 11px; }
    th, td{ border:1px solid #99DFF7; padding:7px 8px; text-align:left; vertical-align: top; }
    th{ background:#CCEFFB; font-weight:900; color:#003b73; width: 40%; }

    .pill{
      display:inline-block;
      padding:2px 8px;
      border-radius:999px;
      border:1px solid #99DFF7;
      background:#CCEFFB;
      font-weight:900;
      font-size: 10px;
      color:#003b73;
    }

    /* ===== Cliente 2 por fila (PDF reliable: TABLE) ===== */
    .kvs-table{ width:100%; border-collapse: collapse; }
    .kvs-table td{ border:0; padding:0 0 8px 0; vertical-align: top; }
    .kvs-table td.gap{ width:2%; }
    .kv{
      border:1px solid #99DFF7;
      border-radius:10px;
      padding:8px 10px;
      background:#CCEFFB;
      box-sizing:border-box;
    }
    .kv .k{ font-size:10px; color:#003b73; font-weight:900; margin:0; }
    .kv .v{ font-size:11px; font-weight:900; margin:3px 0 0; color:#0b1220; }

    :root{ --hscale: {{ pxPerH }}px; }

    .cols-wrap{ font-size:0; margin-top: 6px; display:inline-block; }

    .col-shell{
      width:60px;
      display:inline-block;
      padding: 0px;
      vertical-align: top;
      margin-right:5px;
      margin-bottom:10px;
      font-size:12px;
      page-break-inside: avoid;
    }
    .col-shell:last-child{ margin-right:0; }

    .col-card{
      width:60px;
      border-style:solid;
      border-left-width:4px;
      border-right-width:4px;
      border-top-width:6px;
      border-bottom-width:6px;
      border-radius:8px;
      background:#f7f7f7;
      position:relative;
      z-index:2;
    }

    .dim-row{
      display:block;
      text-align:center;
      font-size:9px;
      line-height:1;
      color:#0b1220;
      margin-top:4px;
      white-space:nowrap;
    }

    .dim-row .arrow{
      font-size:12px;
    }

    .dim-row .line{
      display:inline-block;
      width:40px;
      border-top:1px solid #0b1220;
      vertical-align:middle;
      margin:0 2px;
    }

    .dim-value{
      font-size:9px;
      font-weight:900;
      text-align:center;
    }

    .group-width-total{
      display:inline-block;
      margin-top:6px;
    }

    .group-width-total .dim-row .line{
      width:60px;
    }

    .group-width-total .dim-value{
      font-size:11px;
    }

    .group-height-label{
      font-size:11px;
      font-weight:900;
      text-align:center;
      margin-bottom:2px;
    }

    .group-height-dim{
      text-align:center;
      margin-bottom:6px;
    }

    .group-height-dim .dim-row .line{
      width:70px;
    }

    .col-body{ background:#eaeaea; }
    .col-half{ overflow:hidden; }

    /* Grupo buzones PDF */
    .mb-pdf-block{
      display:inline-block;
      vertical-align:top;
      border-style:solid;
      border-left-width:4px;
      border-right-width:4px;
      border-top-width:6px;
      border-bottom-width:6px;
      border-radius:8px;
      overflow:hidden;
      font-size:0;
    }
    .mb-pdf-col{
      display:inline-block;
      vertical-align:top;
      width:44px;
    }
    .mb-pdf-cell{
      display:block;
      width:44px;
      overflow:hidden;
    }

    .half-sep{
      border-top:2px dashed rgba(255,255,255,.95);
      border-bottom:1px dashed rgba(0,0,0,.18);
      height:0;
    }

    .door{
      width:100%;
      position:relative;
      border-left:1px solid rgba(11,18,32,.55);
      border-right:1px solid rgba(11,18,32,.55);
      border-top:1px solid rgba(11,18,32,.55);
      overflow:hidden;
    }
    .door.last{ border-bottom:1px solid rgba(11,18,32,.55); }

    .door .badges{
      position:absolute;
      right:6px;
      top:6px;
      white-space:nowrap;
      z-index:3;
    }

    .badge{
      display:inline-block;
      font-size:9px;
      font-weight:900;
      background: rgba(255,255,255,.92);
      border:1px solid rgba(0,0,0,.25);
      border-radius:999px;
      padding:1px 6px;
      margin-left:4px;
    }

    .door.screen{ position:relative; background:#0f172a; }
    .door.screen .screen-img{
      position:absolute;
      top:50%;
      left:50%;
      transform:translate(-50%,-50%);
      width:90%;
      height:105%;
      display:block;
    }

    /* ✅ Metacrilato para PDF: capa interior real, más fiable que ::after */
    .door-overlay{
      position:absolute;
      top:6px;
      left:6px;
      right:6px;
      bottom:6px;
      background:rgba(0,0,0,.38);
      border-radius:3px;
      z-index:1;
    }

    /* ===========================
       ✅ SOPORTE SUELO (PDF)
       =========================== */
    .support-wrap{
      position: relative;
      display: inline-block;
      margin: 14px 0 6px;
      padding-bottom: 100px;
      page-break-inside: avoid;
    }

    .preview-core{
      position: relative;
      display: inline-block;
    }

    .arm-img{
      position:absolute;
      top: 30px;
      padding:0;
      width: 40px;
      object-fit: contain;
      z-index: 1;
    }

    .arm-img.left{
      right: 100%;
      margin-right: 0px;   /* separación mínima */
      transform: scaleX(-1);
    }

    .arm-img.right{
      left: 100%;
      margin-left: 9px;    /* separación mínima */
    }

    /* ✅ PATAS (PDF reliable): TABLE */
    .legs-under{
      width:60px;
      margin-top:-7px;
      border-collapse:collapse;
      font-size:0;
    }
    .legs-under td{ border:0; padding:0; width:50%; vertical-align:top; }
    .legs-under td.right{ text-align:right; }

    .leg{
      display:inline-block;
      width:16px;
      height:22px;
      border-radius:6px;
      border:1px solid rgba(0,0,0,.18);
      margin:0;
    }
    .leg.white{ background:#ffffff; }
    .leg.black{ background:#111827; }
    .leg.silver{ background: linear-gradient(135deg, #cbd5e1, #94a3b8); }

    .footer{
      margin-top: 12px;
      border-top: 1px solid #99DFF7;
      padding-top: 8px;
      font-size: 10px;
      color:#6b7280;
    }
  </style>
</head>

<body>
<div class="page">

  {# =========================
     Datos base
     ========================= #}
  {% set p = payload ?? {} %}
  {% if p is not iterable %}{% set p = {} %}{% endif %}

  {% set groups = p.groups ?? [] %}
  {% if groups is not iterable %}{% set groups = [] %}{% endif %}

  {% set columnsFlat = p.columns ?? [] %}
  {% if columnsFlat is not iterable %}{% set columnsFlat = [] %}{% endif %}

  {% if groups is empty and columnsFlat is not empty %}
    {% set groups = [columnsFlat] %}
  {% endif %}

  {% set columnsAll = [] %}
  {% for g in groups %}
    {% if g is iterable %}
      {% set columnsAll = columnsAll|merge(g) %}
    {% endif %}
  {% endfor %}

  {% set addons = p.addons ?? {} %}

  {% set doorColor = p.colorDoor ?? '#3a9efc' %}
  {% set doorColorRal = p.colorDoorRal ?? '' %}
  {% set bodyColor = p.colorBody ?? '#000' %}
  {% set bodyColorRal = p.colorBodyRal ?? '' %}

  {% set type = p.type ?? '' %}
  {% set instalacion = p.instalacion ?? '' %}

  {% set selectedType  = p.bracketType ?? '' %}
  {% set selectedColor = p.bracketColor ?? '' %}
  {% set isSoporteSuelo = (instalacion == 'soporte_suelo') %}

  {% set legClass = selectedColor == 'blanco' ? 'white' : (selectedColor == 'plata' ? 'silver' : 'black') %}

  {# ✅ imágenes locales para Dompdf #}
  {% set screenSrc = 'file://' ~ public_dir ~ '/assets/pantalla.png' %}

  {% if isSoporteSuelo and selectedType == 'brazos' and selectedColor %}
    {% set armSrc =
      selectedColor == 'blanco' ? arm_blanco :
      (selectedColor == 'plata' ? arm_plata : arm_negro)
    %}
  {% endif %}

  {% set isHome = (type == 'home') %}
  {% set isZocalo = (isHome and instalacion == 'zocalo') %}
  {% set isEmpotradoLike = (isHome and (instalacion == 'empotrado' or instalacion == 'soporte_suelo')) %}

  {% set agrupacionCombinada = p.agrupacion_combinada ?? false %}
  {% set mailboxGroup = p.mailboxGroup ?? null %}
  {% set mbSide  = mailboxGroup.side ?? 'right' %}
  {% set mbRows  = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.rows ?? 0) : 0 %}
  {% set mbCols  = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.cols ?? 0) : 0 %}
  {% set mbCells = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.cells ?? []) : [] %}

  {% set topCap    = isZocalo ? (p.topCap|default(kuik.default_top_cap)) : kuik.default_top_cap %}
  {% set bottomCap = isZocalo ? 70 : kuik.default_bottom_cap %}
  {% set singleCap = isEmpotradoLike ? (p.singleCap|default(kuik.default_single_cap)) : kuik.default_single_cap %}
  {% set mbTotalH = isEmpotradoLike ? (singleCap * pxPerH) : ((topCap + bottomCap) * pxPerH) %}
  {% set mbCellH = mbRows > 0 ? (mbTotalH / mbRows) : (10 * pxPerH) %}
  {% set mbCellHR = mbRows > 0 ? (mbTotalH / mbRows)|round(0, 'floor') : 0 %}
  {% set mbCellW = mbCellHR * 2.76 %}
  {% set mbActualBlockH = mbRows * mbCellHR %}
  {% set mbPaddingTop = 6 + (mbTotalH - mbActualBlockH) / 2 %}
  
  {% set previewHeightPx = (isEmpotradoLike ? singleCap : (topCap + bottomCap)) * pxPerH %}
  {% set armHeightPx = previewHeightPx + 58 %}

  {% set fondo = p.fondo ?? '' %}
  {% set material = p.material ?? '' %}
  {% set placement = p.placement ?? '' %}

  {% set fondoLabel =
    fondo == '300' ? 'Serie 300' :
    fondo == '400' ? 'Serie 400' :
    fondo == '500' ? 'Serie 500' : (fondo ?: '—')
  %}

  {% set isHomeSerie400 = isHome and fondo == '400' %}

  {# Ancho de columna (mm) según la serie de fondo, y alto de la agrupación (125 por cada H10) #}
  {% set colWidthLabel = isHomeSerie400 ? 380 : (fondo in ['300', '400', '500'] ? fondo : null) %}
  {% set groupWidthExtraMm = isHomeSerie400 ? 200 : 50 %}
  {% set totalHUnitsPdf = isEmpotradoLike ? singleCap : (topCap + bottomCap) %}
  {% set groupHeightLabelPdf = kuik.h_heights_mm[totalHUnitsPdf] is defined ? kuik.h_heights_mm[totalHUnitsPdf] : (totalHUnitsPdf / 10 * 125)|round %}
  {% set placementLabel =
    placement == 'interior' ? 'Interior' :
    placement == 'exterior' ? 'Exterior' : (placement ?: '—')
  %}

  {# =========================
     Contadores
     ========================= #}
  {% set doorCounts = {} %}
  {% set totalDoors = 0 %}
  {% set enchCount = 0 %}
  {% set usbCount = 0 %}
  {% set methacrylateCount = 0 %}

  {% for col in columnsAll %}
    {% if col.single is defined and col.single is not empty %}
      {% for blk in (col.single.blocks ?? []) %}
        {% set bType = blk.type ?? 'door' %}
        {% set h = blk.h ?? blk %}
        {% if bType != 'screen' and bType != 'mailbox' %}
          {% set totalDoors = totalDoors + 1 %}
          {% set key = 'H' ~ h %}
          {% set doorCounts = doorCounts|merge({ (key): (doorCounts[key]|default(0) + 1) }) %}
          {% set sel = addons[totalDoors ~ ''] ?? addons[totalDoors] ?? null %}
          {% if sel and sel.socket %}{% set enchCount = enchCount + 1 %}{% endif %}
          {% if sel and sel.usb %}{% set usbCount = usbCount + 1 %}{% endif %}
          {% if sel and sel.methacrylate %}{% set methacrylateCount = methacrylateCount + 1 %}{% endif %}
        {% endif %}
      {% endfor %}
    {% else %}
      {% for blk in (col.top.blocks ?? []) %}
        {% set bType = blk.type ?? 'door' %}
        {% set h = blk.h ?? blk %}
        {% if bType != 'screen' and bType != 'mailbox' %}
          {% set totalDoors = totalDoors + 1 %}
          {% set key = 'H' ~ h %}
          {% set doorCounts = doorCounts|merge({ (key): (doorCounts[key]|default(0) + 1) }) %}
          {% set sel = addons[totalDoors ~ ''] ?? addons[totalDoors] ?? null %}
          {% if sel and sel.socket %}{% set enchCount = enchCount + 1 %}{% endif %}
          {% if sel and sel.usb %}{% set usbCount = usbCount + 1 %}{% endif %}
          {% if sel and sel.methacrylate %}{% set methacrylateCount = methacrylateCount + 1 %}{% endif %}
        {% endif %}
      {% endfor %}
      {% for blk in (col.bottom.blocks ?? []) %}
        {% set bType = blk.type ?? 'door' %}
        {% set h = blk.h ?? blk %}
        {% if bType != 'screen' and bType != 'mailbox' %}
          {% set totalDoors = totalDoors + 1 %}
          {% set key = 'H' ~ h %}
          {% set doorCounts = doorCounts|merge({ (key): (doorCounts[key]|default(0) + 1) }) %}
          {% set sel = addons[totalDoors ~ ''] ?? addons[totalDoors] ?? null %}
          {% if sel and sel.socket %}{% set enchCount = enchCount + 1 %}{% endif %}
          {% if sel and sel.usb %}{% set usbCount = usbCount + 1 %}{% endif %}
          {% if sel and sel.methacrylate %}{% set methacrylateCount = methacrylateCount + 1 %}{% endif %}
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endfor %}

  {# =========================
     Cabecera
     ========================= #}
  <div class="head">
    <div class="row" style="margin-top:0;">
      <div class="col col-50">
        {% if logo_base64 %}
          <img src="{{ logo_base64 }}" style="height:54px; width:auto;" alt="Kuik Smart Lockers">
        {% else %}
          <p class="brand">Kuik</p>
        {% endif %}
        <p class="muted" style="margin:2px 0 0;">
        </p>
      </div>
      <div class="col col-50" style="text-align:right;">
        <p class="doc-title" style="margin:0;">{{ 'pdf_summary.header.title'|trans }}</p>
        <div class="meta">
          {{ 'pdf_summary.header.number'|trans }}: <b>#{{ configuration.id }}</b><br>
          {{ 'pdf_summary.header.date'|trans }}: <b>{{ p._pdf_fecha ?? ("now"|date("d/m/Y")) }}</b>
        </div>
      </div>
    </div>
  </div>

  {# =========================
     Cliente + Proyecto
     ========================= #}
  <div class="card">
    <h3>{{ 'pdf_summary.client.title'|trans }}</h3>

    <table class="kvs-table">
      <tbody>
        <tr>
          <td><div class="kv"><div class="k">{{ 'pdf_summary.client.project'|trans }}</div><div class="v">{{ project.projectName ?? '—' }}</div></div></td>
          <td class="gap"></td>
          <td><div class="kv"><div class="k">{{ 'pdf_summary.client.client'|trans }}</div><div class="v">{{ project.clientName ?? '—' }}</div></div></td>
          <td class="gap"></td>
          <td><div class="kv"><div class="k">{{ 'pdf_summary.client.email'|trans }}</div><div class="v">{{ project.email ?: '—' }}</div></div></td>
        </tr>
        <tr>
          <td><div class="kv"><div class="k">{{ 'pdf_summary.client.phone'|trans }}</div><div class="v">{{ project.phone ?: '—' }}</div></div></td>
          <td class="gap"></td>
          <td><div class="kv"><div class="k">{{ 'pdf_summary.client.city'|trans }}</div><div class="v">{{ project.city ?: '—' }}</div></div></td>
          <td class="gap"></td>
          <td><div class="kv"><div class="k">{{ 'pdf_summary.client.address'|trans }}</div><div class="v">{{ project.address ?: '—' }}</div></div></td>
        </tr>
      </tbody>
    </table>
  </div>


  {# =========================
     Configuración + puertas
     ========================= #}
  {#<div class="row">
    <div class="col col-50">
      <div class="card">
        <h3>{{ 'pdf_summary.config.title'|trans }}</h3>
        <table>
          <tbody>
            <tr><th>{{ 'pdf_summary.config.type'|trans }}</th><td><span class="pill">{{ p.type ?? '—' }}</span></td></tr>
            <tr><th>{{ 'pdf_summary.config.installation'|trans }}</th><td>{{ instalacion ?: '—' }}</td></tr>
            <tr><th>{{ 'pdf_summary.config.background_size'|trans }}</th><td>{{ fondoLabel }}</td></tr>
            <tr><th>{{ 'pdf_summary.config.indoor_outdoor'|trans }}</th><td>{{ placementLabel }}</td></tr>
            <tr><th>{{ 'pdf_summary.config.door_color'|trans }}</th><td>{{ doorColorRal ?: '—' }}</td></tr>
            <tr><th>{{ 'pdf_summary.config.body_color'|trans }}</th><td>{{ bodyColorRal ?: '—' }}</td></tr>
            <tr><th>{{ 'pdf_summary.config.column_count'|trans }}</th><td>{{ columnsAll|length }}</td></tr>
            {% if isSoporteSuelo %}
              <tr><th>{{ 'pdf_summary.config.support'|trans }}</th><td>{{ selectedType ?: '—' }} {{ selectedColor ?: '' }}</td></tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </div>

    <div class="col col-50">
      <div class="card">
        <h3>{{ 'pdf_summary.doors_addons.title'|trans }}</h3>

        <table>
          <tbody>
