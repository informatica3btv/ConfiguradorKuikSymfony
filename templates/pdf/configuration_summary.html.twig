        {% if groupNeedRotate %}
        {# Outer: width=estGroupH, height=groupW+rotMargin (extra room for top/bottom margin) #}
        <div style="position: relative; width: {{ estGroupH }}px; height: {{ groupW + rotMargin }}px; overflow: visible; margin: 10px auto 20px;">
          <div style="position: absolute; width: {{ groupW }}px; height: {{ estGroupH }}px; left: {{ 0 - rotOffset + rotMargin }}px; top: {{ rotOffset }}px; transform: rotate(-90deg); transform-origin: center center;">
