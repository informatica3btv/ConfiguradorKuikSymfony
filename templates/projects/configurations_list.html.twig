{% extends 'layout.html.twig' %}
{% block page_title %}Configuraciones{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{ --hscale: 1.7; }

    /* ===== PAGE WRAP ===== */
    .wrap{ max-width: 1400px; margin: 26px auto; padding: 0 14px; }
    .muted{ color:#6b7280; font-size:16px; }

    h1.page-title{
      margin:0;
      font-size:34px;
      letter-spacing:-0.02em;
    }

    /* ===== TOP INFO BAR (cliente/email/teléfono/ubicación) ===== */
    .info-bar{
      margin-top:14px;
      background:#fff;
      border:1px solid rgba(15,23,42,.12);
      border-radius:14px;
      padding:14px;
      display:grid;
      grid-template-columns: repeat(4, 1fr);
      gap:14px;
      align-items:center;
    }
    @media (max-width: 1020px){
      .info-bar{ grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 620px){
      .info-bar{ grid-template-columns: 1fr; }
    }

    .info-item{
      display:flex;
      align-items:center;
      gap:12px;
      min-height:52px;
    }
    .info-ico{
      width:44px;
      height:44px;
      border-radius:999px;
      background: rgba(11,118,216,.10);
      display:flex;
      align-items:center;
      justify-content:center;
      flex:0 0 44px;
    }
    .info-ico svg{ display:block; }
    .info-k{ font-size:12px; color:#6b7280; font-weight:900; }
    .info-v{ font-size:14px; font-weight:900; margin-top:2px; }

    /* ===== ACTIONS ROW ===== */
    .top-actions{
      margin-top:14px;
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      align-items:center;
    }

    /* ===== CARDS ===== */
    .card{
      background:#fff;
      border:1px solid rgba(15,23,42,.12);
      border-radius:16px;
      padding:16px;
      margin-top:16px;
    }

    /* ===== CONFIG ITEM CARD ===== */
    .config-head{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:14px;
      flex-wrap:wrap;
    }
    .config-title{
      display:flex;
      align-items:center;
      gap:10px;
      flex-wrap:wrap;
      font-weight:900;
      font-size:18px;
    }
    .config-sub{
      margin-top:6px;
      color:#6b7280;
      font-size:14px;
    }

    .actions{
      display:flex;
      gap:10px;
      align-items:center;
      flex-wrap:wrap;
    }

    .btn{
      border:1px solid rgba(15,23,42,.12);
      background:#fff;
      border-radius:12px;
      padding:10px 14px;
      font-weight:900;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      gap:10px;
      text-decoration:none;
      color:#0b1220;
      font-size:13px;
      box-shadow: 0 1px 0 rgba(15,23,42,.04);
    }
    .btn:hover{ background: rgba(2,6,23,.03); }
    .btn.primary{
      background:#0b76d8;
      border-color:#0b76d8;
      color:#fff;
    }
    .btn.primary:hover{ filter: brightness(.97); }
    .btn.icon svg{ display:block; }

    .btn.accept{
      background: #23C920;
      color: #fff;
    }

    .btn.reject{
      background: #fc0000;
      color: #fff;
    }

    .config-body{
      margin-top:14px;
      display:grid;
      grid-template-columns: 1fr 1.65fr;
      gap:14px;
      align-items:stretch;
    }
    @media (max-width: 980px){
      .config-body{ grid-template-columns: 1fr; }
    }

    /* KV CARDS */
    .kvs{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:10px;
    }
    .kv{
      border:0;
      border-radius:14px;
      padding:14px;
      background:#f8fafc;
      min-height:74px;
    }
    .kv .k{ font-size:12px; color:#6b7280; font-weight:900; }
    .kv .v{ font-size:14px; font-weight:900; margin-top:4px; }
    .kv.wide{ grid-column: 1 / -1; }

    /* Color swatch */
    .swatch{
      display:inline-flex;
      align-items:center;
      gap:10px;
    }
    .dot{
      width:14px;
      height:14px;
      border-radius:4px;
      border:1px solid rgba(0,0,0,.15);
      display:inline-block;
    }

    /* ===== MINI PREVIEW ===== */
    .mini-wrap{
      border:0;
      border-radius:14px;
      padding:14px;
      padding-bottom:80px;
      background:#f8fafc;
      min-width: 0;
      overflow: visible;
    }
    .mini-title{
      font-weight:900;
      color:#0b1220;
      margin-bottom:10px;
    }

    /* ✅ bloques por grupo */
    .mini-groups{
      display:flex;
      flex-direction:column;
      gap:14px;
    }

    .mini-group{
      border-radius:12px;
      background: rgba(255,255,255,.55);
      border:1px dashed rgba(15,23,42,.14);
      padding:10px;
      min-width: 0;
      overflow: visible;
    }

    .mini-group-label{
      font-size:11px;
      font-weight:900;
      color:#334155;
      margin-bottom:6px;
    }

    /* ✅ CLAVE: wrapper INLINE del grupo (brazos/patas se posicionan aquí) */
    .mini-support-wrap{
      --armW: 48px;
      --armOverlap: 14px;
      --colW: 60px;
      position:relative;
      display:inline-block;
      padding-left:  calc(var(--armW) - var(--armOverlap));
      padding-right: calc(var(--armW) - var(--armOverlap));
      padding-bottom: 74px;
    }

    /* Centrar el wrapper dentro del grupo */
    .mini-support-center{
      overflow-x: auto;
      padding-bottom: 6px;
      text-align:center;
      cursor: grab;
      user-select: none;
    }
    .mini-support-center.is-dragging{
      cursor: grabbing;
    }

    .group-roof{
      width: calc(var(--colsN) *60px);
      height: 14px;
      background: var(--col-border, #000);
      border-radius: 6px 6px 0 0;
      display: block;
      margin: 10px auto -6px;
      position: relative;
      z-index: 3;
    }

    .cols{
      position:relative;
      z-index:2;
      display:flex;
      gap:0px;
      flex-wrap:nowrap;
      justify-content:center;
      width: max-content;
      min-width: 100%;
      margin-top:6px;
    }

    .group-roof + .cols{
      margin-top: 0;
    }

    .col-shell{ width:60px; display:flex; flex-direction:column; gap:5px; }
    .col-topbar{
      padding:5px 7px;
      border-radius:8px;
      background:#003b73;
      color:#fff;
      font-weight:900;
      font-size:11px;
      text-align:center;
    }

    .col-card{
      width:60px;
      border-style:solid;
      border-color: var(--col-border, #000);
      border-left-width:3px;
      border-right-width:3px;
      border-top-width:6px;
      border-bottom-width:6px;
      border-radius:8px;
      overflow:hidden;
      background:#f7f7f7;
      position:relative;
      z-index:2;
    }

    .col-body{
      height:calc(180px * var(--hscale));
      background:#eaeaea;
      display:flex;
      flex-direction:column;
    }

    .col-half{
      height:calc(90px * var(--hscale));
      display:flex;
      flex-direction:column;
      overflow:hidden;
    }

    .half-sep{ border-top:2px dashed rgba(0,0,0,.25); height:0; }

    .door{
      width:100%;
      border-left:1px solid rgba(44,62,80,.7);
      border-right:1px solid rgba(44,62,80,.7);
      border-top:1px solid rgba(44,62,80,.7);
      background: var(--door-color, #3a9efc);
      position:relative;
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:hidden;
    }
    .door.last{ border-bottom:1px solid rgba(44,62,80,.7); }

    .door .num{
      position:absolute;
      left:4px;
      top:3px;
      font-weight:900;
      font-size:9px;
      background: rgba(0,0,0,.65);
      color:#fff;
      border-radius:999px;
      padding:1px 5px;
      line-height:1.2;
      z-index:2;
    }

    .door.screen{ padding:3px; }
    .door.screen img{
      width:135%;
      height:135%;
      object-fit:contain;
      pointer-events:none;
      user-select:none;
    }

    /* ✅ Metacrilato en miniatura */
    .door.methacrylate::after{
      content:"";
      position:absolute;
      inset:6px;
      background:rgba(0,0,0,.38);
      border-radius:3px;
      pointer-events:none;
      z-index:1;
    }

    .badge{
      display:inline-flex;
      align-items:center;
      padding:4px 10px;
      border-radius:999px;
      font-weight:900;
      font-size:12px;
      border:1px solid rgba(15,23,42,.10);
      background:#fff;
      margin-left:6px;
    }
    
    /* ✅ PATAS por grupo (mini) -> imagen + grid como Resumen */
    .mini-legs-under{
      width: calc(var(--colsN) * var(--colW));
      display:grid;
      grid-template-columns: repeat(var(--colsN), var(--colW));
      pointer-events:none;
      user-select:none;
      z-index:1;
    }

    .mini-leg-img{
      width:60px;
      height:60px;
      object-fit:contain;
      justify-self:center;
    }

    /* brazos posicionados respecto al WRAPPER */
    .mini-arm{
      position:absolute;
      top: var(--armTop, 14px);
      width: var(--armW);
      height: var(--armH, 140px);
      object-fit:contain;
      pointer-events:none;
      z-index:1;
    }
    .mini-arm.left{ left: calc(-0.01 * var(--armOverlap)); transform:scaleX(-1); }
    .mini-arm.right{ right: calc( 0.05 * var(--armOverlap)); }

    /* ===== Modal (simple) ===== */
    .modalx{
      position: fixed;
      inset: 0;
      display: none;
      z-index: 9999;
    }
    .modalx.is-open{ display:block; }

    .modalx__backdrop{
      position:absolute;
      inset:0;
      background: rgba(2,6,23,.55);
      backdrop-filter: blur(2px);
    }

    .modalx__dialog{
      position: relative;
      max-width: 560px;
      margin: 8vh auto;
      background:#fff;
      border:1px solid rgba(15,23,42,.14);
      border-radius:16px;
      box-shadow: 0 20px 45px rgba(2,20,60,.20);
      overflow:hidden;
    }

    .modalx__head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      padding:14px 16px;
      border-bottom:1px solid rgba(15,23,42,.10);
    }

    .modalx__title{
      margin:0;
      font-size:16px;
      font-weight:900;
    }

    .modalx__close{
      border:0;
      background:transparent;
      cursor:pointer;
      font-size:22px;
      line-height:1;
      padding:6px 10px;
      border-radius:10px;
    }
    .modalx__close:hover{ background: rgba(2,6,23,.06); }

    .modalx__body{ padding:16px; }
    .modalx__footer{
      padding:14px 16px;
      border-top:1px solid rgba(15,23,42,.10);
      display:flex;
      justify-content:flex-end;
      gap:10px;
      flex-wrap:wrap;
    }

    .form-row{
      display:grid;
      grid-template-columns: 1fr;
      gap:10px;
    }
    .field label{
      display:block;
      font-size:12px;
      font-weight:900;
      color:var(--muted);
      margin-bottom:6px;
    }
    .field input{
      width:100%;
      border:1px solid rgba(15,23,42,.14);
      border-radius:12px;
      padding:10px 12px;
      outline:none;
    }
    .field input:focus{
      border-color: rgba(11,118,216,.55);
      box-shadow: 0 0 0 3px rgba(11,118,216,.12);
    }

    .door.mailbox{
      padding:0;
    }

    .door.mailbox img{
      width:80%;
      height:100%;
      object-fit:fill;
      pointer-events:none;
      user-select:none;
      display:block;
    }
  </style>
{% endblock %}

{% block content %}
<div class="wrap">

  <h1 class="page-title">Configuraciones del proyecto</h1>
  <div class="muted" style="margin-top:6px;">
    Proyecto: <b>{{ project.projectName }}</b> · Comercial: <b>{{user.name}}</b>
  </div>

  <div class="info-bar">
    <div class="info-item">
      <div class="info-ico" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Z" stroke="#0b76d8" stroke-width="2"/>
          <path d="M4 21a8 8 0 0 1 16 0" stroke="#0b76d8" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      <div>
        <div class="info-k">Cliente</div>
        <div class="info-v">{{ project.clientName ?: '—' }}</div>
      </div>
    </div>

    <div class="info-item">
      <div class="info-ico" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M4 6h16v12H4V6Z" stroke="#0b76d8" stroke-width="2" stroke-linejoin="round"/>
          <path d="m4 7 8 6 8-6" stroke="#0b76d8" stroke-width="2" stroke-linejoin="round"/>
        </svg>
      </div>
      <div>
        <div class="info-k">Email</div>
        <div class="info-v">{{ project.email ?: '—' }}</div>
      </div>
    </div>

    <div class="info-item">
     <div class="info-ico" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M12 22s7-5.2 7-12a7 7 0 1 0-14 0c0 6.8 7 12 7 12Z" stroke="#0b76d8" stroke-width="2" stroke-linejoin="round"/>
          <path d="M12 10.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" stroke="#0b76d8" stroke-width="2"/>
        </svg>
      </div>
      <div>
        <div class="info-k">Ubicación</div>
        <div class="info-v">{{ project.city ?: '—' }} - {{ project.address }}</div>
      </div>

    </div>

    <div class="info-item">

      <div class="info-ico" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1A19.5 19.5 0 0 1 3.2 10.8 19.8 19.8 0 0 1 .1 2.2 2 2 0 0 1 2.1 0h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.4 2.1L6 8a16 16 0 0 0 10 10l1.5-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.7.6A2 2 0 0 1 22 16.9Z" stroke="#0b76d8" stroke-width="2" stroke-linejoin="round"/>
        </svg>
      </div>
      <div>
        <div class="info-k">Teléfono</div>
        <div class="info-v">{{ project.phone ?: '—' }}</div>
      </div>

      {% if project.user.id == app.user.id and project.status == "0" %}
        <a class="btn primary icon" style="margin-left:80px;"
          href="#"
          id="openEditClient">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 20h9" stroke="white" stroke-width="2" stroke-linecap="round"/>
            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z" stroke="white" stroke-width="2" stroke-linejoin="round"/>
          </svg>
          Editar
        </a>
      {% endif %}
    </div>
  </div>

  <div class="modalx" id="editClientModal" aria-hidden="true">
    <div class="modalx__backdrop" data-close="1"></div>

    <div class="modalx__dialog" role="dialog" aria-modal="true" aria-labelledby="editClientTitle">
      <div class="modalx__head">
        <h4 class="modalx__title" id="editClientTitle">Editar datos</h4>
        <button type="button" class="modalx__close" aria-label="Cerrar" data-close="1">×</button>
      </div>

      <form method="post" action="{{ path('project_update_info', {id: project.id}) }}">
        <div class="modalx__body">
          <input type="hidden" name="_token" value="{{ csrf_token('update_project_info_' ~ project.id) }}">

          <div class="form-row">
            <div class="field">
              <label>Cliente</label>
              <input type="text" name="clientName" value="{{ project.clientName }}">
            </div>

            <div class="field">
              <label>Email</label>
              <input type="email" name="email" value="{{ project.email }}">
            </div>

            <div class="field">
              <label>Teléfono</label>
              <input type="text" name="phone" value="{{ project.phone }}">
            </div>

            <div class="field">
              <label>Ubicación</label>
              <input type="text" name="city" value="{{ project.city }}">
            </div>

            <div class="field">
              <label>Dirección</label>
              <input type="text" name="address" value="{{ project.address }}">
            </div>
          </div>
        </div>

        <div class="modalx__footer">
          <button type="button" class="btn" data-close="1">Cancelar</button>
          <button type="submit" class="btn primary">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>

  <div class="top-actions">
    <a class="btn" href="{{ path('projects_list', { user_id: app.user.id }) }}">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M15 18 9 12l6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Volver a proyectos
    </a>

    {% if project.status == 0 and app.user.id == user.id %}
      <a class="btn primary" href="{{ path('configuration_type', { project_id: project.id }) }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 5v14M5 12h14" stroke="white" stroke-width="2" stroke-linecap="round"/>
        </svg>
        Nueva configuración
      </a>
    {% endif %}

    {% if project.status == 0 and app.user.id == user.id %}
      <a class="btn reject icon" href="{{ path('project_reject', { id: project.id }) }}"
          onclick="return confirm('¿Seguro que quieres rechazar esta configuración?');">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M14 2v6h6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        </svg>
        Rechazar proyecto
      </a>
    {% endif %}
  </div>

  {% if items is empty %}
    <div class="card">
      <b>No hay configuraciones aún.</b>
      {% if app.user.id == user.id %}
        <div style="margin-top:10px;">
          <a class="btn primary" href="{{ path('configuration_type', { project_id: project.id }) }}">
            Nueva configuración
          </a>
        </div>
      {% endif %}
    </div>
  {% else %}

    {% for it in items %}
      {% set c = it.configuration %}
      {% set p = it.payload %}
      {% if p is not iterable %}{% set p = {} %}{% endif %}

      {% set groups = p.groups ?? [] %}
      {% if groups is not iterable %}{% set groups = [] %}{% endif %}

      {% set columnsFlat = p.columns ?? [] %}
      {% if columnsFlat is not iterable %}{% set columnsFlat = [] %}{% endif %}

      {% if groups is empty and columnsFlat is not empty %}
        {% set groups = [columnsFlat] %}
      {% endif %}

      {% set columnsAll = [] %}
      {% for g in groups %}
        {% if g is iterable %}
          {% set columnsAll = columnsAll|merge(g) %}
        {% endif %}
      {% endfor %}

      {% set doorColor = p.colorDoor ?? '#3a9efc' %}
      {% set doorColorRal = p.colorDoorRal ?? p.colorDoor ?? '#3a9efc' %}
      {% set bodyColor = p.colorBody ?? '#000' %}
      {% set bodyColorRal = p.colorBodyRal ?? p.colorBody ?? '#000' %}
      {% set addons = p.addons ?? {} %}

      {% set type = p.type ?? '—' %}
      {% set instalacion = p.instalacion ?? '' %}
      {% set agrupacionCombinada = p.agrupacion_combinada ?? false %}
      {% set mailboxGroup = p.mailboxGroup ?? null %}

      {% set selectedType  = p.bracketType ?? '' %}
      {% set selectedColor = p.bracketColor ?? '' %}
      {% set isSoporteSuelo = (instalacion == 'soporte_suelo') %}
      {% set mbLegPos = p.mbLegPositions ?? [] %}
      {% if mbLegPos is not iterable %}{% set mbLegPos = [] %}{% endif %}

      {% if isSoporteSuelo and selectedType == 'brazos' and selectedColor %}
        {% set armSrc =
          selectedColor == 'blanco' ? asset('assets/brazo_blanco.jpg') :
          (selectedColor == 'plata' ? asset('assets/brazo_plata.jpg') : asset('assets/brazo_negro.jpg'))
        %}
      {% endif %}

      {% set legClass = selectedColor == 'blanco' ? 'white' : (selectedColor == 'plata' ? 'silver' : 'black') %}

      <div class="card">
        <div class="config-head">
          <div>
            <div class="config-title">
              Configuración #{{ c.id }}
              {% if c.status == 0 %}
                <span class="badge open">Abierta</span>
              {% elseif c.status == 1 %}
                <span class="badge closed">Cerrada</span>
              {% else %}
                <span class="badge accepted">Aceptada</span>
              {% endif %}
            </div>

            <div class="config-sub">
              Tipo: <b>{{ type }}</b>
              {% if instalacion %}
                · Instalación: <b>{{ instalacion }}</b>
              {% endif %}
              {% if c.createdAt is defined and c.createdAt %}
                · Creada: <b>{{ c.createdAt|date('d/m/Y H:i') }}</b>
              {% endif %}
              {% set navOfferNum = p._navOfferResult.result.Cabecera.NumeroOfertaNav ?? null %}
              {% if navOfferNum %}
                · Oferta NAV: <b style="color:#16a34a;">{{ navOfferNum }}</b>
              {% endif %}
            </div>
          </div>

          <div class="actions">

            {% if c.status == 2 and is_granted('ROLE_TECNICO') %}
              <a class="btn accept icon" href="{{ path('configuration_accept', { id: c.id }) }}"
                 onclick="return confirm('¿Seguro que quieres aceptar esta configuración?');">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                  <path d="M14 2v6h6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                </svg>
                Bajar detalles técnicos
              </a>
            {% endif %}
            {% if project.status == 0 and app.user.id == user.id %}
              <a class="btn accept icon" href="{{ path('configuration_accept', { id: c.id }) }}"
                 onclick="return confirm('¿Seguro que quieres aceptar esta configuración?');">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                  <path d="M14 2v6h6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                </svg>
                Aceptar configuración
              </a>
            {% endif %}

            {% if project.status == 0 and app.user.id == user.id %}
              <a class="btn icon" href="{{ path('configuration_copy', { id: c.id }) }}">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M9 9h11v11H9V9Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                  <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                Copiar
              </a>
            {% endif %}

            <a class="btn icon" href="{{ path('configuration_summary', { id: c.id }) }}">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                <path d="M14 2v6h6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              </svg>
              Resumen
            </a>

            {% if c.status == 0 and project.status == 0 and app.user.id == user.id %}
              <a class="btn primary icon" href="{{ path('configuration_columns', { project_id: project.id, config_id: c.id }) }}">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 20h9" stroke="white" stroke-width="2" stroke-linecap="round"/>
                  <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z" stroke="white" stroke-width="2" stroke-linejoin="round"/>
                </svg>
                Editar
              </a>
            {% endif %}

            {% if app.user.id == project.user.id %}
              <a class="btn icon" href="{{ path('configuration_pdf', { id: c.id }) }}">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                  <path d="M14 2v6h6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                </svg>
                PDF
              </a>
            {% endif %}

          </div>
        </div>

        <div class="config-body">
          <div>
            <div class="kvs">
              <div class="kv"><div class="k">Estado</div><div class="v">{{ c.statusLabel }}</div></div>
              <div class="kv"><div class="k">Columnas</div><div class="v">{{ columnsAll|length }}</div></div>
              <div class="kv">
                <div class="k">Color cuerpo</div>
                <div class="v"><span class="swatch"><span class="dot" style="background: {{ bodyColor }};"></span>{{ bodyColorRal }}</span></div>
              </div>
              <div class="kv">
                <div class="k">Color puerta</div>
                <div class="v"><span class="swatch"><span class="dot" style="background: {{ doorColor }};"></span>{{ doorColorRal }}</span></div>
              </div>
              <div class="kv wide"><div class="k">Config ID</div><div class="v">#{{ c.id }}</div></div>
            </div>
          </div>

          <div class="mini-wrap">
            <div class="mini-title">Vista previa (miniatura)</div>

            {% if columnsAll is empty %}
              <div style="margin-top:8px; color:#c0392b; font-weight:900;">Sin columnas</div>
            {% else %}

              {% set isHome = (type == 'home') %}
              {% set isZocalo = (isHome and instalacion == 'zocalo') %}
              {% set isEmpotradoLike = (isHome and (instalacion == 'empotrado' or instalacion == 'soporte_suelo' or instalacion == 'colgado')) %}
              {% set topCap = isZocalo ? (p.topCap|default(kuik.default_top_cap)) : kuik.default_top_cap %}
              {% set bottomCap = isZocalo ? kuik.bottom_cap_zocalo : kuik.default_bottom_cap %}
              {% set singleCap = isEmpotradoLike ? (p.singleCap|default(40)) : kuik.default_single_cap %}

              {% set maxCols = 40 %}
              {% set shown = 0 %}
              {% set totalCols = columnsAll|length %}
              {% set doorIndex = 0 %}

              {# Variables del bloque de buzones — se renderizan dentro del último grupo #}
              {% set mbSide  = mailboxGroup.side ?? 'right' %}
              {% set mbRows  = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.rows ?? 0) : 0 %}
              {% set mbCols  = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.cols ?? 0) : 0 %}
              {% set mbCells = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.cells ?? []) : [] %}
              {# Dimensiones del bloque de buzones para la escala mini #}
              {% set mbLockerPx = singleCap * kuik.scale_list %}
              {% set mbCellW    = mbRows > 0 ? ((mbLockerPx / mbRows) * 2.2)|round : 44 %}
              {# Ancho total del bloque (para offset de patas): cols * cellW + 8px bordes #}
              {% set mbBlockPx  = (mbRows > 0 and mbCols > 0) ? (mbCols * mbCellW + 8) : 0 %}
              {% set lastGroupIdx = groups|length %}

              <div class="mini-groups" style="--door-color: {{ doorColor }}; --col-border: {{ bodyColor }};">

                {% for groupCols in groups %}
                  {% if shown < maxCols %}
                    {% if groupCols is not iterable %}{% set groupCols = [] %}{% endif %}
                    {% set left = maxCols - shown %}
                    {% set colsToShow = groupCols|slice(0, left) %}

                    {% if colsToShow is not empty %}
                      {% set isLastGroup = loop.index == lastGroupIdx %}
                      {% set legSrc = selectedColor == 'blanco' ? asset('assets/pie_blanco.jpg') : (selectedColor == 'plata' ? asset('assets/pie_plata.jpg') : asset('assets/pie_negro.jpg')) %}
                      {% set firstCol = colsToShow|first %}
                      {% set firstColBlocks = (firstCol.single.blocks is defined and firstCol.single.blocks is not empty) ? firstCol.single.blocks : ((firstCol.top.blocks ?? [])|merge(firstCol.bottom.blocks ?? [])) %}
                      {% set numRows = firstColBlocks|length %}
                      <div class="mini-group" {% if instalacion == 'soporte_suelo' %} style="padding-bottom:70px;" {% endif %}>

                        <div class="mini-group-label">Grupo {{ loop.index }}</div>

                        <div class="mini-support-center">
                          <div class="mini-support-wrap" style="--colsN: {{ colsToShow|length }};--armTop:{{ singleCap > 50 ? '40px' : '14px' }};--armH:{{ (singleCap * 1.65 + 60)|round }}px;">

                            {% if isSoporteSuelo and selectedType == 'brazos' and selectedColor %}
                              <img class="mini-arm left"  src="{{ armSrc }}" alt="Brazo izq">
                              <img class="mini-arm right" src="{{ armSrc }}" alt="Brazo der">
                            {% endif %}

                            {% if not isHome %}
                              <div class="group-roof"></div>
                            {% endif %}

                            <div class="cols">

                              {# Buzones IZQUIERDA — solo en último grupo, primer item del flex #}
                              {% if isLastGroup and mbRows > 0 and mbCols > 0 and mbSide == 'left' %}
                                <div style="position:relative;flex-shrink:0;">
                                  <div style="display:flex;flex-direction:row;height:calc({{ singleCap }}px * var(--hscale) + 12px);border:4px solid var(--col-border,#000);border-radius:6px;overflow:hidden;">
                                    {% for c in 0..(mbCols - 1) %}
                                      <div style="display:flex;flex-direction:column;flex:1;width:{{ mbCellW }}px;">
                                        {% for r in 0..(mbRows - 1) %}
                                          {% set cellIdx = r * mbCols + c %}
                                          {% set filled = mbCells[cellIdx] ?? true %}
                                          <div style="flex:1;width:{{ mbCellW }}px;overflow:hidden;border:1px solid {{ filled ? '#1187e6' : '#cbd5e1' }};background:{{ filled ? '#fff' : '#f0f4f8' }};">
                                            {% if filled %}<img src="{{ kuik.img_buzon_btv }}" alt="" style="width:100%;height:100%;object-fit:cover;display:block;">{% endif %}
                                          </div>
                                        {% endfor %}
                                      </div>
                                    {% endfor %}
                                  </div>
                                  {% if isSoporteSuelo %}
                                    {% set _mbMiniLegH = 80 %}
                                    {% set _mbMiniCellW = mbCellW %}
                                    {% if selectedType == 'patas' %}
                                      {% set _n = mbCols %}
                                      {% if _n == 1 %}{% set _autoCols = [1] %}
                                      {% elseif _n == 2 %}{% set _autoCols = [1, 2] %}
                                      {% elseif _n == 3 %}{% set _autoCols = [1, 3] %}
                                      {% elseif _n == 4 %}{% set _autoCols = [2, 3] %}
                                      {% elseif _n == 5 %}{% set _autoCols = [2, 4] %}
                                      {% elseif _n == 6 %}{% set _autoCols = [2, 4, 6] %}
                                      {% elseif _n == 7 %}{% set _autoCols = [2, 4, 6, 7] %}
                                      {% elseif _n == 8 %}{% set _autoCols = [2, 4, 6, 8] %}
                                      {% elseif _n == 9 %}{% set _autoCols = [2, 4, 7, 8] %}
                                      {% else %}{% set _autoCols = [2, 4, 7, 9] %}{% endif %}
                                      <div style="position:absolute;top:100%;left:4px;width:{{ mbCols * _mbMiniCellW }}px;height:{{ _mbMiniLegH }}px;">
                                        {% for _c in _autoCols %}
                                          {% set _xC = (_c - 0.5) * _mbMiniCellW %}
                                          <img style="position:absolute;left:{{ (_xC - 40)|round }}px;top:0;width:80px;height:{{ _mbMiniLegH }}px;object-fit:contain;" src="{{ legSrc }}" alt="Pata">
                                        {% endfor %}
                                      </div>
                                    {% elseif selectedType == 'brazos' and mbLegPos|length > 0 %}
                                      <div style="position:absolute;top:100%;left:4px;width:{{ mbCols * _mbMiniCellW }}px;height:{{ _mbMiniLegH }}px;">
                                        {% for _i in mbLegPos %}
                                          {% set _xC = (_i is even) ? ((_i / 2) + 0.5) * _mbMiniCellW : ((_i + 1) / 2) * _mbMiniCellW %}
                                          <img style="position:absolute;left:{{ (_xC - 40)|round }}px;top:0;width:80px;height:{{ _mbMiniLegH }}px;object-fit:contain;" src="{{ legSrc }}" alt="Pata">
                                        {% endfor %}
                                      </div>
                                    {% endif %}
                                  {% endif %}
                                </div>
                              {% endif %}

                              {% for col in colsToShow %}
                                {% set isEmpotrado = (col.single is defined and col.single is not empty) %}

                                <div class="col-shell">

                                  <div class="col-card">
                                    {% if isEmpotrado and instalacion == 'colgado' %}
                                      {% set colSingleSum = 0 %}
                                      {% for blk in (col.single.blocks ?? []) %}{% set colSingleSum = colSingleSum + (blk.h|default(blk)) %}{% endfor %}
                                    {% endif %}
                                    <div class="col-body"
                                      {% if isEmpotrado %}
                                        style="height: calc({{ instalacion == 'colgado' ? colSingleSum : singleCap }}px * var(--hscale));"
                                      {% elseif type == 'home' and instalacion == 'zocalo' %}
                                        style="height: calc({{ (topCap + bottomCap) }}px * var(--hscale));"
                                      {% endif %}>

                                      {% if isEmpotrado %}
                                        <div class="col-half" style="height: calc({{ instalacion == 'colgado' ? colSingleSum : singleCap }}px * var(--hscale));">
                                          {% for blk in (col.single.blocks ?? []) %}
                                            {% set hh = blk.h|default(blk) %}
                                            {% set btype = blk.type|default('door') %}

                                            {% if btype != 'screen' and btype != 'mailbox' %}
                                              {% set doorIndex = doorIndex + 1 %}
                                              {% set key = doorIndex ~ '' %}
                                              {% set sel = addons[key] ?? addons[doorIndex] ?? null %}
                                              {% set methacrylate = (sel is iterable and (sel.methacrylate ?? false)) ? true : false %}
                                            {% else %}
                                              {% set methacrylate = false %}
                                            {% endif %}

                                            <div class="door {{ btype == 'screen' ? 'screen' : '' }} {{ btype == 'mailbox' ? 'mailbox' : '' }} {{ methacrylate ? 'methacrylate' : '' }} {% if loop.last %}last{% endif %}"
                                                style="height: calc({{ hh }}px * var(--hscale));">
                                              {% if btype == 'screen' %}
                                                <img src="{{ asset('assets/pantalla.png') }}" alt="Pantalla">
                                              {% elseif btype == 'mailbox' %}
                                                {% set _elec = blk.electronico ?? false %}
                                                {% set _tarj = blk.tarjetero ?? false %}
                                                {% set _buzonImg = _elec ? (_tarj ? 'assets/buzon_kuik_electronico_con_tarjetero.png' : 'assets/buzon_kuik_electronico_sin_tarjetero.png') : (_tarj ? 'assets/buzon_kuik_mecanico_con_tarjetero.png' : 'assets/buzon_kuik_mecanico_sin_tarjetero.png') %}
                                                <img src="{{ asset(_buzonImg) }}" alt="Buzón">
                                              {% else %}
                                                <div class="num">{{ doorIndex }}</div>
                                              {% endif %}
                                            </div>
                                          {% endfor %}
                                        </div>
                                      {% else %}
                                        <div class="col-half" style="height: calc({{ topCap }}px * var(--hscale));">
                                          {% for blk in (col.top.blocks ?? []) %}
                                            {% set hh = blk.h|default(blk) %}
                                            {% set btype = blk.type|default('door') %}

                                            {% if btype != 'screen' and btype != 'mailbox' %}
                                              {% set doorIndex = doorIndex + 1 %}
                                              {% set key = doorIndex ~ '' %}
                                              {% set sel = addons[key] ?? addons[doorIndex] ?? null %}
                                              {% set methacrylate = (sel is iterable and (sel.methacrylate ?? false)) ? true : false %}
                                            {% else %}
                                              {% set methacrylate = false %}
                                            {% endif %}

                                            <div class="door {{ btype == 'screen' ? 'screen' : '' }} {{ btype == 'mailbox' ? 'mailbox' : '' }} {{ methacrylate ? 'methacrylate' : '' }} {% if loop.last %}last{% endif %}"
                                                style="height: calc({{ hh }}px * var(--hscale));">
                                              {% if btype == 'screen' %}
                                                <img src="{{ asset('assets/pantalla.png') }}" alt="Pantalla">
                                              {% elseif btype == 'mailbox' %}
                                                {% set _elec = blk.electronico ?? false %}
                                                {% set _tarj = blk.tarjetero ?? false %}
                                                {% set _buzonImg = _elec ? (_tarj ? 'assets/buzon_kuik_electronico_con_tarjetero.png' : 'assets/buzon_kuik_electronico_sin_tarjetero.png') : (_tarj ? 'assets/buzon_kuik_mecanico_con_tarjetero.png' : 'assets/buzon_kuik_mecanico_sin_tarjetero.png') %}
                                                <img src="{{ asset(_buzonImg) }}" alt="Buzón">
                                              {% else %}
                                                <div class="num">{{ doorIndex }}</div>
                                              {% endif %}
                                            </div>
                                          {% endfor %}
                                        </div>

                                        <div class="half-sep"></div>

                                        <div class="col-half" style="height: calc({{ bottomCap }}px * var(--hscale));">
                                          {% for blk in (col.bottom.blocks ?? []) %}

                                            {% set hh = blk.h|default(blk) %}
                                            {% set btype = blk.type|default('door') %}

                                            {% if btype != 'screen' and btype != 'mailbox' %}
                                              {% set doorIndex = doorIndex + 1 %}
                                              {% set key = doorIndex ~ '' %}
                                              {% set sel = addons[key] ?? addons[doorIndex] ?? null %}
                                              {% set methacrylate = (sel is iterable and (sel.methacrylate ?? false)) ? true : false %}
                                            {% else %}
                                              {% set methacrylate = false %}
                                            {% endif %}

                                            <div class="door {{ btype == 'screen' ? 'screen' : '' }} {{ btype == 'mailbox' ? 'mailbox' : '' }} {{ methacrylate ? 'methacrylate' : '' }} {% if loop.last %}last{% endif %}"
                                                style="height: calc({{ hh }}px * var(--hscale));">
                                              {% if btype == 'screen' %}
                                                <img src="{{ asset('assets/pantalla.png') }}" alt="Pantalla">
                                              {% elseif btype == 'mailbox' %}
                                                {% set _elec = blk.electronico ?? false %}
                                                {% set _tarj = blk.tarjetero ?? false %}
                                                {% set _buzonImg = _elec ? (_tarj ? 'assets/buzon_kuik_electronico_con_tarjetero.png' : 'assets/buzon_kuik_electronico_sin_tarjetero.png') : (_tarj ? 'assets/buzon_kuik_mecanico_con_tarjetero.png' : 'assets/buzon_kuik_mecanico_sin_tarjetero.png') %}
                                                <img src="{{ asset(_buzonImg) }}" alt="Buzón">
                                              {% else %}
                                                <div class="num">{{ doorIndex }}</div>
                                              {% endif %}
                                            </div>
                                          {% endfor %}
                                        </div>
                                      {% endif %}

                                    </div>
                                  </div>
                                </div>

                              {% endfor %}

                              {# Buzones DERECHA — solo en último grupo, último item del flex #}
                              {% if isLastGroup and mbRows > 0 and mbCols > 0 and mbSide == 'right' %}
                                <div style="position:relative;flex-shrink:0;">
                                  <div style="display:flex;flex-direction:row;height:calc({{ singleCap }}px * var(--hscale) + 12px);border:4px solid var(--col-border,#000);border-radius:6px;overflow:hidden;">
                                    {% for c in 0..(mbCols - 1) %}
                                      <div style="display:flex;flex-direction:column;flex:1;width:{{ mbCellW }}px;">
                                        {% for r in 0..(mbRows - 1) %}
                                          {% set cellIdx = r * mbCols + c %}
                                          {% set filled = mbCells[cellIdx] ?? true %}
                                          <div style="flex:1;width:{{ mbCellW }}px;overflow:hidden;border:1px solid {{ filled ? '#1187e6' : '#cbd5e1' }};background:{{ filled ? '#fff' : '#f0f4f8' }};">
                                            {% if filled %}<img src="{{ kuik.img_buzon_btv }}" alt="" style="width:100%;height:100%;object-fit:cover;display:block;">{% endif %}
                                          </div>
                                        {% endfor %}
                                      </div>
                                    {% endfor %}
                                  </div>
                                  {% if isSoporteSuelo %}
                                    {% set _mbMiniLegH = 80 %}
                                    {% set _mbMiniCellW = mbCellW %}
                                    {% if selectedType == 'patas' %}
                                      {% set _n = mbCols %}
                                      {% if _n == 1 %}{% set _autoCols = [1] %}
                                      {% elseif _n == 2 %}{% set _autoCols = [1, 2] %}
                                      {% elseif _n == 3 %}{% set _autoCols = [1, 3] %}
                                      {% elseif _n == 4 %}{% set _autoCols = [2, 3] %}
                                      {% elseif _n == 5 %}{% set _autoCols = [2, 4] %}
                                      {% elseif _n == 6 %}{% set _autoCols = [2, 4, 6] %}
                                      {% elseif _n == 7 %}{% set _autoCols = [2, 4, 6, 7] %}
                                      {% elseif _n == 8 %}{% set _autoCols = [2, 4, 6, 8] %}
                                      {% elseif _n == 9 %}{% set _autoCols = [2, 4, 7, 8] %}
                                      {% else %}{% set _autoCols = [2, 4, 7, 9] %}{% endif %}
                                      <div style="position:absolute;top:100%;left:4px;width:{{ mbCols * _mbMiniCellW }}px;height:{{ _mbMiniLegH }}px;">
                                        {% for _c in _autoCols %}
                                          {% set _xC = (_c - 0.5) * _mbMiniCellW %}
                                          <img style="position:absolute;left:{{ (_xC - 40)|round }}px;top:0;width:80px;height:{{ _mbMiniLegH }}px;object-fit:contain;" src="{{ legSrc }}" alt="Pata">
                                        {% endfor %}
                                      </div>
                                    {% elseif selectedType == 'brazos' and mbLegPos|length > 0 %}
                                      <div style="position:absolute;top:100%;left:4px;width:{{ mbCols * _mbMiniCellW }}px;height:{{ _mbMiniLegH }}px;">
                                        {% for _i in mbLegPos %}
                                          {% set _xC = (_i is even) ? ((_i / 2) + 0.5) * _mbMiniCellW : ((_i + 1) / 2) * _mbMiniCellW %}
                                          <img style="position:absolute;left:{{ (_xC - 40)|round }}px;top:0;width:80px;height:{{ _mbMiniLegH }}px;object-fit:contain;" src="{{ legSrc }}" alt="Pata">
                                        {% endfor %}
                                      </div>
                                    {% endif %}
                                  {% endif %}
                                </div>
                              {% endif %}

                            </div>{# /cols #}

                            {% if isSoporteSuelo %}
                              {% set n = colsToShow|length %}
                              {% if n == 1 %}{% set legPositions = [1] %}
                              {% elseif n == 2 %}{% set legPositions = [1, 2] %}
                              {% elseif n == 3 %}{% set legPositions = [1, 3] %}
                              {% elseif n == 4 %}{% set legPositions = [2, 3] %}
                              {% elseif n == 5 %}{% set legPositions = [2, 4] %}
                              {% elseif n == 6 %}{% set legPositions = [2, 4, 6] %}
                              {% elseif n == 7 %}{% set legPositions = [2, 4, 6, 7] %}
                              {% elseif n == 8 %}{% set legPositions = [2, 4, 6, 8] %}
                              {% elseif n == 9 %}{% set legPositions = [2, 4, 7, 8] %}
                              {% else %}{% set legPositions = [2, 4, 7, 9] %}{% endif %}
                              {% if agrupacionCombinada and mbSide == 'left' and n > 5 %}
                                {% if n == 6 %}{% set legPositions = [1, 3, 5] %}
                                {% elseif n == 7 %}{% set legPositions = [1, 2, 4, 6] %}
                                {% elseif n == 8 %}{% set legPositions = [1, 3, 5, 7] %}
                                {% elseif n == 9 %}{% set legPositions = [2, 3, 6, 8] %}
                                {% endif %}
                              {% endif %}
                              {% set _taqLegLeft = (isLastGroup and mbBlockPx > 0 and mbSide == 'left') ? mbBlockPx : 0 %}
                              <div style="position:relative; height:80px; margin-left:{{ _taqLegLeft }}px; width:{{ n * 60 }}px; pointer-events:none; flex-shrink:0;">
                                {% for pos in legPositions %}
                                  {% set _xC = (pos - 0.5) * 60 %}
                                  <img style="position:absolute; left:{{ (_xC - 40)|round }}px; top:0; width:80px; height:80px; object-fit:contain;" src="{{ legSrc }}" alt="Pata">
                                {% endfor %}
                              </div>
                            {% endif %}

                          </div>{# /mini-support-wrap #}
                        </div>{# /mini-support-center #}

                      </div>{# /mini-group #}

                      {% set shown = shown + (colsToShow|length) %}
                    {% endif %}
                  {% endif %}
                {% endfor %}

                {% if totalCols > maxCols %}
                  <div class="muted" style="margin-top:10px;">
                    Mostrando {{ maxCols }} de {{ totalCols }} columnas…
                  </div>
                {% endif %}

              </div>{# /mini-groups #}

            {% endif %}
          </div>

        </div>
      </div>
    {% endfor %}

  {% endif %}
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    window.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.mini-support-center').forEach(function(scroll) {
        var isDragging = false, startX, scrollLeft;
        scroll.addEventListener('mousedown', function(e) {
          isDragging = true;
          scroll.classList.add('is-dragging');
          startX     = e.pageX - scroll.getBoundingClientRect().left;
          scrollLeft = scroll.scrollLeft;
          e.preventDefault();
        });
        document.addEventListener('mouseup', function() {
          isDragging = false;
          scroll.classList.remove('is-dragging');
        });
        scroll.addEventListener('mousemove', function(e) {
          if (!isDragging) return;
          var x    = e.pageX - scroll.getBoundingClientRect().left;
          var walk = (x - startX) * 1.2;
          scroll.scrollLeft = scrollLeft - walk;
        });
      });

      const openBtn = document.getElementById('openEditClient');
      const modal = document.getElementById('editClientModal');

      if (!openBtn || !modal) return;

      const open = () => {
        modal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        modal.setAttribute('aria-hidden', 'false');

        const first = modal.querySelector('input[name="clientName"]');
        if (first) first.focus();
      };

      const close = () => {
        modal.classList.remove('is-open');
        document.body.style.overflow = '';
        modal.setAttribute('aria-hidden', 'true');
      };

      openBtn.addEventListener('click', (e) => {
        e.preventDefault();
        open();
      });

      modal.addEventListener('click', (e) => {
        const closeEl = e.target.closest('[data-close="1"]');
        if (closeEl) close();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('is-open')) close();
      });
    });
  </script>
{% endblock %}