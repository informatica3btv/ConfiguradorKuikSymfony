{% extends 'layout.html.twig' %}
{% block page_title %}{{ 'recover.title'|trans }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --hscale: {{ kuik.scale_recover }};

      --bg:#f6f9fc;
      --ink:#0b1220;
      --muted:#6b7280;
      --line: rgba(15,23,42,.12);
      --shadow: 0 10px 25px rgba(2,20,60,.10);
      --shadow-sm: 0 6px 14px rgba(2,20,60,.10);

      --kuik-blue-900:#003b73;
      --kuik-blue-600:#0b76d8;
      --kuik-blue-500:#1187e6;
    }

    .page-wrap{
      max-width: 1600px;
      margin: 22px auto 50px;
      padding: 0 14px;
    }

    .page-head{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:14px;
      flex-wrap:wrap;
      margin-bottom:14px;
    }

    .page-title{
      margin:0;
      font-size:34px;
      font-weight:900;
      letter-spacing:-0.02em;
    }

    .page-sub{
      margin-top:6px;
      color:var(--muted);
      font-size:15px;
      display:flex;
      align-items:center;
      gap:10px;
      flex-wrap:wrap;
    }

    .id-pill{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:6px 10px;
      border-radius:999px;
      background: rgba(11,118,216,.10);
      border:1px solid rgba(11,118,216,.18);
      font-weight:900;
      color:#0b76d8;
    }

    .grid{
      display:grid;
      grid-template-columns: 1.50fr .50fr;
      gap:14px;
      align-items:start;
    }
    @media (max-width: 980px){
      .grid{ grid-template-columns: 1fr; }
    }

    .card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:16px;
      padding:16px;
      box-shadow: 0 1px 0 rgba(15,23,42,.04);
      min-width: 0;
    }

    .card h3{
      margin:0 0 12px;
      font-size:16px;
      font-weight:900;
      letter-spacing:-0.01em;
    }

    .section-sep{
      height:1px;
      background: rgba(15,23,42,.10);
      margin:14px 0;
    }

    /* ===== BUSCADOR ===== */
    .search-row{
      max-width:720px;
      display:flex;
      gap:10px;
      align-items:center;
      margin: 12px 0 10px;
      flex-wrap:wrap;
    }
    .search-row input{
      flex:1;
      padding:14px;
      border-radius:14px;
      border:1px solid rgba(15,23,42,.14);
    }

    .warn{
      max-width:720px;
      margin-top:6px;
      color:#7c2d12;
      background:#fff7ed;
      border:1px solid rgba(124,45,18,.18);
      padding:10px 12px;
      border-radius:14px;
      font-weight:700;
    }

    /* ===== INFO GRID ===== */
    .kvs{
      display:grid;
      grid-template-columns: 1.25fr 0.75fr;
      gap:10px;
    }

    .kv{
      border:1px solid rgba(15,23,42,.10);
      border-radius:14px;
      padding:10px 12px;
      background:#fbfcfe;
    }
    .kv .k{ font-size:12px; color:var(--muted); font-weight:900; }
    .kv .v{ font-size:14px; font-weight:900; margin-top:4px; color:var(--ink); }

    /* ===== PREVIEW ===== */
    .preview-wrap{
      border:1px solid rgba(15,23,42,.10);
      border-radius:16px;
      padding:12px;
      background: #fff;
    }

    .preview-scroll{
      overflow-x: auto;
      padding-bottom: 8px;
      cursor: grab;
      user-select: none;
    }

    .preview-scroll.is-dragging{
      cursor: grabbing;
    }

    .preview-stage{
      display:flex;
      justify-content:flex-start;
      align-items:flex-start;
      width: max-content;
      min-width: 100%;
      padding-bottom: 80px;
    }

    .groups-stage{
      display:flex;
      flex-direction:column;
      gap:70px;
      align-items:center;
      width:100%;
    }

    .group-block{
      width:100%;
    }

    .group-label{
      font-weight:900;
      color:#0b1220;
      font-size:14px;
      margin:6px 0 18px;
      text-align:center;
    }

    .cols{
      position:relative;
      display:grid;
      grid-template-columns: repeat(var(--colsN), 140px);
      justify-content:center;
      margin-top:10px;
    }

    .col-shell{
      width:140px;
      display:flex;
      flex-direction:column;
      gap:6px;
    }

    .col-topbar{
      padding:7px 10px;
      border-radius:12px;
      background: linear-gradient(135deg, var(--kuik-blue-900), #005fae);
      color:#fff;
      font-weight:900;
      box-shadow: var(--shadow-sm);
      text-align:center;
    }

    .col-card{
      width:140px;
      border-style:solid;
      border-color: var(--col-border, #000);
      border-left-width:4px;
      border-right-width:4px;
      border-top-width:8px;
      border-bottom-width:8px;
      overflow:visible;
      background:#f7f7f7;
    }

    .col-body{
      height:calc({{ kuik.default_single_cap }}px * var(--hscale));
      background:#eaeaea;
      display:flex;
      flex-direction:column;
    }

    .col-half{
      height:calc(90px * var(--hscale));
      display:flex;
      flex-direction:column;
      overflow:visible;
    }

    .half-sep{
      border-top:2px dashed rgba(0,0,0,.28);
    }

    /* Bisel de profundidad (fondo) del mueble, igual que en el resumen. */
    .depth-top{
      position:absolute;
      top:-25px;
      left:0px;
      width:100%;
      height:25px;
      background: linear-gradient(rgba(255,255,255,.25), rgba(255,255,255,.25)), var(--col-border);
      transform-origin: left bottom;
      transform: skewX(-49deg);
      z-index:1;
    }
    .depth-right{
      position:absolute;
      top:0px;
      left:100%;
      width:29px;
      height: 100%;
      background: linear-gradient(rgba(0,0,0,.2), rgba(0,0,0,.2)), var(--col-border);
      transform-origin: left top;
      transform: skewY(-41deg);
      z-index:1;
    }
    .depth-label{
      position:absolute;
      right:-48px;
      bottom:-4px;
      display:flex;
      flex-direction:column;
      align-items:center;
      transform: rotate(-41deg);
      transform-origin: right center;
      z-index:4;
    }
    .depth-label .dim-row{ width:50px; }
    .depth-label .dim-value{ white-space:nowrap; }
    .dim-row{ display:flex; align-items:center; gap:2px; font-size:9px; }
    .dim-row .arrow{ font-size:12px; line-height:1; color:#0b1220; }
    .dim-row .line{ flex:1; height:1px; background:#0b1220; }
    .dim-value{ text-align:center; font-size:11px; font-weight:900; color:#0b1220; margin-top:2px; }

    /* Cota de altura (izquierda) y de anchos por columna + total (abajo),
       igual que en el resumen. */
    .height-dim{
      position:absolute;
      left:0;
      top:20px;
      width:38px;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:6px;
      z-index:3;
      overflow:visible;
    }
    .vdim-line{
      display:flex;
      flex-direction:column;
      align-items:center;
      height:100%;
      flex-shrink:0;
    }
    .vdim-line .varrow{ font-size:11px; line-height:1; color:#0b1220; flex-shrink:0; }
    .vdim-line .vline{ width:2px; flex:1; min-height:10px; background:#0b1220; }
    .group-height-label{
      display:inline-block;
      flex-shrink:0;
      transform: rotate(-90deg);
      font-size:13px;
      font-weight:900;
      color:#0b1220;
      white-space:nowrap;
    }

    .col-dim{ margin-top:4px; }

    .group-width-total{ margin:8px auto 0; }
    .group-width-total .dim-value{ font-size:13px; }

    .width-dims-below{ margin-top:10px; }
    .width-dims-row{
      width:100%;
      display:grid;
      grid-template-columns: repeat(var(--colsN), var(--colW));
      justify-content:center;
    }

    /* .door = ranura estática con el "hueco" de fondo (foto teñida del
       color del cuerpo). .door-leaf = la hoja que gira sobre bisagra al
       hacer click, igual que en el resumen. */
    .door{
      width:100%;
      background: var(--col-border, #22262b);
      border-bottom: 1px solid rgba(0,0,0,.35);
      position:relative;
      box-sizing: border-box;
      cursor:pointer;
      z-index:1;
      perspective: 1400px;
    }

    .door-leaf{
      width:100%;
      height:100%;
      display:flex;
      align-items:center;
      justify-content:center;
      position:relative;
      box-sizing: border-box;
      border:1px solid rgba(255,255,255,.6);
      background: var(--door-color, #3a9efc);
      transform-style: preserve-3d;
      transform-origin: right center;
      backface-visibility: hidden;
      transition: transform .55s cubic-bezier(.34,1.15,.64,1), box-shadow .55s ease;
      will-change: transform;
    }

    .door-leaf::before{
      content:"";
      position:absolute;
      top:0; left:0; bottom:0;
      width:6px;
      background: rgba(0,0,0,.32);
      transform: rotateY(90deg) translateX(-3px);
      transform-origin: left center;
      opacity:0;
      transition: opacity .5s ease;
      pointer-events:none;
    }

    .door.is-open .door-leaf{
      transform: skewY(var(--door-skew, 0deg)) rotateY(64deg) translateZ(14px) translateX(-4px);
      box-shadow: -14px 10px 28px rgba(0,0,0,.5);
      z-index:5;
    }

    .door.is-open .door-leaf::before{ opacity:1; }

    .door-leaf::after{
      content:"";
      position:absolute;
      inset:0;
      background: linear-gradient(245deg, rgba(0,0,0,.5), rgba(0,0,0,.15) 40%, transparent 70%);
      opacity:0;
      transition: opacity .45s ease .1s;
      pointer-events:none;
    }

    .door.is-open .door-leaf::after{ opacity:1; }

    .door.screen{
      padding:0;
    }

    .door.screen .door-leaf{
      overflow:hidden;
    }

    .door.screen img{
      width:125%;
      height:125%;
      object-fit:contain;
      pointer-events:none;
      user-select:none;
    }

    .door.mailbox{
      padding:0;
    }

    .door.mailbox .door-leaf{
      overflow:hidden;
    }

    .door.mailbox img{
      position:absolute;
      top:0; left:0;
      width:100%;
      height:100%;
      object-fit:fill;
      pointer-events:none;
      user-select:none;
      display:block;
    }

    .door .size-label{
      font-weight:900;
      font-size:16px;
      color:#fff;
      text-shadow:0 0 3px rgba(0,0,0,.7);
      pointer-events:none;
      user-select:none;
    }

    .door .num{
      position:absolute;
      left:6px;
      top:4px;
      font-weight:900;
      font-size:12px;
      background: rgba(0,0,0,.65);
      color:#fff;
      border-radius:999px;
      padding:2px 7px;
      line-height:1.2;
      z-index:2;
    }

    .door .badges{
      position:absolute;
      right:6px;
      top:4px;
      display:flex;
      gap:4px;
      z-index:2;
    }

    .badge-mini{
      font-size:11px;
      font-weight:900;
      background: rgba(255,255,255,.92);
      border:1px solid rgba(0,0,0,.18);
      border-radius:999px;
      padding:1px 7px;
    }

    /* ===== TABLES ===== */
    .addons-table{a
      width:100%;
      border-collapse:separate;
      border-spacing:0;
      margin-top:10px;
      border:1px solid rgba(15,23,42,.12);
      border-radius:14px;
      overflow:hidden;
      background:#fff;
    }

    .addons-table th,
    .addons-table td{
      padding:10px 12px;
      border-bottom:1px solid rgba(15,23,42,.08);
      font-size:14px;
      text-align:left;
    }

    .addons-table th{
      background:#fbfcfe;
      font-weight:900;
      color:#334155;
      font-size:12px;
    }

    .addons-table tr:last-child td{
      border-bottom:0;
    }

    .support-wrap{
      --armW: 65px;
      --armOverlap: 14px;
      --colW: 140px;
      padding-bottom:155px;
      position: relative;
      display: inline-block;
      padding-left: calc(var(--armW) - var(--armOverlap) + 40px);
      padding-right: calc(var(--armW) - var(--armOverlap));
    }

    .arm-img{
      position:absolute;
      top: 50px;
      width: var(--armW);
      height: calc(90px * var(--hscale) + 16px);
      object-fit: contain;
      z-index: 1;
      pointer-events:none;
      user-select:none;
      padding-bottom: 40px;
    }

    .arm-img.left{
      left: calc(-0.55 * var(--armOverlap));
      transform: scaleX(-1);
    }

    .arm-img.right{
      right: calc(-0.56* var(--armOverlap));
    }

    .legs-under{
      width:100%;
      display:grid;
      grid-template-columns: repeat(var(--colsN), var(--colW));
      justify-content:center;
      pointer-events:none;
      user-select:none;
      z-index:1;
      padding: 0 18px;
    }

    .leg-img{
      width:140px;
      height:175px;
      object-fit:contain;
      justify-self:center;
    }

    /* ===== BUTTONS ===== */
    .btn{
      border:1px solid rgba(15,23,42,.12);
      background:#fff;
      border-radius:12px;
      padding:10px 14px;
      font-weight:900;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      gap:10px;
      text-decoration:none;
      color:#0b1220;
      transition:.15s;
    }

    .btn:hover{
      background: rgba(2,6,23,.03);
    }

    .btn.primary{
      background:#0b76d8;
      border-color:#0b76d8;
      color:#fff;
      box-shadow: 0 10px 18px rgba(11,118,216,.18);
    }

    .btn.primary:hover{
      filter:brightness(.98);
      transform: translateY(-1px);
    }

    .muted{
      color:var(--muted);
      font-size:15px;
    }

    @media (max-width: 1100px){
      .cols{
        grid-template-columns: repeat(auto-fit, minmax(180px, 180px));
      }
    }
  </style>
{% endblock %}

{% block content %}
<div class="page-wrap">
  <div class="page-head">
    <div>
      <h2 class="page-title">{{ 'recover.title'|trans }}</h2>
      <div class="page-sub">{{ 'recover.subtitle'|trans }}</div>
    </div>
  </div>

  <div class="search-row">
    <input id="codeInput" type="number" min="1" placeholder="{{ 'recover.search_placeholder'|trans }}" required>
    <button id="btnSearch" class="btn primary" type="button">{{ 'recover.search_button'|trans }}</button>
    <button id="btnClear" class="btn" type="button">{{ 'recover.clear_button'|trans }}</button>
  </div>

  <div id="msg" class="warn" style="display:none;"></div>

  <div id="result" style="display:none;">
    <div class="page-sub" style="margin: 6px 0 14px;">
      <span class="id-pill">{{ 'recover.config_id_label'|trans }}: <span id="confId">—</span></span>
      <span class="id-pill" id="projPill" style="display:none;">{{ 'recover.project_label'|trans }}: <span id="projName">—</span></span>
    </div>

    <div class="grid">
      <div class="card">
        <h3>{{ 'recover.preview_title'|trans }}</h3>

        <div class="preview-wrap">
          <div class="preview-scroll">
            <div class="preview-stage">
              <div id="previewGroups" class="groups-stage" style="--door-color:#3a9efc; --col-border:#000;"></div>
            </div>
          </div>
        </div>

        <img id="resultadoIA"
             style="max-width:100%; margin-top:12px; display:none; border:1px solid rgba(15,23,42,.12); border-radius:12px;">
      </div>

      <div class="card">
        <h3>{{ 'recover.config_title'|trans }}</h3>

        <div id="infoBox" class="kvs"></div>

        <div class="section-sep"></div>
        <h3>{{ 'recover.doors_by_size_title'|trans }}</h3>
        <div id="doorsTable"></div>

        <div class="section-sep"></div>
        <h3>{{ 'recover.addons_title'|trans }}</h3>
        <div id="addonsTotals" class="kvs" style="margin-top:10px;"></div>

        <h3 style="margin-top:14px;">{{ 'recover.addons_detail_title'|trans }}</h3>
        <div id="addonsDetail"></div>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
  window.I18N_RECOVER = {{ {
    size_header: 'recover.size_header'|trans,
    quantity_header: 'recover.quantity_header'|trans,
    total_doors: 'recover.total_doors'|trans,
    door_header: 'recover.door_header'|trans,
    addon_header: 'recover.addon_header'|trans,
    socket_usb: 'recover.socket_usb'|trans,
    socket: 'recover.socket'|trans,
    usb: 'recover.usb'|trans,
    series_300: 'recover.series_300'|trans,
    series_400: 'recover.series_400'|trans,
    series_500: 'recover.series_500'|trans,
    interior: 'recover.interior'|trans,
    exterior: 'recover.exterior'|trans,
    group_label: 'recover.group_label'|trans,
    no_columns: 'recover.no_columns'|trans,
    no_doors: 'recover.no_doors'|trans,
    no_addons_doors: 'recover.no_addons_doors'|trans,
    invalid_id: 'recover.invalid_id_error'|trans,
    not_found: 'recover.not_found_error'|trans,
    invalid_json: 'recover.invalid_json_error'|trans,
    network_error: 'recover.network_error'|trans,
    project_label: 'recover.project_label'|trans,
    type_label: 'recover.type_label'|trans,
    installation_label: 'recover.installation_label'|trans,
    background_label: 'recover.background_label'|trans,
    location_label: 'recover.location_label'|trans,
    material_label: 'recover.material_label'|trans,
    door_color_label: 'recover.door_color_label'|trans,
    body_color_label: 'recover.body_color_label'|trans,
    columns_label: 'recover.columns_label'|trans,
    total_sockets: 'recover.total_sockets'|trans,
    total_usb: 'recover.total_usb'|trans,
    doors_with_both: 'recover.doors_with_both'|trans
  }|json_encode|raw }};
</script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const input = document.getElementById('codeInput');
  const btnSearch = document.getElementById('btnSearch');
  const btnClear = document.getElementById('btnClear');
  const msg = document.getElementById('msg');

  const result = document.getElementById('result');
  const previewGroups = document.getElementById('previewGroups');
  const infoBox = document.getElementById('infoBox');
  const doorsTable = document.getElementById('doorsTable');
  const addonsTotals = document.getElementById('addonsTotals');
  const addonsDetail = document.getElementById('addonsDetail');

  const confId = document.getElementById('confId');
  const projPill = document.getElementById('projPill');
  const projName = document.getElementById('projName');

  const SCALE = {{ kuik.scale }};
  const FONDO_MM = {{ kuik.fondo_mm|json_encode|raw }};
  const H_HEIGHTS_MM = {{ kuik.h_heights_mm|json_encode|raw }};
  const BOTTOM_CAP_ZOCALO = {{ kuik.bottom_cap_zocalo }};
  const DEFAULT_BOTTOM_CAP = {{ kuik.default_bottom_cap }};
  const DEFAULT_TOP_CAP = {{ kuik.default_top_cap }};
  const TINTED_HUECO_URL = '{{ path('api_tinted_hueco') }}';
  let currentHuecoUrl = null;
  let allDoorEls = [];
  const MAILBOX_IMGS = {
    elecCon: "{{ asset('assets/buzon_kuik_electronico_con_tarjetero.png') }}",
    elecSin: "{{ asset('assets/buzon_kuik_electronico_sin_tarjetero.png') }}",
    mecCon:  "{{ asset('assets/buzon_kuik_mecanico_con_tarjetero.png') }}",
    mecSin:  "{{ asset('assets/buzon_kuik_mecanico_sin_tarjetero.png') }}"
  };

  function safeParse(jsonStr){
    try {
      return JSON.parse(jsonStr);
    } catch(e) {
      return null;
    }
  }

  function showMsg(text){
    msg.style.display = text ? 'block' : 'none';
    msg.textContent = text || '';
  }

  function clearUI(){
    showMsg('');
    result.style.display = 'none';

    confId.textContent = '—';
    projPill.style.display = 'none';
    projName.textContent = '—';

    previewGroups.innerHTML = '';
    infoBox.innerHTML = '';
    doorsTable.innerHTML = '';
    addonsTotals.innerHTML = '';
    addonsDetail.innerHTML = '';
  }

  function labelBg(bg){
    if (bg === '300') return window.I18N_RECOVER.series_300;
    if (bg === '400') return window.I18N_RECOVER.series_400;
    if (bg === '500') return window.I18N_RECOVER.series_500;
    return '—';
  }

  function labelPlacement(p){
    if (p === 'interior') return window.I18N_RECOVER.interior;
    if (p === 'exterior') return window.I18N_RECOVER.exterior;
    return '—';
  }

  function kv(title, value){
    const div = document.createElement('div');
    div.className = 'kv';
    div.innerHTML = `
      <div class="k">${title}</div>
      <div class="v">${value ?? '—'}</div>
    `;
    return div;
  }

  function blockHeight(blk){
    if (typeof blk === 'number') return blk;
    if (typeof blk === 'object' && blk && blk.h != null) return blk.h;
    return 0;
  }

  function blockType(blk){
    if (typeof blk === 'object' && blk && blk.type) return blk.type;
    return 'door';
  }

  function getAddonForDoor(addons, doorIndex){
    if (!addons) return null;
    return addons[String(doorIndex)] || addons[doorIndex] || null;
  }

  function makeBadge(txt){
    const b = document.createElement('span');
    b.className = 'badge-mini';
    b.textContent = txt;
    return b;
  }

  function normalizeGroups(payload){
    let groups = Array.isArray(payload?.groups) ? payload.groups : [];
    const columnsFlat = Array.isArray(payload?.columns) ? payload.columns : [];

    if (!groups.length && columnsFlat.length) {
      groups = [columnsFlat];
    }

    return groups.filter(g => Array.isArray(g) && g.length);
  }

  function buildColumn(col, doorHex, bodyHex, addons, counterRef, payload){
    const type = (payload?.type || '').trim();
    const instalacion = (payload?.instalacion || '').trim();

    const isEmpotrado = !!(col && col.single && Array.isArray(col.single.blocks));
    const topCap = (type === 'home' && instalacion === 'zocalo') ? (parseInt(payload?.topCap, 10) || 90) : 90;
    const bottomCap = (type === 'home' && instalacion === 'zocalo') ? {{ kuik.bottom_cap_zocalo }} : {{ kuik.default_bottom_cap }};
    const singleCap = (parseInt(payload?.singleCap, 10) || 180);

    const shell = document.createElement('div');
    shell.className = 'col-shell';

    //const topbar = document.createElement('div');
    //topbar.className = 'col-topbar';
    //topbar.textContent = `Col ${counterRef.colIndex}`;

    const card = document.createElement('div');
    card.className = 'col-card';
    card.style.setProperty('--col-border', bodyHex || '#000');

    const body = document.createElement('div');
    body.className = 'col-body';

    if (isEmpotrado){
      body.style.height = (singleCap * SCALE) + 'px';
    } else if (type === 'home' && instalacion === 'zocalo'){
      body.style.height = ((topCap + bottomCap) * SCALE) + 'px';
    }

    function half(blocks, capH){
      const halfEl = document.createElement('div');
      halfEl.className = 'col-half';

      if (typeof capH === 'number' && capH > 0){
        halfEl.style.height = (capH * SCALE) + 'px';
      }

      (blocks || []).forEach((blk, blkIdx) => {
        const h = blockHeight(blk);
        const t = blockType(blk);

        // .door = ranura estática (color del cuerpo + hueco teñido de fondo).
        // .door-leaf = la hoja, gira sobre bisagra al hacer click.
        const d = document.createElement('div');
        d.className = 'door' + (t === 'screen' ? ' screen' : (t === 'mailbox' ? ' mailbox' : ''));
        d.style.height = (h * SCALE) + 'px';
        d.style.zIndex = String(100 - blkIdx);
        const skewDeg = Math.min(-10, Math.max(-22, -25 * h / 40));
        d.style.setProperty('--door-skew', skewDeg + 'deg');
        d.addEventListener('click', () => d.classList.toggle('is-open'));
        allDoorEls.push(d);

        const leaf = document.createElement('div');
        leaf.className = 'door-leaf';
        leaf.style.setProperty('--door-color', doorHex || '#3a9efc');
        d.appendChild(leaf);

        if (t === 'screen'){
          const img = document.createElement('img');
          img.src = "{{ asset(kuik.img_pantalla) }}";
          img.alt = "Pantalla";
          leaf.appendChild(img);
        } else if (t === 'mailbox'){
          const elec = !!(blk && blk.electronico);
          const tarj = !!(blk && blk.tarjetero);
          const buzonImg = elec
            ? (tarj ? MAILBOX_IMGS.elecCon : MAILBOX_IMGS.elecSin)
            : (tarj ? MAILBOX_IMGS.mecCon : MAILBOX_IMGS.mecSin);

          const img = document.createElement('img');
          img.src = buzonImg;
          img.alt = 'Buzón';
          leaf.appendChild(img);

          if (elec && blk && blk.plateNumber != null){
            const num = document.createElement('div');
            num.className = 'num';
            num.textContent = blk.plateNumber + ',' + blk.doorNumber;
            leaf.appendChild(num);
          }
        } else {
          counterRef.value += 1;
          const doorIndex = counterRef.value;

          const num = document.createElement('div');
          num.className = 'num';
          num.textContent = doorIndex;
          leaf.appendChild(num);

          const sizeLabel = document.createElement('div');
          sizeLabel.className = 'size-label';
          sizeLabel.textContent = 'H' + h;
          leaf.appendChild(sizeLabel);

          const sel = getAddonForDoor(addons, doorIndex);
          const socket = !!(sel && sel.socket);
          const usb = !!(sel && sel.usb);

          if (socket || usb){
            const badges = document.createElement('div');
            badges.className = 'badges';
            if (socket) badges.appendChild(makeBadge('ENCH'));
            if (usb) badges.appendChild(makeBadge('USB'));
            leaf.appendChild(badges);
          }
        }

        halfEl.appendChild(d);
      });

      return halfEl;
    }

    if (isEmpotrado){
      body.appendChild(half(col?.single?.blocks || [], singleCap));
    } else {
      const sep = document.createElement('div');
      sep.className = 'half-sep';

      body.appendChild(half(col?.top?.blocks || [], (type === 'home' && instalacion === 'zocalo') ? topCap : null));
      body.appendChild(sep);
      body.appendChild(half(col?.bottom?.blocks || [], (type === 'home' && instalacion === 'zocalo') ? bottomCap : null));
    }

    card.appendChild(body);
    //shell.appendChild(topbar);
    shell.appendChild(card);

    return shell;
  }

  function isSoporteSuelo(payload){
    return (payload?.instalacion || '').trim() === 'soporte_suelo';
  }

  function getBracketType(payload){
    return (payload?.bracketType || '').trim();
  }

  function getBracketColor(payload){
    return (payload?.bracketColor || '').trim();
  }

  function getArmSrc(color){
    if (color === 'blanco') return "{{ asset(kuik.img_brazo_blanco) }}";
    if (color === 'plata') return "{{ asset(kuik.img_brazo_plata) }}";
    return "{{ asset(kuik.img_brazo_negro) }}";
  }

  function getLegSrc(color){
    if (color === 'blanco') return "{{ asset('assets/pie_blanco.jpg') }}";
    if (color === 'plata') return "{{ asset('assets/pie_plata.jpg') }}";
    return "{{ asset(kuik.img_pie) }}";
  }

  function getLegPositions(n){
    if (n <= 0) return [];
    if (n === 1) return [1];
    if (n <= 3) return [1, n];
    if (n === 4) return [1, 3, 4];
    return [1, 3, 5];
  }

  function renderGroups(groups, doorHex, bodyHex, addons, payload){
    previewGroups.innerHTML = '';
    previewGroups.style.setProperty('--door-color', doorHex || '#3a9efc');
    previewGroups.style.setProperty('--col-border', bodyHex || '#000');
    allDoorEls = [];

    if (!groups.length){
      const div = document.createElement('div');
      div.className = 'muted';
      div.textContent = window.I18N_RECOVER.no_columns;
      previewGroups.appendChild(div);
      return;
    }

    const counterRef = { value: 0, colIndex: 0 };
    const soporteSuelo = isSoporteSuelo(payload);
    const bracketType = getBracketType(payload);
    const bracketColor = getBracketColor(payload);

    const isHomeType = (payload?.type || '').trim() === 'home';
    const instalacionG = (payload?.instalacion || '').trim();
    const bg = (payload?.fondo || '').trim();
    const isHomeSerie400 = isHomeType && bg === '400';
    const fondoMm = isHomeSerie400 ? 403 : (FONDO_MM[bg] ?? null);

    const isZocaloG = isHomeType && instalacionG === 'zocalo';
    const isEmpotradoLikeG = isHomeType && ['empotrado', 'soporte_suelo', 'colgado'].includes(instalacionG);
    const gTopCap = isZocaloG ? (parseInt(payload?.topCap, 10) || DEFAULT_TOP_CAP) : DEFAULT_TOP_CAP;
    const gBottomCap = isZocaloG ? BOTTOM_CAP_ZOCALO : DEFAULT_BOTTOM_CAP;
    const gSingleCap = parseInt(payload?.singleCap, 10) || 180;
    const totalHUnits = isEmpotradoLikeG ? gSingleCap : (gTopCap + gBottomCap);
    let groupHeightLabel = H_HEIGHTS_MM[totalHUnits] ?? Math.round(totalHUnits / 10 * 125);
    if (isZocaloG) groupHeightLabel += 177;
    const groupHeightPx = totalHUnits * SCALE;

    const colWidthLabel = isHomeSerie400 ? 380 : (['300', '400', '500'].includes(bg) ? Number(bg) : null);
    const groupWidthExtraMm = 50;

    groups.forEach((groupCols, groupIndex) => {
      const groupBlock = document.createElement('div');
      groupBlock.className = 'group-block';

      const label = document.createElement('div');
      label.className = 'group-label';
      label.textContent = window.I18N_RECOVER.group_label
        .replace('%index%', groupIndex + 1)
        .replace('%count%', groupCols.length);

      const supportWrap = document.createElement('div');
      supportWrap.className = 'support-wrap';
      supportWrap.style.setProperty('--colsN', groupCols.length);

      if (soporteSuelo && bracketType === 'brazos' && bracketColor){
        const armLeft = document.createElement('img');
        armLeft.className = 'arm-img left';
        armLeft.src = getArmSrc(bracketColor);
        armLeft.alt = 'Brazo izquierdo';

        const armRight = document.createElement('img');
        armRight.className = 'arm-img right';
        armRight.src = getArmSrc(bracketColor);
        armRight.alt = 'Brazo derecho';

        supportWrap.appendChild(armLeft);
        supportWrap.appendChild(armRight);
      }

      const heightDim = document.createElement('div');
      heightDim.className = 'height-dim';
      heightDim.style.height = groupHeightPx + 'px';
      heightDim.innerHTML =
        '<div class="group-height-label">' + groupHeightLabel + '</div>' +
        '<div class="vdim-line"><span class="varrow">▲</span><span class="vline"></span><span class="varrow">▼</span></div>';
      supportWrap.appendChild(heightDim);

      const cols = document.createElement('div');
      cols.className = 'cols';
      cols.style.setProperty('--colsN', groupCols.length);
      if (fondoMm) cols.style.marginTop = '18px';

      if (fondoMm){
        const dTop = document.createElement('div');
        dTop.className = 'depth-top';
        const dRight = document.createElement('div');
        dRight.className = 'depth-right';
        const dLabel = document.createElement('div');
        dLabel.className = 'depth-label';
        dLabel.innerHTML =
          '<div class="dim-row"><span class="arrow">◄</span><span class="line"></span><span class="arrow">►</span></div>' +
          '<div class="dim-value">' + fondoMm + '</div>';
        cols.appendChild(dTop);
        cols.appendChild(dRight);
        cols.appendChild(dLabel);
      }

      groupCols.forEach((col) => {
        counterRef.colIndex += 1;
        cols.appendChild(buildColumn(col, doorHex, bodyHex, addons, counterRef, payload));
      });

      supportWrap.appendChild(cols);

      if (colWidthLabel !== null){
        const widthDimsBelow = document.createElement('div');
        widthDimsBelow.className = 'width-dims-below';

        const widthDimsRow = document.createElement('div');
        widthDimsRow.className = 'width-dims-row';
        widthDimsRow.style.setProperty('--colsN', groupCols.length);

        groupCols.forEach(() => {
          const colDim = document.createElement('div');
          colDim.className = 'col-dim';
          colDim.innerHTML =
            '<div class="dim-row"><span class="arrow">◄</span><span class="line"></span><span class="arrow">►</span></div>' +
            '<div class="dim-value">' + colWidthLabel + '</div>';
          widthDimsRow.appendChild(colDim);
        });

        widthDimsBelow.appendChild(widthDimsRow);

        if (groupCols.length > 1){
          const totalMm = colWidthLabel * groupCols.length + groupWidthExtraMm;
          const groupWidthTotal = document.createElement('div');
          groupWidthTotal.className = 'group-width-total';
          groupWidthTotal.style.width = 'calc(' + groupCols.length + ' * 140px)';
          groupWidthTotal.innerHTML =
            '<div class="dim-row"><span class="arrow">◄</span><span class="line"></span><span class="arrow">►</span></div>' +
            '<div class="dim-value">' + totalMm + '</div>';
          widthDimsBelow.appendChild(groupWidthTotal);
        }

        supportWrap.appendChild(widthDimsBelow);
      }

      if (soporteSuelo && bracketType === 'patas'){
        const legPositions = getLegPositions(groupCols.length);

        const legs = document.createElement('div');
        legs.className = 'legs-under';
        legs.style.setProperty('--colsN', groupCols.length);

        legPositions.forEach((pos) => {
          const img = document.createElement('img');
          img.className = 'leg-img';
          img.src = getLegSrc(bracketColor);
          img.alt = 'Pata';
          img.style.gridColumn = String(pos);
          legs.appendChild(img);
        });

        supportWrap.appendChild(legs);
      }

      groupBlock.appendChild(label);
      groupBlock.appendChild(supportWrap);
      previewGroups.appendChild(groupBlock);
    });

    applyTintedHueco(bodyHex);
  }

  function applyTintedHueco(bodyHex){
    const doors = allDoorEls.slice();
    const fallback = 'url(\'{{ asset("assets/hueco6.png") }}\') center top / 100% 100% no-repeat, ' + (bodyHex || '#22262b');
    doors.forEach(d => { d.style.background = fallback; });

    fetch(TINTED_HUECO_URL + '?color=' + encodeURIComponent((bodyHex || '').replace('#', '')))
      .then(r => r.json())
      .then(data => {
        if (!data || !data.url) return;
        currentHuecoUrl = data.url;
        const tinted = 'url(\'' + data.url + '\') center top / 100% 100% no-repeat, ' + (bodyHex || '#22262b');
        doors.forEach(d => { d.style.background = tinted; });
      })
      .catch(() => {});
  }

  function computeDoorCounts(columns){
    const counts = {};
    let totalDoors = 0;

    (columns || []).forEach(col => {
      const isEmpotrado = !!(col && col.single && Array.isArray(col.single.blocks));
      const all = isEmpotrado
        ? (col?.single?.blocks || [])
        : []
            .concat(col?.top?.blocks || [])
            .concat(col?.bottom?.blocks || []);

      all.forEach(blk => {
        const t = blockType(blk);
        if (t === 'screen') return;

        const h = blockHeight(blk);
        totalDoors++;
        counts[h] = (counts[h] || 0) + 1;
      });
    });

    return { counts, totalDoors };
  }

  function renderCountsTable(columns){
    const { counts, totalDoors } = computeDoorCounts(columns);

    const sizes = Object.keys(counts)
      .map(n => parseInt(n, 10))
      .filter(n => counts[n] > 0)
      .sort((a, b) => a - b);

    if (!sizes.length){
      const div = document.createElement('div');
      div.className = 'muted';
      div.textContent = window.I18N_RECOVER.no_doors;
      return div;
    }

    const table = document.createElement('table');
    table.className = 'addons-table';
    table.innerHTML = `
      <thead>
        <tr>
          <th>${window.I18N_RECOVER.size_header}</th>
          <th>${window.I18N_RECOVER.quantity_header}</th>
        </tr>
      </thead>
      <tbody></tbody>
    `;

    const tbody = table.querySelector('tbody');

    sizes.forEach(h => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><b>H${h}</b></td>
        <td>${counts[h]}</td>
      `;
      tbody.appendChild(tr);
    });

    const trTotal = document.createElement('tr');
    trTotal.innerHTML = `
      <td><b>${window.I18N_RECOVER.total_doors}</b></td>
      <td><b>${totalDoors}</b></td>
    `;
    tbody.appendChild(trTotal);

    return table;
  }

  function computeAddons(addons){
    let totalSocket = 0, totalUsb = 0, totalBoth = 0;
    const detail = [];

    if (!addons || typeof addons !== 'object') {
      return { totalSocket, totalUsb, totalBoth, detail };
    }

    Object.keys(addons).forEach(k => {
      const sel = addons[k];
      const socket = !!(sel && sel.socket);
      const usb = !!(sel && sel.usb);

      if (socket) totalSocket++;
      if (usb) totalUsb++;
      if (socket && usb) totalBoth++;

      if (socket || usb){
        detail.push({
          door: k,
          label: (socket && usb) ? window.I18N_RECOVER.socket_usb : (socket ? window.I18N_RECOVER.socket : window.I18N_RECOVER.usb)
        });
      }
    });

    detail.sort((a, b) => (parseInt(a.door, 10) || 0) - (parseInt(b.door, 10) || 0));
    return { totalSocket, totalUsb, totalBoth, detail };
  }

  function renderAddonsDetail(detail){
    if (!detail.length){
      const div = document.createElement('div');
      div.className = 'muted';
      div.textContent = window.I18N_RECOVER.no_addons_doors;
      return div;
    }

    const table = document.createElement('table');
    table.className = 'addons-table';
    table.innerHTML = `
      <thead>
        <tr>
          <th>${window.I18N_RECOVER.door_header}</th>
          <th>${window.I18N_RECOVER.addon_header}</th>
        </tr>
      </thead>
      <tbody></tbody>
    `;

    const tbody = table.querySelector('tbody');

    detail.forEach(row => {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td><b>${row.door}</b></td><td>${row.label}</td>`;
      tbody.appendChild(tr);
    });

    return table;
  }

  async function fetchById(id){
    const res = await fetch(`/api/configurations/public-recover?id=${encodeURIComponent(id)}`, {
      headers: { 'Accept': 'application/json' }
    });

    if (!res.ok) throw new Error('HTTP ' + res.status);
    return res.json();
  }

  async function search(){
    clearUI();

    const id = (input.value || '').trim();
    if (!id || !/^\d+$/.test(id) || parseInt(id, 10) <= 0){
      showMsg(window.I18N_RECOVER.invalid_id);
      return;
    }

    btnSearch.disabled = true;

    try{
      const data = await fetchById(id);
      const item = (data.items && data.items.length) ? data.items[0] : null;

      if (!item){
        showMsg(window.I18N_RECOVER.not_found.replace('%id%', id));
        return;
      }

      const payload = safeParse(item.payload || '');
      if (!payload){
        showMsg(window.I18N_RECOVER.invalid_json);
        return;
      }

      const groups = normalizeGroups(payload);
      const columns = groups.flat();
      const addons = payload.addons || {};

      const doorColor = payload.colorDoor || '#3a9efc';
      const bodyColor = payload.colorBody || '#000';

      const doorColorRal = payload.colorDoorRal || payload.colorDoorRAL || null;
      const bodyColorRal = payload.colorBodyRal || payload.colorBodyRAL || null;

      confId.textContent = item.id ?? id;

      if (item.projectName){
        projPill.style.display = 'inline-flex';
        projName.textContent = item.projectName;
      }

      infoBox.innerHTML = '';
      infoBox.appendChild(kv('ID', item.id));
      infoBox.appendChild(kv(window.I18N_RECOVER.project_label, item.projectName || '—'));
      infoBox.appendChild(kv(window.I18N_RECOVER.type_label, payload.type || '—'));

      if (payload.instalacion) {
        infoBox.appendChild(kv(window.I18N_RECOVER.installation_label, payload.instalacion));
      }

      infoBox.appendChild(kv(window.I18N_RECOVER.background_label, labelBg(payload.fondo)));
      infoBox.appendChild(kv(window.I18N_RECOVER.location_label, labelPlacement(payload.placement)));
      infoBox.appendChild(kv(window.I18N_RECOVER.material_label, payload.material || '—'));
      infoBox.appendChild(kv(window.I18N_RECOVER.door_color_label, doorColorRal || doorColor));
      infoBox.appendChild(kv(window.I18N_RECOVER.body_color_label, bodyColorRal || bodyColor));
      infoBox.appendChild(kv(window.I18N_RECOVER.columns_label, Array.isArray(columns) ? columns.length : 0));

      renderGroups(groups, doorColor, bodyColor, addons, payload);

      doorsTable.innerHTML = '';
      doorsTable.appendChild(renderCountsTable(columns));

      const a = computeAddons(addons);

      addonsTotals.innerHTML = '';
      addonsTotals.appendChild(kv(window.I18N_RECOVER.total_sockets, a.totalSocket));
      addonsTotals.appendChild(kv(window.I18N_RECOVER.total_usb, a.totalUsb));
      addonsTotals.appendChild(kv(window.I18N_RECOVER.doors_with_both, a.totalBoth));

      addonsDetail.innerHTML = '';
      addonsDetail.appendChild(renderAddonsDetail(a.detail));

      result.style.display = 'block';
    }catch(e){
      console.error(e);
      showMsg(window.I18N_RECOVER.network_error);
    }finally{
      btnSearch.disabled = false;
    }
  }

  btnSearch.addEventListener('click', search);

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      search();
    }
  });

  btnClear.addEventListener('click', () => {
    input.value = '';
    clearUI();
  });

  // Drag-to-scroll on preview
  var scroll = document.querySelector('.preview-scroll');
  if (scroll) {
    var isDragging = false, startX, scrollLeft;

    scroll.addEventListener('mousedown', function (e) {
      isDragging = true;
      scroll.classList.add('is-dragging');
      startX     = e.pageX - scroll.getBoundingClientRect().left;
      scrollLeft = scroll.scrollLeft;
      e.preventDefault();
    });

    document.addEventListener('mouseup', function () {
      isDragging = false;
      scroll.classList.remove('is-dragging');
    });

    document.addEventListener('mousemove', function (e) {
      if (!isDragging) return;
      var x    = e.pageX - scroll.getBoundingClientRect().left;
      var walk = (x - startX) * 1.2;
      scroll.scrollLeft = scrollLeft - walk;
    });
  }
});
</script>
