{% if products is defined and products is not empty %}
  {% set instalacionPrecio = instalacionPrecio ?? 0 %}
  {% set instalacionIva    = instalacionIva ?? false %}

  <div style="height:1px; background:rgba(15,23,42,.10); margin:16px 0;"></div>

  <div style="display:flex; align-items:center; gap:12px; margin-bottom:10px; flex-wrap:wrap;">
    <h3 style="margin:0; font-size:16px; font-weight:900; letter-spacing:-0.01em;">Referencias de producto</h3>
    <label style="display:flex; align-items:center; gap:6px; font-size:13px; font-weight:700; cursor:pointer;">
      <input type="checkbox" id="ivaCheck" style="width:15px;height:15px;" {{ instalacionIva ? 'checked' : '' }}>
      Aplicar IVA (21%)
    </label>
  </div>

  <table style="width:100%; border-collapse:separate; border-spacing:0; border:1px solid rgba(15,23,42,.12); border-radius:14px; overflow:hidden; background:#fff;">
    <thead>
      <tr>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:left; border-bottom:1px solid rgba(15,23,42,.08);">Tamaño</th>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:left; border-bottom:1px solid rgba(15,23,42,.08);">Referencia</th>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:left; border-bottom:1px solid rgba(15,23,42,.08);">Descripción</th>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">Uds.</th>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">Precio ud.</th>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">Total línea</th>
      </tr>
    </thead>
    <tbody>
      {% set grandTotal = 0 %}
      {% for size, product in products %}
        {% set info = productInfo[size] ?? null %}
        {% set count = sizeCounts[size] ?? 0 %}
        {% set border = 'border-bottom:1px solid rgba(15,23,42,.08);' %}
        <tr>
          <td style="padding:10px 12px; font-size:14px; font-weight:900; {{ border }}">
            {% if size starts with 'columna_' %}
              Columna H{{ size|replace({'columna_': ''}) }}
            {% elseif size == 'columna' %}
              Columna
            {% elseif size == 'control' %}
              Periféricos
            {% elseif size == 'bandeja' %}
              Bandeja Intermedia
            {% elseif size starts with 'lateral_' %}
              Par de laterales H{{ size|replace({'lateral_': ''}) }}
            {% elseif size == 'lateral' %}
              Par de laterales
            {% elseif size starts with 'mailbox_col_' %}
              {% set _mbParts = size|replace({'mailbox_col_': ''})|split('_') %}
              Buzón {{ _mbParts[0] == '1' ? 'electrónico' : 'mecánico' }}{{ _mbParts[1] == '1' ? ' con tarjetero' : ' sin tarjetero' }}
            {% elseif size starts with 'brazo_' %}
              Brazos H{{ size|replace({'brazo_': ''}) }}
            {% elseif size starts with 'pata_' %}
              Patas ({{ size|replace({'pata_': ''}) }} col.)
            {% elseif size == 'instalacion_ref' %}
              Instalación
            {% elseif size == 'placa' %}
              Placa
            {% elseif size == 'colgador' %}
              Colgador
            {% elseif size == 'buzon_group' %}
              Buzones (agrupación)
            {% elseif size == 'envolvente_buzon' %}
              Envolvente buzones ({{ info._rango ?? '' }}) — {{ info._metros ?? count }} m
            {% elseif size starts with 'tejado_' %}
              Tejado {{ size|replace({'tejado_': ''}) }} col.
            {% elseif size ends with '_meth' %}
              H{{ size|replace({'_meth': ''}) }} + Metacrilato
            {% else %}
              H{{ size }}
            {% endif %}
          </td>
          {% if product %}
            <td style="padding:10px 12px; font-size:14px; font-weight:900; {{ border }}">{{ (size in ['placa','buzon_group','colgador','instalacion_ref']) ? product : product.reference }}</td>
            <td style="padding:10px 12px; font-size:14px; color:#6b7280; {{ border }}">
              {% if size in ['buzon_group', 'envolvente_buzon', 'control'] and info._descripcion is defined and info._descripcion %}{{ info._descripcion }}
              {% elseif size starts with 'brazo_' and product.descripcion is defined and product.descripcion %}{{ product.descripcion }}
              {% elseif size starts with 'pata_' and product.descripcion is defined and product.descripcion %}{{ product.descripcion }}
              {% else %}—{% endif %}
            </td>
            <td style="padding:10px 12px; font-size:14px; text-align:right; {{ border }}">{{ count }}</td>
            {% if info and info.PrecioVenta is defined and info.PrecioVenta is not iterable %}
              {% set priceStr = info.PrecioVenta|replace({'.': '', ',': '.'}) %}
              {% set lineTotal = priceStr * count %}
              {% set grandTotal = grandTotal + lineTotal %}
              <td style="padding:10px 12px; font-size:14px; text-align:right; {{ border }}">{{ info.PrecioVenta }} €</td>
              <td style="padding:10px 12px; font-size:14px; font-weight:900; text-align:right; {{ border }}">{{ lineTotal|number_format(2, ',', '.') }} €</td>
            {% else %}
              <td colspan="2" style="padding:10px 12px; font-size:14px; color:#6b7280; text-align:right; {{ border }}">—</td>
            {% endif %}
          {% else %}
            <td colspan="5" style="padding:10px 12px; font-size:14px; color:#6b7280; {{ border }}">Sin referencia</td>
          {% endif %}
        </tr>
      {% endfor %}

      {% if instalacionPrecio > 0 %}
        <tr>
          <td style="padding:10px 12px; font-size:14px; font-weight:900; border-bottom:1px solid rgba(15,23,42,.08);">Instalación</td>
          <td style="padding:10px 12px; font-size:14px; font-weight:900; border-bottom:1px solid rgba(15,23,42,.08);">{{ instalacionReference ?? '—' }}</td>
          <td style="padding:10px 12px; font-size:14px; color:#6b7280; border-bottom:1px solid rgba(15,23,42,.08);">—</td>
          <td style="padding:10px 12px; font-size:14px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">1</td>
          <td style="padding:10px 12px; font-size:14px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">{{ instalacionPrecio|number_format(2, ',', '.') }} €</td>
          <td style="padding:10px 12px; font-size:14px; font-weight:900; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">{{ instalacionPrecio|number_format(2, ',', '.') }} €</td>
        </tr>
      {% endif %}
    </tbody>
    <tfoot>
      {% set subtotal = grandTotal + instalacionPrecio %}
      {% set totalFinal = instalacionIva ? subtotal * 1.21 : subtotal %}
      {% if instalacionIva and subtotal > 0 %}
        <tr>
          <td colspan="5" style="padding:8px 12px; font-size:13px; text-align:right; border-top:1px solid rgba(15,23,42,.08); color:#6b7280;">Subtotal</td>
          <td style="padding:8px 12px; font-size:13px; text-align:right; border-top:1px solid rgba(15,23,42,.08); color:#6b7280;">{{ subtotal|number_format(2, ',', '.') }} €</td>
        </tr>
        <tr>
          <td colspan="5" style="padding:8px 12px; font-size:13px; text-align:right; color:#6b7280;">IVA (21%)</td>
          <td style="padding:8px 12px; font-size:13px; text-align:right; color:#6b7280;">{{ (subtotal * 0.21)|number_format(2, ',', '.') }} €</td>
        </tr>
      {% endif %}
      <tr>
        <td colspan="5" style="padding:10px 12px; font-size:14px; font-weight:900; text-align:right; border-top:2px solid rgba(15,23,42,.12);">Total{{ instalacionIva ? ' (IVA incl.)' : '' }}</td>
        <td style="padding:10px 12px; font-size:16px; font-weight:900; text-align:right; border-top:2px solid rgba(15,23,42,.12);">{{ totalFinal|number_format(2, ',', '.') }} €</td>
      </tr>
    </tfoot>
  </table>

{% endif %}
