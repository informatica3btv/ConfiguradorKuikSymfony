{% if products is defined and products is not empty %}
  {% set instalacionPrecio = instalacionPrecio ?? 0 %}
  {% set instalacionIva    = instalacionIva ?? false %}

  <div style="height:1px; background:rgba(15,23,42,.10); margin:16px 0;"></div>

  <div style="display:flex; align-items:center; gap:12px; margin-bottom:10px; flex-wrap:wrap;">
    <h3 style="margin:0; font-size:16px; font-weight:900; letter-spacing:-0.01em;">{{ 'config_ajax.title'|trans }}</h3>
    <label style="display:flex; align-items:center; gap:6px; font-size:13px; font-weight:700; cursor:pointer;">
      <input type="checkbox" id="ivaCheck" style="width:15px;height:15px;" {{ instalacionIva ? 'checked' : '' }}>
      {{ 'config_ajax.apply_iva'|trans }}
    </label>
    <label style="display:flex; align-items:center; gap:6px; font-size:13px; font-weight:700;">
      {{ 'config_ajax.discount'|trans }}
      <input type="number" id="discountPct" min="0" max="100" step="0.1" value="{{ descuento ?? 0 }}"
             style="width:70px; padding:3px 6px; border:1px solid rgba(15,23,42,.18); border-radius:6px; font-size:13px; font-weight:700; text-align:right;">
      %
    </label>
  </div>

  {% set grandTotal = 0 %}
  {% for size, product in products %}
    {% set info = productInfo[size] ?? null %}
    {% set count = sizeCounts[size] ?? 0 %}
    {% if info and info.PrecioVenta is defined and info.PrecioVenta is not iterable %}
      {% set priceStr = info.PrecioVenta|replace({'.': '', ',': '.'}) %}
      {% set grandTotal = grandTotal + priceStr * count %}
    {% endif %}
  {% endfor %}
  {% set manualLines = manualLines ?? [] %}
  {% set manualTotal = 0 %}
  {% for line in manualLines %}
    {% set manualTotal = manualTotal + (line.uds * line.precio) %}
  {% endfor %}
  {% set baseSubtotal = grandTotal + instalacionPrecio %}
  {% set subtotalBase = baseSubtotal + manualTotal %}
  <div style="overflow-x:auto;">
  <table id="productTable" data-subtotal="{{ subtotalBase }}" data-base-subtotal="{{ baseSubtotal }}" data-iva="{{ instalacionIva ? '1' : '0' }}"
         style="width:100%; min-width:640px; border-collapse:separate; border-spacing:0; border:1px solid rgba(15,23,42,.12); border-radius:14px; overflow:hidden; background:#fff;">
    <thead>
      <tr>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:left; border-bottom:1px solid rgba(15,23,42,.08);">{{ 'config_ajax.table.size'|trans }}</th>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:left; border-bottom:1px solid rgba(15,23,42,.08);">{{ 'config_ajax.table.reference'|trans }}</th>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:left; border-bottom:1px solid rgba(15,23,42,.08);">{{ 'config_ajax.table.description'|trans }}</th>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">{{ 'config_ajax.table.units'|trans }}</th>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">{{ 'config_ajax.table.unit_price'|trans }}</th>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">{{ 'config_ajax.table.line_total'|trans }}</th>
      </tr>
    </thead>
    <tbody>
      {% for size, product in products %}
        {% set info = productInfo[size] ?? null %}
        {% set count = sizeCounts[size] ?? 0 %}
        {% set border = 'border-bottom:1px solid rgba(15,23,42,.08);' %}
        <tr>
          <td style="padding:10px 12px; font-size:14px; font-weight:900; {{ border }}">
            {% if size starts with 'columna_' %}
              {{ 'config_ajax.row.column_h'|trans({'%h%': size|replace({'columna_': ''})}) }}
            {% elseif size == 'columna' %}
              {{ 'config_ajax.row.column'|trans }}
            {% elseif size == 'control' %}
              {{ 'config_ajax.row.peripherals'|trans }}
            {% elseif size == 'bandeja' %}
              {{ 'config_ajax.row.intermediate_tray'|trans }}
            {% elseif size starts with 'lateral_' %}
              {{ 'config_ajax.row.side_pair_h'|trans({'%h%': size|replace({'lateral_': ''})}) }}
            {% elseif size == 'lateral' %}
              {{ 'config_ajax.row.side_pair'|trans }}
            {% elseif size starts with 'mailbox_col_ref_' %}
              {{ info.descripcion ?? size|replace({'mailbox_col_ref_': ''}) }}
            {% elseif size starts with 'mailbox_col_' %}
              {% set _mbParts = size|replace({'mailbox_col_': ''})|split('_') %}
              {{ 'config_ajax.row.mailbox'|trans({
                '%kind%': _mbParts[0] == '1' ? ('config_ajax.row.mailbox_electronic'|trans) : ('config_ajax.row.mailbox_mechanical'|trans),
                '%card_reader%': _mbParts[1] == '1' ? ('config_ajax.row.mailbox_with_card_reader'|trans) : ('config_ajax.row.mailbox_without_card_reader'|trans)
              }) }}
            {% elseif size starts with 'brazo_' %}
              {{ 'config_ajax.row.arms_h'|trans({'%h%': size|replace({'brazo_': ''})}) }}
            {% elseif size starts with 'pata_' %}
              {{ 'config_ajax.row.legs_cols'|trans({'%cols%': size|replace({'pata_': ''})}) }}
            {% elseif size == 'instalacion_ref' %}
              {{ 'config_ajax.row.installation'|trans }}
            {% elseif size == 'color_door' %}
              {{ 'config_ajax.row.door_color'|trans }}
            {% elseif size == 'color_body' %}
              {{ 'config_ajax.row.body_color'|trans }}
            {% elseif size == 'placa' %}
              {{ 'config_ajax.row.plate'|trans }}
            {% elseif size == 'colgador' %}
              {{ 'config_ajax.row.hanger'|trans }}
            {% elseif size == 'buzon_group' %}
              {{ 'config_ajax.row.mailbox_group'|trans }}
            {% elseif size == 'envolvente_buzon' %}
              {{ 'config_ajax.row.mailbox_enclosure'|trans({'%range%': info._rango ?? '', '%meters%': info._metros ?? count}) }}
            {% elseif size starts with 'tejado_' %}
              {{ 'config_ajax.row.roof_cols'|trans({'%cols%': size|replace({'tejado_': ''})}) }}
            {% elseif size ends with '_meth' %}
              {{ 'config_ajax.row.h_methacrylate'|trans({'%h%': size|replace({'_meth': ''})}) }}
            {% else %}
              H{{ size }}
            {% endif %}
          </td>
          {% if product %}
            <td style="padding:10px 12px; font-size:14px; font-weight:900; {{ border }}">{{ (size in ['placa','buzon_group','colgador','instalacion_ref','color_door','color_body']) ? product : product.reference }}</td>
            <td style="padding:10px 12px; font-size:14px; color:#6b7280; {{ border }}">
              {% if size in ['buzon_group', 'envolvente_buzon', 'control'] and info._descripcion is defined and info._descripcion %}{{ info._descripcion }}
              {% elseif size starts with 'brazo_' and product.descripcion is defined and product.descripcion %}{{ product.descripcion }}
              {% elseif size starts with 'pata_' and product.descripcion is defined and product.descripcion %}{{ product.descripcion }}
              {% else %}—{% endif %}
            </td>
            <td style="padding:10px 12px; font-size:14px; text-align:right; {{ border }}">{{ count }}</td>
            {% if info and info.PrecioVenta is defined and info.PrecioVenta is not iterable %}
              {% set priceStr = info.PrecioVenta|replace({'.': '', ',': '.'}) %}
              {% set lineTotal = priceStr * count %}
              <td style="padding:10px 12px; font-size:14px; text-align:right; {{ border }}">{{ info.PrecioVenta }} €</td>
              <td style="padding:10px 12px; font-size:14px; font-weight:900; text-align:right; {{ border }}">{{ lineTotal|number_format(2, ',', '.') }} €</td>
            {% else %}
              <td colspan="2" style="padding:10px 12px; font-size:14px; color:#6b7280; text-align:right; {{ border }}">—</td>
            {% endif %}
          {% else %}
            <td colspan="5" style="padding:10px 12px; font-size:14px; color:#6b7280; {{ border }}">{{ 'config_ajax.row.no_reference'|trans }}</td>
          {% endif %}
        </tr>
      {% endfor %}

      {% if instalacionPrecio > 0 %}
        <tr>
          <td style="padding:10px 12px; font-size:14px; font-weight:900; border-bottom:1px solid rgba(15,23,42,.08);">{{ 'config_ajax.row.installation'|trans }}</td>
          <td style="padding:10px 12px; font-size:14px; font-weight:900; border-bottom:1px solid rgba(15,23,42,.08);">{{ instalacionReference ?? '—' }}</td>
          <td style="padding:10px 12px; font-size:14px; color:#6b7280; border-bottom:1px solid rgba(15,23,42,.08);">—</td>
          <td style="padding:10px 12px; font-size:14px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">1</td>
          <td style="padding:10px 12px; font-size:14px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">{{ instalacionPrecio|number_format(2, ',', '.') }} €</td>
          <td style="padding:10px 12px; font-size:14px; font-weight:900; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">{{ instalacionPrecio|number_format(2, ',', '.') }} €</td>
        </tr>
      {% endif %}

      {% for line in manualLines %}
        <tr class="manual-line-row" data-line-index="{{ loop.index0 }}">
          <td colspan="3" style="padding:6px 12px; border-bottom:1px solid rgba(15,23,42,.08);">
            <input type="text" class="manual-line-desc" value="{{ line.descripcion|e('html_attr') }}"
                   placeholder="{{ 'config_ajax.manual_line.description_placeholder'|trans }}"
                   style="width:100%; border:1px solid rgba(15,23,42,.15); border-radius:6px; padding:5px 8px; font-size:13px;">
          </td>
          <td style="padding:6px 12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">
            <input type="number" class="manual-line-uds" min="0" step="1" value="{{ line.uds }}"
                   style="width:64px; text-align:right; border:1px solid rgba(15,23,42,.15); border-radius:6px; padding:5px 8px; font-size:13px;">
          </td>
          <td style="padding:6px 12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">
            <input type="number" class="manual-line-precio" min="0" step="0.01" value="{{ line.precio }}"
                   style="width:90px; text-align:right; border:1px solid rgba(15,23,42,.15); border-radius:6px; padding:5px 8px; font-size:13px;">
          </td>
          <td style="padding:6px 12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08); white-space:nowrap;">
            <span class="manual-line-total" style="font-weight:900;">{{ (line.uds * line.precio)|number_format(2, ',', '.') }} €</span>
            <button type="button" class="manual-line-delete" title="{{ 'config_ajax.manual_line.delete'|trans }}"
                    style="margin-left:8px; border:0; background:transparent; color:#ef4444; cursor:pointer; font-weight:900; font-size:15px; line-height:1;">×</button>
          </td>
        </tr>
      {% endfor %}

      <tr id="rowAddManualLine">
        <td colspan="6" style="padding:8px 12px;">
          <button type="button" id="btnAddManualLine"
                  style="border:1px dashed rgba(15,23,42,.25); background:#fbfcfe; border-radius:8px; padding:6px 14px; font-size:13px; font-weight:700; cursor:pointer; color:#0b76d8;">
            + {{ 'config_ajax.manual_line.add'|trans }}
          </button>
        </td>
      </tr>
    </tbody>
    <tfoot>
      {% set subtotal = subtotalBase %}
      {% set totalFinal = instalacionIva ? subtotal * 1.21 : subtotal %}
      <tr id="rowSubtotal" style="display:none;">
        <td colspan="5" style="padding:8px 12px; font-size:13px; text-align:right; border-top:1px solid rgba(15,23,42,.08); color:#6b7280;">{{ 'config_ajax.totals.subtotal'|trans }}</td>
        <td id="cellSubtotal" style="padding:8px 12px; font-size:13px; text-align:right; border-top:1px solid rgba(15,23,42,.08); color:#6b7280;">{{ subtotal|number_format(2, ',', '.') }} €</td>
      </tr>
      <tr id="rowDiscount" style="display:none;">
        <td colspan="5" style="padding:8px 12px; font-size:13px; text-align:right; color:#6b7280;">{{ 'config_ajax.totals.discount'|trans }} (<span id="discountPctLabel">0</span>%)</td>
        <td id="cellDiscount" style="padding:8px 12px; font-size:13px; text-align:right; color:#6b7280;">−0,00 €</td>
      </tr>
      <tr id="rowIva" style="display:none;">
        <td colspan="5" style="padding:8px 12px; font-size:13px; text-align:right; color:#6b7280;">{{ 'config_ajax.totals.iva'|trans }}</td>
        <td id="cellIva" style="padding:8px 12px; font-size:13px; text-align:right; color:#6b7280;">{{ (subtotal * 0.21)|number_format(2, ',', '.') }} €</td>
      </tr>
      <tr>
        <td colspan="5" id="cellTotalLabel" style="padding:10px 12px; font-size:14px; font-weight:900; text-align:right; border-top:2px solid rgba(15,23,42,.12);">{{ instalacionIva ? ('config_ajax.totals.total_with_discount_iva_incl'|trans) : ('config_ajax.totals.total_with_discount'|trans) }}</td>
        <td id="cellTotal" style="padding:10px 12px; font-size:16px; font-weight:900; text-align:right; border-top:2px solid rgba(15,23,42,.12);">{{ totalFinal|number_format(2, ',', '.') }} €</td>
      </tr>
    </tfoot>
  </table>
  </div>


{% endif %}
