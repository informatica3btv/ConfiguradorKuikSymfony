{% if products is defined and products is not empty %}
  <div style="height:1px; background:rgba(15,23,42,.10); margin:16px 0;"></div>
  <h3 style="margin:0 0 10px; font-size:16px; font-weight:900; letter-spacing:-0.01em;">Referencias de producto</h3>

  <table style="width:100%; border-collapse:separate; border-spacing:0; border:1px solid rgba(15,23,42,.12); border-radius:14px; overflow:hidden; background:#fff;">
    <thead>
      <tr>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:left; border-bottom:1px solid rgba(15,23,42,.08);">Tamaño</th>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:left; border-bottom:1px solid rgba(15,23,42,.08);">Referencia</th>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:left; border-bottom:1px solid rgba(15,23,42,.08);">Descripción</th>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">Uds.</th>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">Precio ud.</th>
        <th style="padding:10px 12px; background:#fbfcfe; font-weight:900; color:#334155; font-size:12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">Total línea</th>
      </tr>
    </thead>
    <tbody>
      {% set grandTotal = 0 %}
      {% for size, product in products %}
        {% set info = productInfo[size] ?? null %}
        {% set count = sizeCounts[size] ?? 0 %}
        {% set isLast = loop.last %}
        {% set border = not isLast ? 'border-bottom:1px solid rgba(15,23,42,.08);' %}
        <tr>
          <td style="padding:10px 12px; font-size:14px; font-weight:900; {{ border }}">
            {% if size == 'lateral' %}
              Par de laterales
            {% elseif size starts with 'tejado_' %}
              Tejado {{ size|replace({'tejado_': ''}) }} col.
            {% else %}
              H{{ size }}
            {% endif %}
          </td>
          {% if product %}
            <td style="padding:10px 12px; font-size:14px; font-weight:900; {{ border }}">{{ product.reference }}</td>
            <td style="padding:10px 12px; font-size:14px; color:#6b7280; {{ border }}">—</td>
            <td style="padding:10px 12px; font-size:14px; text-align:right; {{ border }}">{{ count }}</td>
            {% if info %}
              {% set priceStr = info.PrecioVenta|replace({'.': '', ',': '.'}) %}
              {% set lineTotal = priceStr * count %}
              {% set grandTotal = grandTotal + lineTotal %}
              <td style="padding:10px 12px; font-size:14px; text-align:right; {{ border }}">{{ info.PrecioVenta }} €</td>
              <td style="padding:10px 12px; font-size:14px; font-weight:900; text-align:right; {{ border }}">{{ lineTotal|number_format(2, ',', '.') }} €</td>
            {% else %}
              <td colspan="2" style="padding:10px 12px; font-size:14px; color:#6b7280; text-align:right; {{ border }}">—</td>
            {% endif %}
          {% else %}
            <td colspan="5" style="padding:10px 12px; font-size:14px; color:#6b7280; {{ border }}">Sin referencia</td>
          {% endif %}
        </tr>
      {% endfor %}
    </tbody>
    <tfoot>
      <tr>
        <td colspan="5" style="padding:10px 12px; font-size:14px; font-weight:900; text-align:right; border-top:2px solid rgba(15,23,42,.12);">Total</td>
        <td style="padding:10px 12px; font-size:16px; font-weight:900; text-align:right; border-top:2px solid rgba(15,23,42,.12);">{{ grandTotal|number_format(2, ',', '.') }} €</td>
      </tr>
    </tfoot>
  </table>
{% endif %}
