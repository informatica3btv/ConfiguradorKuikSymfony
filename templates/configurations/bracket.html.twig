{% extends 'layout.html.twig' %}

{% block page_title %}{{ 'bracket.page_title'|trans }}{% endblock %}

{% set p = payload ?? {} %}
{% if p is not iterable %}{% set p = {} %}{% endif %}

{# ✅ NUEVO: groups (si existe) #}
{% set groups = p.groups ?? [] %}
{% if groups is not iterable %}{% set groups = [] %}{% endif %}

{# ✅ fallback antiguo: columns #}
{% set columnsFlat = p.columns ?? [] %}
{% if columnsFlat is not iterable %}{% set columnsFlat = [] %}{% endif %}

{# ✅ si no hay groups, creamos 1 grupo con columns #}
{% if groups is empty and columnsFlat is not empty %}
  {% set groups = [columnsFlat] %}
{% endif %}

{% set type = p.type ?? '' %}
{% set instalacion = p.instalacion ?? '' %}

{% set doorColor = p.colorDoor ?? '#3a9efc' %}
{% set bodyColor = p.colorBody ?? '#000' %}

{% set selectedType = p.bracketType ?? '' %}
{% set selectedColor = p.bracketColor ?? '' %}

{# ✅ SOLO SINGLECAP (soporte_suelo) #}
{% set singleCap = p.singleCap|default(kuik.default_single_cap) %}

{# ✅ MISMA ESCALA QUE RESUMEN #}
{% set scale = kuik.scale %}
{% set scaleArm = kuik.scale_arm %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --bg:#f6f9fc;
      --ink:#0b1220;
      --muted:#6b7280;
      --line: rgba(15,23,42,.12);
      --shadow: 0 10px 25px rgba(2,20,60,.10);
      --shadow-sm: 0 6px 14px rgba(2,20,60,.10);

      --kuik-blue-900:#003b73;
      --kuik-blue-600:#0b76d8;
      --kuik-blue-500:#1187e6;

      --hscale: {{ kuik.scale }};
    }

    .page-wrap{ max-width: 100%; padding: 0 14px; }
    .page-head{ display:flex; align-items:flex-end; justify-content:space-between; gap:14px; flex-wrap:wrap; margin-bottom:14px; }
    .page-title{ margin:0; font-size:34px; font-weight:900; letter-spacing:-0.02em; }
    .page-sub{ margin-top:6px; color:var(--muted); font-size:15px; display:flex; align-items:center; gap:10px; flex-wrap:wrap; }

    .id-pill{
      display:inline-flex; align-items:center; gap:8px;
      padding:6px 10px; border-radius:999px;
      background: rgba(11,118,216,.10);
      border:1px solid rgba(11,118,216,.18);
      font-weight:900; color:#0b76d8;
    }

    .grid{ display:grid; grid-template-columns: 1fr; gap:14px; }
    .card{
      background:#fff; border:1px solid var(--line);
      border-radius:16px; padding:16px;
      box-shadow: 0 1px 0 rgba(15,23,42,.04);
      min-width: 0;
      overflow: hidden;
    }
    .card h3{ margin:0 0 12px; font-size:16px; font-weight:900; letter-spacing:-0.01em; }
    .muted{ color:var(--muted); font-size:15px; }

    .section-sep{ height:1px; background: rgba(15,23,42,.10); margin:14px 0; }

    .btn-row{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-top:14px; }
    .btn{
      border:1px solid rgba(15,23,42,.12);
      background:#fff; border-radius:12px;
      padding:10px 14px; font-weight:900;
      cursor:pointer; display:inline-flex;
      align-items:center; gap:10px;
      text-decoration:none; color:#0b1220;
      transition:.15s; user-select:none;
    }
    .btn:hover{ background: rgba(2,6,23,.03); }
    .btn.primary{
      background:#0b76d8; border-color:#0b76d8;
      color:#fff; box-shadow: 0 10px 18px rgba(11,118,216,.18);
    }
    .btn.primary:hover{ filter:brightness(.98); transform: translateY(-1px); }
    .btn[disabled]{ opacity:.55; cursor:not-allowed; transform:none !important; box-shadow:none !important; }

    /* Selector cards */
    .pick-grid{ display:grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap:12px; }
    @media (max-width: 720px){ .pick-grid{ grid-template-columns: 1fr; } }

    .pick{
      border:1px solid rgba(15,23,42,.12);
      border-radius:16px; padding:14px;
      background:#fbfcfe; cursor:pointer;
      transition:.15s; position:relative;
      display:flex; flex-direction:column;
      gap:8px; min-height:96px;
    }
    .pick:hover{ background: rgba(2,6,23,.02); }
    .pick .t{
      font-weight:900; font-size:16px;
      letter-spacing:-0.01em; color:var(--ink);
      display:flex; align-items:center; justify-content:space-between; gap:10px;
    }
    .pick .d{ color:var(--muted); font-size:14px; line-height:1.35; }
    .pick.selected{
      border-color: rgba(11,118,216,.65);
      box-shadow: 0 10px 18px rgba(11,118,216,.12);
      background: rgba(11,118,216,.06);
    }

    .tick{
      width:22px; height:22px; border-radius:999px;
      border:2px solid rgba(15,23,42,.18);
      display:inline-flex; align-items:center; justify-content:center;
      flex:0 0 22px;
    }
    .pick.selected .tick{ border-color:#0b76d8; background:#0b76d8; color:#fff; }
    .tick svg{ display:block; }

    /* Color chips */
    .color-grid{ display:grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap:12px; }
    @media (max-width: 720px){ .color-grid{ grid-template-columns: 1fr; } }

    .chip{
      border:1px solid rgba(15,23,42,.12);
      border-radius:16px; padding:12px 14px;
      background:#fbfcfe; cursor:pointer;
      transition:.15s; display:flex; align-items:center; gap:12px;
      font-weight:900;
    }
    .chip:hover{ background: rgba(2,6,23,.02); }
    .chip.selected{
      border-color: rgba(11,118,216,.65);
      background: rgba(11,118,216,.06);
      box-shadow: 0 10px 18px rgba(11,118,216,.10);
    }

    .dot{
      width:18px; height:18px; border-radius:6px;
      border:1px solid rgba(0,0,0,.18);
      flex:0 0 18px;
    }
    .dot.white{ background:#ffffff; }
    .dot.black{ background:#111827; }
    .dot.silver{ background: linear-gradient(135deg, #cbd5e1, #94a3b8); }

    .hidden{ display:none !important; }

    /* ===========================
       ✅ PREVIEW
       =========================== */
    .preview-area{
      margin-top:14px;
      border:1px solid rgba(15,23,42,.12);
      border-radius:16px;
      background:#fbfcfe;
      padding:14px;
      overflow: hidden;
      min-width: 0;
    }
    .preview-title{ font-weight:900; color:var(--ink); margin-bottom:10px; }

    .preview-scroll{
      width: 100%;
      overflow-x: auto;
      padding-bottom: 8px;
      cursor: grab;
      user-select: none;
    }
    .preview-scroll.is-dragging{ cursor: grabbing; }

    .preview-stage{
      position:relative;
      border-radius:14px;
      background:#fff;
      border:1px solid rgba(15,23,42,.10);
      padding:18px;
      padding-bottom:160px;
      overflow:visible;
      display:flex;
      justify-content:flex-start;
      align-items:flex-start;
      width: max-content;
      min-width: 100%;
    }

    /* ✅ contenedor de todos los grupos */
    .groups-stage{
      display:flex;
      flex-direction:column;
      gap:150px;
      align-items:center;
      width:100%;
    }

    /* ✅ etiqueta de grupo */
    .group-label{
      font-weight:900;
      color:#0b1220;
      font-size:14px;
      margin-bottom:8px;
      text-align:center;
    }

    /* ✅ Wrapper por grupo (brazos/patas por grupo)
       + variables para grid de columnas/patas */
    .support-wrap{
      --armW: 75px;
      --armOverlap: 24px;

      /* ✅ mismas medidas para .cols y .legs-under */
      --colW: {{ kuik.col_width_px }}px;
      --colGap: 6px;

      position:relative;
      display:inline-block;
      padding-left:  calc(var(--armW) - var(--armOverlap));
      padding-right: calc(var(--armW) - var(--armOverlap));
    }

    /* ✅ columnas en GRID para alinear patas */
    .cols{
      display:grid;
      grid-template-columns: repeat(var(--colsN), var(--colW));
      justify-content:center;
      align-items:flex-start;
    }

    .col-shell{
      width:var(--colW);
      display:flex;
      flex-direction:column;
      gap:6px;
      align-items:center;
    }

    .col-card{
      width:100%;
      border-style:solid;
      border-color: var(--col-border, #000);
      border-left-width:4px;
      border-right-width:4px;
      border-top-width:8px;
      border-bottom-width:8px;
      border-radius:12px;
      overflow:hidden;
      background:#f7f7f7;
      box-shadow: var(--shadow);
      position:relative;
      z-index:2;
    }

    .col-body{
      background:#eaeaea;
      display:flex;
      flex-direction:column;
    }

    .col-half{
      display:flex;
      flex-direction:column;
      overflow:hidden;
    }

    .door{
      width:100%;
      border:1px solid rgba(44,62,80,.9);
      background: var(--door-color, #3a9efc);
      position:relative;
      display:flex;
      align-items:center;
      justify-content:center;
    }

    .door.screen{ padding:6px; }
    .door.screen img{
      width:125%;
      height:125%;
      object-fit:contain;
      pointer-events:none;
      user-select:none;
    }

    .door .num{
      position:absolute;
      left:6px;
      top:4px;
      font-weight:900;
      font-size:12px;
      background: rgba(0,0,0,.65);
      color:#fff;
      border-radius:999px;
      padding:2px 7px;
      line-height:1.2;
    }

    /* ✅ PATAS por GRUPO (IMAGEN) alineadas con columnas */
    .legs-under{
      width:100%;
      display:grid;
      grid-template-columns: repeat(var(--colsN), var(--colW));
      justify-content:center;
      pointer-events:none;
      user-select:none;
      z-index:1;
      //padding: 0 18px;
    }

    .leg-img{
      width:65px;
      height:{{ (132 + singleCap * (scaleArm - scale))|round }}px;
      object-fit:fill;
      justify-self:center;
      flex:0 0 auto;
    }

    /* ✅ BRAZOS por grupo */
    .arm-img{
      position:absolute;
      top: 58px;
      width: var(--armW);
      height: calc({{ (singleCap * scaleArm) }}px + 86px);
      object-fit: contain;
      z-index:1;
      pointer-events:none;
      user-select:none;
      opacity:1;
    }

    .arm-img.left{
      left: calc(-0.2 * var(--armOverlap));
      transform: scaleX(-1);
    }

    .arm-img.right{
      right: calc(-0.2 * var(--armOverlap));
    }

    @media (max-width: 720px){
      .support-wrap{
        --armW: 100px;
        --armOverlap: 14px;

        --colW: 165px;
        --colGap: 6px;
      }

      .arm-img{ top:42px; }

      .legs-under{ padding:0 14px; }
      .leg-img{ width:42px; height:42px; }
    }

    .door.mailbox{
      padding:0;
      overflow:hidden;
    }

    .door.mailbox img{
      position:absolute;
      top:0; left:0;
      width:100%;
      height:100%;
      object-fit:fill;
      pointer-events:none;
      user-select:none;
      display:block;
    }

    /* Bloque de agrupación de buzones */
    .mb-group-block {
      display: flex;
      flex-direction: row;
      border-style: solid;
      border-color: var(--col-border, #000);
      border-left-width: 4px;
      border-right-width: 4px;
      border-top-width: 8px;
      border-bottom-width: 8px;
      border-radius: 7px;
      overflow: hidden;
      //box-shadow: var(--shadow);
      position: relative;
      z-index: 2;
      flex-shrink: 0;
    }
    .mb-group-col {
      width: {{ kuik.mb_col_width_px }}px;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
    }
    .mb-group-col .door.mailbox {
      border: none;
      border-radius: 0;
    }

    /* Picker de patas para agrupación de buzones */
    .mb-leg-picker-wrap{
      position: relative;
      flex-shrink: 0;
    }
    .mb-leg-picker-row{
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      height: 28px;
      z-index: 6;
    }
    .mb-leg-btn{
      position: absolute;
      top: 2px;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      border: 2px solid #0b76d8;
      background: #fff;
      color: #0b76d8;
      font-size: 14px;
      font-weight: 900;
      cursor: pointer;
      line-height: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 5;
      padding: 0;
      transition: .15s;
    }
    .mb-legs-display{
      position: absolute;
      top: 100%;
      left: 0;
      z-index: 5;
      display: none;
      background: transparent;
    }
    .mb-leg-slot{
      position: absolute;
      top: 0;
      display: none;
      background: transparent;
      width: 80px;
    }
    .mb-leg-remove{
      position: absolute;
      top: 4px;
      left: 50%;
      transform: translateX(-50%);
      width: 20px;
      height: 20px;
      border-radius: 50%;
      border: none;
      background: #ef4444;
      color: #fff;
      font-size: 13px;
      font-weight: 900;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
      padding: 0;
      opacity: 0;
      transition: opacity .15s;
    }
    .mb-leg-slot:hover .mb-leg-remove{ opacity: 1; }

    /* Wrapper flex para taquillas + buzones en fila */
    .cols-and-mb {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      gap: 0;
    }
  </style>
{% endblock %}

{% block content %}
  <div class="page-wrap">
    <div class="page-head">
      <div>
        <h2 class="page-title">{{ 'bracket.page_title'|trans }}</h2>
        <div class="page-sub">
          <span class="id-pill">{{ 'bracket.header.config_id'|trans({'%id%': configuration.id}) }}</span>
          <span class="id-pill">{{ 'bracket.header.project'|trans({'%name%': project.projectName}) }}</span>
          <span class="id-pill">{{ 'bracket.header.installation'|trans }}</span>
        </div>
      </div>
    </div>

    <div class="grid">
      <div class="card">
        <h3>{{ 'bracket.step1.title'|trans }}</h3>
        <div class="muted">{{ 'bracket.step1.help'|trans({'%patas%': '<b>' ~ ('bracket.type.patas'|trans) ~ '</b>', '%brazos%': '<b>' ~ ('bracket.type.brazos'|trans) ~ '</b>'})|raw }}</div>

        <div class="pick-grid" style="margin-top:12px;">
          <div class="pick js-pick-type {% if selectedType == 'patas' %}selected{% endif %}" data-value="patas" role="button" tabindex="0">
            <div class="t">
              {{ 'bracket.type.patas'|trans }}
              <span class="tick" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
            <div class="d">{{ 'bracket.type.patas_desc'|trans }}</div>
          </div>

          <div class="pick js-pick-type {% if selectedType == 'brazos' %}selected{% endif %}" data-value="brazos" role="button" tabindex="0">
            <div class="t">
              {{ 'bracket.type.brazos'|trans }}
              <span class="tick" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
            <div class="d">{{ 'bracket.type.brazos_desc'|trans }}</div>
          </div>
        </div>

        <div class="section-sep"></div>

        <div id="colorSection" class="{% if not selectedType %}hidden{% endif %}">
          <h3>{{ 'bracket.step2.title'|trans }}</h3>
          <div class="muted">{{ 'bracket.step2.help'|trans }}</div>

          <div class="color-grid" style="margin-top:12px;">
            <div class="chip js-pick-color {% if selectedColor == 'blanco' %}selected{% endif %}" data-value="blanco" role="button" tabindex="0">
              <span class="dot white"></span> {{ 'bracket.color.white'|trans }}
            </div>
            <div class="chip js-pick-color {% if selectedColor == 'negro' %}selected{% endif %}" data-value="negro" role="button" tabindex="0">
              <span class="dot black"></span> {{ 'bracket.color.black'|trans }}
            </div>
            <div class="chip js-pick-color {% if selectedColor == 'plata' %}selected{% endif %}" data-value="plata" role="button" tabindex="0">
              <span class="dot silver"></span> {{ 'bracket.color.silver'|trans }}
            </div>
          </div>
        </div>

        {# ✅ PREVIEW: por GRUPOS #}
        <div class="preview-area">
          <div class="preview-title">{{ 'bracket.preview.title'|trans }}</div>

          <div class="preview-scroll">
          <div class="preview-stage">
            <div class="groups-stage" id="previewGroups" style="--door-color: {{ doorColor }}; --col-border: {{ bodyColor }};">
              {# Agrupación de buzones #}
              {% set agrupacionCombinada = p.agrupacion_combinada ?? false %}
              {% set mailboxGroup = p.mailboxGroup ?? null %}
              {% set mbImg = mailboxGroup.imageUrl ?? kuik.img_buzon_btv %}
              {% set mbSide = mailboxGroup.side ?? 'right' %}
              {% set mbRows = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.rows ?? 0) : 0 %}
              {% set mbCols = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.cols ?? 0) : 0 %}
              {% set mbCells = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.cells ?? []) : [] %}
              {% set mbCellH = 10 * scale %}
              {% set mbBlockH = mbRows * mbCellH + 16 %}
              {% set mbLockerH = (singleCap * scale) + 16 %}
              {% set mbMarginTop = 10 + (mbLockerH - mbBlockH) / 2 %}
              {# Solo mostramos el bloque de buzones en el último grupo #}
              {% set lastGroupIndex = groups|length %}

              {% if groups is empty %}
                <div class="muted">{{ 'bracket.preview.no_columns'|trans }}</div>
              {% else %}
                {% set doorIndex = 0 %}

                {% for groupCols in groups %}
                  {% if groupCols is not iterable %}{% set groupCols = [] %}{% endif %}
                  {% set isLastGroup = loop.index == lastGroupIndex %}

                  <div class="group-block">
                    <div class="group-label">{{ 'bracket.preview.group_label'|trans({'%index%': loop.index, '%count%': groupCols|length}) }}</div>

                    {# ✅ --colsN para alinear grid columnas + patas #}
                    {% set mbBlockW = (isLastGroup and mbRows > 0 and mbCols > 0) ? (mbCols * kuik.mb_col_width_px) : 0 %}
                    <div class="support-wrap" style="--colsN: {{ groupCols|length }}; --mbBlockW: {{ mbBlockW }}px;">

                      {# ✅ brazos por grupo #}
                      <img
                        class="arm-img left js-arm {% if selectedType != 'brazos' %}hidden{% endif %}"
                        data-arm="left"
                        src="{% if selectedColor == 'blanco' %}
                              {{ asset(kuik.img_brazo_blanco) }}
                            {% elseif selectedColor == 'plata' %}
                              {{ asset(kuik.img_brazo_plata) }}
                            {% else %}
                              {{ asset(kuik.img_brazo_negro) }}
                            {% endif %}"
                        alt="{{ 'bracket.alt.arm_left'|trans }}">

                      <img
                        class="arm-img right js-arm {% if selectedType != 'brazos' %}hidden{% endif %}"
                        data-arm="right"
                        src="{% if selectedColor == 'blanco' %}
                              {{ asset(kuik.img_brazo_blanco) }}
                            {% elseif selectedColor == 'plata' %}
                              {{ asset(kuik.img_brazo_plata) }}
                            {% else %}
                              {{ asset(kuik.img_brazo_negro) }}
                            {% endif %}"
                        alt="{{ 'bracket.alt.arm_right'|trans }}">

                      <div class="cols-and-mb">

                        {# ── Buzones IZQUIERDA (solo en último grupo) ── #}
                        {% if isLastGroup and mbRows > 0 and mbCols > 0 and mbSide == 'left' %}
                          {% set mbTotalW = mbCols * kuik.mb_col_width_px %}
                          {% set mbLegH = (132 + singleCap * (scaleArm - scale))|round %}
                          <div class="mb-leg-picker-wrap">
                            <div class="mb-group-block">
                              {% for c in 0..(mbCols - 1) %}
                                <div class="mb-group-col">
                                  {% for r in 0..(mbRows - 1) %}
                                    {% set cellIdx = r * mbCols + c %}
                                    {% set filled = mbCells[cellIdx] ?? true %}
                                    <div class="door mailbox" style="height:{{ mbCellH }}px;{% if not filled %}opacity:0.1;background:#eaeaea;{% endif %}">
                                      {% if filled %}<img src="{{ mbImg }}" alt="{{ 'bracket.alt.mailbox'|trans }}">{% endif %}
                                    </div>
                                  {% endfor %}
                                </div>
                              {% endfor %}
                            </div>
                            {% if instalacion == 'soporte_suelo' %}
                              <div class="mb-leg-picker-row" style="width:{{ mbTotalW }}px;" data-mb-cols="{{ mbCols }}">
                                {% for i in 0..(mbCols * 2 - 2) %}
                                  {% if i is even %}
                                    {% set xCenter = ((i / 2) + 0.5) * kuik.mb_col_width_px %}
                                  {% else %}
                                    {% set xCenter = ((i + 1) / 2) * kuik.mb_col_width_px %}
                                  {% endif %}
                                  <button type="button" class="mb-leg-btn" data-pos="{{ i }}" style="left:{{ (xCenter - 12)|round }}px;">+</button>
                                {% endfor %}
                              </div>
                              <div class="mb-legs-display" style="width:{{ mbTotalW }}px; height:{{ mbLegH }}px;">
                                {% for i in 0..(mbCols * 2 - 2) %}
                                  {% if i is even %}
                                    {% set xCenter = ((i / 2) + 0.5) * kuik.mb_col_width_px %}
                                  {% else %}
                                    {% set xCenter = ((i + 1) / 2) * kuik.mb_col_width_px %}
                                  {% endif %}
                                  <div class="mb-leg-slot" data-pos="{{ i }}" style="left:{{ (xCenter - 40)|round }}px;">
                                    <img class="leg-img" style="width:65px; height:{{ mbLegH }}px; object-fit:fill; display:block;" src="{{ asset(kuik.img_pie) }}" alt="{{ 'bracket.alt.leg'|trans }}">
                                    <button type="button" class="mb-leg-remove" title="{{ 'bracket.action.remove_leg'|trans }}">×</button>
                                  </div>
                                {% endfor %}
                              </div>
                            {% endif %}
                          </div>
                        {% endif %}

                      <div class="cols">
                        {% for col in groupCols %}
                          <div class="col-shell">

                            <div class="col-card">
                              <div class="col-body" style="height: {{ (singleCap * scale) }}px;">
                                <div class="col-half" style="height: {{ (singleCap * scale) }}px;">

                                  {% set blocks = (col.single.blocks_prepared ?? col.single.blocks ?? col.blocks_prepared ?? col.blocks ?? []) %}
                                  {% if blocks is not iterable %}{% set blocks = [] %}{% endif %}

                                  {% for blk in blocks %}
                                    {% set hh = blk.h|default(blk) %}
                                    {% set btype = blk.type|default('door') %}

                                    {% if btype != 'screen' and btype != 'mailbox' %}
                                      {% set doorIndex = doorIndex + 1 %}
                                    {% endif %}

                                    <div class="door {{ btype == 'screen' ? 'screen' : '' }} {{ btype == 'mailbox' ? 'mailbox' : '' }}"
                                        style="height: {{ (hh * scale) }}px;">
                                      {% if btype == 'screen' %}
                                        <img src="{{ asset(kuik.img_pantalla) }}" alt="{{ 'bracket.alt.screen'|trans }}">
                                      {% elseif btype == 'mailbox' %}
                                        {% set _elec = blk.electronico ?? false %}
                                        {% set _tarj = blk.tarjetero ?? false %}
                                        {% set _buzonImg = _elec ? (_tarj ? 'assets/buzon_kuik_electronico_con_tarjetero.png' : 'assets/buzon_kuik_electronico_sin_tarjetero.png') : (_tarj ? 'assets/buzon_kuik_mecanico_con_tarjetero.png' : 'assets/buzon_kuik_mecanico_sin_tarjetero.png') %}
                                        <img src="{{ asset(_buzonImg) }}" alt="{{ 'bracket.alt.mailbox'|trans }}">
                                      {% else %}
                                        <div class="num">{{ doorIndex }}</div>
                                      {% endif %}
                                    </div>
                                  {% endfor %}

                                </div>
                              </div>
                            </div>

                          </div>
                        {% endfor %}
                      </div>

                        {# ── Buzones DERECHA (solo en último grupo) ── #}
                        {% if isLastGroup and mbRows > 0 and mbCols > 0 and mbSide == 'right' %}
                          {% set mbTotalW = mbCols * kuik.mb_col_width_px %}
                          {% set mbLegH = (132 + singleCap * (scaleArm - scale))|round %}
                          <div class="mb-leg-picker-wrap">
                            <div class="mb-group-block">
                              {% for c in 0..(mbCols - 1) %}
                                <div class="mb-group-col">
                                  {% for r in 0..(mbRows - 1) %}
                                    {% set cellIdx = r * mbCols + c %}
                                    {% set filled = mbCells[cellIdx] ?? true %}
                                    <div class="door mailbox" style="height:{{ mbCellH }}px;{% if not filled %}opacity:0.1;background:#eaeaea;{% endif %}">
                                      {% if filled %}<img src="{{ mbImg }}" alt="{{ 'bracket.alt.mailbox'|trans }}">{% endif %}
                                    </div>
                                  {% endfor %}
                                </div>
                              {% endfor %}
                            </div>
                            {% if instalacion == 'soporte_suelo' %}
                              <div class="mb-leg-picker-row" style="width:{{ mbTotalW }}px;" data-mb-cols="{{ mbCols }}">
                                {% for i in 0..(mbCols * 2 - 2) %}
                                  {% if i is even %}
                                    {% set xCenter = ((i / 2) + 0.5) * kuik.mb_col_width_px %}
                                  {% else %}
                                    {% set xCenter = ((i + 1) / 2) * kuik.mb_col_width_px %}
                                  {% endif %}
                                  <button type="button" class="mb-leg-btn" data-pos="{{ i }}" style="left:{{ (xCenter - 12)|round }}px;">+</button>
                                {% endfor %}
                              </div>
                              <div class="mb-legs-display" style="width:{{ mbTotalW }}px; height:{{ mbLegH }}px;">
                                {% for i in 0..(mbCols * 2 - 2) %}
                                  {% if i is even %}
                                    {% set xCenter = ((i / 2) + 0.5) * kuik.mb_col_width_px %}
                                  {% else %}
                                    {% set xCenter = ((i + 1) / 2) * kuik.mb_col_width_px %}
                                  {% endif %}
                                  <div class="mb-leg-slot" data-pos="{{ i }}" style="left:{{ (xCenter - 40)|round }}px;">
                                    <img class="leg-img" style="width:65px; height:{{ mbLegH }}px; object-fit:fill; display:block;" src="{{ asset(kuik.img_pie) }}" alt="{{ 'bracket.alt.leg'|trans }}">
                                    <button type="button" class="mb-leg-remove" title="{{ 'bracket.action.remove_leg'|trans }}">×</button>
                                  </div>
                                {% endfor %}
                              </div>
                            {% endif %}
                          </div>
                        {% endif %}

                      </div>{# /cols-and-mb #}

                      {# ✅ PATAS bajo taquillas cuando brazos + agrupacion combinada #}
                      {% if isLastGroup and instalacion == 'soporte_suelo' and agrupacionCombinada and mbCols > 0 %}
                        {% set n = groupCols|length %}
                        {% if n == 1 %}
                          {% set mbLegPositions = [1] %}
                        {% elseif n == 2 %}
                          {% set mbLegPositions = [1, 2] %}
                        {% elseif n == 3 %}
                          {% set mbLegPositions = [1, 3] %}
                        {% elseif n == 4 %}
                          {% set mbLegPositions = [2, 3] %}
                        {% elseif n == 5 %}
                          {% set mbLegPositions = [2, 4] %}
                        {% elseif n == 6 %}
                          {% set mbLegPositions = [2, 4, 6] %}
                        {% elseif n == 7 %}
                          {% set mbLegPositions = [2, 4, 6, 7] %}
                        {% elseif n == 8 %}
                          {% set mbLegPositions = [2, 4, 6, 8] %}
                        {% elseif n == 9 %}
                          {% set mbLegPositions = [2, 4, 7, 8] %}
                        {% else %}
                          {% set mbLegPositions = [2, 4, 7, 9] %}
                        {% endif %}
                        {% if mbSide == 'left' and n > 5 %}
                          {% if n == 6 %}{% set mbLegPositions = [1, 3, 5] %}
                          {% elseif n == 7 %}{% set mbLegPositions = [1, 2, 4, 6] %}
                          {% elseif n == 8 %}{% set mbLegPositions = [1, 3, 5, 7] %}
                          {% elseif n == 9 %}{% set mbLegPositions = [2, 3, 6, 8] %}
                          {% endif %}
                        {% endif %}
                        {% set mbBlockWFull = mbCols * kuik.mb_col_width_px + 8 %}
                        <div class="js-brazos-legs {% if selectedType != 'brazos' %}hidden{% endif %}" style="display:flex;flex-direction:row;width:100%;">
                          {% if mbSide == 'left' %}
                            <div style="width:{{ mbBlockWFull }}px;flex-shrink:0;"></div>
                          {% endif %}
                          <div class="legs-under" style="flex:1;">
                            {% for pos in mbLegPositions %}
                              <img class="leg-img" style="grid-column: {{ pos }};" src="{{ asset(kuik.img_pie) }}" alt="{{ 'bracket.alt.leg'|trans }}">
                            {% endfor %}
                          </div>
                          {% if mbSide == 'right' %}
                            <div style="width:{{ mbBlockWFull }}px;flex-shrink:0;"></div>
                          {% endif %}
                        </div>
                      {% endif %}

                      {# ✅ PATAS por GRUPO -> posiciones alineadas (1,3,5 cuando son 5) #}
                      {% set n = groupCols|length %}

                      {% if n == 1 %}
                        {% set legPositions = [1] %}
                      {% elseif n == 2 %}
                        {% set legPositions = [1, 2] %}
                      {% elseif n == 3 %}
                        {% set legPositions = [1, 3] %}
                      {% elseif n == 4 %}
                        {% set legPositions = [2, 3] %}
                      {% elseif n == 5 %}
                        {% set legPositions = [2, 4] %}
                      {% elseif n == 6 %}
                        {% set legPositions = [2, 4, 6] %}
                      {% elseif n == 7 %}
                        {% set legPositions = [2, 4, 6, 7] %}
                      {% elseif n == 8 %}
                        {% set legPositions = [2, 4, 6, 8] %}
                      {% elseif n == 9 %}
                        {% set legPositions = [2, 4, 7, 8] %}
                      {% else %}
                        {% set legPositions = [2, 4, 7, 9] %}
                      {% endif %}
                      {% if agrupacionCombinada and mbSide == 'left' and n > 5 %}
                        {% if n == 6 %}{% set legPositions = [1, 3, 5] %}
                        {% elseif n == 7 %}{% set legPositions = [1, 2, 4, 6] %}
                        {% elseif n == 8 %}{% set legPositions = [1, 3, 5, 7] %}
                        {% elseif n == 9 %}{% set legPositions = [2, 3, 6, 8] %}
                        {% endif %}
                      {% endif %}

                      {% if isLastGroup and agrupacionCombinada and mbCols > 0 %}
                        {% set mbBlockWFull = mbCols * kuik.mb_col_width_px + 8 %}
                        <div style="display:flex;flex-direction:row;width:100%;" class="js-legs {% if selectedType != 'patas' %}hidden{% endif %}">
                          {% if mbSide == 'left' %}
                            <div style="width:{{ mbBlockWFull }}px;flex-shrink:0;"></div>
                          {% endif %}
                          <div class="legs-under" style="flex:1;">
                            {% for pos in legPositions %}
                              <img class="leg-img" style="grid-column: {{ pos }};" src="{{ asset(kuik.img_pie) }}" alt="{{ 'bracket.alt.leg'|trans }}">
                            {% endfor %}
                          </div>
                          {% if mbSide == 'right' %}
                            <div style="width:{{ mbBlockWFull }}px;flex-shrink:0;"></div>
                          {% endif %}
                        </div>
                      {% else %}
                        <div class="legs-under js-legs {% if selectedType != 'patas' %}hidden{% endif %}">
                          {% for pos in legPositions %}
                            <img class="leg-img"
                                 style="grid-column: {{ pos }};"
                                 src="{{ asset(kuik.img_pie) }}"
                                 alt="{{ 'bracket.alt.leg'|trans }}">
                          {% endfor %}
                        </div>
                      {% endif %}

                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            </div>
          </div>
          </div>{# /preview-scroll #}
        </div>

        <form id="bracketForm" method="post" action="{{ path('save_brackets') }}" style="margin-top:16px;">
          <input type="hidden" name="_token" value="{{ csrf_token('save_brackets') }}">
          <input type="hidden" name="project_id" value="{{ project.id }}">
          <input type="hidden" name="configuration_id" value="{{ configuration.id }}">

          <input type="hidden" name="bracketType" id="bracketType" value="{{ selectedType }}">
          <input type="hidden" name="bracketColor" id="bracketColor" value="{{ selectedColor }}">
          <input type="hidden" name="mbLegPositions" id="mbLegPositions" value="{{ (p.mbLegPositions is defined and p.mbLegPositions is iterable) ? p.mbLegPositions|json_encode : '[]' }}">

          <div class="btn-row">
            <a class="btn" style="text-decoration:none; color:#000"
               href="{{ path('configuration_columns', {
                 config_id: configuration.id,
                 type: payload.type|default('')
               }) }}">
              {{ 'bracket.actions.back'|trans }}
            </a>

            <button id="btnContinue" class="btn primary" type="submit" {% if not selectedType or not selectedColor %}disabled{% endif %}>
              {{ 'bracket.actions.continue'|trans }}
            </button>
          </div>

          <div class="muted" style="margin-top:10px;">
            {{ 'bracket.actions.continue_hint'|trans({'%continue%': '<b>' ~ ('bracket.actions.continue'|trans) ~ '</b>'})|raw }}
          </div>
        </form>
      </div>
    </div>
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const typeBtns = Array.from(document.querySelectorAll('.js-pick-type'));
      const colorBtns = Array.from(document.querySelectorAll('.js-pick-color'));

      const colorSection = document.getElementById('colorSection');
      const inpType = document.getElementById('bracketType');
      const inpColor = document.getElementById('bracketColor');
      const btnContinue = document.getElementById('btnContinue');

      // ✅ brazos (por grupo) y patas (por grupo)
      const armList = Array.from(document.querySelectorAll('.js-arm'));
      const legsList = Array.from(document.querySelectorAll('.js-legs'));

      if (!colorSection || !inpType || !inpColor || !btnContinue) return;

      const armSrcMap = {
        blanco: '{{ asset(kuik.img_brazo_blanco) }}',
        negro:  '{{ asset(kuik.img_brazo_negro) }}',
        plata:  '{{ asset(kuik.img_brazo_plata) }}'
      };

      function setSelected(list, el){
        list.forEach(x => x.classList.remove('selected'));
        el.classList.add('selected');
      }

      function updateContinue(){
        btnContinue.disabled = !(inpType.value && inpColor.value);
      }

      function enableColors(){
        colorSection.classList.remove('hidden');
      }

      function toggleSupports(){
        const v = (inpType.value || '').trim();

        // brazos (todos)
        if (armList.length){
          if (v === 'brazos') armList.forEach(x => x.classList.remove('hidden'));
          else armList.forEach(x => x.classList.add('hidden'));
        }

        // patas bajo taquillas cuando brazos + combinada
        document.querySelectorAll('.js-brazos-legs').forEach(x => {
          if (v === 'brazos') x.classList.remove('hidden');
          else x.classList.add('hidden');
        });

        // patas (todas)
        if (legsList.length){
          if (v === 'patas') legsList.forEach(x => x.classList.remove('hidden'));
          else legsList.forEach(x => x.classList.add('hidden'));
        }
      }

      function updateSupportColor(){
        const c = (inpColor.value || '').trim(); // blanco|negro|plata

        // ✅ patas ahora son imagen fija (pie_negro.jpg) -> no se recolorean

        // brazos (cambia src a todos)
        const src = armSrcMap[c] || armSrcMap.negro;
        armList.forEach(img => { img.src = src; });
      }

      typeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          setSelected(typeBtns, btn);
          inpType.value = btn.dataset.value;
          enableColors();
          toggleSupports();
          updateSupportColor();
          updateContinue();
          syncMbLegs();
        });
      });

      colorBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          setSelected(colorBtns, btn);
          inpColor.value = btn.dataset.value;
          updateSupportColor();
          updateContinue();
        });
      });

      // init
      if (inpType.value) enableColors();
      toggleSupports();
      updateSupportColor();
      updateContinue();

      // ── Picker de patas en agrupación de buzones (selección única) ──
      const mbLegInp = document.getElementById('mbLegPositions');
      let mbSelected = [];
      try {
        const parsed = JSON.parse(mbLegInp ? mbLegInp.value : '[]');
        mbSelected = Array.isArray(parsed) ? parsed.map(Number) : [];
      } catch(e) {}

      // Posiciones automáticas según número de columnas de buzones (misma lógica que taquillas)
      // Devuelve slot-indices (0-indexed): col k (1-indexed) → slot (k-1)*2
      function getMbAutoPositions(n) {
        let cols;
        if      (n === 1) cols = [1];
        else if (n === 2) cols = [1, 2];
        else if (n === 3) cols = [1, 3];
        else if (n === 4) cols = [2, 3];
        else if (n === 5) cols = [2, 4];
        else if (n === 6) cols = [2, 4, 6];
        else if (n === 7) cols = [2, 4, 6, 7];
        else if (n === 8) cols = [2, 4, 6, 8];
        else if (n === 9) cols = [2, 4, 7, 8];
        else              cols = [2, 4, 7, 9];
        return cols.map(c => (c - 1) * 2);
      }

      function isMbPatas() {
        return inpType && inpType.value === 'patas';
      }

      function getMbCols() {
        const row = document.querySelector('.mb-leg-picker-row');
        return row ? parseInt(row.dataset.mbCols || '0') : 0;
      }

      function getMbMaxLegs() {
        const n = getMbCols();
        return n > 0 ? Math.ceil(n / 5) : 0;
      }

      function syncMbLegs() {
        const patas = isMbPatas();
        let activePositions;

        if (patas) {
          const n = getMbCols();
          activePositions = n > 0 ? getMbAutoPositions(n) : [];
          mbSelected = activePositions;
        } else {
          activePositions = mbSelected;
        }

        const hasSel = activePositions.length > 0;
        const maxLegs = getMbMaxLegs();
        const atLimit = !patas && mbSelected.length >= maxLegs;

        // Picker: oculto en patas (auto) y cuando se alcanza el límite en brazos
        document.querySelectorAll('.mb-leg-picker-row').forEach(row => {
          row.style.display = (patas || atLimit) ? 'none' : '';
        });
        document.querySelectorAll('.mb-legs-display').forEach(disp => {
          disp.style.display = hasSel ? 'block' : 'none';
        });
        document.querySelectorAll('.mb-leg-slot').forEach(slot => {
          slot.style.display = activePositions.includes(parseInt(slot.dataset.pos)) ? 'block' : 'none';
        });
        document.querySelectorAll('.mb-leg-btn').forEach(btn => {
          const pos = parseInt(btn.dataset.pos);
          const selected = mbSelected.includes(pos);
          btn.classList.toggle('active', selected);
          btn.textContent = selected ? '✓' : '+';
          // Ocultar todos los botones cuando se alcanza el límite (la pata ya es visible y el × sale al hover)
          btn.style.display = (!patas && atLimit) ? 'none' : 'flex';
        });
        if (mbLegInp) mbLegInp.value = JSON.stringify(mbSelected);
      }

      document.querySelectorAll('.mb-leg-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          if (isMbPatas()) return;
          const pos = parseInt(btn.dataset.pos);
          const idx = mbSelected.indexOf(pos);
          if (idx >= 0) {
            mbSelected.splice(idx, 1);
          } else if (mbSelected.length < getMbMaxLegs()) {
            mbSelected.push(pos);
          }
          syncMbLegs();
        });
      });

      document.querySelectorAll('.mb-leg-remove').forEach(btn => {
        btn.addEventListener('click', () => {
          if (isMbPatas()) return;
          const slot = btn.closest('.mb-leg-slot');
          if (slot) mbSelected = mbSelected.filter(p => p !== parseInt(slot.dataset.pos));
          else mbSelected = [];
          syncMbLegs();
        });
      });

      syncMbLegs();

      // drag-to-scroll en preview
      var scroll = document.querySelector('.preview-scroll');
      if (scroll) {
        var isDragging = false, startX, scrollLeft;
        scroll.addEventListener('mousedown', function(e) {
          isDragging = true;
          scroll.classList.add('is-dragging');
          startX = e.pageX - scroll.getBoundingClientRect().left;
          scrollLeft = scroll.scrollLeft;
          e.preventDefault();
        });
        document.addEventListener('mouseup', function() {
          isDragging = false;
          scroll.classList.remove('is-dragging');
        });
        document.addEventListener('mousemove', function(e) {
          if (!isDragging) return;
          var x = e.pageX - scroll.getBoundingClientRect().left;
          scroll.scrollLeft = scrollLeft - (x - startX) * 1.2;
        });
      }
    });
  </script>
{% endblock %}
