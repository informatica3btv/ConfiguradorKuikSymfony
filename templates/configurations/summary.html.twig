{% extends 'layout.html.twig' %}

{% set p = payload ?? {} %}
{% if p is not iterable %}{% set p = {} %}{% endif %}

{% set groups = p.groups ?? [] %}
{% if groups is not iterable %}{% set groups = [] %}{% endif %}

{% set columnsFlat = p.columns ?? [] %}
{% if columnsFlat is not iterable %}{% set columnsFlat = [] %}{% endif %}

{% if groups is empty and columnsFlat is not empty %}
  {% set groups = [columnsFlat] %}
{% endif %}

{% set columnsAll = [] %}
{% for g in groups %}
  {% if g is iterable %}
    {% set columnsAll = columnsAll|merge(g) %}
  {% endif %}
{% endfor %}

{% set type = p.type ?? '' %}
{% set instalacion = p.instalacion ?? '' %}

{% set doorColor = p.colorDoor ?? '#3a9efc' %}
{% set doorColorRal = p.colorDoorRal ?? '' %}
{% set bodyColor = p.colorBody ?? '#000' %}
{% set bodyColorRal = p.colorBodyRal ?? '' %}

{% set bg = p.fondo ?? '' %}
{% set placement = p.placement ?? '' %}
{% set material = p.material ?? '' %}
{% set addons = p.addons ?? {} %}

{% set isHome = (type == 'home') %}
{% set isZocalo = (isHome and instalacion == 'zocalo') %}
{% set isEmpotradoLike = (isHome and (instalacion == 'empotrado' or instalacion == 'soporte_suelo' or instalacion == 'colgado')) %}

{% set topCap = isZocalo ? (p.topCap|default(kuik.default_top_cap)) : kuik.default_top_cap %}
{% set bottomCap = isZocalo ? 70 : kuik.default_bottom_cap %}
{% set singleCap = isEmpotradoLike ? (p.singleCap|default(40)) : kuik.default_single_cap %}

{% set selectedType  = p.bracketType ?? '' %}
{% set selectedColor = p.bracketColor ?? '' %}
{% set isSoporteSuelo = (instalacion == 'soporte_suelo') %}

{% set bgLabel =
  bg == '300'  ? 'Serie 300' :
  bg == '400'  ? 'Serie 400' :
  bg == '500'  ? 'Serie 500' : '—'
%}

{% set placementLabel =
  placement == 'interior' ? 'Interior' :
  placement == 'exterior' ? 'Exterior' : '—'
%}

{% block page_title %}Resumen{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --hscale: 3.66;

      --bg:#f6f9fc;
      --ink:#0b1220;
      --muted:#6b7280;
      --line: rgba(15,23,42,.12);
      --shadow: 0 10px 25px rgba(2,20,60,.10);
      --shadow-sm: 0 6px 14px rgba(2,20,60,.10);

      --kuik-blue-900:#003b73;
      --kuik-blue-600:#0b76d8;
      --kuik-blue-500:#1187e6;
    }

    .page-wrap{
      max-width: 100%;
      margin: 22px auto 50px;
      padding: 0 14px;
    }

    .page-head{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:14px;
      flex-wrap:wrap;
      margin-bottom:14px;
    }

    .page-title{
      margin:0;
      font-size:34px;
      font-weight:900;
      letter-spacing:-0.02em;
    }

    .page-sub{
      margin-top:6px;
      color:var(--muted);
      font-size:15px;
      display:flex;
      align-items:center;
      gap:10px;
      flex-wrap:wrap;
    }

    .grid{
      display:grid;
      grid-template-columns: 1.35fr .75fr;
      gap:14px;
      align-items:start;
    }
    @media (max-width: 980px){
      .grid{ grid-template-columns: 1fr; }
    }

    .card{
      background:#fff;
      border:1px solid var(--line);
      min-width: 0;
      border-radius:16px;
      padding:16px;
      box-shadow: 0 1px 0 rgba(15,23,42,.04);
    }

    .card h3{
      margin:0 0 12px;
      font-size:16px;
      font-weight:900;
      letter-spacing:-0.01em;
    }

    .section-sep{
      height:1px;
      background: rgba(15,23,42,.10);
      margin:14px 0;
    }

    .kvs{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:10px;
    }

    .kv{
      border:1px solid rgba(15,23,42,.10);
      border-radius:14px;
      padding:10px 12px;
      background:#fbfcfe;
    }
    .kv .k{ font-size:12px; color:var(--muted); font-weight:900; }
    .kv .v{ font-size:14px; font-weight:900; margin-top:4px; color:var(--ink); }

    .preview-wrap{
      border:1px solid rgba(15,23,42,.10);
      border-radius:16px;
      padding:12px;
      overflow: visible;
      min-width: 0;
    }

    .preview-scroll{
      overflow-x: auto;
      padding-bottom: 8px;
      cursor: grab;
      user-select: none;
    }

    .preview-scroll.is-dragging{
      cursor: grabbing;
    }

    .preview-stage{
      position: relative;
      overflow: visible;
      display:flex;
      justify-content:flex-start;
      align-items:flex-start;
      padding-bottom: 175px;
      width: max-content;
      min-width: 100%;
    }

    .groups-stage{
      display:flex;
      flex-direction:column;
      gap:155px;
      align-items:center;
      width: max-content;
    }

    .group-label{
      font-weight:900;
      color:#0b1220;
      font-size:14px;
      margin:6px 0 10px;
      text-align:center;
    }

    .cols{
      display:grid;
      grid-template-columns: repeat(var(--colsN), 135px);
      justify-content:center;
      align-items:flex-start;
      margin-top:10px;
    }

    .col-shell{
      width:{{ kuik.col_width_px }}px;
      display:flex;
      flex-direction:column;
      gap:6px;
    }

    .col-card{
      width:{{ kuik.col_width_px }}px;
      border-style:solid;
      border-color: var(--col-border, #000);
      border-left-width:4px;
      border-right-width:4px;
      border-top-width:8px;
      border-bottom-width:8px;
      overflow:hidden;
      background:#f7f7f7;
      box-shadow: var(--shadow);
      position: relative;
      z-index: 2;
    }

    /* Grupo de buzones: bloque único con un solo borde exterior */
    .mb-group-block {
      display: flex;
      flex-direction: row;
      border-style: solid;
      border-color: var(--col-border, #000);
      border-left-width: 4px;
      border-right-width: 4px;
      border-top-width: 8px;
      border-bottom-width: 8px;
      border-radius: 7px;
      overflow: hidden;
      box-shadow: var(--shadow);
      position: relative;
      z-index: 2;
    }
    .mb-group-col {
      width: {{ kuik.mb_col_width_px }}px;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
    }
    .mb-group-col .door.mailbox {
      border: none;
      border-radius: 0;
    }

    .col-body{
      height:calc(180px * var(--hscale));
      background:#eaeaea;
      display:flex;
      flex-direction:column;
    }

    .col-half{
      height:calc(90px * var(--hscale));
      display:flex;
      flex-direction:column;
      overflow:hidden;
    }

    .half-sep{
      border-top:2px dashed rgba(0,0,0,.28);
    }

    .door{
      width:100%;
      border:1px solid rgba(44,62,80,.9);
      background: var(--door-color, #3a9efc);
      position:relative;
      display:flex;
      align-items:center;
      justify-content:center;
      box-sizing: border-box;
    }

    .door.screen{
      padding:0;
      overflow:hidden;
    }

    .door.screen img{
      width:115%;
      height:115%;
      object-fit:contain;
      pointer-events:none;
      user-select:none;
    }

    .door.mailbox{
      padding:0;
      overflow:hidden;
    }

    .door.mailbox img{
      position:absolute;
      top:0; left:0;
      width:100%;
      height:100%;
      object-fit:fill;
      pointer-events:none;
      user-select:none;
      display:block;
    }

    .door.methacrylate::after{
      content:"";
      position:absolute;
      inset:12px;
      background:rgba(0,0,0,.38);
      border-radius:4px;
      pointer-events:none;
    }

    .door .num,
    .door .badges{
      z-index:2;
    }

    .door .num{
      position:absolute;
      left:6px;
      top:4px;
      font-weight:900;
      font-size:12px;
      background: rgba(0,0,0,.65);
      color:#fff;
      border-radius:999px;
      padding:2px 7px;
      line-height:1.2;
    }

    .door .badges{
      position:absolute;
      right:6px;
      bottom:4px;
      display:flex;
      gap:4px;
      flex-wrap:wrap;
    }

    .badge-mini{
      font-size:10px;
      font-weight:900;
      background: rgba(255,255,255,.92);
      border:1px solid rgba(0,0,0,.18);
      border-radius:999px;
      padding:1px 5px;
    }

    .addons-table{
      width:100%;
      border-collapse:separate;
      border-spacing:0;
      margin-top:10px;
      border:1px solid rgba(15,23,42,.12);
      border-radius:14px;
      overflow:hidden;
      background:#fff;
    }

    .addons-table th,
    .addons-table td{
      padding:10px 12px;
      border-bottom:1px solid rgba(15,23,42,.08);
      font-size:14px;
      text-align:left;
    }

    .addons-table th{
      background:#fbfcfe;
      font-weight:900;
      color:#334155;
      font-size:12px;
    }

    .addons-table tr:last-child td{
      border-bottom:0;
    }

    .btn-row{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
      margin:14px;
    }

    .btn{
      border:1px solid rgba(15,23,42,.12);
      background:#fff;
      border-radius:12px;
      padding:10px 14px;
      font-weight:900;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      gap:10px;
      text-decoration:none;
      color:#0b1220;
      transition:.15s;
    }

    .btn:hover{
      background: rgba(2,6,23,.03);
    }

    .btn.primary{
      background:#0b76d8;
      border-color:#0b76d8;
      color:#fff;
      box-shadow: 0 10px 18px rgba(11,118,216,.18);
    }

    .btn.primary:hover{
      filter:brightness(.98);
      transform: translateY(-1px);
    }

    .muted{
      color:var(--muted);
      font-size:15px;
    }

    .id-pill{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:6px 10px;
      border-radius:999px;
      background: rgba(11,118,216,.10);
      border:1px solid rgba(11,118,216,.18);
      font-weight:900;
      color:#0b76d8;
    }

    .support-wrap{
      --armW: 65px;
      --armOverlap: 14px;
      --colW: {{ kuik.col_width_px }}px;

      position: relative;
      display: inline-block;
      padding-left:  calc(var(--armW) - var(--armOverlap));
      padding-right: calc(var(--armW) - var(--armOverlap));
    }

    .arm-img{
      position:absolute;
      top: 60px;
      width: var(--armW);
      height: calc(90px * var(--hscale) + 16px);
      object-fit: contain;
      z-index: 1;
      pointer-events:none;
      padding-bottom: 40px;
      user-select:none;
    }

    .arm-img.left{
      left: calc(-0.3 * var(--armOverlap));
      transform: scaleX(-1);
    }

    .arm-img.right{
      right: calc(-0.3 * var(--armOverlap));
    }

    .legs-under{
      width:100%;
      display:grid;
      grid-template-columns: repeat(var(--colsN), var(--colW));
      justify-content:center;
      pointer-events:none;
      user-select:none;
      z-index:1;
      margin-top:-10px;
    }

    .leg-img{
      width:60px;
      height:175px;
      object-fit:contain;
      justify-self:center;
    }

    .group-roof {
      width: calc(var(--colsN) * 135px);
      height: 22px;
      background: var(--col-border, #000);
      border-radius: 6px 6px 0 0;
      display: block;
      margin: 10px auto -20px;
      position: relative;
      z-index: 3;
    }

    .group-roof + .cols {
      margin-top: 0;
    }
  </style>
{% endblock %}

{% block content %}
  {% set scale = kuik.scale %}

  <div class="page-wrap">

    <div class="page-head">
      <div>
        <h2 class="page-title">Resumen</h2>
        <div class="page-sub">
          <span class="id-pill">ID configuración: {{ configuration.id }}</span>

          {% if configuration.status == 0 %}
            <span class="badge open">Abierta</span>
          {% elseif configuration.status == 1 %}
            <span class="badge closed">Cerrada</span>
          {% else %}
            <span class="badge accepted">Aceptada</span>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="btn-row">
      <a class="btn" href="{{ path('configuration_project_new') }}">Nuevo proyecto</a>
      <a class="btn" href="{{ path('project_configurations', { project_id: project.id }) }}">Ver proyecto</a>
      {% if app.user.id == project.user.id %}

        {% if project.status == 0 %}
          <a class="btn primary" href="{{ path('configuration_type', { project_id: project.id }) }}">Nueva configuración</a>
        {% endif %}

        {% if configuration.status == 0 %}
          <a class="btn primary" href="{{ path('configuration_columns', { project_id: project.id, config_id: configuration.id }) }}">Editar configuración</a>
        {% endif %}

        <button class="btn primary" id="btnDescargarPdf"
          data-screenshot-url="{{ path('configuration_screenshot', { id: configuration.id }) }}"
          data-pdf-url="{{ path('configuration_pdf', { id: configuration.id }) }}">
          Descargar PDF
        </button>
      {% endif %}
    </div>

    <div class="grid">

      <div class="card">
        <h3>Vista previa</h3>

        <div class="preview-wrap">

          {% if isSoporteSuelo and selectedType == 'brazos' and selectedColor %}
            {% set armSrc =
              selectedColor == 'blanco' ? asset(kuik.img_brazo_blanco) :
              (selectedColor == 'plata' ? asset(kuik.img_brazo_plata) : asset(kuik.img_brazo_negro))
            %}
          {% endif %}

          <div class="preview-scroll">
          <div class="preview-stage" id="previewCapture">
            {% set agrupacionCombinada = p.agrupacion_combinada ?? false %}
            {% set mailboxGroup = p.mailboxGroup ?? null %}
            {% set mbSide = mailboxGroup.side ?? 'right' %}
            {% set mbRows = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.rows ?? 0) : 0 %}
            {% set mbCols = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.cols ?? 0) : 0 %}
            {% set mbCells = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.cells ?? []) : [] %}
            {% set mbTotalH = isEmpotradoLike ? (singleCap * scale) : ((topCap + bottomCap) * scale) %}
            {% set mbCellH = 10 * scale %}
            {% set mbBlockH = mbRows * mbCellH + 16 %}
            {% set mbLockerH = mbTotalH + 16 %}
            {% set mbMarginTop = 10 + (mbLockerH - mbBlockH) / 2 %}

            <div class="groups-stage" style="--door-color: {{ doorColor }}; --col-border: {{ bodyColor }};">

              {% if groups is empty %}
                <div class="muted">No hay columnas en esta configuración.</div>
              {% else %}
                {% for groupCols in groups %}
                  {% if groupCols is not iterable %}{% set groupCols = [] %}{% endif %}
                  {% set totalCols = groupCols|length %}

                  <div class="group-block">
                    <div class="group-label">Agrupación {{ loop.index }} ({{ groupCols|length }} columnas)</div>

                    <div class="support-wrap" style="--colsN: {{ totalCols }};">

                      {% if isSoporteSuelo and selectedType == 'brazos' and selectedColor %}
                        <img class="arm-img left" src="{{ armSrc }}" alt="Brazo izquierdo">
                        <img class="arm-img right" src="{{ armSrc }}" alt="Brazo derecho">
                      {% endif %}

                      {% if not isHome %}
                        <div class="group-roof"></div>
                      {% endif %}

                      <div style="display:flex;flex-direction:row;align-items:flex-start;gap:0;">

                        {# ── Buzones IZQUIERDA ── #}
                        {% if mbRows > 0 and mbCols > 0 and mbSide == 'left' %}
                          <div class="mb-group-block" style="margin-top:{{ mbMarginTop }}px;">
                            {% for c in 0..(mbCols - 1) %}
                              <div class="mb-group-col">
                                {% for r in 0..(mbRows - 1) %}
                                  {% set cellIdx = r * mbCols + c %}
                                  {% set filled = mbCells[cellIdx] ?? true %}
                                  <div class="door mailbox" style="height:{{ mbCellH }}px;{% if not filled %}opacity:0.1;background:#eaeaea;{% endif %}">
                                    {% if filled %}<img src="{{ kuik.img_buzon_btv }}" alt="Buzón">{% endif %}
                                  </div>
                                {% endfor %}
                              </div>
                            {% endfor %}
                          </div>
                        {% endif %}

                      <div class="cols" id="previewCols">
                        {% for col in groupCols %}
                          {% set isEmpotrado = (col.single is defined and col.single is not empty) %}

                          <div class="col-shell">
                            <div class="col-card">
                              <div class="col-body"
                                {% if isEmpotrado %}
                                  style="height: {{ (singleCap * scale) }}px;"
                                {% elseif type == 'home' and instalacion == 'zocalo' %}
                                  style="height: {{ ((topCap + bottomCap) * scale) }}px;"
                                {% endif %}
                              >

                                {% if isEmpotrado %}

                                  <div class="col-half" style="height: {{ singleCap * scale }}px;">
                                    {% set singleBlocks = col.single.blocks_prepared ?? col.single.blocks ?? [] %}
                                    {% for blk in singleBlocks %}
                                      {% set hh = blk.h|default(blk) %}
                                      {% set btype = blk.type|default('door') %}
                                      {% set socket = blk.socket ?? false %}
                                      {% set usb = blk.usb ?? false %}
                                      {% set methacrylate = blk.methacrylate ?? false %}
                                      {% set plateNumber = blk.plateNumber ?? null %}
                                      {% set doorNumber = blk.doorNumber ?? null %}

                                      <div class="door {{ btype == 'screen' ? 'screen' : '' }} {{ btype == 'mailbox' ? 'mailbox' : '' }} {{ methacrylate ? 'methacrylate' : '' }}"
                                           style="height: {{ hh * scale }}px;">

                                        {% if btype == 'screen' %}
                                          <img src="{{ asset(kuik.img_pantalla) }}" alt="Pantalla">
                                        {% elseif btype == 'mailbox' %}
                                          {% set _elec = blk.electronico ?? false %}
                                          {% set _tarj = blk.tarjetero ?? false %}
                                          {% set _buzonImg = _elec ? (_tarj ? 'assets/buzon_kuik_electronico_con_tarjetero.png' : 'assets/buzon_kuik_electronico_sin_tarjetero.png') : (_tarj ? 'assets/buzon_kuik_mecanico_con_tarjetero.png' : 'assets/buzon_kuik_mecanico_sin_tarjetero.png') %}
                                          <img src="{{ asset(_buzonImg) }}" alt="Buzón">
                                          {% if _elec and plateNumber is not null %}
                                            <div class="num" style="color:#fff;text-shadow:0 0 3px #000;">{{ plateNumber }},{{ doorNumber }}</div>
                                          {% endif %}
                                        {% else %}
                                          <div class="num">
                                            {{ plateNumber }},{{ doorNumber }}
                                          </div>

                                          <div class="badges">
                                            {% if socket %}<span class="badge-mini">ENCH</span>{% endif %}
                                            {% if usb %}<span class="badge-mini">USB</span>{% endif %}
                                          </div>
                                        {% endif %}
                                      </div>
                                    {% endfor %}
                                  </div>

                                {% else %}

                                  <div class="col-half" style="height: {{ topCap * scale }}px;">
                                    {% set topBlocks = col.top.blocks_prepared ?? col.top.blocks ?? [] %}
                                    {% for blk in topBlocks %}
                                      {% set hh = blk.h|default(blk) %}
                                      {% set btype = blk.type|default('door') %}
                                      {% set socket = blk.socket ?? false %}
                                      {% set usb = blk.usb ?? false %}
                                      {% set methacrylate = blk.methacrylate ?? false %}
                                      {% set plateNumber = blk.plateNumber ?? null %}
                                      {% set doorNumber = blk.doorNumber ?? null %}

                                      <div class="door {{ btype == 'screen' ? 'screen' : '' }} {{ btype == 'mailbox' ? 'mailbox' : '' }} {{ methacrylate ? 'methacrylate' : '' }}"
                                           style="height: {{ hh * scale }}px;">

                                        {% if btype == 'screen' %}
                                          <img src="{{ asset(kuik.img_pantalla) }}" alt="Pantalla">
                                        {% elseif btype == 'mailbox' %}
                                          {% set _elec = blk.electronico ?? false %}
                                          {% set _tarj = blk.tarjetero ?? false %}
                                          {% set _buzonImg = _elec ? (_tarj ? 'assets/buzon_kuik_electronico_con_tarjetero.png' : 'assets/buzon_kuik_electronico_sin_tarjetero.png') : (_tarj ? 'assets/buzon_kuik_mecanico_con_tarjetero.png' : 'assets/buzon_kuik_mecanico_sin_tarjetero.png') %}
                                          <img src="{{ asset(_buzonImg) }}" alt="Buzón">
                                          {% if _elec and plateNumber is not null %}
                                            <div class="num" style="color:#fff;text-shadow:0 0 3px #000;">{{ plateNumber }},{{ doorNumber }}</div>
                                          {% endif %}
                                        {% else %}
                                          <div class="num">
                                            {{ plateNumber }},{{ doorNumber }}
                                          </div>

                                          <div class="badges">
                                            {% if socket %}<span class="badge-mini">ENCH</span>{% endif %}
                                            {% if usb %}<span class="badge-mini">USB</span>{% endif %}
                                          </div>
                                        {% endif %}
                                      </div>
                                    {% endfor %}
                                  </div>

                                  <div class="half-sep"></div>

                                  <div class="col-half" style="height: {{ bottomCap * scale }}px;">
                                    {% set bottomBlocks = col.bottom.blocks_prepared ?? col.bottom.blocks ?? [] %}
                                    {% for blk in bottomBlocks %}
                                      {% set hh = blk.h|default(blk) %}
                                      {% set btype = blk.type|default('door') %}
                                      {% set socket = blk.socket ?? false %}
                                      {% set usb = blk.usb ?? false %}
                                      {% set methacrylate = blk.methacrylate ?? false %}
                                      {% set plateNumber = blk.plateNumber ?? null %}
                                      {% set doorNumber = blk.doorNumber ?? null %}

                                      <div class="door {{ btype == 'screen' ? 'screen' : '' }} {{ btype == 'mailbox' ? 'mailbox' : '' }} {{ methacrylate ? 'methacrylate' : '' }}"
                                           style="height: {{ hh * scale }}px;">

                                        {% if btype == 'screen' %}
                                          <img src="{{ asset(kuik.img_pantalla) }}" alt="Pantalla">
                                        {% elseif btype == 'mailbox' %}
                                          {% set _elec = blk.electronico ?? false %}
                                          {% set _tarj = blk.tarjetero ?? false %}
                                          {% set _buzonImg = _elec ? (_tarj ? 'assets/buzon_kuik_electronico_con_tarjetero.png' : 'assets/buzon_kuik_electronico_sin_tarjetero.png') : (_tarj ? 'assets/buzon_kuik_mecanico_con_tarjetero.png' : 'assets/buzon_kuik_mecanico_sin_tarjetero.png') %}
                                          <img src="{{ asset(_buzonImg) }}" alt="Buzón">
                                          {% if _elec and plateNumber is not null %}
                                            <div class="num" style="color:#fff;text-shadow:0 0 3px #000;">{{ plateNumber }},{{ doorNumber }}</div>
                                          {% endif %}
                                        {% else %}
                                          <div class="num">
                                            {{ plateNumber }},{{ doorNumber }}
                                          </div>

                                          <div class="badges">
                                            {% if socket %}<span class="badge-mini">ENCH</span>{% endif %}
                                            {% if usb %}<span class="badge-mini">USB</span>{% endif %}
                                          </div>
                                        {% endif %}
                                      </div>
                                    {% endfor %}
                                  </div>

                                {% endif %}
                              </div>
                            </div>
                          </div>
                        {% endfor %}{# endfor col in groupCols #}
                      </div>{# /cols grid #}

                        {# ── Buzones DERECHA ── #}
                        {% if mbRows > 0 and mbCols > 0 and mbSide == 'right' %}
                          <div class="mb-group-block" style="margin-top:{{ mbMarginTop }}px;">
                            {% for c in 0..(mbCols - 1) %}
                              <div class="mb-group-col">
                                {% for r in 0..(mbRows - 1) %}
                                  {% set cellIdx = r * mbCols + c %}
                                  {% set filled = mbCells[cellIdx] ?? true %}
                                  <div class="door mailbox" style="height:{{ mbCellH }}px;{% if not filled %}opacity:0.1;background:#eaeaea;{% endif %}">
                                    {% if filled %}<img src="{{ kuik.img_buzon_btv }}" alt="Buzón">{% endif %}
                                  </div>
                                {% endfor %}
                              </div>
                            {% endfor %}
                          </div>
                        {% endif %}

                      </div>{# /flex row #}

                      {% if isSoporteSuelo and selectedType == 'patas' %}
                        {% set n = groupCols|length %}

                        {% if n == 1 %}
                          {% set legPositions = [1] %}
                        {% else %}
                          {% set legPositions = [1, n] %}
                        {% endif %}

                        <div class="legs-under">
                          {% for pos in legPositions %}
                            <img class="leg-img"
                                 style="grid-column: {{ pos }};"
                                 src="{{ asset(kuik.img_pie) }}"
                                 alt="Pata">
                          {% endfor %}
                        </div>
                      {% endif %}

                    </div>
                  </div>
                {% endfor %}
              {% endif %}

            </div>{# /groups-stage #}
          </div>
          </div>
        </div>

        <img id="resultadoIA"
             style="max-width:100%; margin-top:12px; display:none; border:1px solid rgba(15,23,42,.12); border-radius:12px;">

        {% block product_table %}
          <div id="productTableContainer"></div>
        {% endblock %}

        <div style="margin-top:16px; border-top:1px solid rgba(15,23,42,.08); padding-top:16px; display:flex; align-items:center; gap:12px;">
          <label style="font-size:14px; font-weight:700; white-space:nowrap;">Instalación (€):</label>
          <input type="number" id="instalacionPrecio" min="0" step="0.01"
            value="{{ p._instalacion_precio ?? '' }}"
            placeholder="0,00"
            style="width:130px; padding:6px 10px; border:1px solid rgba(15,23,42,.15); border-radius:8px; font-size:14px;">
          <span id="instalacionStatus" style="font-size:12px; color:#6b7280; display:none;">Guardado ✓</span>
        </div>
      </div>

      <div class="card">
        <h3>Configuración</h3>

        <div class="kvs">
          <div class="kv"><div class="k">Tipo</div><div class="v">{{ type }}</div></div>
          <div class="kv"><div class="k">Fondo</div><div class="v">{{ bgLabel }}</div></div>
          <div class="kv"><div class="k">Ubicación</div><div class="v">{{ placementLabel }}</div></div>
          {#<div class="kv"><div class="k">Material</div><div class="v">{{ material }}</div></div>#}
          <div class="kv"><div class="k">Color puerta</div><div class="v">{{ doorColorRal }}</div></div>
          <div class="kv"><div class="k">Color cuerpo</div><div class="v">{{ bodyColorRal }}</div></div>
          <div class="kv"><div class="k">Columnas</div><div class="v">{{ columnsAll|length }}</div></div>
          {% if instalacion == 'colgado' %}
            {% set _ncols = columnsAll|length %}
            {% set _colgadores = _ncols <= 1 ? 1 : ((_ncols - 2) // 3 + 2) %}
            <div class="kv"><div class="k">Colgadores</div><div class="v">{{ _colgadores }}</div></div>
          {% endif %}
          {% if p.control is defined and p.control %}
            <div class="kv"><div class="k">Control</div><div class="v">{{ p.control }}</div></div>
          {% endif %}
          {% set _mbGroup = p.mailboxGroup ?? null %}
          {% if (p.agrupacion_combinada ?? false) and _mbGroup %}
            <div class="kv"><div class="k">Buzones (ref.)</div><div class="v">{{ _mbGroup.reference ?? '—' }}</div></div>
            {% if _mbGroup.descripcion ?? null %}
              <div class="kv"><div class="k">Descripción buzón</div><div class="v">{{ _mbGroup.descripcion }}</div></div>
            {% endif %}
          {% endif %}
        </div>

        <div class="section-sep"></div>

        <h3>Datos del cliente</h3>

        <div class="kvs">
          <div class="kv"><div class="k">Proyecto</div><div class="v">{{ project.projectName }}</div></div>
          <div class="kv"><div class="k">Cliente</div><div class="v">{{ project.clientName }}</div></div>
          <div class="kv"><div class="k">Teléfono</div><div class="v">{{ project.phone ?: '—' }}</div></div>
          <div class="kv"><div class="k">Email</div><div class="v">{{ project.email ?: '—' }}</div></div>
          <div class="kv"><div class="k">Ciudad</div><div class="v">{{ project.city ?: '—' }}</div></div>
          <div class="kv"><div class="k">Dirección</div><div class="v">{{ project.address ?: '—' }}</div></div>
        </div>

        <div class="section-sep"></div>
        <h3>Puertas por tamaño</h3>

        {% set doorSizeCounts = {} %}
        {% set mailboxSizeCounts = {} %}
        {% set totalDoors = 0 %}
        {% set totalMailboxes = 0 %}

        {% for col in columnsAll %}
          {% if col.single is defined and col.single is not empty %}

            {% set singleBlocks = col.single.blocks_prepared ?? col.single.blocks ?? [] %}
            {% for blk in singleBlocks %}
              {% set btype = blk.type|default('door') %}
              {% set hh = blk.h|default(blk) %}
              {% set key = 'H' ~ hh %}

              {% if btype == 'mailbox' %}
                {% set mailboxSizeCounts = mailboxSizeCounts|merge({ (key): (mailboxSizeCounts[key]|default(0) + 1) }) %}
                {% set totalMailboxes = totalMailboxes + 1 %}
              {% elseif btype != 'screen' %}
                {% set doorSizeCounts = doorSizeCounts|merge({ (key): (doorSizeCounts[key]|default(0) + 1) }) %}
                {% set totalDoors = totalDoors + 1 %}
              {% endif %}
            {% endfor %}

          {% else %}

            {% set topBlocks = col.top.blocks_prepared ?? col.top.blocks ?? [] %}
            {% for blk in topBlocks %}
              {% set btype = blk.type|default('door') %}
              {% set hh = blk.h|default(blk) %}
              {% set key = 'H' ~ hh %}

              {% if btype == 'mailbox' %}
                {% set mailboxSizeCounts = mailboxSizeCounts|merge({ (key): (mailboxSizeCounts[key]|default(0) + 1) }) %}
                {% set totalMailboxes = totalMailboxes + 1 %}
              {% elseif btype != 'screen' %}
                {% set doorSizeCounts = doorSizeCounts|merge({ (key): (doorSizeCounts[key]|default(0) + 1) }) %}
                {% set totalDoors = totalDoors + 1 %}
              {% endif %}
            {% endfor %}

            {% set bottomBlocks = col.bottom.blocks_prepared ?? col.bottom.blocks ?? [] %}
            {% for blk in bottomBlocks %}
              {% set btype = blk.type|default('door') %}
              {% set hh = blk.h|default(blk) %}
              {% set key = 'H' ~ hh %}

              {% if btype == 'mailbox' %}
                {% set mailboxSizeCounts = mailboxSizeCounts|merge({ (key): (mailboxSizeCounts[key]|default(0) + 1) }) %}
                {% set totalMailboxes = totalMailboxes + 1 %}
              {% elseif btype != 'screen' %}
                {% set doorSizeCounts = doorSizeCounts|merge({ (key): (doorSizeCounts[key]|default(0) + 1) }) %}
                {% set totalDoors = totalDoors + 1 %}
              {% endif %}
            {% endfor %}

          {% endif %}
        {% endfor %}

        {% if totalDoors == 0 and totalMailboxes == 0 %}
          <div class="muted">No hay puertas ni buzones.</div>
        {% else %}
          <table class="addons-table">
            <thead>
              <tr>
                <th>Tamaño</th>
                <th>Cantidad</th>
              </tr>
            </thead>
            <tbody>
              {% for h in [10,20,30,40,50,60,70,80,90] %}
                {% set k = 'H' ~ h %}
                {% if doorSizeCounts[k]|default(0) > 0 %}
                  <tr>
                    <td><b>{{ k }}</b></td>
                    <td>{{ doorSizeCounts[k] }}</td>
                  </tr>
                {% endif %}
              {% endfor %}

              {% for h in [10,20,30,40,50,60,70,80,90] %}
                {% set k = 'H' ~ h %}
                {% if mailboxSizeCounts[k]|default(0) > 0 %}
                  <tr>
                    <td><b>Buzón</b></td>
                    <td>{{ mailboxSizeCounts[k] }}</td>
                  </tr>
                {% endif %}
              {% endfor %}

              <tr>
                <td><b>Total puertas</b></td>
                <td><b>{{ totalDoors }}</b></td>
              </tr>
              <tr>
                <td><b>Total buzones</b></td>
                <td><b>{{ totalMailboxes }}</b></td>
              </tr>
            </tbody>
          </table>
        {% endif %}

        <div class="section-sep"></div>
        <h3>Complementos</h3>

        {% set totalSocket = 0 %}
        {% set totalUsb = 0 %}
        {% set totalBoth = 0 %}
        {% set totalMethacrylate = 0 %}

        {% for doorNum, sel in addons %}
          {% set socket = (sel is iterable and (sel.socket ?? false)) ? 1 : 0 %}
          {% set usb = (sel is iterable and (sel.usb ?? false)) ? 1 : 0 %}
          {% set methacrylate = (sel is iterable and (sel.methacrylate ?? false)) ? 1 : 0 %}

          {% set totalSocket = totalSocket + socket %}
          {% set totalUsb = totalUsb + usb %}
          {% set totalMethacrylate = totalMethacrylate + methacrylate %}

          {% if socket and usb %}
            {% set totalBoth = totalBoth + 1 %}
          {% endif %}
        {% endfor %}

        <div class="kvs" style="margin-top:10px;">
          <div class="kv">
            <div class="k">Total enchufes</div>
            <div class="v">{{ totalSocket }}</div>
          </div>
          <div class="kv">
            <div class="k">Total USB</div>
            <div class="v">{{ totalUsb }}</div>
          </div>
          <div class="kv">
            <div class="k">Puertas con ambos</div>
            <div class="v">{{ totalBoth }}</div>
          </div>
          <div class="kv">
            <div class="k">Puertas con metacrilato</div>
            <div class="v">{{ totalMethacrylate }}</div>
          </div>
        </div>

        <h3 style="margin-top:14px;">Detalle (solo puertas con complementos)</h3>

        {% set anyAddon = false %}
        {% for doorNum, sel in addons %}
          {% set socket = (sel is iterable and (sel.socket ?? false)) ? true : false %}
          {% set usb = (sel is iterable and (sel.usb ?? false)) ? true : false %}
          {% set methacrylate = (sel is iterable and (sel.methacrylate ?? false)) ? true : false %}
          {% if socket or usb or methacrylate %}
            {% set anyAddon = true %}
          {% endif %}
        {% endfor %}

        {% if not anyAddon %}
          <div class="muted">No hay puertas con complementos.</div>
        {% else %}
          <table class="addons-table">
            <thead>
              <tr>
                <th>Puerta</th>
                <th>Complemento</th>
              </tr>
            </thead>
            <tbody>
              {% for doorNum, sel in addons|sort %}
                {% set socket = (sel is iterable and (sel.socket ?? false)) ? true : false %}
                {% set usb = (sel is iterable and (sel.usb ?? false)) ? true : false %}
                {% set methacrylate = (sel is iterable and (sel.methacrylate ?? false)) ? true : false %}

                {% if socket or usb or methacrylate %}
                  {% set labels = [] %}

                  {% if methacrylate %}
                    {% set labels = labels|merge(['Metacrilato']) %}
                  {% endif %}
                  {% if socket %}
                    {% set labels = labels|merge(['Enchufe']) %}
                  {% endif %}
                  {% if usb %}
                    {% set labels = labels|merge(['USB']) %}
                  {% endif %}

                  <tr>
                    <td><b>{{ doorNum }}</b></td>
                    <td>{{ labels|join(' + ') }}</td>
                  </tr>
                {% endif %}
              {% endfor %}
            </tbody>
          </table>
        {% endif %}

      </div>
    </div>
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>

  <script>
    window.addEventListener('DOMContentLoaded', function () {
      // Drag-to-scroll on preview
      var scroll = document.querySelector('.preview-scroll');
      if (scroll) {
        var isDragging = false, startX, scrollLeft;

        scroll.addEventListener('mousedown', function (e) {
          isDragging = true;
          scroll.classList.add('is-dragging');
          startX    = e.pageX - scroll.getBoundingClientRect().left;
          scrollLeft = scroll.scrollLeft;
          e.preventDefault();
        });

        document.addEventListener('mouseup', function () {
          isDragging = false;
          scroll.classList.remove('is-dragging');
        });

        document.addEventListener('mousemove', function (e) {
          if (!isDragging) return;
          var x    = e.pageX - scroll.getBoundingClientRect().left;
          var walk = (x - startX) * 1.2;
          scroll.scrollLeft = scrollLeft - walk;
        });
      }
    });

    const _saveUrl   = '{{ path('configuration_instalacion', { id: configuration.id }) }}';
    const _tableUrl  = '{{ path('configuration_product_table', { id: configuration.id }) }}';
    const _tableContainer = () => document.getElementById('productTableContainer');

    async function saveAndReloadFromIva() {
      const precioEl = document.getElementById('instalacionPrecio');
      const ivaEl    = document.getElementById('ivaCheck');
      const precio   = parseFloat(precioEl?.value) || 0;
      const iva      = ivaEl ? ivaEl.checked : false;
      console.log('saveAndReloadFromIva', { precio, iva, saveUrl: _saveUrl });
      await fetch(_saveUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ precio, iva })
      });
      const c = _tableContainer();
      if (c) {
        const html = await fetch(_tableUrl + '?_=' + Date.now()).then(r => r.text());
        c.innerHTML = html;
        bindIvaCheck();
      }
    }

    function bindIvaCheck() {}

    document.addEventListener('change', function (e) {
      console.log('change event', e.target?.id);
      if (e.target && e.target.id === 'ivaCheck') {
        saveAndReloadFromIva();
      }
    });
    console.log('IVA listener registered');

    // Load product reference table via AJAX
    function loadProductTable() {
      const _productContainer = document.getElementById('productTableContainer');
      if (_productContainer) {
        fetch('{{ path('configuration_product_table', { id: configuration.id }) }}?_=' + Date.now())
          .then(function (r) { return r.text(); })
          .then(function (html) { _productContainer.innerHTML = html; })
          .catch(function (e) { console.error('Error cargando referencias de producto:', e); });
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadProductTable);
    } else {
      loadProductTable();
    }

    window.addEventListener('DOMContentLoaded', function () {
      const btn = document.getElementById('btnIA');
      const status = document.getElementById('iaStatus');
      const node = document.getElementById('previewCapture');

      if (!btn || !status || !node) return;

      btn.addEventListener('click', async function () {
        status.style.display = 'inline';
        status.textContent = 'Generando…';
        btn.disabled = true;

        try {
          const canvas = await html2canvas(node, { backgroundColor: '#ffffff', scale: 1 });
          const dataUrl = canvas.toDataURL('image/png');

          const prompt =
            `Genera un render realista del armario/taquillas basado en el esquema adjunto.
            - Color puertas: {{ doorColor|e('js') }}
            - Color cuerpo/bordes: {{ bodyColor|e('js') }}
            - Fondo: {{ bgLabel|e('js') }}
            - Ubicación: {{ placementLabel|e('js') }}
            - Material: {{ material|e('js') }}
            - Instalación: {{ instalacion|e('js') }}
            - Soporte: {{ selectedType|e('js') }} {{ selectedColor|e('js') }}
            Respeta el número de puertas y proporciones del esquema.`;

          const form = new FormData();
          form.append('prompt', prompt);
          form.append('preview_base64', dataUrl);

          const res = await fetch('{{ path("api_generar_imagen") }}', {
            method: 'POST',
            body: form
          });

          const text = await res.text();
          let json = null;

          try {
            json = JSON.parse(text);
          } catch (e) {
            console.error('Respuesta NO JSON del servidor:', text);
            alert('El servidor devolvió un error (no JSON). Mira la consola y el log de Symfony.');
            return;
          }

          if (!res.ok) {
            alert(json.error || 'Error generando imagen');
            return;
          }

          const img = document.getElementById('resultadoIA');
          img.src = 'data:' + json.mime + ';base64,' + json.image_base64;
          img.style.display = 'block';

        } catch (e) {
          console.error(e);
          alert('Error inesperado (mira consola).');
        } finally {
          status.style.display = 'none';
          btn.disabled = false;
        }
      });
    });
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const precioInput  = document.getElementById('instalacionPrecio');
      const statusEl     = document.getElementById('instalacionStatus');
      const saveUrl      = '{{ path('configuration_instalacion', { id: configuration.id }) }}';
      const tableUrl     = '{{ path('configuration_product_table', { id: configuration.id }) }}';
      const productContainer = document.getElementById('productTableContainer');

      function getIvaChecked() {
        const chk = document.getElementById('ivaCheck');
        return chk ? chk.checked : false;
      }

      async function saveInstalacion() {
        const precio = parseFloat(precioInput?.value) || 0;
        const iva    = getIvaChecked();
        await fetch(saveUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ precio, iva })
        });
        if (statusEl) { statusEl.style.display = 'inline'; setTimeout(() => { statusEl.style.display = 'none'; }, 2000); }
      }

      async function saveAndReloadTable() {
        await saveInstalacion();
        if (productContainer) {
          const html = await fetch(tableUrl).then(r => r.text());
          productContainer.innerHTML = html;
          bindIvaCheck();
        }
      }

      window.saveAndReloadTable = saveAndReloadTable;

      if (precioInput) {
        precioInput.addEventListener('change', saveAndReloadTable);
        precioInput.addEventListener('blur', saveAndReloadTable);
        let _debounceTimer = null;
        precioInput.addEventListener('input', function () {
          clearTimeout(_debounceTimer);
          _debounceTimer = setTimeout(saveAndReloadTable, 800);
        });
      }
    });

    document.addEventListener('DOMContentLoaded', function () {
      const btnPdf = document.getElementById('btnDescargarPdf');
      if (!btnPdf) return;

      btnPdf.addEventListener('click', async function () {
        const screenshotUrl = btnPdf.dataset.screenshotUrl;
        const pdfUrl        = btnPdf.dataset.pdfUrl;

        btnPdf.disabled = true;
        btnPdf.textContent = 'Generando…';

        try {
          const groups = document.querySelectorAll('#previewCapture .group-block');
          if (groups.length > 0) {
            const hidden = [...document.querySelectorAll('#previewCapture .num, #previewCapture .badges')];
            hidden.forEach(el => el.style.visibility = 'hidden');

            const screenshots = [];
            for (const group of groups) {
              const prevPadding = group.style.padding;
              group.style.padding = '10px 70px 100px';
              const canvas = await html2canvas(group, { backgroundColor: '#ffffff', scale: 1 });
              group.style.padding = prevPadding;
              screenshots.push(canvas.toDataURL('image/png'));
            }

            hidden.forEach(el => el.style.visibility = '');

            await fetch(screenshotUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ screenshots })
            });
          }
        } catch (e) {
          console.warn('Screenshot failed, continuing without it:', e);
        }

        window.location.href = pdfUrl;
        setTimeout(() => {
          btnPdf.disabled = false;
          btnPdf.textContent = 'Descargar PDF';
        }, 2000);
      });
    });
  </script>
{% endblock %}