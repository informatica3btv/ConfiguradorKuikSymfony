            taillight: new THREE.MeshStandardMaterial({ color: 0xd23a2f, emissive: 0x8a1a12, emissiveIntensity: 0.5 })
          };

          // --- Terreno, aceras y carretera (medidas fijas del original) ---
          cbox(mU(64), mU(G), mU(23), M.pave1, 0, mU(G) / 2, mU(-6.5), city, true);
          cbox(mU(64), mU(0.2), mU(0.3), M.curb, 0, mU(0.1), mU(5), city);
          cbox(mU(64), mU(0.2), mU(0.3), M.curb, 0, mU(0.1), mU(14), city);

          const roadMesh = new THREE.Mesh(new THREE.PlaneGeometry(mU(64), mU(9)), M.asphalt);
          roadMesh.rotation.x = -Math.PI / 2;
          roadMesh.position.set(0, mU(0.02), mU(9.5));
          city.add(roadMesh);
          for (let x = -31; x < 31; x += 4) cbox(mU(2), mU(0.01), mU(0.15), M.paint, mU(x + 1), mU(0.03), mU(10.6));
          cbox(mU(64), mU(0.01), mU(0.12), M.paint, 0, mU(0.03), mU(7.3));
          for (let i = 0; i < 7; i++) cbox(mU(3), mU(0.01), mU(0.5), M.paint, mU(-14), mU(0.03), mU(7.7 + i * 0.95));

          const grassMesh = new THREE.Mesh(new THREE.PlaneGeometry(mU(320), mU(320)), M.grass);
          grassMesh.rotation.x = -Math.PI / 2;
          grassMesh.position.set(0, -mU(0.001), 0);
          city.add(grassMesh);

          // --- Edificio ---
          const TOP = mU(G + GFm + FHm * NF);
          // Si la taquilla es "empotrada", hay que dejarle un hueco en la
          // planta baja (y el arco de apertura de sus puertas) en vez de un
          // bloque macizo, igual que en los demás escenarios. Los huecos
          // vienen en coordenadas de mundo; aquí se pasan a locales del
          // grupo "city" restando su desplazamiento en X.
          (function addGroundFloorWithHole() {
            const gfY0 = mU(G), gfY1 = mU(G) + mU(GFm), gfZ = mU(-BD / 2);
            const pieceX0 = -mU(BW) / 2, pieceX1 = mU(BW) / 2;
            const holeY0 = Math.max(baseY - lockerHoleMarginY, gfY0);
            const holeY1 = Math.min(baseY + maxHeight + lockerHoleMarginY, gfY1);
            const holesLocal = lockerHoleSegments
              .map(function (h) { return { x0: h.x0 - cityOffsetX, x1: h.x1 - cityOffsetX }; })
              .map(function (h) { return { x0: Math.max(h.x0, pieceX0), x1: Math.min(h.x1, pieceX1) }; })
              .filter(function (h) { return h.x1 > h.x0; })
              .sort(function (a, b) { return a.x0 - b.x0; });

            if (!isEmpotrado || holesLocal.length === 0 || holeY0 >= holeY1) {
              cbox(mU(BW), mU(GFm), mU(BD), M.stone, 0, mU(G) + mU(GFm) / 2, gfZ);
              return;
            }
            function strip(x0, x1, y0, y1) {
              const w = x1 - x0, h = y1 - y0;
              if (w <= 0 || h <= 0) return;
              cbox(w, h, mU(BD), M.stone, (x0 + x1) / 2, (y0 + y1) / 2, gfZ);
            }
            strip(pieceX0, pieceX1, gfY0, holeY0);
            strip(pieceX0, pieceX1, holeY1, gfY1);
            let cursor = pieceX0;
            holesLocal.forEach(function (h) {
              strip(cursor, h.x0, holeY0, holeY1);
              cursor = Math.max(cursor, h.x1);
            });
            strip(cursor, pieceX1, holeY0, holeY1);
          })();
          cbox(mU(BW), mU(FHm * NF), mU(BD), M.facade, 0, mU(G) + mU(GFm) + mU(FHm * NF) / 2, mU(-BD / 2));
          [-mU(BW / 2) + mU(0.62), mU(BW / 2) - mU(0.62)].forEach(function (x) {
            cbox(mU(1.2), mU(FHm * NF), mU(BD) + mU(0.06), M.accent, x, mU(G) + mU(GFm) + mU(FHm * NF) / 2, mU(-BD / 2));
          });
          for (let i = 0; i <= NF; i++) cbox(mU(BW) + mU(0.3), mU(0.22), mU(BD) + mU(0.3), M.slab, 0, mU(G) + mU(GFm) + mU(i * FHm), mU(-BD / 2));
          cbox(mU(BW) - mU(0.1), mU(0.05), mU(BD) - mU(0.1), M.roof, 0, TOP + mU(0.12), mU(-BD / 2), city, true);

          function addFacadeWindow(x, y, z, rotY, o) {
            o = o || {};
            const g = new THREE.Group();
            g.position.set(x, y, z);
            g.rotation.y = rotY;
            city.add(g);
            const w = o.w || 1.5, h = o.h || 1.7;
            cbox(mU(w), mU(h), mU(0.1), M.frame, 0, 0, mU(0.02), g, true);
            cbox(mU(w - 0.2), mU(h - 0.2), mU(0.06), M.glass, 0, 0, mU(0.05), g, true);
            cbox(mU(0.06), mU(h - 0.2), mU(0.08), M.frame, 0, 0, mU(0.08), g, true);
            if (!o.door) cbox(mU(w + 0.2), mU(0.08), mU(0.25), M.frame, 0, -mU(h) / 2 - mU(0.04), mU(0.12), g);
            if (o.bars) {
              cbox(mU(w + 0.1), mU(0.04), mU(0.04), M.rail, 0, -mU(h) / 2 + mU(0.55), mU(0.25), g);
              cbox(mU(w + 0.1), mU(0.04), mU(0.04), M.rail, 0, -mU(h) / 2 + mU(0.05), mU(0.25), g);
              const n = Math.round(w / 0.2);
              for (let i = 0; i <= n; i++) {
                const p = new THREE.Mesh(new THREE.CylinderGeometry(mU(0.015), mU(0.015), mU(0.5), 6), M.rail);
                p.position.set(-mU(w) / 2 + i * mU(w) / n, -mU(h) / 2 + mU(0.3), mU(0.25));
                g.add(p);
              }
            }
            if (o.balcony) {
              const by = -mU(h) / 2 - mU(0.05);
              cbox(mU(3.2), mU(0.16), mU(1.1), M.slab, 0, by, mU(0.6), g);
              cbox(mU(3.2), mU(0.05), mU(0.05), M.rail, 0, by + mU(1.05), mU(1.12), g);
              [-mU(1.57), mU(1.57)].forEach(function (sx) { cbox(mU(0.05), mU(1.0), mU(1.1), M.rail, sx, by + mU(0.55), mU(0.6), g); });
              for (let i = 0; i <= 14; i++) {
                const p = new THREE.Mesh(new THREE.CylinderGeometry(mU(0.015), mU(0.015), mU(1), 6), M.rail);
                p.position.set(-mU(1.55) + i * mU(0.221), by + mU(0.55), mU(1.12));
                g.add(p);
              }
            }
          }
          for (let f = 0; f < NF; f++) {
            const yc = mU(G) + mU(GFm) + mU(f * FHm) + mU(1.55);
            [-6.3, -3.2, 0, 3.2, 6.3].forEach(function (x, i) {
              const bal = (i === 1 || i === 3);
              addFacadeWindow(mU(x), bal ? yc - mU(0.25) : yc, 0, 0, bal ? { h: 2.3, door: true, balcony: true } : {});
              addFacadeWindow(mU(x), yc, -mU(BD), Math.PI, {});
            });
            [-2, -4.7, -7.3, -10].forEach(function (z) {
              addFacadeWindow(mU(BW / 2), yc, mU(z), Math.PI / 2, {});
              addFacadeWindow(-mU(BW / 2), yc, mU(z), -Math.PI / 2, {});
            });
          }
          [-6.6, -3.6].forEach(function (x) { addFacadeWindow(mU(x), mU(G) + mU(1.9), 0, 0, { w: 1.8, h: 1.6, bars: true }); });
          [-3, -9].forEach(function (z) {
            addFacadeWindow(mU(BW / 2), mU(G) + mU(1.9), mU(z), Math.PI / 2, { w: 1.8, h: 1.6, bars: true });
            addFacadeWindow(-mU(BW / 2), mU(G) + mU(1.9), mU(z), -Math.PI / 2, { w: 1.8, h: 1.6, bars: true });
          });
          [-5, 0, 5].forEach(function (x) { addFacadeWindow(mU(x), mU(G) + mU(1.9), -mU(BD), Math.PI, { w: 1.8, h: 1.6, bars: true }); });

          // --- Portal ---
          cbox(mU(3.4), mU(3), mU(0.16), M.darkFrame, 0, mU(G) + mU(1.5), mU(0.02));
          cbox(mU(1.45), mU(2.7), mU(0.06), M.glass, mU(-0.75), mU(G) + mU(1.4), mU(0.1), city, true);
          cbox(mU(1.45), mU(2.7), mU(0.06), M.glass, mU(0.75), mU(G) + mU(1.4), mU(0.1), city, true);
          cbox(mU(0.04), mU(0.7), mU(0.06), M.frame, mU(-0.15), mU(G) + mU(1.3), mU(0.16), city, true);
          cbox(mU(0.04), mU(0.7), mU(0.06), M.frame, mU(0.15), mU(G) + mU(1.3), mU(0.16), city, true);
          cbox(mU(4.6), mU(0.22), mU(1.8), M.darkFrame, 0, mU(G) + mU(3.2), mU(0.9));
          cbox(mU(4.2), mU(0.14), mU(1.1), M.concrete, 0, mU(G) + mU(0.07), mU(0.55));

          // --- Jardinera y banco junto al portal ---
          function addHomeHedge(x, z, w) {
            cbox(mU(w), mU(0.4), mU(0.8), M.concrete, x, mU(G) + mU(0.2), z);
            const hh = mU(0.6), r = mU(0.22), wU = mU(w);
            const s = new THREE.Shape();
            s.moveTo(-wU / 2 + r, 0); s.lineTo(wU / 2 - r, 0); s.quadraticCurveTo(wU / 2, 0, wU / 2, r);
            s.lineTo(wU / 2, hh - r); s.quadraticCurveTo(wU / 2, hh, wU / 2 - r, hh); s.lineTo(-wU / 2 + r, hh);
            s.quadraticCurveTo(-wU / 2, hh, -wU / 2, hh - r); s.lineTo(-wU / 2, r); s.quadraticCurveTo(-wU / 2, 0, -wU / 2 + r, 0);
            const geo = new THREE.ExtrudeGeometry(s, { depth: mU(0.5), bevelEnabled: true, bevelThickness: mU(0.09), bevelSize: mU(0.07), bevelSegments: 3, curveSegments: 8 });
            geo.translate(0, 0, -mU(0.25));
            const mesh = new THREE.Mesh(geo, M.hedge);
            mesh.position.set(x, mU(G) + mU(0.4), z);
            city.add(mesh);
          }
          addHomeHedge(mU(-2.9), mU(0.55), 1.6);
          addHomeHedge(mU(-8.6), mU(0.6), 1.4);

          // El banco se coloca pasado el borde derecho de la taquilla
          // (ahora en la zona derecha de la fachada), para no solaparse.
          const benchLocalX = mU(4.0) + totalWidth + mU(1.5);
          const bench = new THREE.Group();
          bench.position.set(benchLocalX, mU(G), mU(1.1));
          city.add(bench);
          cbox(mU(1.25), mU(0.42), mU(0.5), M.black, 0, mU(0.21), 0, bench);
          for (let i = 0; i < 3; i++) cbox(mU(1.32), mU(0.06), mU(0.15), M.wood, 0, mU(0.45), mU(-0.17 + i * 0.17), bench);

          // --- Árboles y farolas ---
          function homeLowpolyBlob(r, seed, m) {
            const geo = new THREE.IcosahedronGeometry(r, 1);
            const pos = geo.attributes.position, cache = {}, rand = rngHome(seed);
            for (let i = 0; i < pos.count; i++) {
              const k = pos.getX(i).toFixed(3) + ',' + pos.getY(i).toFixed(3) + ',' + pos.getZ(i).toFixed(3);
              if (!cache[k]) cache[k] = 0.85 + rand() * 0.3;
              pos.setXYZ(i, pos.getX(i) * cache[k], pos.getY(i) * cache[k] * 0.92, pos.getZ(i) * cache[k]);
            }
            geo.computeVertexNormals();
            return new THREE.Mesh(geo, m);
          }
          function addHomeTree(x, z, seed, s) {
            s = s || 1;
            const g = new THREE.Group();
            g.position.set(x, mU(G), z);
            g.scale.setScalar(s);
            city.add(g);
            cbox(mU(1.4), mU(0.03), mU(1.4), M.pit, 0, mU(0.015), 0, g, true);
            const t = new THREE.Mesh(new THREE.CylinderGeometry(mU(0.13), mU(0.2), mU(3.4), 8), M.trunk);
            t.position.y = mU(1.7);
            g.add(t);
            [[0, mU(4), 0, mU(1.6), M.leaf1], [-mU(0.9), mU(3.5), mU(0.3), mU(1.1), M.leaf2],
             [mU(0.9), mU(3.6), -mU(0.2), mU(1.15), M.leaf2], [mU(0.1), mU(4.9), mU(0.2), mU(1.05), M.leaf2]]
              .forEach(function (b, i) {
                const m = homeLowpolyBlob(b[3], seed + i * 13, b[4]);
                m.position.set(b[0], b[1], b[2]);
                g.add(m);
              });
          }
          [-27, -17, 17, 27].forEach(function (x, i) { addHomeTree(mU(x), mU(3.4), 11 + i * 7); });
          [-22, -6, 9, 25].forEach(function (x, i) { addHomeTree(mU(x), mU(16.9), 40 + i * 5); });

          function addHomeLamp(x, z, dir) {
            const g = new THREE.Group();
            g.position.set(x, mU(G), z);
            g.rotation.y = dir;
            city.add(g);
            const p = new THREE.Mesh(new THREE.CylinderGeometry(mU(0.07), mU(0.1), mU(6), 10), M.black);
            p.position.y = mU(3);
            g.add(p);
            cbox(mU(0.08), mU(0.08), mU(1.4), M.black, 0, mU(5.95), mU(0.65), g);
            cbox(mU(0.35), mU(0.15), mU(0.6), M.black, 0, mU(5.9), mU(1.35), g);
            cbox(mU(0.28), mU(0.03), mU(0.5), M.bulb, 0, mU(5.82), mU(1.35), g, true);
          }
          [-22, -9, 9, 22].forEach(function (x) { addHomeLamp(mU(x), mU(4.5), 0); });
          [-15, 0, 15].forEach(function (x) { addHomeLamp(mU(x), mU(14.6), Math.PI); });

          // --- Coches circulando ---
          function addCar(color, x, z, dir, speed) {
            const c = new THREE.MeshStandardMaterial({ color: color, roughness: 0.35, metalness: 0.3 });
            const g = new THREE.Group();
            g.position.set(x, 0, z);
            g.rotation.y = dir;
            city.add(g);
            cbox(mU(4.2), mU(0.7), mU(1.8), c, 0, mU(0.6), 0, g);
            cbox(mU(2.3), mU(0.62), mU(1.62), M.carGlass, mU(-0.25), mU(1.25), 0, g);
            cbox(mU(2.1), mU(0.08), mU(1.66), c, mU(-0.25), mU(1.6), 0, g);
            [-mU(1.25), mU(0.75)].forEach(function (px) { cbox(mU(0.08), mU(0.6), mU(1.64), c, px, mU(1.25), 0, g); });
            [[mU(2.1), mU(0.45)], [mU(2.1), -mU(0.45)]].forEach(function (p) { cbox(mU(0.04), mU(0.14), mU(0.36), M.headlight, p[0], mU(0.72), p[1], g); });
            [[-mU(2.1), mU(0.55)], [-mU(2.1), -mU(0.55)]].forEach(function (p) { cbox(mU(0.04), mU(0.14), mU(0.32), M.taillight, p[0], mU(0.72), p[1], g); });
            const wheels = [];
            [[mU(1.35), mU(0.85)], [mU(1.35), -mU(0.85)], [-mU(1.35), mU(0.85)], [-mU(1.35), -mU(0.85)]].forEach(function (p) {
              const w = new THREE.Mesh(new THREE.CylinderGeometry(mU(0.36), mU(0.36), mU(0.26), 14), M.tire);
              w.rotation.x = Math.PI / 2;
              w.position.set(p[0], mU(0.36), p[1]);
              g.add(w);
              wheels.push(w);
            });
            sceneUpdaters.push(function (dt) {
              if (!speed) return;
              g.position.x += Math.cos(g.rotation.y) * mU(speed) * dt;
              if (g.position.x > mU(34)) g.position.x = -mU(34);
              if (g.position.x < -mU(34)) g.position.x = mU(34);
              wheels.forEach(function (w) { w.rotation.y -= mU(speed) * dt / mU(0.36); });
            });
          }
          addCar(0xd8483c, mU(-6), mU(9), 0, 7);
          addCar(0xf2f2ee, mU(18), mU(9), 0, 7);
          addCar(0xf0b632, mU(10), mU(12.3), Math.PI, 6);
          addCar(0x2f6db5, mU(-24), mU(12.3), Math.PI, 6);
          addCar(0x5d6670, mU(-19.2), mU(6.2), 0, 0);
          addCar(0xe9e6df, mU(13.8), mU(6.2), Math.PI, 0);

          // Encuadre de cámara fijo (igual relación que en el archivo
          // original: posición (20,11,32), objetivo (0,5,0), en metros),
          // trasladado a donde está ahora el grupo "city".
          // El objetivo de la cámara es la taquilla (no el portal): se
          // apunta a su centro en vez de a cityOffsetX, que es donde está
          // la puerta del edificio.
          const lockerCenterX = totalWidth / 2;
          const lockerCenterZ = homeEmbedShiftZ + depth / 2;
          cameraPosOverride = new THREE.Vector3(lockerCenterX + mU(20), mU(11), lockerCenterZ + mU(32));
          cameraTargetOverride = new THREE.Vector3(lockerCenterX, mU(5), lockerCenterZ);
        } else if (currentScenario === 'profesional') {
          // Entorno "profesional": una oficina dividida en dos salas. A la
          // izquierda, una sala de reuniones separada por una cristalera
          // (mesa + sillas). A la derecha, la zona de trabajo abierta con
          // la taquilla pegada a la pared de fondo y varios escritorios con
          // pantalla delante.
          const margin = Math.max(totalWidth, baseY + maxHeight) * 1.6;
          const roomHeight = (baseY + maxHeight) * 2.2;
          const wallT = mmToUnits(100);
          const floorY = -wallT / 2;

          // Zona principal (taquilla + escritorios), centrada en la propia
          // taquilla, igual que antes.
          const mainAreaWidth = totalWidth + margin * 2;
          const mainAreaX0 = totalWidth / 2 - mainAreaWidth / 2;
          const mainAreaX1 = mainAreaX0 + mainAreaWidth;

          // Sala de reuniones, a la izquierda de la zona principal, con
          // ancho fijo suficiente para la mesa (no depende del tamaño de la
          // taquilla, al contrario que la zona principal).
          const meetingWidth = Math.max(margin * 1.1, mmToUnits(2600));
          const partitionX = mainAreaX0;
          const meetingX0 = partitionX - meetingWidth;

          const roomCenterX = (meetingX0 + mainAreaX1) / 2;
          const roomWidth   = mainAreaX1 - meetingX0;
          const roomBackX0  = meetingX0;

          // La sala tiene que ENVOLVER la taquilla (que ocupa z en [0,
          // depth]), con la taquilla pegada a la pared de fondo (como un
          // mueble real contra la pared) y todo el espacio libre por
          // delante, para el mobiliario y para poder orbitar la cámara sin
          // salirse de la sala. Las dos salas comparten la misma
          // profundidad (están una al lado de la otra, no una detrás de
          // otra).
          // Si es "empotrado", la pared de fondo se adelanta hasta casi
          // tapar el fondo de la taquilla, para que quede encastrada.
          const roomBackWallZ = isEmpotrado ? Math.max(depth - mmToUnits(50), mmToUnits(10)) : -mmToUnits(10);
          const roomFrontZ    = depth + margin * 1.8;
          const roomDepth     = roomFrontZ - roomBackWallZ;
          const roomCenterZ   = (roomFrontZ + roomBackWallZ) / 2;

          // Moqueta: textura de cuadrícula tenue, en vez de un gris liso.
          function makeCarpetTexture() {
            const size = 64;
            const canvas = document.createElement('canvas');
            canvas.width = size; canvas.height = size;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#9aa3ab';
            ctx.fillRect(0, 0, size, size);
            ctx.strokeStyle = 'rgba(0,0,0,0.08)';
            ctx.lineWidth = 2;
            ctx.strokeRect(0, 0, size, size);
            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = THREE.RepeatWrapping;
            tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(roomWidth / mmToUnits(600), roomDepth / mmToUnits(600));
            return tex;
          }
          const floorMatOffice   = new THREE.MeshStandardMaterial({ map: makeCarpetTexture(), roughness: 0.97 });
          const wallMatOffice    = new THREE.MeshStandardMaterial({ color: 0xeef0f1, roughness: 0.92 });
          const ceilingMatOffice = new THREE.MeshStandardMaterial({ color: 0xf7f8f8, roughness: 0.9 });
          const skirtingMat      = new THREE.MeshStandardMaterial({ color: 0xcfd3d6, roughness: 0.6 });

          const officeFloor = new THREE.Mesh(new THREE.BoxGeometry(roomWidth, wallT, roomDepth), floorMatOffice);
          officeFloor.position.set(roomCenterX, floorY, roomCenterZ);
          scene.add(officeFloor);

          const officeCeiling = new THREE.Mesh(new THREE.BoxGeometry(roomWidth, wallT, roomDepth), ceilingMatOffice);
          officeCeiling.position.set(roomCenterX, roomHeight + wallT / 2, roomCenterZ);
          scene.add(officeCeiling);

          if (isEmpotrado) {
            addWallWithLockerHoles(
              wallMatOffice, roomCenterX - roomWidth / 2, roomCenterX + roomWidth / 2, 0, roomHeight, roomBackWallZ - wallT / 2,
              lockerHoleSegments, baseY - lockerHoleMarginY, baseY + maxHeight + lockerHoleMarginY
            );
          } else {
            const backWall = new THREE.Mesh(new THREE.BoxGeometry(roomWidth, roomHeight, wallT), wallMatOffice);
            backWall.position.set(roomCenterX, roomHeight / 2, roomBackWallZ - wallT / 2);
            scene.add(backWall);
          }

          const leftWall = new THREE.Mesh(new THREE.BoxGeometry(wallT, roomHeight, roomDepth), wallMatOffice);
          leftWall.position.set(roomCenterX - roomWidth / 2 + wallT / 2, roomHeight / 2, roomCenterZ);
          scene.add(leftWall);

          const rightWall = new THREE.Mesh(new THREE.BoxGeometry(wallT, roomHeight, roomDepth), wallMatOffice);
          rightWall.position.set(roomCenterX + roomWidth / 2 - wallT / 2, roomHeight / 2, roomCenterZ);
          scene.add(rightWall);

          // Zócalo fino en la base de las tres paredes.
          const skirtH = mmToUnits(80);
          const skirtT = mmToUnits(15);
          scene.add(new THREE.Mesh(new THREE.BoxGeometry(roomWidth, skirtH, skirtT), skirtingMat)
            .translateX(roomCenterX).translateY(skirtH / 2).translateZ(roomBackWallZ - skirtT / 2 + mmToUnits(2)));
          scene.add(new THREE.Mesh(new THREE.BoxGeometry(skirtT, skirtH, roomDepth), skirtingMat)
            .translateX(roomBackX0 + skirtT / 2 - mmToUnits(2)).translateY(skirtH / 2).translateZ(roomCenterZ));
          scene.add(new THREE.Mesh(new THREE.BoxGeometry(skirtT, skirtH, roomDepth), skirtingMat)
            .translateX(roomBackX0 + roomWidth - skirtT / 2 + mmToUnits(2)).translateY(skirtH / 2).translateZ(roomCenterZ));

          // Paneles de luz empotrados en el techo (emisivos, no iluminan de
          // verdad la escena, pero dan la sensación de fluorescentes).
          const lightPanelMat = new THREE.MeshStandardMaterial({ color: 0xffffff, emissive: 0xffffff, emissiveIntensity: 0.9, roughness: 0.6 });
          const panelW = mmToUnits(1200), panelD = mmToUnits(300), panelT = mmToUnits(15);
          [-1, 0, 1].forEach(function (col) {
            [0.3, 0.65].forEach(function (frac) {
              scene.add(new THREE.Mesh(new THREE.BoxGeometry(panelW, panelT, panelD), lightPanelMat)
                .translateX(roomCenterX + col * roomWidth * 0.22)
                .translateY(roomHeight - panelT / 2 - mmToUnits(2))
                .translateZ(roomBackWallZ + roomDepth * frac));
            });
          });

          // Ventana con persiana veneciana (lamas horizontales) en la pared
          // de fondo, a un lado de la taquilla.
          const officeFrameMat = new THREE.MeshStandardMaterial({ color: 0x3a3f47, roughness: 0.5, metalness: 0.3 });
          const officeGlassMat = new THREE.MeshStandardMaterial({
            color: 0xbfe3f0, roughness: 0.1, metalness: 0.1,
            transparent: true, opacity: 0.2
          });
          const officeSillMat = new THREE.MeshStandardMaterial({ color: 0xd8dadc, roughness: 0.5 });
          const blindMat = new THREE.MeshStandardMaterial({ color: 0xe4e1d6, roughness: 0.6, side: THREE.DoubleSide });
          const winWidthOffice  = mmToUnits(1600);
          const winHeightOffice = mmToUnits(1600);
          const winFrameTOffice = mmToUnits(25);
          const winCenterX = mainAreaX1 - margin * 0.55;
          const winCenterY = Math.max(baseY + maxHeight * 0.9, roomHeight * 0.48);
          const winZOffice = roomBackWallZ + wallT / 2 - mmToUnits(2);

          scene.add(new THREE.Mesh(
            new THREE.BoxGeometry(winWidthOffice + winFrameTOffice * 2, winHeightOffice + winFrameTOffice * 2, winFrameTOffice),
            officeFrameMat
          ).translateX(winCenterX).translateY(winCenterY).translateZ(winZOffice));
          // Montantes de la ventana (cruz central), para que no sea un
          // cristal liso de una sola pieza.
          scene.add(new THREE.Mesh(new THREE.BoxGeometry(mmToUnits(25), winHeightOffice, winFrameTOffice * 0.7), officeFrameMat)
            .translateX(winCenterX).translateY(winCenterY).translateZ(winZOffice + mmToUnits(2)));
          scene.add(new THREE.Mesh(new THREE.BoxGeometry(winWidthOffice, mmToUnits(25), winFrameTOffice * 0.7), officeFrameMat)
            .translateX(winCenterX).translateY(winCenterY).translateZ(winZOffice + mmToUnits(2)));
          scene.add(new THREE.Mesh(
            new THREE.BoxGeometry(winWidthOffice, winHeightOffice, mmToUnits(10)),
            officeGlassMat
          ).translateX(winCenterX).translateY(winCenterY).translateZ(winZOffice + mmToUnits(10)));
          // Alféizar que sobresale un poco de la pared.
          scene.add(new THREE.Mesh(new THREE.BoxGeometry(winWidthOffice + winFrameTOffice * 3, mmToUnits(25), winFrameTOffice * 3), officeSillMat)
            .translateX(winCenterX).translateY(winCenterY - winHeightOffice / 2 - winFrameTOffice).translateZ(winZOffice + winFrameTOffice));
          // Persiana: lamas finas, ligeramente inclinadas, cubriendo la
          // mitad superior del cristal como si estuviera medio bajada.
          const slatCount = 7;
          const slatZone = winHeightOffice * 0.55;
          const slatTopY = winCenterY + winHeightOffice / 2 - mmToUnits(15);
          for (let i = 0; i < slatCount; i++) {
            const slat = new THREE.Mesh(new THREE.BoxGeometry(winWidthOffice - mmToUnits(10), mmToUnits(8), mmToUnits(90)), blindMat);
            slat.position.set(winCenterX, slatTopY - (slatZone / slatCount) * i, winZOffice + mmToUnits(25));
            slat.rotation.x = 0.25;
            scene.add(slat);
          }

          const legMatOffice = new THREE.MeshStandardMaterial({ color: 0x4a4f55, roughness: 0.4, metalness: 0.4 });
          const chairMat = new THREE.MeshStandardMaterial({ color: 0x2f3338, roughness: 0.5 });
          const tableMat = new THREE.MeshStandardMaterial({ color: 0xcfcfd2, roughness: 0.3, metalness: 0.1 });
          const deskMat = new THREE.MeshStandardMaterial({ color: 0xb08968, roughness: 0.6 });
          const monitorMat = new THREE.MeshStandardMaterial({ color: 0x1b1d1f, roughness: 0.3, metalness: 0.2 });
          const plantPotMat = new THREE.MeshStandardMaterial({ color: 0x2f3338, roughness: 0.8 });
          const plantLeafMat = new THREE.MeshStandardMaterial({ color: 0x4a8f4f, roughness: 0.85 });

          // Una silla esquemática (asiento + respaldo + pata central).
          function addChairAt(cx, cz, facingSign) {
            const seatZ = cz + facingSign * mmToUnits(40);
            scene.add(new THREE.Mesh(new THREE.BoxGeometry(mmToUnits(420), mmToUnits(40), mmToUnits(420)), chairMat)
              .translateX(cx).translateY(mmToUnits(430)).translateZ(seatZ));
            scene.add(new THREE.Mesh(new THREE.BoxGeometry(mmToUnits(420), mmToUnits(520), mmToUnits(40)), chairMat)
              .translateX(cx).translateY(mmToUnits(690)).translateZ(seatZ - facingSign * mmToUnits(190)));
            scene.add(new THREE.Mesh(new THREE.BoxGeometry(mmToUnits(60), mmToUnits(410), mmToUnits(60)), legMatOffice)
              .translateX(cx).translateY(mmToUnits(205)).translateZ(seatZ));
          }
          // Igual que addChairAt, pero orientada hacia el eje X en vez de Z
          // (para sillas a los lados de una mesa orientada en profundidad).
          function addChairAtX(cx, cz, facingSign) {
            const seatX = cx + facingSign * mmToUnits(40);
            scene.add(new THREE.Mesh(new THREE.BoxGeometry(mmToUnits(420), mmToUnits(40), mmToUnits(420)), chairMat)
              .translateX(seatX).translateY(mmToUnits(430)).translateZ(cz));
            scene.add(new THREE.Mesh(new THREE.BoxGeometry(mmToUnits(40), mmToUnits(520), mmToUnits(420)), chairMat)
              .translateX(seatX - facingSign * mmToUnits(190)).translateY(mmToUnits(690)).translateZ(cz));
            scene.add(new THREE.Mesh(new THREE.BoxGeometry(mmToUnits(60), mmToUnits(410), mmToUnits(60)), legMatOffice)
              .translateX(seatX).translateY(mmToUnits(205)).translateZ(cz));
          }
          function addPlantAt(px, pz) {
            scene.add(new THREE.Mesh(new THREE.CylinderGeometry(mmToUnits(160), mmToUnits(130), mmToUnits(300), 12), plantPotMat)
              .translateX(px).translateY(mmToUnits(150)).translateZ(pz));
            scene.add(new THREE.Mesh(new THREE.SphereGeometry(mmToUnits(260), 10, 8), plantLeafMat)
              .translateX(px).translateY(mmToUnits(520)).translateZ(pz));
          }

          // --- Sala de reuniones (izquierda): mesa + 6 sillas, con la mesa
          // orientada en el otro sentido (el lado largo en Z, sillas a los
          // lados en X), para que quepa en una sala más estrecha. ---
          const meetingCenterX = (meetingX0 + partitionX) / 2;
          const tableZ = roomBackWallZ + roomDepth * 0.5;
          const tableW = mmToUnits(1200);
          const tableD = Math.min(roomDepth * 0.5, mmToUnits(2800));
          const tableH = mmToUnits(740);
          const tableTopT = mmToUnits(40);

          scene.add(new THREE.Mesh(new THREE.BoxGeometry(tableW, tableTopT, tableD), tableMat)
            .translateX(meetingCenterX).translateY(tableH).translateZ(tableZ));
          [-1, 1].forEach(function (sx) {
            [-1, 1].forEach(function (sz) {
              scene.add(new THREE.Mesh(new THREE.BoxGeometry(mmToUnits(60), tableH - tableTopT, mmToUnits(60)), legMatOffice)
                .translateX(meetingCenterX + sx * (tableW / 2 - mmToUnits(80)))
                .translateY((tableH - tableTopT) / 2)
                .translateZ(tableZ + sz * (tableD / 2 - mmToUnits(80))));
            });
          });
          [-1, 0, 1].forEach(function (frac) {
            const cz = tableZ + frac * (tableD / 2 - mmToUnits(300));
            addChairAtX(meetingCenterX - tableW / 2 - mmToUnits(300), cz, 1);
            addChairAtX(meetingCenterX + tableW / 2 + mmToUnits(300), cz, -1);
          });
          addPlantAt(meetingX0 + margin * 0.3, roomBackWallZ + roomDepth * 0.15);
          addPlantAt(meetingX0 + margin * 0.3, roomFrontZ - margin * 0.3);

          // --- Cristalera: separa la sala de reuniones de la zona de
          // trabajo (pared interior, no la fachada), de suelo a techo con
          // montantes negros, como un tabique de oficina real. ---
          const glassWallMullionMat = new THREE.MeshStandardMaterial({ color: 0x2b2e33, roughness: 0.4, metalness: 0.5 });
          const glassWallGlassMat = new THREE.MeshStandardMaterial({
            color: 0xbfe3f0, roughness: 0.05, metalness: 0.0,
            transparent: true, opacity: 0.12, side: THREE.DoubleSide
          });
          const mullionW = mmToUnits(70);
          const mullionCount = Math.max(3, Math.round(roomDepth / mmToUnits(1400)));
          const mullionSpacing = roomDepth / mullionCount;

          scene.add(new THREE.Mesh(new THREE.BoxGeometry(mmToUnits(15), roomHeight, roomDepth), glassWallGlassMat)
            .translateX(partitionX).translateY(roomHeight / 2).translateZ(roomCenterZ));
          scene.add(new THREE.Mesh(new THREE.BoxGeometry(mmToUnits(40), mullionW, roomDepth), glassWallMullionMat)
            .translateX(partitionX).translateY(mullionW / 2).translateZ(roomCenterZ));
          scene.add(new THREE.Mesh(new THREE.BoxGeometry(mmToUnits(40), mullionW, roomDepth), glassWallMullionMat)
            .translateX(partitionX).translateY(roomHeight - mullionW / 2).translateZ(roomCenterZ));
          for (let i = 0; i <= mullionCount; i++) {
            scene.add(new THREE.Mesh(new THREE.BoxGeometry(mmToUnits(40), roomHeight, mullionW), glassWallMullionMat)
              .translateX(partitionX).translateY(roomHeight / 2).translateZ(roomBackWallZ + i * mullionSpacing));
          }

          // --- Zona de trabajo (derecha): varios escritorios con pantalla,
          // delante de la taquilla. ---
          function addDeskAt(cx, cz) {
            const deskW = mmToUnits(1200), deskD = mmToUnits(600), deskH = mmToUnits(740), deskTopT = mmToUnits(30);
            scene.add(new THREE.Mesh(new THREE.BoxGeometry(deskW, deskTopT, deskD), deskMat)
              .translateX(cx).translateY(deskH).translateZ(cz));
            [-1, 1].forEach(function (sx) {
              [-1, 1].forEach(function (sz) {
                scene.add(new THREE.Mesh(new THREE.BoxGeometry(mmToUnits(40), deskH - deskTopT, mmToUnits(40)), legMatOffice)
                  .translateX(cx + sx * (deskW / 2 - mmToUnits(40)))
                  .translateY((deskH - deskTopT) / 2)
                  .translateZ(cz + sz * (deskD / 2 - mmToUnits(40))));
              });
            });
            scene.add(new THREE.Mesh(new THREE.BoxGeometry(mmToUnits(500), mmToUnits(320), mmToUnits(20)), monitorMat)
              .translateX(cx).translateY(deskH + deskTopT / 2 + mmToUnits(210)).translateZ(cz - deskD / 2 + mmToUnits(60)));
            scene.add(new THREE.Mesh(new THREE.BoxGeometry(mmToUnits(60), mmToUnits(60), mmToUnits(60)), monitorMat)
              .translateX(cx).translateY(deskH + deskTopT / 2 + mmToUnits(30)).translateZ(cz - deskD / 2 + mmToUnits(60)));
            addChairAt(cx, cz + deskD / 2 + mmToUnits(260), -1);
          }

          const deskRowZ = roomBackWallZ + roomDepth * 0.6;
          const deskSpacing = mmToUnits(1650);
          [-1, 0, 1].forEach(function (frac) {
            addDeskAt(totalWidth / 2 + frac * deskSpacing, deskRowZ);
          });
          addPlantAt(mainAreaX1 - margin * 0.35, roomFrontZ - margin * 0.3);

          // La cámara debe quedarse DENTRO de la zona de trabajo (no
          // atravesar la fachada abierta ni colarse en la sala de
          // reuniones).
          officeCameraMaxDistZ = roomFrontZ - depth / 2 - margin * 0.25;
          officeCameraHalfWidth = mainAreaWidth / 2 - margin * 0.25;
        } else if (currentScenario === 'exterior') {
          // Entorno "exterior": fachada de comunidad de vecinos tipo plaza
          // (fachada con ventanas y barandillas, jardineras con seto,
          // árboles low-poly, farola y banco), siguiendo el render de
          // referencia que pasó el cliente.
          const margin = Math.max(totalWidth, baseY + maxHeight) * 3.2;
          const mU = function (m) { return m * 100; }; // metros -> unidades (1 unidad = 1cm)

          function makeExtTex(w, h, draw, rx, ry) {
            const canvas = document.createElement('canvas');
            canvas.width = w; canvas.height = h;
            draw(canvas.getContext('2d'), w, h);
            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(rx, ry);
            return tex;
          }
          function extRng(seed) {
            return function () { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
          }

          const floorTex = makeExtTex(512, 512, function (g, w, h) {
            const r = extRng(7), tones = ['#e4ddd3', '#d6cec2', '#cbc2b5', '#ebe6de', '#ddd5ca'];
            g.fillStyle = '#f3f0ea'; g.fillRect(0, 0, w, h);
            const bw = 64, bh = 32;
            for (let y = 0; y < h / bh; y++) {
              const off = (y % 2) * bw / 2;
              for (let x = -1; x <= w / bw; x++) {
                g.fillStyle = tones[Math.floor(r() * tones.length)];
                g.fillRect(x * bw + off + 2, y * bh + 2, bw - 4, bh - 4);
              }
            }
          }, Math.max(6, (margin * 3) / mU(1.5)), Math.max(6, (margin * 3) / mU(1.5)));

          const wallTexBase = makeExtTex(512, 256, function (g, w, h) {
            const r = extRng(3), tones = ['#e2dacd', '#d6cdbd', '#ebe5da', '#cfc5b4', '#ddd4c5'];
            g.fillStyle = '#f6f4ef'; g.fillRect(0, 0, w, h);
            const bw = 128, bh = 48;
            for (let y = 0; y < Math.ceil(h / bh); y++) {
              const off = (y % 2) * bw / 2;
              for (let x = -1; x <= w / bw; x++) {
                g.fillStyle = tones[Math.floor(r() * tones.length)];
                g.fillRect(x * bw + off + 4, y * bh + 4, bw - 8, bh - 8);
              }
            }
          }, 1, 1);
          // Tamaño real (en metros) del azulejo del lienzo de arriba, para
          // poder recortar cada pieza de la pared con su propio repetido y
          // offset alineados a una rejilla común (igual que el ladrillo del
          // escenario "home"): si no, el patrón "salta" entre piezas cuando
          // la pared se parte para dejar hueco a la taquilla "empotrada".
          const wallTileW = mU(1.0), wallTileH = mU(0.47);
          function makeExtWallMat(pieceWidth, pieceHeight, worldLeftX, worldBottomY) {
            const tex = wallTexBase.clone();
            tex.needsUpdate = true;
            tex.repeat.set(pieceWidth / wallTileW, pieceHeight / wallTileH);
            tex.offset.set(((worldLeftX || 0) / wallTileW) % 1, ((worldBottomY || 0) / wallTileH) % 1);
            return new THREE.MeshStandardMaterial({ map: tex, roughness: 0.9 });
          }

          const extFloorMat = new THREE.MeshStandardMaterial({ map: floorTex, roughness: 0.95 });
          const extWallPlainMat = new THREE.MeshStandardMaterial({ color: 0xebe6dd, roughness: 0.95 });
          const extFrameMat = new THREE.MeshStandardMaterial({ color: 0xf2f0ec, roughness: 0.7 });
          const extGlassMat = new THREE.MeshStandardMaterial({ color: 0x7fa8cf, roughness: 0.15, metalness: 0.2 });
          const extRailMat = new THREE.MeshStandardMaterial({ color: 0x8a837b, roughness: 0.5, metalness: 0.4 });
          const extConcreteMat = new THREE.MeshStandardMaterial({ color: 0xc9c6c1, roughness: 0.95 });
          const extHedgeMat = new THREE.MeshStandardMaterial({ color: 0x5fae4e, roughness: 0.85 });
          const extLeaf1Mat = new THREE.MeshStandardMaterial({ color: 0x4f9a3f, flatShading: true, roughness: 0.9 });
          const extLeaf2Mat = new THREE.MeshStandardMaterial({ color: 0x72bb5c, flatShading: true, roughness: 0.9 });
          const extTrunkMat = new THREE.MeshStandardMaterial({ color: 0x8a6440, roughness: 0.9 });
          const extBlackMat = new THREE.MeshStandardMaterial({ color: 0x22252a, roughness: 0.55, metalness: 0.3 });
          const extWoodMat = new THREE.MeshStandardMaterial({ color: 0xd19a55, roughness: 0.75 });
          const extBulbMat = new THREE.MeshStandardMaterial({ color: 0xfff3d0, emissive: 0xffe2a0, emissiveIntensity: 1 });

          const extCenterX = totalWidth / 2;

          const floorSize = Math.max(totalWidth, margin) * 3;
          const extFloorMesh = new THREE.Mesh(new THREE.PlaneGeometry(floorSize, floorSize), extFloorMat);
          extFloorMesh.rotation.x = -Math.PI / 2;
          extFloorMesh.position.set(extCenterX, 0, depth * 0.3);
          scene.add(extFloorMesh);

          // Si es "empotrado", la pared se acerca hasta tapar casi todo el
          // fondo de la taquilla, para que parezca encajada dentro del
          // muro en vez de simplemente apoyada delante.
          const wallZ = isEmpotrado ? Math.max(depth - mmToUnits(50), mmToUnits(10)) : -mmToUnits(300);
          const wallWidth = Math.max(totalWidth + margin * 2, mU(10));
          const lowWallH = mU(3.4), upWallH = mU(6);
          if (isEmpotrado) {
            // Hueco en la pared justo en la zona de la taquilla (y el arco
            // de apertura de sus puertas), para que no se vea como si las
            // puertas atravesaran el ladrillo al abrirse.
            addWallWithLockerHoles(
              makeExtWallMat, extCenterX - wallWidth / 2, extCenterX + wallWidth / 2, 0, lowWallH, wallZ,
              lockerHoleSegments, baseY - lockerHoleMarginY, baseY + maxHeight + lockerHoleMarginY
            );
          } else {
            const lowWall = new THREE.Mesh(
              new THREE.PlaneGeometry(wallWidth, lowWallH),
              makeExtWallMat(wallWidth, lowWallH, extCenterX - wallWidth / 2, 0)
            );
            lowWall.position.set(extCenterX, lowWallH / 2, wallZ);
            scene.add(lowWall);
          }
          const upWall = new THREE.Mesh(new THREE.PlaneGeometry(wallWidth, upWallH), extWallPlainMat);
          upWall.position.set(extCenterX, lowWallH + upWallH / 2, wallZ);
          scene.add(upWall);
          addBox(wallWidth, mU(0.12), mU(0.12), extFrameMat, extCenterX, lowWallH, wallZ + mU(0.06));

          // Ventanas con barandilla, repartidas a lo largo de la fachada.
          function addExtWindow(cx, cy) {
            const g = new THREE.Group();
            g.position.set(cx, cy, wallZ);
            scene.add(g);
            function gbox(w, h, d, mat, x, y, z) {
              const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
              m.position.set(x, y, z);
              g.add(m);
              return m;
            }
            gbox(mU(2.3), mU(1.9), mU(0.06), extFrameMat, 0, 0, mU(0.02));
            gbox(mU(1.0), mU(1.7), mU(0.04), extGlassMat, -mU(0.56), 0, mU(0.06));
            gbox(mU(1.0), mU(1.7), mU(0.04), extGlassMat, mU(0.56), 0, mU(0.06));
            gbox(mU(2.5), mU(0.08), mU(0.3), extFrameMat, 0, -mU(1.0), mU(0.15));
            gbox(mU(2.4), mU(0.04), mU(0.04), extRailMat, 0, -mU(0.3), mU(0.28));
            gbox(mU(2.4), mU(0.04), mU(0.04), extRailMat, 0, -mU(0.93), mU(0.28));
            for (let i = 0; i < 11; i++) {
              const p = new THREE.Mesh(new THREE.CylinderGeometry(mU(0.015), mU(0.015), mU(0.65), 6), extRailMat);
              p.position.set(-mU(1.15) + i * mU(0.23), -mU(0.62), mU(0.28));
              g.add(p);
            }
          }
          const winY = mU(4.9);
          const winCount = Math.max(2, Math.round(wallWidth / mU(5)));
          for (let i = 0; i < winCount; i++) {
            const wx = extCenterX - wallWidth / 2 + mU(2.6) + i * ((wallWidth - mU(5.2)) / Math.max(1, winCount - 1));
            addExtWindow(wx, winY);
          }

          // Jardineras con seto, a ambos lados de la taquilla.
          function hedgePlanterExt(x, z) {
            const g = new THREE.Group();
            g.position.set(x, 0, z);
            scene.add(g);
            const base = new THREE.Mesh(new THREE.BoxGeometry(mU(2.0), mU(0.42), mU(0.85)), extConcreteMat);
            base.position.set(0, mU(0.21), 0);
            g.add(base);
            const w = mU(1.9), h = mU(0.68), r = mU(0.25);
            const s = new THREE.Shape();
            s.moveTo(-w / 2 + r, 0); s.lineTo(w / 2 - r, 0); s.quadraticCurveTo(w / 2, 0, w / 2, r);
            s.lineTo(w / 2, h - r); s.quadraticCurveTo(w / 2, h, w / 2 - r, h); s.lineTo(-w / 2 + r, h);
            s.quadraticCurveTo(-w / 2, h, -w / 2, h - r); s.lineTo(-w / 2, r); s.quadraticCurveTo(-w / 2, 0, -w / 2 + r, 0);
            const geo = new THREE.ExtrudeGeometry(s, { depth: mU(0.55), bevelEnabled: true, bevelThickness: mU(0.1), bevelSize: mU(0.08), bevelSegments: 4, curveSegments: 10 });
            geo.translate(0, 0, -mU(0.275));
            const hedgeMesh = new THREE.Mesh(geo, extHedgeMat);
            hedgeMesh.position.y = mU(0.44);
            g.add(hedgeMesh);
          }
          // La jardinera mide 1,9m de ancho (0,95m de radio): si el hueco
          // hasta la taquilla es menor que eso, la jardinera se mete por
          // encima del mueble. El hueco crece con el ancho de la taquilla
          // (más columnas → más separación), no es un valor fijo.
          const hedgeHalfW = mU(0.95);
          const hedgeGap = mU(0.3) + totalWidth * 0.12;
          const hedgeOffset = totalWidth / 2 + hedgeHalfW + hedgeGap;
          hedgePlanterExt(extCenterX - hedgeOffset, mU(0.1));
          hedgePlanterExt(extCenterX + hedgeOffset, mU(0.1));

          // Árboles low-poly.
          function extLowpolyBlob(r, detail, seed, mat) {
            const geo = new THREE.IcosahedronGeometry(r, detail);
            const pos = geo.attributes.position, cache = {}, rand = extRng(seed);
            for (let i = 0; i < pos.count; i++) {
              const k = pos.getX(i).toFixed(3) + ',' + pos.getY(i).toFixed(3) + ',' + pos.getZ(i).toFixed(3);
              if (!cache[k]) cache[k] = 0.85 + rand() * 0.3;
              pos.setXYZ(i, pos.getX(i) * cache[k], pos.getY(i) * cache[k] * 0.92, pos.getZ(i) * cache[k]);
            }
            geo.computeVertexNormals();
            return new THREE.Mesh(geo, mat);
          }
          function extTree(x, z, seed) {
            const g = new THREE.Group();
            g.position.set(x, 0, z);
            scene.add(g);
            const base = new THREE.Mesh(new THREE.BoxGeometry(mU(1.6), mU(0.5), mU(1.6)), extConcreteMat);
            base.position.y = mU(0.25);
            g.add(base);
            const trunk = new THREE.Mesh(new THREE.CylinderGeometry(mU(0.11), mU(0.17), mU(3.2), 8), extTrunkMat);
            trunk.position.y = mU(2.0);
            g.add(trunk);
            const blobs = [
              [0, mU(4.3), 0, mU(1.5), extLeaf1Mat],
              [-mU(0.8), mU(3.8), mU(0.3), mU(1.05), extLeaf2Mat],
              [mU(0.8), mU(3.9), -mU(0.2), mU(1.1), extLeaf2Mat],
              [mU(0.1), mU(5.1), mU(0.2), mU(1.0), extLeaf2Mat]
            ];
            blobs.forEach(function (b, i) {
              const m = extLowpolyBlob(b[3], 1, seed + i * 13, b[4]);
              m.position.set(b[0], b[1], b[2]);
              g.add(m);
            });
          }
          // Los árboles se adelantan bastante respecto a la fachada (no
          // solo lateralmente): si no, la copa se mete dentro de la pared.
          extTree(extCenterX - hedgeOffset - margin * 0.4, mU(3.2), 11);
          extTree(extCenterX + hedgeOffset + margin * 0.4, mU(3.6), 29);

          // Farola: por fuera de la jardinera, no encima.
          const lampX = extCenterX - hedgeOffset - hedgeHalfW - mU(0.6);
          const pole = new THREE.Mesh(new THREE.CylinderGeometry(mU(0.06), mU(0.08), mU(4.4), 12), extBlackMat);
          pole.position.set(lampX, mU(2.2), mU(0.2));
          scene.add(pole);
          const shade = new THREE.Mesh(new THREE.CylinderGeometry(mU(0.28), mU(0.14), mU(0.42), 12), extBlackMat);
          shade.position.set(lampX, mU(4.55), mU(0.2));
          scene.add(shade);
          const bulb = new THREE.Mesh(new THREE.CylinderGeometry(mU(0.2), mU(0.2), mU(0.03), 16), extBulbMat);
          bulb.position.set(lampX, mU(4.33), mU(0.2));
          scene.add(bulb);

          // Banco de madera.
          const benchX = extCenterX + hedgeOffset + hedgeHalfW + mU(0.7);
          const benchSeat = new THREE.Mesh(new THREE.BoxGeometry(mU(0.55), mU(0.42), mU(1.25)), extBlackMat);
          benchSeat.position.set(benchX, mU(0.21), mU(0.9));
          scene.add(benchSeat);
          for (let i = 0; i < 3; i++) {
            const slat = new THREE.Mesh(new THREE.BoxGeometry(mU(0.17), mU(0.06), mU(1.32)), extWoodMat);
            slat.position.set(benchX - mU(0.2) + i * mU(0.2), mU(0.45), mU(0.9));
            scene.add(slat);
          }

          // El edificio/entorno es mucho más ancho que la taquilla (árboles
          // y banco a los lados), así que fuerzo que la cámara arranque lo
          // bastante lejos como para ver la escena completa, no solo el
          // mueble.
          minCameraDist = wallWidth * 0.75;
        }

        const sceneTotalHeight = baseY + maxHeight;

        camera = new THREE.PerspectiveCamera(45, 1, 1, 30000);
        let dist = Math.max(totalWidth, sceneTotalHeight, depth) * 1.8 + 50;
        if (minCameraDist !== null) dist = Math.max(dist, minCameraDist);
        let camX = totalWidth / 2 + dist * 0.6;
        let camZ = dist * 0.9;
        if (officeCameraMaxDistZ !== null) {
          // Reescala toda la posición de cámara (no solo recorta Z) para
          // conservar el mismo ángulo de vista, pero sin salir de la sala.
          const scale = Math.min(1, officeCameraMaxDistZ / camZ, (officeCameraHalfWidth + totalWidth / 2) / camX);
          dist *= scale;
          camX = totalWidth / 2 + dist * 0.6;
          camZ = dist * 0.9;
        }
        if (cameraPosOverride) {
          camera.position.copy(cameraPosOverride);
        } else {
          camera.position.set(camX, sceneTotalHeight * 0.7 + dist * 0.35, camZ);
        }

        // logarithmicDepthBuffer: el plano lejano de la cámara es muy
        // grande (hace falta para el escenario del edificio/calle), y sin
        // esto la precisión del buffer de profundidad se queda corta a
        // media/larga distancia, haciendo que superficies casi pegadas
        // (marco/cristal de las ventanas, por ejemplo) parpadeen (z-fighting).
        renderer = new THREE.WebGLRenderer({ antialias: true, logarithmicDepthBuffer: true });
        viewer.innerHTML = '';
        viewer.appendChild(renderer.domElement);

        controls = new THREE.OrbitControls(camera, renderer.domElement);
        if (cameraTargetOverride) {
          controls.target.copy(cameraTargetOverride);
        } else {
          controls.target.set(totalWidth / 2, sceneTotalHeight / 2, 0);
        }
        controls.enableDamping = true;
        controls.dampingFactor = 0.08;
        // Límite de alejamiento proporcional al encuadre inicial, no un
        // número fijo: así cada escenario (desde una taquilla sola hasta
        // el edificio con calle) permite alejarse un poco más de lo normal
        // pero no "perderse" en la escena. Cuando la cámara tiene una
        // posición fija propia (p.ej. el edificio), el encuadre real no es
        // "dist" sino la distancia a ese punto fijo.
        const initialCamDist = cameraPosOverride ? camera.position.distanceTo(controls.target) : dist;
        controls.maxDistance = Math.max(initialCamDist * 1.5, 500);
        controls.update();

        resizeRenderer();
        setupDoorClicks();
        startAnimation();
      }

      function setupDoorClicks() {
        const raycaster = new THREE.Raycaster();
        const pointer = new THREE.Vector2();
        let downX = 0, downY = 0;

        renderer.domElement.addEventListener('pointerdown', function (e) {
          downX = e.clientX;
          downY = e.clientY;
        });

        renderer.domElement.addEventListener('pointerup', function (e) {
          // Si hubo arrastre (rotar/paneo con OrbitControls), no se considera un clic.
          if (Math.abs(e.clientX - downX) > 4 || Math.abs(e.clientY - downY) > 4) return;

          const rect = renderer.domElement.getBoundingClientRect();
          pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
          pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

          raycaster.setFromCamera(pointer, camera);
          const hits = raycaster.intersectObjects(clickableMeshes, false);
          if (hits.length === 0) return;

          const idx = hits[0].object.userData.doorPivotIndex;
          const entry = doorPivots[idx];
          if (entry) entry.open = !entry.open;
        });
      }

      function startAnimation() {
        if (animationId) cancelAnimationFrame(animationId);
        let lastT = null;
        function animate(t) {
          animationId = requestAnimationFrame(animate);
          // La primera llamada (más abajo) se hace a mano, sin "t" (eso
          // solo lo da requestAnimationFrame), así que hay que comprobar
          // que sea un número real y no solo que lastT ya tenga valor: si
          // no, lastT quedaba en "undefined" y dt se volvía NaN para
          // siempre desde el segundo frame (los coches dejaban de moverse).
          const dt = (lastT === null || typeof t !== 'number') ? 0 : Math.min((t - lastT) / 1000, 0.05);
          lastT = typeof t === 'number' ? t : lastT;
          controls.update();
          doorPivots.forEach(function (entry) {
            const target = entry.open ? DOOR_OPEN_ANGLE : 0;
            entry.pivot.rotation.y += (target - entry.pivot.rotation.y) * 0.18;
          });
          sceneUpdaters.forEach(function (fn) { fn(dt); });
          renderer.render(scene, camera);
        }
        animate();
      }

      function resizeRenderer() {
        if (!renderer || !camera || !viewer) return;
        const w = viewer.clientWidth || 1;
        const h = viewer.clientHeight || 1;
        renderer.setPixelRatio(window.devicePixelRatio || 1);
        renderer.setSize(w, h);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      }

      function openModal() {
        modal3d.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        modal3d.setAttribute('aria-hidden', 'false');

        ensureThree().then(function () {
          if (!renderer) {
            buildScene();
          } else {
            startAnimation();
          }
          requestAnimationFrame(resizeRenderer);
        }).catch(function (err) {
          console.error('No se pudo cargar el visor 3D:', err);
          viewer.innerHTML = '<div style="padding:24px;color:#dc2626;">No se pudo cargar el visor 3D. Revisa la consola del navegador para más detalles.</div>';
        });
      }

      function closeModal() {
        modal3d.classList.remove('is-open');
        document.body.style.overflow = '';
        modal3d.setAttribute('aria-hidden', 'true');
        if (animationId) { cancelAnimationFrame(animationId); animationId = null; }
      }

      btn3d.addEventListener('click', openModal);
      modal3d.addEventListener('click', function (e) {
        if (e.target.closest('[data-close3d="1"]')) closeModal();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal3d.classList.contains('is-open')) closeModal();
      });
      window.addEventListener('resize', function () {
        if (modal3d.classList.contains('is-open')) resizeRenderer();
      });
    });
  </script>

  <script>
    window.addEventListener('DOMContentLoaded', function () {
      // Drag-to-scroll on preview
      var scroll = document.querySelector('.preview-scroll');
      var dragMoved = 0;
      if (scroll) {
        var isDragging = false, startX, scrollLeft;

        scroll.addEventListener('mousedown', function (e) {
          isDragging = true;
          dragMoved = 0;
          scroll.classList.add('is-dragging');
          startX    = e.pageX - scroll.getBoundingClientRect().left;
          scrollLeft = scroll.scrollLeft;
          e.preventDefault();
        });

        document.addEventListener('mouseup', function () {
          isDragging = false;
          scroll.classList.remove('is-dragging');
        });

        document.addEventListener('mousemove', function (e) {
          if (!isDragging) return;
          var x    = e.pageX - scroll.getBoundingClientRect().left;
          var walk = (x - startX) * 1.2;
          dragMoved = Math.max(dragMoved, Math.abs(walk));
          scroll.scrollLeft = scrollLeft - walk;
        });
      }

      // Puertas "clicables": al pulsar una puerta se abre girando sobre una
      // bisagra (rotateY con perspectiva en .col-body), como una puerta real.
      // Se ignora el click si viene de arrastrar el scroll de la vista previa.
      var previewCaptureEl = document.getElementById('previewCapture');
      if (previewCaptureEl) {
        previewCaptureEl.addEventListener('click', function (e) {
          if (dragMoved > 6) return;
          var doorEl = e.target.closest('.door');
          if (!doorEl || !previewCaptureEl.contains(doorEl)) return;
          doorEl.classList.toggle('is-open');
        });
      }

      // En móvil, en vez de scroll horizontal, escalamos el dibujo para que
      // quepa entero en pantalla; si el usuario quiere ver detalle (puertas,
      // cotas) hace zoom táctil, no hace falta desplazarse por los lados.
      var MOBILE_BREAKPOINT = 768;
      var stage = document.getElementById('previewCapture');

      function fitPreviewToMobile() {
        if (!scroll || !stage) return;

        if (window.innerWidth > MOBILE_BREAKPOINT) {
          stage.style.transform = '';
          stage.style.transformOrigin = '';
          scroll.style.height = '';
          return;
        }

        stage.style.transform = 'none';
        var naturalWidth  = stage.scrollWidth;
        var naturalHeight = stage.scrollHeight;
        var availWidth    = scroll.clientWidth;
        var scale = availWidth > 0 && naturalWidth > 0 ? Math.min(1, availWidth / naturalWidth) : 1;

        stage.style.transformOrigin = 'top left';
        stage.style.transform = 'scale(' + scale + ')';
        scroll.style.height = (naturalHeight * scale) + 'px';
      }

      fitPreviewToMobile();
      window.addEventListener('resize', fitPreviewToMobile);
      window.addEventListener('orientationchange', fitPreviewToMobile);
    });

    const _saveUrl   = '{{ path('configuration_instalacion', { id: configuration.id }) }}';
    const _tableUrl  = '{{ path('configuration_product_table', { id: configuration.id }) }}';
    const _tableContainer = () => document.getElementById('productTableContainer');

    async function saveAndReloadFromIva() {
      const precioEl    = document.getElementById('instalacionPrecio');
      const ivaEl       = document.getElementById('ivaCheck');
      const discountEl  = document.getElementById('discountPct');
      const precio      = parseFloat(precioEl?.value) || 0;
      const iva         = ivaEl ? ivaEl.checked : false;
      const descuento   = discountEl ? (parseFloat(discountEl.value) || 0) : 0;
      await fetch(_saveUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ precio, iva, descuento })
      });
      const c = _tableContainer();
      if (c) {
        const html = await fetch(_tableUrl + '?_=' + Date.now()).then(r => r.text());
        c.innerHTML = html;
        bindIvaCheck();
        initProductTable();
      }
    }

    function bindIvaCheck() {}

    document.addEventListener('change', function (e) {
      console.log('change event', e.target?.id);
      if (e.target && e.target.id === 'ivaCheck') {
        saveAndReloadFromIva();
      }
    });
    console.log('IVA listener registered');

    function initProductTable() {
      const table = document.getElementById('productTable');
      if (!table) return;
      const ivaCheck    = document.getElementById('ivaCheck');
      const discountInp = document.getElementById('discountPct');
      if (!discountInp) return;

      function fmt(n) {
        return n.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
      }

      function recalc() {
        const subtotal      = parseFloat(table.dataset.subtotal) || 0;
        const pct           = Math.min(100, Math.max(0, parseFloat(discountInp.value) || 0));
        const iva           = ivaCheck ? ivaCheck.checked : false;
        const discount      = subtotal * pct / 100;
        const subtotalAfter = subtotal - discount;
        const total         = iva ? subtotalAfter * 1.21 : subtotalAfter;

        const rSub  = document.getElementById('rowSubtotal');
        const rDisc = document.getElementById('rowDiscount');
        const rIva  = document.getElementById('rowIva');

        if (rSub) {
          rSub.style.display = (iva || pct > 0) ? '' : 'none';
          document.getElementById('cellSubtotal').textContent = fmt(subtotal);
        }

        if (rDisc) {
          rDisc.style.display = pct > 0 ? '' : 'none';
          document.getElementById('discountPctLabel').textContent = pct % 1 === 0 ? pct : pct.toFixed(1);
          document.getElementById('cellDiscount').textContent = '−' + fmt(discount);
        }

        if (rIva) {
          rIva.style.display = iva ? '' : 'none';
          document.getElementById('cellIva').textContent = fmt(subtotalAfter * 0.21);
        }

        const lbl = document.getElementById('cellTotalLabel');
        if (lbl) lbl.textContent = (pct > 0 ? window.I18N_SUMMARY.total_with_discount : window.I18N_SUMMARY.total) + (iva ? window.I18N_SUMMARY.iva_included : window.I18N_SUMMARY.iva_excluded);
        document.getElementById('cellTotal').textContent = fmt(total);
      }

      let _discountTimer = null;
      discountInp.addEventListener('input', function() {
        recalc();
        clearTimeout(_discountTimer);
        _discountTimer = setTimeout(function() {
          if (typeof window.saveInstalacion === 'function') window.saveInstalacion();
        }, 800);
      });
      discountInp.addEventListener('change', function() {
        if (typeof window.saveInstalacion === 'function') window.saveInstalacion();
      });
      if (ivaCheck) ivaCheck.addEventListener('change', recalc);

      // ===== Líneas manuales (añadir a mano, sin producto asociado) =====
      const baseSubtotal = parseFloat(table.dataset.baseSubtotal) || 0;
      const linesUrl = '{{ path('configuration_manual_lines', { id: configuration.id }) }}';

      function collectManualLines() {
        return Array.from(table.querySelectorAll('.manual-line-row')).map(function (row) {
          return {
            descripcion: row.querySelector('.manual-line-desc').value,
            uds:         parseFloat(row.querySelector('.manual-line-uds').value) || 0,
            precio:      parseFloat(row.querySelector('.manual-line-precio').value) || 0
          };
        });
      }

      function recalcManualLines() {
        let manualTotal = 0;
        table.querySelectorAll('.manual-line-row').forEach(function (row) {
          const uds    = parseFloat(row.querySelector('.manual-line-uds').value) || 0;
          const precio = parseFloat(row.querySelector('.manual-line-precio').value) || 0;
          const lineTotal = uds * precio;
          manualTotal += lineTotal;
          row.querySelector('.manual-line-total').textContent = fmt(lineTotal);
        });
        table.dataset.subtotal = baseSubtotal + manualTotal;
        recalc();
      }

      function saveManualLines() {
        fetch(linesUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ lines: collectManualLines() })
        });
      }

      let _manualLinesTimer = null;
      function scheduleSaveManualLines() {
        clearTimeout(_manualLinesTimer);
        _manualLinesTimer = setTimeout(saveManualLines, 800);
      }

      table.addEventListener('input', function (e) {
        if (!e.target.classList.contains('manual-line-desc')
            && !e.target.classList.contains('manual-line-uds')
            && !e.target.classList.contains('manual-line-precio')) return;
        recalcManualLines();
        scheduleSaveManualLines();
      });

      table.addEventListener('click', function (e) {
        const delBtn = e.target.closest('.manual-line-delete');
        if (delBtn) {
          delBtn.closest('.manual-line-row').remove();
          recalcManualLines();
          saveManualLines();
        }
      });

      const btnAddManualLine = document.getElementById('btnAddManualLine');
      if (btnAddManualLine) {
        btnAddManualLine.addEventListener('click', function () {
          const tbody = table.querySelector('tbody');
          const addRow = document.getElementById('rowAddManualLine');
          const tr = document.createElement('tr');
          tr.className = 'manual-line-row';
          tr.innerHTML =
            '<td colspan="3" style="padding:6px 12px; border-bottom:1px solid rgba(15,23,42,.08);">' +
              '<input type="text" class="manual-line-desc" placeholder="' + window.I18N_SUMMARY.manual_line_description_placeholder + '" ' +
                'style="width:100%; border:1px solid rgba(15,23,42,.15); border-radius:6px; padding:5px 8px; font-size:13px;">' +
            '</td>' +
            '<td style="padding:6px 12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">' +
              '<input type="number" class="manual-line-uds" min="0" step="1" value="1" ' +
                'style="width:64px; text-align:right; border:1px solid rgba(15,23,42,.15); border-radius:6px; padding:5px 8px; font-size:13px;">' +
            '</td>' +
            '<td style="padding:6px 12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">' +
              '<input type="number" class="manual-line-precio" min="0" step="0.01" value="0" ' +
                'style="width:90px; text-align:right; border:1px solid rgba(15,23,42,.15); border-radius:6px; padding:5px 8px; font-size:13px;">' +
            '</td>' +
            '<td style="padding:6px 12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08); white-space:nowrap;">' +
              '<span class="manual-line-total" style="font-weight:900;">0,00 €</span>' +
              '<button type="button" class="manual-line-delete" style="margin-left:8px; border:0; background:transparent; color:#ef4444; cursor:pointer; font-weight:900; font-size:15px; line-height:1;">×</button>' +
            '</td>';
          tbody.insertBefore(tr, addRow);
          tr.querySelector('.manual-line-desc').focus();
          saveManualLines();
        });
      }

      recalc();
    }

    // Load product reference table via AJAX
    function loadProductTable() {
      const _productContainer = document.getElementById('productTableContainer');
      if (_productContainer) {
        fetch('{{ path('configuration_product_table', { id: configuration.id }) }}?_=' + Date.now())
          .then(function (r) { return r.text(); })
          .then(function (html) { _productContainer.innerHTML = html; initProductTable(); })
          .catch(function (e) { console.error('Error cargando referencias de producto:', e); });
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadProductTable);
    } else {
      loadProductTable();
    }

    window.addEventListener('DOMContentLoaded', function () {
      const btn = document.getElementById('btnIA');
      const status = document.getElementById('iaStatus');
      const node = document.getElementById('previewCapture');

      if (!btn || !status || !node) return;

      btn.addEventListener('click', async function () {
        status.style.display = 'inline';
        status.textContent = window.I18N_SUMMARY.generating;
        btn.disabled = true;

        try {
          const canvas = await html2canvas(node, { backgroundColor: '#ffffff', scale: 1 });
          const dataUrl = canvas.toDataURL('image/png');

          const prompt =
            `Genera un render realista del armario/taquillas basado en el esquema adjunto.
            - Color puertas: {{ doorColor|e('js') }}
            - Color cuerpo/bordes: {{ bodyColor|e('js') }}
            - Fondo: {{ bgLabel|e('js') }}
            - Ubicación: {{ placementLabel|e('js') }}
            - Material: {{ material|e('js') }}
            - Instalación: {{ instalacion|e('js') }}
            - Soporte: {{ selectedType|e('js') }} {{ selectedColor|e('js') }}
            Respeta el número de puertas y proporciones del esquema.`;

          const form = new FormData();
          form.append('prompt', prompt);
          form.append('preview_base64', dataUrl);

          const res = await fetch('{{ path("api_generar_imagen") }}', {
            method: 'POST',
            body: form
          });

          const text = await res.text();
          let json = null;

          try {
            json = JSON.parse(text);
          } catch (e) {
            console.error('Respuesta NO JSON del servidor:', text);
            alert(window.I18N_SUMMARY.non_json_response);
            return;
          }

          if (!res.ok) {
            alert(json.error || window.I18N_SUMMARY.image_generation_error);
            return;
          }

          const img = document.getElementById('resultadoIA');
          img.src = 'data:' + json.mime + ';base64,' + json.image_base64;
          img.style.display = 'block';

        } catch (e) {
          console.error(e);
          alert(window.I18N_SUMMARY.unexpected_error);
        } finally {
          status.style.display = 'none';
          btn.disabled = false;
        }
      });
    });
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const precioInput  = document.getElementById('instalacionPrecio');
      const statusEl     = document.getElementById('instalacionStatus');
      const saveUrl      = '{{ path('configuration_instalacion', { id: configuration.id }) }}';
      const tableUrl     = '{{ path('configuration_product_table', { id: configuration.id }) }}';
      const productContainer = document.getElementById('productTableContainer');

      function getIvaChecked() {
        const chk = document.getElementById('ivaCheck');
        return chk ? chk.checked : false;
      }

      async function saveInstalacion() {
        const precio     = parseFloat(precioInput?.value) || 0;
        const iva        = getIvaChecked();
        const discountEl = document.getElementById('discountPct');
        const descuento  = discountEl ? (parseFloat(discountEl.value) || 0) : 0;
        await fetch(saveUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ precio, iva, descuento })
        });
        if (statusEl) { statusEl.style.display = 'inline'; setTimeout(() => { statusEl.style.display = 'none'; }, 2000); }
      }

      async function saveAndReloadTable() {
        await saveInstalacion();
        if (productContainer) {
          const html = await fetch(tableUrl).then(r => r.text());
          productContainer.innerHTML = html;
          bindIvaCheck();
          initProductTable();
        }
      }

      window.saveAndReloadTable = saveAndReloadTable;
      window.saveInstalacion    = saveInstalacion;

      if (precioInput) {
        precioInput.addEventListener('change', saveAndReloadTable);
        precioInput.addEventListener('blur', saveAndReloadTable);
        let _debounceTimer = null;
        precioInput.addEventListener('input', function () {
          clearTimeout(_debounceTimer);
          _debounceTimer = setTimeout(saveAndReloadTable, 800);
        });
      }
    });

    document.addEventListener('DOMContentLoaded', function () {
      const btnPdf = document.getElementById('btnDescargarPdf');
      if (!btnPdf) return;

      btnPdf.addEventListener('click', async function () {
        const screenshotUrl = btnPdf.dataset.screenshotUrl;
        const pdfUrl        = btnPdf.dataset.pdfUrl;

        btnPdf.disabled = true;
        btnPdf.textContent = window.I18N_SUMMARY.generating;

        // Descargar el PDF cierra la configuración en el servidor: ocultamos
        // ya el botón de editar para que no se pueda modificar sin recargar
        // (el DOM no se refresca solo porque la descarga no navega la página).
        const btnEdit = document.getElementById('btnEditConfig');
        if (btnEdit) btnEdit.style.display = 'none';

        // Si el croquis está escalado (vista móvil), lo restauramos a tamaño
        // real para que la captura del PDF salga a resolución completa.
        const previewStageEl = document.getElementById('previewCapture');
        const prevStageTransform = previewStageEl ? previewStageEl.style.transform : '';
        if (previewStageEl) previewStageEl.style.transform = 'none';

        try {
          const groups = document.querySelectorAll('#previewCapture .group-block');
          if (groups.length > 0) {
            const hidden = [...document.querySelectorAll('#previewCapture .num, #previewCapture .badges')];
            hidden.forEach(el => el.style.visibility = 'hidden');

            const proxyBase = '/api/image-proxy?url=';
            const externalImgs = [...document.querySelectorAll('#previewCapture img')].filter(
              img => /^https?:\/\//.test(img.src)
            );
            const originalSrcs = externalImgs.map(img => img.src);
            externalImgs.forEach(img => { img.src = proxyBase + encodeURIComponent(img.src); });
            await Promise.all(externalImgs.map(img => img.complete ? Promise.resolve() : new Promise(r => { img.onload = r; img.onerror = r; })));

            const screenshots = [];
            for (const group of groups) {
              const prevPadding = group.style.padding;
              // top y right ampliados para no recortar el bisel de profundidad (fondo)
              group.style.padding = '42px 110px 100px 70px';
              const canvas = await html2canvas(group, {
                backgroundColor: '#ffffff',
                scale: Math.max(window.devicePixelRatio || 1, 3),
              });
              group.style.padding = prevPadding;
              screenshots.push(canvas.toDataURL('image/png'));
            }

            externalImgs.forEach((img, i) => { img.src = originalSrcs[i]; });

            hidden.forEach(el => el.style.visibility = '');

            await fetch(screenshotUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ screenshots })
            });
          }
        } catch (e) {
          console.warn('Screenshot failed, continuing without it:', e);
        } finally {
          if (previewStageEl) previewStageEl.style.transform = prevStageTransform;
        }

        window.location.href = pdfUrl;
        setTimeout(() => {
          btnPdf.disabled = false;
          btnPdf.textContent = window.I18N_SUMMARY.download_pdf;
        }, 2000);
      });
    });
  </script>

  {# ============================================================
     "Ver en RA" — funcionalidad totalmente aparte de "Ver en 3D".
     No comparte código con el visor 3D (solo lee los mismos datos
     de window.LOCKER_3D_DATA, que son datos, no comportamiento),
     así que un cambio aquí nunca puede romper el botón de 3D.
     Usa WebXR (de momento solo Android/Chrome; iOS no lo soporta).
     ============================================================ #}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const btnAR = document.getElementById('btnVerRA');
      if (!btnAR) return;

      // El botón empieza oculto (style="display:none" en el HTML) y solo
      // se muestra si el propio navegador confirma que soporta RA.
      if (navigator.xr && navigator.xr.isSessionSupported) {
        navigator.xr.isSessionSupported('immersive-ar').then(function (supported) {
          if (supported) btnAR.style.display = '';
        }).catch(function () {});
      }

      let threeLoadedForAR = false;
      function loadScriptAR(src) {
        return new Promise(function (resolve, reject) {
          const s = document.createElement('script');
          s.src = src;
          s.onload = resolve;
          s.onerror = reject;
          document.head.appendChild(s);
        });
      }
      function ensureThreeForAR() {
        if (threeLoadedForAR || (window.THREE && window.THREE.Group)) { threeLoadedForAR = true; return Promise.resolve(); }
        return loadScriptAR('https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js')
          .then(function () { threeLoadedForAR = true; });
      }

      function mmToM(mm) { return (mm || 0) / 1000; }

      // Construye el mueble (solo el mueble, sin suelo ni edificio) a
      // tamaño real en metros, a partir de los mismos datos que usa el
      // visor 3D normal. Es una versión simplificada a propósito: puertas
      // macizas (sin hueco interior ni apertura al pulsar), para que esta
      // parte sea ligera y no dependa de la lógica del otro visor.
      function buildARLocker() {
        const data = window.LOCKER_3D_DATA || { groups: [], doorColor: '#3a9efc', bodyColor: '#111', fondoMm: 400, doorWidthMm: 380 };
        // "root" es el grupo que se mueve/gira libremente al colocar la
        // taquilla en RA; "inner" lleva el centrado horizontal del mueble,
        // para que no se pierda cuando root.position se sobrescriba.
        const root = new THREE.Group();
        const inner = new THREE.Group();
        root.add(inner);

        const depth = mmToM(data.fondoMm || 400);
        arLockerDepthM = depth; // se usa luego para "pegar" el mueble a una pared detectada
        const colW  = mmToM(data.doorWidthMm || 380);
        const sideW = mmToM(25);
        const groupGap = mmToM(450);

        const doorMat = new THREE.MeshStandardMaterial({ color: data.doorColor || '#3a9efc', roughness: 0.6, metalness: 0.05 });
        const bodyMat = new THREE.MeshStandardMaterial({ color: data.bodyColor || '#111111', roughness: 0.7, metalness: 0.05 });
        const legMat  = new THREE.MeshStandardMaterial({ color: 0xc7c9cc, roughness: 0.5, metalness: 0.3 });
        const edgesMatAR = new THREE.LineBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.35 });

        // Igual que en el visor 3D: compone la imagen sobre un lienzo del
        // color de puerta y la aplica solo a la cara frontal (+z) de la
        // caja, mediante un array de 6 materiales por caja.
        const frontTextureMatsCacheAR = {};
        function makeFrontTextureMatsAR(imageUrl, heightMultiplier) {
          if (!imageUrl) return doorMat;
          const cacheKey = imageUrl + '|' + (heightMultiplier || 1);
          if (frontTextureMatsCacheAR[cacheKey]) return frontTextureMatsCacheAR[cacheKey];

          const frontMat = new THREE.MeshStandardMaterial({ color: data.doorColor || '#3a9efc', roughness: 0.4, metalness: 0.1 });
          const img = new Image();
          img.crossOrigin = 'anonymous';
          img.onload = function () {
            const size = 512;
            const canvas = document.createElement('canvas');
            canvas.width = size;
            canvas.height = size;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = data.doorColor || '#3a9efc';
            ctx.fillRect(0, 0, size, size);
            const scale = Math.min(size / img.width, size / img.height);
            const dw = img.width * scale;
            const dh = img.height * scale * (heightMultiplier || 1);
            ctx.drawImage(img, (size - dw) / 2, (size - dh) / 2, dw, dh);
            const texture = new THREE.CanvasTexture(canvas);
            frontMat.map = texture;
            frontMat.color.set(0xffffff);
            frontMat.needsUpdate = true;
          };
          img.src = imageUrl;

          const mats = [doorMat, doorMat, doorMat, doorMat, frontMat, doorMat];
          frontTextureMatsCacheAR[cacheKey] = mats;
          return mats;
        }

        const screenMatsAR = makeFrontTextureMatsAR(data.screenImageUrl);

        function mailboxImageUrlAR(blk) {
          const imgs = data.mailboxImages || {};
          if (blk.electronico) return blk.tarjetero ? imgs.elecTarj : imgs.elecNoTarj;
          return blk.tarjetero ? imgs.mecTarj : imgs.mecNoTarj;
        }

        function legPositionsForAR(n) {
          if (n === 1) return [1];
          if (n === 2) return [1, 2];
          if (n === 3) return [1, 3];
          if (n === 4) return [2, 3];
          if (n === 5) return [2, 4];
          if (n === 6) return [2, 4, 6];
          if (n === 7) return [2, 4, 6, 7];
          if (n === 8) return [2, 4, 6, 8];
          if (n === 9) return [2, 4, 7, 8];
          return [2, 4, 7, 9];
        }

        function addBoxAR(w, h, d, mat, x, y, z) {
          const geo = new THREE.BoxGeometry(w, h, d);
          const mesh = new THREE.Mesh(geo, mat);
          mesh.position.set(x, y, z);
          inner.add(mesh);
          // Contorno negro fino: sin esto, puertas del mismo color quedan
          // pegadas visualmente sin distinguirse unas de otras.
          const line = new THREE.LineSegments(new THREE.EdgesGeometry(geo), edgesMatAR);
          line.position.copy(mesh.position);
          inner.add(line);
          return mesh;
        }

        const legsApply = !!(data.isSoporteSuelo && (data.bracketType === 'patas' || data.bracketType === 'brazos'));
        const legHeight = mmToM(700);
        const baseY = legsApply ? legHeight : 0;

        let cursorX = 0;
        let maxHeight = 0;
        const groups = Array.isArray(data.groups) ? data.groups : [];

        groups.forEach(function (cols3d) {
          if (!Array.isArray(cols3d) || cols3d.length === 0) return;
          const numCols = cols3d.length;
          const groupWidth = numCols * colW + sideW * 2;
          const groupStartX = cursorX;

          cols3d.forEach(function (doorBlocks, colIdx) {
            const blocks = Array.isArray(doorBlocks) ? doorBlocks : [];
            const colTotalH = blocks.reduce(function (s, b) { return s + mmToM(b.h || 125); }, 0);
            let cursorY = colTotalH;
            blocks.forEach(function (blk) {
              const h = mmToM(blk.h || 125);
              cursorY -= h;
              const cx = groupStartX + sideW + colIdx * colW + colW / 2;
              const cy = cursorY + h / 2 + baseY;
              let blockMat = doorMat;
              if (blk.type === 'screen') {
                blockMat = screenMatsAR;
              } else if (blk.type === 'mailbox') {
                blockMat = makeFrontTextureMatsAR(mailboxImageUrlAR(blk), 2);
              }
              addBoxAR(colW - 0.004, h - 0.004, depth - 0.02, blockMat, cx, cy, depth / 2);
            });
            if (colTotalH > maxHeight) maxHeight = colTotalH;
          });

          const totalHeightWithRoof = maxHeight + sideW;
          addBoxAR(sideW, totalHeightWithRoof, depth, bodyMat, groupStartX + sideW / 2, baseY + totalHeightWithRoof / 2, depth / 2);
          addBoxAR(sideW, totalHeightWithRoof, depth, bodyMat, groupStartX + groupWidth - sideW / 2, baseY + totalHeightWithRoof / 2, depth / 2);
          addBoxAR(groupWidth, sideW, depth, bodyMat, groupStartX + groupWidth / 2, baseY + totalHeightWithRoof - sideW / 2, depth / 2);
          addBoxAR(groupWidth, mmToM(10), depth, bodyMat, groupStartX + groupWidth / 2, baseY + mmToM(5), depth / 2);

          if (legsApply) {
            const legSize = mmToM(40) * 1.5 * 1.2;
            const addLegAR = function (x) {
              addBoxAR(legSize, legHeight, legSize, legMat, x, legHeight / 2, depth / 2);
            };
            if (data.bracketType === 'patas') {
              legPositionsForAR(numCols).forEach(function (pos) {
                addLegAR(groupStartX + sideW + (pos - 1) * colW + colW / 2);
              });
            } else {
              addLegAR(groupStartX + sideW / 2);
              addLegAR(groupStartX + groupWidth - sideW / 2);
              if (numCols >= 5) {
                legPositionsForAR(numCols).forEach(function (pos) {
                  addLegAR(groupStartX + sideW + (pos - 1) * colW + colW / 2);
                });
              }
            }
          }

          cursorX = groupStartX + groupWidth + groupGap;
        });

        // Centra el mueble sobre el punto donde el usuario toque la
        // pantalla (si no, se colocaría con la esquina ahí).
        const totalWidth = Math.max(cursorX - groupGap, colW);
        inner.position.x = -totalWidth / 2;

        return root;
      }

      let arRenderer = null, arScene = null, arCamera = null, arReticle = null, arLockerGroup = null;
      let arHitTestSource = null, arSession = null, arPlaced = false;
      let arLockerDepthM = 0;
      let arPlaneDetectionOn = false;
      // Última colocación calculada cada frame (posición + giro en Y). Tanto
      // el seguimiento en vivo como el toque de confirmación usan estos
      // mismos valores, así no hay que repetir el cálculo en el evento
      // "select" (que no recibe el XRFrame directamente).
      let arPendingPos = null;
      let arPendingRotY = 0;
      // Posición/rotación suavizadas que realmente se aplican cada frame
      // mientras se sigue la retícula: sin esto, la detección del suelo
      // "tiembla" frame a frame y cuesta mucho fijar la taquilla justo
      // donde se quiere.
      let arSmoothedPos = null;
      let arSmoothedRotY = 0;
      const AR_SMOOTH_FACTOR = 0.18;
      // Pequeño desplazamiento/giro manual aplicado con los botones, para
      // poder afinar la colocación una vez fijada (por si el suelo
      // detectado no queda exactamente donde se quiere).
      const AR_NUDGE_STEP_M = 0.04;
      const AR_NUDGE_STEP_ROT = 5 * Math.PI / 180;
      // Busca, entre los planos verticales detectados (paredes), el más
      // cercano al punto del suelo tocado. Si hay uno cerca, la taquilla se
      // coloca pegada a esa pared y orientada hacia afuera en vez de mirar
      // sin más hacia la cámara.
      function findNearbyWall(frame, referenceSpace, floorPos) {
        if (!arPlaneDetectionOn || !frame.detectedPlanes) return null;

        let best = null;
        frame.detectedPlanes.forEach(function (plane) {
          if (plane.orientation !== 'Vertical') return;
          const planePose = frame.getPose(plane.planeSpace, referenceSpace);
          if (!planePose) return;

          const p = planePose.transform.position;
          const dx = p.x - floorPos.x;
          const dz = p.z - floorPos.z;
          const dist = Math.sqrt(dx * dx + dz * dz);
          if (dist < 1.5 && (!best || dist < best.dist)) {
            best = { pose: planePose, dist: dist };
          }
        });
        return best;
      }

      // Posiciona y orienta la taquilla sobre el punto detectado: si hay una
      // pared cerca, se pega a ella (de espaldas); si no, gira sobre el eje Y
      // para que la fachada mire hacia la cámara.
      function computePlacement(frame, referenceSpace, floorPos) {
        const wall = findNearbyWall(frame, referenceSpace, floorPos);

        if (wall) {
          const o = wall.pose.transform.orientation;
          const wallQuat = new THREE.Quaternion(o.x, o.y, o.z, o.w);
          // En un XRPlane, el eje Y local del "planeSpace" es la normal del
          // plano. La proyectamos sobre el suelo (ignorando su componente Y)
          // para quedarnos solo con la dirección horizontal hacia la sala.
          let normal = new THREE.Vector3(0, 1, 0).applyQuaternion(wallQuat);
          normal.y = 0;
          if (normal.lengthSq() < 0.0001) return { pos: floorPos.clone(), rotY: arPendingRotY };
          normal.normalize();

          const wallPos = new THREE.Vector3(wall.pose.transform.position.x, 0, wall.pose.transform.position.z);
          const hitXZ = new THREE.Vector3(floorPos.x, 0, floorPos.z);
          const distAlongNormal = hitXZ.clone().sub(wallPos).dot(normal);
          // Punto del toque proyectado sobre la línea de la pared, y luego
          // empujado hacia la sala la mitad del fondo del mueble, para que
          // su parte de atrás quede pegada a la pared.
          const onWall = hitXZ.clone().sub(normal.clone().multiplyScalar(distAlongNormal));
          const finalXZ = onWall.add(normal.clone().multiplyScalar(arLockerDepthM / 2));

          return {
            pos: new THREE.Vector3(finalXZ.x, floorPos.y, finalXZ.z),
            rotY: Math.atan2(normal.x, normal.z),
            snapped: true
          };
        }

        const camPos = new THREE.Vector3();
        arCamera.getWorldPosition(camPos);
        const dx = camPos.x - floorPos.x;
        const dz = camPos.z - floorPos.z;
        return { pos: floorPos.clone(), rotY: Math.atan2(dx, dz), snapped: false };
      }

      // Suaviza el valor nuevo hacia el anterior (interpolación exponencial),
      // en vez de saltar directamente al último resultado del hit-test.
      function smoothAngle(prev, next, factor) {
        let diff = next - prev;
        while (diff > Math.PI) diff -= Math.PI * 2;
        while (diff < -Math.PI) diff += Math.PI * 2;
        return prev + diff * factor;
      }

      function applyPendingPlacement() {
        if (!arPendingPos || !arLockerGroup) return;
        if (!arSmoothedPos) {
          arSmoothedPos = arPendingPos.clone();
          arSmoothedRotY = arPendingRotY;
        } else {
          arSmoothedPos.lerp(arPendingPos, AR_SMOOTH_FACTOR);
          arSmoothedRotY = smoothAngle(arSmoothedRotY, arPendingRotY, AR_SMOOTH_FACTOR);
        }
        arLockerGroup.position.copy(arSmoothedPos);
        arLockerGroup.rotation.y = arSmoothedRotY;
        arLockerGroup.visible = true;
      }

      function onARSelect() {
        if (!arReticle || !arReticle.visible || !arPendingPos) return;
        // Un solo toque: la taquilla ya se ve siguiendo el suelo en vivo
        // (posición y orientación), así que tocar la pantalla simplemente
        // la fija donde está en ese momento.
        arPlaced = true;
        applyPendingPlacement();
        setARStatus('Taquilla colocada. Usa los botones para afinarla si hace falta.');
        showARAdjustControls(true);
      }

      // Mueve la taquilla ya colocada relativa a hacia dónde mira la cámara
      // (adelante/atrás/lateral), no en ejes absolutos del mundo: así los
      // botones siempre se comportan igual sin importar cómo esté girada.
      function nudgeARLocker(rightAmount, forwardAmount) {
        if (!arLockerGroup || !arCamera) return;
        const forward = new THREE.Vector3(0, 0, -1).applyQuaternion(arCamera.quaternion);
        forward.y = 0;
        if (forward.lengthSq() < 0.0001) return;
        forward.normalize();
        const right = new THREE.Vector3(forward.z, 0, -forward.x);
        arLockerGroup.position.addScaledVector(forward, forwardAmount * AR_NUDGE_STEP_M);
        arLockerGroup.position.addScaledVector(right, rightAmount * AR_NUDGE_STEP_M);
        // El ajuste manual debe persistir: si no se sincroniza aquí, el
        // siguiente toque en pantalla (re-colocar) partiría del valor
        // suavizado antiguo, deshaciendo el ajuste.
        if (arSmoothedPos) arSmoothedPos.copy(arLockerGroup.position);
      }

      function nudgeARRotation(sign) {
        if (!arLockerGroup) return;
        arLockerGroup.rotation.y += sign * AR_NUDGE_STEP_ROT;
        arSmoothedRotY = arLockerGroup.rotation.y;
      }

      // Vuelve a modo "siguiendo la retícula", para colocar la taquilla en
      // otro punto sin tener que salir y reabrir la RA.
      function reposicionarARLocker() {
        arPlaced = false;
        arSmoothedPos = null;
        if (arLockerGroup) arLockerGroup.visible = false;
        showARAdjustControls(false);
        setARStatus('Mueve el móvil despacio apuntando al suelo…');
      }

      function onARFrame(timestamp, frame) {
        try {
          if (frame) {
            const referenceSpace = arRenderer.xr.getReferenceSpace();
            if (arHitTestSource) {
              const hits = frame.getHitTestResults(arHitTestSource);
              if (hits.length > 0) {
                const pose = hits[0].getPose(referenceSpace);
                arReticle.visible = true;
                arReticle.matrix.fromArray(pose.transform.matrix);
                const floorPos = new THREE.Vector3().setFromMatrixPosition(arReticle.matrix);

                const placement = computePlacement(frame, referenceSpace, floorPos);
                arPendingPos = placement.pos;
                arPendingRotY = placement.rotY;

                // Hasta que el usuario toque la pantalla, la taquilla va
                // "siguiendo" la retícula en vivo (posición y giro), como
                // vista previa; el retículo cambia de color cuando detecta
                // una pared cerca y va a pegar la taquilla a ella.
                if (!arPlaced) {
                  arReticle.material.color.set(placement.snapped ? 0x4aa3ff : 0x44c767);
                  applyPendingPlacement();
                  setARStatus(placement.snapped
                    ? 'Pared detectada: toca la pantalla para pegar la taquilla aquí.'
                    : 'Toca la pantalla para fijar la taquilla aquí.');
                }
              } else {
                arReticle.visible = false;
                if (!arPlaced) {
                  arLockerGroup.visible = false;
                  setARStatus('Buscando superficie… mueve el móvil despacio apuntando al suelo.');
                }
              }
            }
          }
          arRenderer.render(arScene, arCamera);
        } catch (err) {
          console.error('Error en el frame de RA:', err);
          setARStatus('Error en RA: ' + (err && err.message ? err.message : err));
        }
      }

      function onAREnd() {
        if (arRenderer) {
          arRenderer.setAnimationLoop(null);
          if (arRenderer.domElement && arRenderer.domElement.parentNode) {
            arRenderer.domElement.parentNode.removeChild(arRenderer.domElement);
          }
        }
        if (arStatusEl && arStatusEl.parentNode) {
          arStatusEl.parentNode.removeChild(arStatusEl);
        }
        arStatusEl = null;
        arHitTestSource = null;
        arSession = null;
        arRenderer = null;
        arScene = null;
        arCamera = null;
        arReticle = null;
        arLockerGroup = null;
        arPlaced = false;
        arPlaneDetectionOn = false;
        arPendingPos = null;
        arPendingRotY = 0;
        arSmoothedPos = null;
        arSmoothedRotY = 0;
        arStatusTextEl = null;
        arControlsEl = null;
      }

      let arStatusEl = null;
      let arStatusTextEl = null;
      let arControlsEl = null;
      function setARStatus(text) {
        if (arStatusTextEl) arStatusTextEl.textContent = text;
      }
      function showARAdjustControls(show) {
        if (arControlsEl) arControlsEl.style.display = show ? 'flex' : 'none';
      }

      function startAR() {
        arPlaced = false;
        arSmoothedPos = null;
        arSmoothedRotY = 0;

        // Raíz del "dom-overlay": todo lo que necesite recibir toques
        // durante la sesión de RA (texto de estado + botones) tiene que
        // vivir dentro de este elemento.
        arStatusEl = document.createElement('div');
        arStatusEl.style.cssText = 'position:fixed;left:0;right:0;bottom:0;top:0;z-index:2001;pointer-events:none;';

        arStatusTextEl = document.createElement('div');
        arStatusTextEl.style.cssText = 'position:fixed;left:0;right:0;bottom:120px;' +
          'text-align:center;color:#fff;font:600 15px/1.4 sans-serif;' +
          'text-shadow:0 1px 4px rgba(0,0,0,.9);pointer-events:none;padding:0 16px;';
        arStatusEl.appendChild(arStatusTextEl);

        // Botones de ajuste manual: mover (adelante/atrás/lateral), girar
        // y "reubicar" (volver a modo seguimiento). Ocultos hasta que la
        // taquilla esté colocada por primera vez.
        function arBtn(label) {
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = label;
          b.style.cssText = 'pointer-events:auto;width:52px;height:52px;border-radius:50%;' +
            'border:1px solid rgba(255,255,255,.6);background:rgba(20,20,20,.55);' +
            'color:#fff;font-size:20px;line-height:1;';
          return b;
        }
        arControlsEl = document.createElement('div');
        arControlsEl.style.cssText = 'position:fixed;left:0;right:0;bottom:24px;z-index:2002;' +
          'display:none;flex-direction:column;align-items:center;gap:10px;pointer-events:none;';

        const moveRow = document.createElement('div');
        moveRow.style.cssText = 'display:flex;gap:10px;';
        const btnLeft = arBtn('◀'), btnFwd = arBtn('▲'), btnBack = arBtn('▼'),
          btnRight = arBtn('▶'), btnRotL = arBtn('⟲'), btnRotR = arBtn('⟳');
        [btnRotL, btnLeft, btnBack, btnFwd, btnRight, btnRotR].forEach(function (b) { moveRow.appendChild(b); });

        const resetRow = document.createElement('div');
        resetRow.style.cssText = 'display:flex;justify-content:center;';
        const btnReplace = arBtn('');
        btnReplace.title = 'Volver a colocar';
        btnReplace.style.width = 'auto';
        btnReplace.style.borderRadius = '20px';
        btnReplace.style.padding = '10px 18px';
        btnReplace.textContent = 'Reubicar';
        resetRow.appendChild(btnReplace);

        arControlsEl.appendChild(moveRow);
        arControlsEl.appendChild(resetRow);
        arStatusEl.appendChild(arControlsEl);

        btnLeft.addEventListener('click', function () { nudgeARLocker(-1, 0); });
        btnRight.addEventListener('click', function () { nudgeARLocker(1, 0); });
        btnFwd.addEventListener('click', function () { nudgeARLocker(0, 1); });
        btnBack.addEventListener('click', function () { nudgeARLocker(0, -1); });
        btnRotL.addEventListener('click', function () { nudgeARRotation(1); });
        btnRotR.addEventListener('click', function () { nudgeARRotation(-1); });
        btnReplace.addEventListener('click', reposicionarARLocker);

        setARStatus('Cargando…');
        document.body.appendChild(arStatusEl);

        ensureThreeForAR().then(function () {
          setARStatus('Iniciando cámara…');
          arScene = new THREE.Scene();
          arCamera = new THREE.PerspectiveCamera();

          const light = new THREE.HemisphereLight(0xffffff, 0x555555, 1);
          arScene.add(light);
          const dirLight = new THREE.DirectionalLight(0xffffff, 0.9);
          dirLight.position.set(0.5, 1, 0.8);
          arScene.add(dirLight);
          const dirLight2 = new THREE.DirectionalLight(0xffffff, 0.35);
          dirLight2.position.set(-0.6, 0.4, -0.5);
          arScene.add(dirLight2);

          arLockerGroup = buildARLocker();
          arLockerGroup.visible = false;
          arScene.add(arLockerGroup);

          arReticle = new THREE.Mesh(
            new THREE.RingGeometry(0.08, 0.1, 32).rotateX(-Math.PI / 2),
            new THREE.MeshBasicMaterial({ color: 0x44c767 })
          );
          arReticle.matrixAutoUpdate = false;
          arReticle.visible = false;
          arScene.add(arReticle);

          arRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
          arRenderer.setPixelRatio(window.devicePixelRatio || 1);
          arRenderer.setSize(window.innerWidth, window.innerHeight);
          arRenderer.setClearColor(0x000000, 0);
          arRenderer.xr.enabled = true;
          arRenderer.domElement.style.position = 'fixed';
          arRenderer.domElement.style.top = '0';
          arRenderer.domElement.style.left = '0';
          arRenderer.domElement.style.zIndex = '2000';
          document.body.appendChild(arRenderer.domElement);

          return navigator.xr.requestSession('immersive-ar', {
            requiredFeatures: ['hit-test'],
            optionalFeatures: ['dom-overlay', 'plane-detection'],
            domOverlay: { root: arStatusEl }
          });
        }).then(function (session) {
          arSession = session;
          // "plane-detection" es opcional: si el dispositivo/navegador no la
          // soporta, frame.detectedPlanes vendrá vacío/indefinido y
          // findNearbyWall() simplemente no encontrará paredes (se sigue
          // usando el punto del suelo mirando a la cámara, como antes).
          arPlaneDetectionOn = typeof session.enabledFeatures === 'undefined'
            || session.enabledFeatures.includes('plane-detection');
          session.addEventListener('end', onAREnd);
          session.addEventListener('select', onARSelect);

          arRenderer.xr.setReferenceSpaceType('local');
          return arRenderer.xr.setSession(session).then(function () {
            return session.requestReferenceSpace('viewer');
          });
        }).then(function (viewerSpace) {
          return arSession.requestHitTestSource({ space: viewerSpace });
        }).then(function (hitTestSource) {
          arHitTestSource = hitTestSource;
          setARStatus('Mueve el móvil despacio apuntando al suelo…');
          arRenderer.setAnimationLoop(onARFrame);
        }).catch(function (err) {
          console.error('No se pudo iniciar la Realidad Aumentada:', err);
          setARStatus('Error al iniciar RA: ' + (err && err.message ? err.message : err));
          setTimeout(onAREnd, 4000);
        });
      }

      btnAR.addEventListener('click', startAR);
    });
  </script>
{% endblock %}