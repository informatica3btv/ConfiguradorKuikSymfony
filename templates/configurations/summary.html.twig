{% extends 'layout.html.twig' %}

{% set p = payload ?? {} %}
{% if p is not iterable %}{% set p = {} %}{% endif %}

{% set groups = p.groups ?? [] %}
{% if groups is not iterable %}{% set groups = [] %}{% endif %}

{% set columnsFlat = p.columns ?? [] %}
{% if columnsFlat is not iterable %}{% set columnsFlat = [] %}{% endif %}

{% if groups is empty and columnsFlat is not empty %}
  {% set groups = [columnsFlat] %}
{% endif %}

{% set columnsAll = [] %}
{% for g in groups %}
  {% if g is iterable %}
    {% set columnsAll = columnsAll|merge(g) %}
  {% endif %}
{% endfor %}

{% set type = p.type ?? '' %}
{% set instalacion = p.instalacion ?? '' %}

{% set doorColor = p.colorDoor ?? '#3a9efc' %}
{% set doorColorRal = p.colorDoorRal ?? '' %}
{% set bodyColor = p.colorBody ?? '#000' %}
{% set bodyColorRal = p.colorBodyRal ?? '' %}

{% set bg = p.fondo ?? '' %}
{% set placement = p.placement ?? '' %}
{% set material = p.material ?? '' %}
{% set addons = p.addons ?? {} %}

{% set isHome = (type == 'home') %}
{% set isHomeSerie400 = isHome and bg == '400' %}
{% set fondoMm = isHomeSerie400 ? 403 : (kuik.fondo_mm[bg] ?? null) %}
{% set isZocalo = (isHome and instalacion == 'zocalo') %}
{% set isEmpotradoLike = (isHome and (instalacion == 'empotrado' or instalacion == 'soporte_suelo' or instalacion == 'colgado')) %}

{% set topCap = isZocalo ? (p.topCap|default(kuik.default_top_cap)) : kuik.default_top_cap %}
{% set bottomCap = isZocalo ? 70 : kuik.default_bottom_cap %}
{% set singleCap = isEmpotradoLike ? (p.singleCap|default(40)) : kuik.default_single_cap %}

{% set selectedType  = p.bracketType ?? '' %}
{% set selectedColor = p.bracketColor ?? '' %}
{% set isSoporteSuelo = (instalacion == 'soporte_suelo') %}
{% set mbLegPos = p.mbLegPositions ?? [] %}
{% if mbLegPos is not iterable %}{% set mbLegPos = [] %}{% endif %}
{% set mbLegPosSelected = mbLegPos|length > 0 ? mbLegPos[0] : null %}
{# Para patas: posiciones automáticas según mbCols (se calcula al renderizar cada grupo) #}

{% set bgLabel =
  bg == '300'  ? 'Serie 300' :
  bg == '400'  ? 'Serie 400' :
  bg == '500'  ? 'Serie 500' : '—'
%}

{# ========================================================
   Datos para la vista 3D (ver botón "Ver en 3D" más abajo).
   Reconstruye, de forma simplificada, la geometría a partir
   del mismo payload que usa el dibujo 2D: una lista de grupos,
   cada uno con sus columnas, y cada columna con sus puertas
   (altura real en mm de cada una).
   ======================================================== #}
{% set groups3d = [] %}
{% for groupCols in groups %}
  {% if groupCols is not iterable %}{% set groupCols = [] %}{% endif %}
  {% set cols3d = [] %}
  {% for col in groupCols %}
    {% set isColEmpotrado = (col.single is defined and col.single is not empty) %}
    {% if isColEmpotrado %}
      {% set srcBlocks = col.single.blocks_prepared ?? col.single.blocks ?? [] %}
    {% else %}
      {% set srcBlocks = (col.top.blocks_prepared ?? col.top.blocks ?? [])|merge(col.bottom.blocks_prepared ?? col.bottom.blocks ?? []) %}
    {% endif %}
    {% set doorBlocks = [] %}
    {% for blk in srcBlocks %}
      {% set hh = blk.h|default(blk) %}
      {# Fórmula lineal (igual que el dibujo 2D de cada puerta), no la tabla
         real h_heights_mm: así, dos columnas con el mismo número de
         unidades H siempre miden lo mismo en el 3D/RA, sin huecos raros
         entre columnas. El 3D/RA no muestra medidas, así que no hace
         falta el valor exacto del catálogo aquí. #}
      {% set hmm = hh * kuik.h_unit_mm %}
      {% set btype = blk.type|default('door') %}
      {% set doorBlocks = doorBlocks|merge([{
        'h': hmm,
        'type': btype,
        'electronico': blk.electronico ?? false,
        'tarjetero': blk.tarjetero ?? false,
        'methacrylate': blk.methacrylate ?? false
      }]) %}
    {% endfor %}
    {% set cols3d = cols3d|merge([doorBlocks]) %}
  {% endfor %}
  {% set groups3d = groups3d|merge([cols3d]) %}
{% endfor %}

{# Ancho de columna (mm) según la serie de fondo, y alto de la agrupación (125 por cada H10) #}
{% set colWidthLabel = isHomeSerie400 ? 380 : (bg in ['300', '400', '500'] ? bg : null) %}
{% set groupWidthExtraMm = 50 %}
{% set totalHUnits = isEmpotradoLike ? singleCap : (topCap + bottomCap) %}
{% set groupHeightLabel = kuik.h_heights_mm[totalHUnits] is defined ? kuik.h_heights_mm[totalHUnits] : (totalHUnits / 10 * 125)|round %}
{% if isZocalo %}
  {% set groupHeightLabel = groupHeightLabel + 177 %}
{% endif %}
{% set groupHeightPx = totalHUnits * kuik.scale %}

{% set placementLabel =
  placement == 'interior' ? 'Interior' :
  placement == 'exterior' ? 'Exterior' : '—'
%}

{% block page_title %}{{ 'summary.page_title'|trans }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --hscale: {{ kuik.scale }};

      --bg:#f6f9fc;
      --ink:#0b1220;
      --muted:#6b7280;
      --line: rgba(15,23,42,.12);
      --shadow: 0 10px 25px rgba(2,20,60,.10);
      --shadow-sm: 0 6px 14px rgba(2,20,60,.10);

      --kuik-blue-900:#003b73;
      --kuik-blue-600:#0b76d8;
      --kuik-blue-500:#1187e6;
    }

    .page-wrap{
      max-width: 100%;
      margin: 22px auto 50px;
      padding: 0 14px;
    }

    .page-head{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:14px;
      flex-wrap:wrap;
      margin-bottom:14px;
    }

    .page-title{
      margin:0;
      font-size:34px;
      font-weight:900;
      letter-spacing:-0.02em;
    }

    .page-sub{
      margin-top:6px;
      color:var(--muted);
      font-size:15px;
      display:flex;
      align-items:center;
      gap:10px;
      flex-wrap:wrap;
    }

    .grid{
      display:grid;
      grid-template-columns: 1.35fr .75fr;
      gap:14px;
      align-items:start;
    }
    @media (max-width: 980px){
      .grid{ grid-template-columns: 1fr; }
    }

    .card{
      background:#fff;
      border:1px solid var(--line);
      min-width: 0;
      border-radius:16px;
      padding:16px;
      box-shadow: 0 1px 0 rgba(15,23,42,.04);
    }

    .card h3{
      margin:0 0 12px;
      font-size:16px;
      font-weight:900;
      letter-spacing:-0.01em;
    }

    .section-sep{
      height:1px;
      background: rgba(15,23,42,.10);
      margin:14px 0;
    }

    .kvs{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:10px;
    }

    .kv{
      border:1px solid rgba(15,23,42,.10);
      border-radius:14px;
      padding:10px 12px;
      background:#fbfcfe;
    }
    .kv .k{ font-size:12px; color:var(--muted); font-weight:900; }
    .kv .v{ font-size:14px; font-weight:900; margin-top:4px; color:var(--ink); }

    .preview-wrap{
      border:1px solid rgba(15,23,42,.10);
      border-radius:16px;
      padding:12px;
      overflow: visible;
      min-width: 0;
      display:flex;
      align-items:flex-start;
      gap:16px;
    }

    .preview-scroll{
      overflow-x: auto;
      padding-bottom: 8px;
      cursor: grab;
      user-select: none;
      flex: 1 1 auto;
      min-width: 0;
    }

    .preview-scroll.is-dragging{
      cursor: grabbing;
    }

    /* Bisel de profundidad (fondo) integrado en el propio dibujo del mueble.
       Se usa transform:skew (bien soportado por html2canvas) en vez de
       clip-path/filter (mal soportados: se veían planos en la captura del PDF). */
    .depth-top{
      position:absolute;
      top:-30px;
      left:0px;
      width:100%;
      height:25px;
      background: linear-gradient(rgba(255,255,255,.25), rgba(255,255,255,.25)), var(--col-border);
      transform-origin: left bottom;
      transform: skewX(-49deg);
      z-index:1;
    }
    .depth-right{
      position:absolute;
      top:-5px;
      left:100%;
      width:29px;
      height: 101.1%;
      background: linear-gradient(rgba(0,0,0,.2), rgba(0,0,0,.2)), var(--col-border);
      transform-origin: left top;
      transform: skewY(-41deg);
      z-index:1;
    }
    .depth-label{
      position:absolute;
      right:-48px;
      bottom:-4px;
      display:flex;
      flex-direction:column;
      align-items:center;
      transform: rotate(-41deg);
      transform-origin: right center;
      z-index:4;
    }
    .depth-label .dim-row{
      width:50px;
    }
    .depth-label .dim-value{
      white-space:nowrap;
    }

    .preview-stage{
      position: relative;
      overflow: visible;
      display:flex;
      justify-content:flex-start;
      align-items:flex-start;
      padding-bottom: 175px;
      width: max-content;
      min-width: 100%;
    }

    .groups-stage{
      display:flex;
      flex-direction:column;
      gap:155px;
      align-items:center;
      width: max-content;
    }

    .group-label{
      font-weight:900;
      color:#0b1220;
      font-size:14px;
      margin:6px 0 20px;
      text-align:center;
    }

    .cols-and-mb{
      position:relative;
      display:flex;
      flex-direction:row;
      align-items:flex-start;
      gap:0;
    }

    .cols{
      display:grid;
      grid-template-columns: repeat(var(--colsN), 135px);
      justify-content:center;
      align-items:flex-start;
      margin-top:-5px;
    }

    .col-shell{
      width:{{ kuik.col_width_px }}px;
      display:flex;
      flex-direction:column;
      gap:6px;
    }

    .col-card{
      width:{{ kuik.col_width_px }}px;
      border-style:solid;
      border-color: var(--col-border, #000);
      border-left-width:4px;
      border-right-width:4px;
      border-top-width:8px;
      border-bottom-width:8px;
      overflow:visible;
      background:#f7f7f7;
      box-shadow: var(--shadow);
      position: relative;
      z-index: 2;
    }

    /* Grupo de buzones: bloque único con un solo borde exterior */
    .mb-group-block {
      display: flex;
      flex-direction: row;
      border-style: solid;
      border-color: var(--col-border, #000);
      border-left-width: 4px;
      border-right-width: 4px;
      border-top-width: 8px;
      border-bottom-width: 8px;
      overflow: visible;
      //box-shadow: var(--shadow);
      position: relative;
      z-index: 2;
    }
    .mb-group-col {
      width: {{ kuik.mb_col_width_px }}px;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
    }
    .mb-group-col .door.mailbox {
      border: none;
      border-radius: 0;
    }

    .col-body{
      height:calc(180px * var(--hscale));
      background:#eaeaea;
      display:flex;
      flex-direction:column;
    }

    .col-half{
      height:calc(90px * var(--hscale));
      display:flex;
      flex-direction:column;
      overflow:visible;
    }

    .half-sep{
      border-top:2px dashed rgba(0,0,0,.28);
    }

    {% set huecoTintedUrl = tinted_image('assets/hueco6.png', bodyColor) %}
    .door{
      width:100%;
      /* Compartimento vacío que se intuye al abrir la puerta: foto real de
         un hueco (esquina + suelo), ya pre-teñida del color del cuerpo como
         PNG generado una vez por color (ver TintedImageService) — así se ve
         igual en el navegador y en la captura que hace html2canvas para el
         PDF (background-blend-mode no vale ahí, no lo soporta). */
      background: url('{{ huecoTintedUrl ?? asset('assets/hueco6.png') }}') center top / 100% 100% no-repeat, var(--col-border, #22262b);
      border-bottom: 1px solid rgba(0,0,0,.35);
      position:relative;
      box-sizing: border-box;
      cursor:pointer;
      z-index:1;
      perspective: 1400px;
    }

    /* .door = ranura estática (siempre con su tamaño/posición real, así se
       puede pulsar para cerrar aunque la hoja esté girada casi de perfil).
       .door-leaf = la hoja que realmente gira sobre la bisagra. */
    .door-leaf{
      width:100%;
      height:100%;
      display:flex;
      align-items:center;
      justify-content:center;
      position:relative;
      z-index:2;
      box-sizing: border-box;
      border:1px solid rgba(255,255,255,.6);
      background: var(--door-color, #3a9efc);
      transform-style: preserve-3d;
      transform-origin: right center;
      backface-visibility: hidden;
      transition: transform .55s cubic-bezier(.34,1.15,.64,1), box-shadow .55s ease;
      will-change: transform;
    }

    /* Canto/borde de la puerta en el lado que barre al abrirse (el
       contrario a la bisagra): da sensación de grosor real. */
    .door-leaf::before{
      content:"";
      position:absolute;
      top:0; left:0; bottom:0;
      width:6px;
      background: rgba(0,0,0,.32);
      transform: rotateY(90deg) translateX(-3px);
      transform-origin: left center;
      opacity:0;
      transition: opacity .5s ease;
      pointer-events:none;
    }

    .door.is-open .door-leaf{
      /* --door-skew se fija por puerta (inline), proporcional a su propia
         altura, para que el desplazamiento en px nunca se salga de su
         propio hueco (a diferencia de un ángulo fijo, cuyo desplazamiento
         depende del ancho, no de la altura, y desbordaba en puertas cortas) */
      transform: skewY(var(--door-skew, 0deg)) rotateY(64deg) translateZ(14px) translateX(-4px);
      box-shadow: -14px 10px 28px rgba(0,0,0,.5);
      z-index:5;
    }

    .door.is-open .door-leaf::before{ opacity:1; }

    /* Sombra sobre la propia hoja al girar, para que se note que pierde luz */
    .door-leaf::after{
      content:"";
      position:absolute;
      inset:0;
      background:
        linear-gradient(245deg, rgba(0,0,0,.5), rgba(0,0,0,.15) 40%, transparent 70%);
      opacity:0;
      transition: opacity .45s ease .1s;
      pointer-events:none;
    }

    .door.is-open .door-leaf::after{ opacity:1; }

    .door.screen{
      padding:0;
    }

    .door.screen .door-leaf{
      overflow:hidden;
    }

    .door.screen img{
      width:115%;
      height:115%;
      object-fit:contain;
      pointer-events:none;
      user-select:none;
    }

    .door.mailbox{
      padding:0;
    }

    .door.mailbox .door-leaf{
      overflow:hidden;
    }

    .door.mailbox img{
      position:absolute;
      top:0; left:0;
      width:100%;
      height:100%;
      object-fit:fill;
      pointer-events:none;
      user-select:none;
      display:block;
    }

    .door.methacrylate .door-leaf::after{
      content:"";
      position:absolute;
      inset:12px;
      background:rgba(0,0,0,.38);
      border-radius:4px;
      pointer-events:none;
      z-index:1;
    }

    .door .num,
    .door .badges{
      z-index:2;
    }

    .door .num{
      position:absolute;
      left:6px;
      top:4px;
      font-weight:900;
      font-size:12px;
      background: rgba(0,0,0,.65);
      color:#fff;
      border-radius:999px;
      padding:2px 7px;
      line-height:1.2;
    }

    .door .badges{
      position:absolute;
      right:6px;
      bottom:4px;
      display:flex;
      gap:4px;
      flex-wrap:wrap;
    }

    .door .size-label{
      position:relative;
      z-index:2;
      font-weight:900;
      font-size:16px;
      color:#fff;
      text-shadow:0 0 3px rgba(0,0,0,.7);
      pointer-events:none;
      user-select:none;
    }

    .badge-mini{
      font-size:10px;
      font-weight:900;
      background: rgba(255,255,255,.92);
      border:1px solid rgba(0,0,0,.18);
      border-radius:999px;
      padding:1px 5px;
    }

    .addons-table{
      width:100%;
      border-collapse:separate;
      border-spacing:0;
      margin-top:10px;
      border:1px solid rgba(15,23,42,.12);
      border-radius:14px;
      overflow:hidden;
      background:#fff;
    }

    .addons-table th,
    .addons-table td{
      padding:10px 12px;
      border-bottom:1px solid rgba(15,23,42,.08);
      font-size:14px;
      text-align:left;
    }

    .addons-table th{
      background:#fbfcfe;
      font-weight:900;
      color:#334155;
      font-size:12px;
    }

    .addons-table tr:last-child td{
      border-bottom:0;
    }

    .btn-row{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
      margin:14px;
    }

    .btn{
      border:1px solid rgba(15,23,42,.12);
      background:#fff;
      border-radius:12px;
      padding:10px 14px;
      font-weight:900;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      gap:10px;
      text-decoration:none;
      color:#0b1220;
      transition:.15s;
    }

    /* ===== Modal "Ver en 3D" ===== */
    .modal3d{ display:none; position:fixed; inset:0; z-index:1000; }
    .modal3d.is-open{ display:block; }
    .modal3d__backdrop{
      position:absolute; inset:0;
      background:rgba(2,6,23,.6);
    }
    .modal3d__dialog{
      position:absolute; top:2%; left:50%; transform:translateX(-50%);
      width:min(1600px, 98vw);
      height:96vh;
      background:#fff;
      border-radius:16px;
      box-shadow:0 30px 70px rgba(2,6,23,.4);
      display:flex;
      flex-direction:column;
      overflow:hidden;
    }
    .modal3d__head{
      display:flex; align-items:center; justify-content:space-between;
      padding:14px 18px;
      border-bottom:1px solid rgba(15,23,42,.08);
    }
    .modal3d__title{ margin:0; font-size:17px; font-weight:900; }
    .modal3d__close{
      border:0; background:transparent; font-size:22px; line-height:1;
      cursor:pointer; color:#6b7280; padding:4px 8px; border-radius:8px;
    }
    .modal3d__close:hover{ background:rgba(2,6,23,.06); }
    .modal3d__body{
      position:relative;
      flex:1;
      display:flex;
      flex-direction:column;
      min-height:0;
    }
    #viewer3d{
      flex:1;
      min-height:0;
      background:#eef2f7;
      cursor:grab;
    }
    #viewer3d:active{ cursor:grabbing; }
    .modal3d__hint{
      padding:8px 14px;
      font-size:12px;
      color:#6b7280;
      text-align:center;
      border-top:1px solid rgba(15,23,42,.06);
    }

    .scenario-bar{
      display:flex; align-items:center; gap:4px; flex-wrap:wrap;
      padding:8px 14px;
      border-bottom:1px solid rgba(15,23,42,.06);
    }
    .scenario-bar__label{
      font-size:12px; color:#6b7280; margin-right:4px;
    }
    .scenario-btn{
      border:1px solid rgba(15,23,42,.1); background:#fff; color:#334155;
      font:600 12.5px inherit; padding:6px 12px; border-radius:999px; cursor:pointer;
    }
    .scenario-btn:hover{ background:rgba(2,6,23,.04); }
    .scenario-btn[aria-pressed="true"]{
      background:#0b76d8; border-color:#0b76d8; color:#fff;
    }

    .btn:hover{
      background: rgba(2,6,23,.03);
    }

    .btn.primary{
      background:#0b76d8;
      border-color:#0b76d8;
      color:#fff;
      box-shadow: 0 10px 18px rgba(11,118,216,.18);
    }

    .btn.primary:hover{
      filter:brightness(.98);
      transform: translateY(-1px);
    }

    .muted{
      color:var(--muted);
      font-size:15px;
    }

    .id-pill{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:6px 10px;
      border-radius:999px;
      background: rgba(11,118,216,.10);
      border:1px solid rgba(11,118,216,.18);
      font-weight:900;
      color:#0b76d8;
    }

    .support-wrap{
      --armW: 55px;
      --armOverlap: 14px;
      --colW: {{ kuik.col_width_px }}px;

      position: relative;
      display: inline-block;
      padding-left:  calc(var(--armW) - var(--armOverlap) + 40px);
      padding-right: calc(var(--armW) - var(--armOverlap));
    }

    .height-dim{
      position:absolute;
      left:0;
      top:20px;
      width:38px;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:6px;
      z-index:3;
      overflow:visible;
    }

    .vdim-line{
      display:flex;
      flex-direction:column;
      align-items:center;
      height:100%;
      flex-shrink:0;
    }

    .vdim-line .varrow{
      font-size:11px;
      line-height:1;
      color:#0b1220;
      flex-shrink:0;
    }

    .vdim-line .vline{
      width:2px;
      flex:1;
      min-height:10px;
      background:#0b1220;
    }

    .group-height-label{
      display:inline-block;
      flex-shrink:0;
      transform: rotate(-90deg);
      font-size:13px;
      font-weight:900;
      color:#0b1220;
      white-space:nowrap;
    }

    .cols-with-total{
      display:flex;
      flex-direction:column;
      align-items:center;
    }

    .col-dim{
      margin-top:4px;
    }

    .dim-row{
      display:flex;
      align-items:center;
      gap:2px;
    }

    .dim-row .arrow{
      font-size:14px;
      line-height:1;
      color:#0b1220;
    }

    .dim-row .line{
      flex:1;
      height:1px;
      background:#0b1220;
    }

    .dim-value{
      text-align:center;
      font-size:11px;
      font-weight:900;
      color:#0b1220;
      margin-top:2px;
    }

    .group-width-total{
      margin:8px auto 0;
    }

    .group-width-total .dim-value{
      font-size:13px;
    }

    .width-dims-below{
      margin-top:10px;
    }

    .width-dims-row{
      width:100%;
      display:grid;
      grid-template-columns: repeat(var(--colsN), var(--colW));
      justify-content:center;
    }

    .arm-img{
      position:absolute;
      top: 55px;
      width: var(--armW);
      height: calc({{ (singleCap * kuik.scale_arm + (singleCap >= 80 ? (singleCap - 70) * 4.5 : 0))|round }}px + 86px);
      object-fit: contain;
      z-index: 3;
      pointer-events:none;
      user-select:none;
    }

    .arm-img.left{
      left: calc(1.95 * var(--armOverlap));
      transform: scaleX(-1);
    }

    .arm-img.right{
      right: calc(-1.75 * var(--armOverlap));
    }

    /* Cuando también hay patas intermedias (5+ columnas), los brazos se dibujan
       más altos que las patas para que se distingan como el soporte principal. */
    .arm-img.reinforced{
      top: 35px;
      height: calc({{ (singleCap * kuik.scale_arm + (singleCap >= 80 ? (singleCap - 70) * 4.5 : 0))|round }}px + 156px);
    }

    .legs-under{
      width:100%;
      display:grid;
      grid-template-columns: repeat(var(--colsN), var(--colW));
      justify-content:center;
      pointer-events:none;
      user-select:none;
      z-index:1;
      //padding: 0 18px;
    }

    .leg-img{
      width: 55px;
      height: {{ (115 + singleCap * (kuik.scale_arm - kuik.scale))|round }}px;
      object-fit:fill;
      justify-self:center;
      flex:0 0 auto;
    }
    .mb-leg-wrap{ position:relative; flex-shrink:0; top:-5px; }
    .mb-leg-summary{
      position:absolute;
      top:100%;
      left:0;
      z-index:5;
      background:transparent;
    }

    .group-roof {
      width: calc(var(--colsN) * 135px);
      height: 22px;
      background: var(--col-border, #000);
      border-radius: 6px 6px 0 0;
      display: block;
      margin: 10px auto -20px;
      position: relative;
      z-index: 3;
      border-bottom: 1px solid white;
    }

    .group-roof + .cols {
      margin-top: 0;
    }
  </style>
{% endblock %}

{% block content %}
  {% set scale = kuik.scale %}

  <div class="page-wrap">

    <div class="page-head">
      <div>
        <h2 class="page-title">{{ 'summary.page_title'|trans }}</h2>
        <div class="page-sub">
          <span class="id-pill">{{ 'summary.config_id'|trans({'%id%': configuration.id}) }}</span>

          {% if configuration.status == 0 %}
            <span class="badge open">{{ 'summary.status.open'|trans }}</span>
          {% elseif configuration.status == 1 %}
            <span class="badge closed">{{ 'summary.status.closed'|trans }}</span>
          {% else %}
            <span class="badge accepted">{{ 'summary.status.accepted'|trans }}</span>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="btn-row">
      <a class="btn" href="{{ path('configuration_project_new') }}">{{ 'summary.btn.new_project'|trans }}</a>
      <a class="btn" href="{{ path('project_configurations', { project_id: project.id }) }}">{{ 'summary.btn.view_project'|trans }}</a>
      {% if app.user.id == project.user.id %}

        {% if project.status == 0 %}
          <a class="btn primary" href="{{ path('configuration_type', { project_id: project.id }) }}">{{ 'summary.btn.new_configuration'|trans }}</a>
        {% endif %}

        {% if configuration.status == 0 %}
          <a class="btn primary" id="btnEditConfig" href="{{ path('configuration_columns', { project_id: project.id, config_id: configuration.id }) }}">{{ 'summary.btn.edit_configuration'|trans }}</a>
        {% endif %}
      {% endif %}

      {% if app.user.id == project.user.id or is_granted('ROLE_ADMIN') %}
        <button class="btn primary" id="btnDescargarPdf"
          data-screenshot-url="{{ path('configuration_screenshot', { id: configuration.id }) }}"
          data-pdf-url="{{ path('configuration_pdf', { id: configuration.id }) }}">
          {{ 'summary.btn.download_pdf'|trans }}
        </button>
      {% endif %}

      {% if is_granted('ROLE_ADMIN') %}
        <button class="btn" id="btnVer3D" type="button">{{ 'summary.btn.view_3d'|trans }}</button>
        <button class="btn" id="btnVerRA" type="button" style="display:none;">{{ 'summary.btn.view_ar'|trans }}</button>
      {% endif %}
    </div>

    <div class="modal3d" id="modal3d" aria-hidden="true">
      <div class="modal3d__backdrop"></div>
      <div class="modal3d__dialog">
        <div class="modal3d__head">
          <h4 class="modal3d__title">{{ 'summary.view3d.title'|trans }}</h4>
          <button type="button" class="modal3d__close" aria-label="{{ 'summary.btn.close'|trans }}" data-close3d="1">×</button>
        </div>
        <div class="scenario-bar" id="scenarioBar">
          <span class="scenario-bar__label">{{ 'summary.view3d.scenario_label'|trans }}</span>
          <button type="button" class="scenario-btn" data-scenario="home">{{ 'summary.view3d.scenario_building'|trans }}</button>
          <button type="button" class="scenario-btn" data-scenario="profesional">{{ 'summary.view3d.scenario_office'|trans }}</button>
          <button type="button" class="scenario-btn" data-scenario="exterior">{{ 'summary.view3d.scenario_exterior'|trans }}</button>
        </div>
        <div class="modal3d__body">
          <div id="viewer3d"></div>
          <div class="modal3d__hint">{{ 'summary.view3d.hint'|trans }}</div>
        </div>
      </div>
    </div>

    <div class="grid">

      <div class="card">
        <h3>{{ 'summary.preview.title'|trans }}</h3>

        <div class="preview-wrap">

          {% if isSoporteSuelo and selectedType == 'brazos' and selectedColor %}
            {% set armSrc =
              selectedColor == 'blanco' ? asset(kuik.img_brazo_blanco) :
              (selectedColor == 'plata' ? asset(kuik.img_brazo_plata) : asset(kuik.img_brazo_negro))
            %}
          {% endif %}

          {% set legSrc =
            selectedColor == 'blanco' ? asset('assets/pie_blanco.jpg') :
            (selectedColor == 'plata' ? asset('assets/pie_plata.jpg') : asset('assets/pie_negro.jpg'))
          %}

          <div class="preview-scroll">
          <div class="preview-stage" id="previewCapture">
            {% set agrupacionCombinada = p.agrupacion_combinada ?? false %}
            {% set mailboxGroup = p.mailboxGroup ?? null %}
            {% set mbImg = mailboxGroup.imageUrl ?? kuik.img_buzon_btv %}
            {% set mbSide = mailboxGroup.side ?? 'right' %}
            {% set mbRows = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.rows ?? 0) : 0 %}
            {% set mbCols = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.cols ?? 0) : 0 %}
            {% set mbCells = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.cells ?? []) : [] %}
            {% set mbTotalH = isEmpotradoLike ? (singleCap * scale) : ((topCap + bottomCap) * scale) %}
            {% set mbCellH = 10 * scale %}
            {% set mbBlockH = mbRows * mbCellH + 16 %}
            {% set mbLockerH = mbTotalH + 16 %}
            {% set mbMarginTop = 10 + (mbLockerH - mbBlockH) / 2 %}

            <div class="groups-stage" style="--door-color: {{ doorColor }}; --col-border: {{ bodyColor }};">

              {% if groups is empty %}
                <div class="muted">{{ 'summary.preview.no_columns'|trans }}</div>
              {% else %}
                {% for groupCols in groups %}
                  {% if groupCols is not iterable %}{% set groupCols = [] %}{% endif %}
                  {% set totalCols = groupCols|length %}

                  <div class="group-block">
                    <div class="group-label">{{ 'summary.preview.group_label'|trans({'%index%': loop.index, '%count%': groupCols|length}) }}</div>

                    <div class="support-wrap" style="--colsN: {{ totalCols }};">

                      <div class="height-dim" style="height: {{ groupHeightPx }}px;">
                        <div class="group-height-label">{{ groupHeightLabel }}</div>
                        <div class="vdim-line">
                          <span class="varrow">▲</span>
                          <span class="vline"></span>
                          <span class="varrow">▼</span>
                        </div>
                      </div>

                      {% if isSoporteSuelo and selectedType == 'brazos' and selectedColor %}
                        {% set armReinforced = totalCols >= 5 %}
                        <img class="arm-img left {% if armReinforced %}reinforced{% endif %}" src="{{ armSrc }}" alt="Brazo izquierdo">
                        <img class="arm-img right {% if armReinforced %}reinforced{% endif %}" src="{{ armSrc }}" alt="Brazo derecho">
                      {% endif %}

                      <div class="cols-and-mb" style="{% if fondoMm %}margin-top:18px;{% endif %}">

                        {% if fondoMm %}
                          <div class="depth-top"></div>
                          <div class="depth-right" style="height: {{ groupHeightPx + 12 }}px;"></div>
                          <div class="depth-label">
                            <div class="dim-row"><span class="arrow">◄</span><span class="line"></span><span class="arrow">►</span></div>
                            <div class="dim-value">{{ fondoMm }}</div>
                          </div>
                        {% endif %}

                        {# ── Buzones IZQUIERDA ── #}
                        {% if mbRows > 0 and mbCols > 0 and mbSide == 'left' %}
                          <div class="mb-leg-wrap">
                            <div class="mb-group-block">
                              {% for c in 0..(mbCols - 1) %}
                                <div class="mb-group-col">
                                  {% for r in 0..(mbRows - 1) %}
                                    {% set cellIdx = r * mbCols + c %}
                                    {% set filled = mbCells[cellIdx] ?? true %}
                                    <div class="door mailbox" style="height:{{ mbCellH }}px;{% if not filled %}opacity:0.1;background:#eaeaea;{% endif %} --door-skew:-10deg; z-index:{{ 1000 - (c * 20) - r }};">
                                      <div class="door-leaf">
                                        {% if filled %}<img src="{{ mbImg }}" alt="Buzón">{% endif %}
                                      </div>
                                    </div>
                                  {% endfor %}
                                </div>
                              {% endfor %}
                            </div>
                            {% if isSoporteSuelo %}
                              {% set _mbLegH = (115 + singleCap * (kuik.scale_arm - kuik.scale))|round %}
                              {% if selectedType == 'patas' %}
                                {# Posiciones automáticas según mbCols #}
                                {% set _n = mbCols %}
                                {% if _n == 1 %}{% set _autoCols = [1] %}
                                {% elseif _n == 2 %}{% set _autoCols = [1, 2] %}
                                {% elseif _n == 3 %}{% set _autoCols = [1, 3] %}
                                {% elseif _n == 4 %}{% set _autoCols = [2, 3] %}
                                {% elseif _n == 5 %}{% set _autoCols = [2, 4] %}
                                {% elseif _n == 6 %}{% set _autoCols = [2, 4, 6] %}
                                {% elseif _n == 7 %}{% set _autoCols = [2, 4, 6, 7] %}
                                {% elseif _n == 8 %}{% set _autoCols = [2, 4, 6, 8] %}
                                {% elseif _n == 9 %}{% set _autoCols = [2, 4, 7, 8] %}
                                {% else %}{% set _autoCols = [2, 4, 7, 9] %}
                                {% endif %}
                                <div class="mb-leg-summary" style="width:{{ kuik.mb_col_width_px * mbCols }}px; height:{{ _mbLegH }}px;">
                                  {% for _c in _autoCols %}
                                    {% set _xCenter = (_c - 0.5) * kuik.mb_col_width_px %}
                                    <img class="leg-img" style="position:absolute; left:{{ (_xCenter - 32)|round }}px; top:0; width:55px; height:{{ _mbLegH }}px; object-fit:fill; justify-self:unset;" src="{{ legSrc }}" alt="Pata">
                                  {% endfor %}
                                </div>
                              {% elseif selectedType == 'brazos' and mbLegPos|length > 0 %}
                                {# Posiciones manuales guardadas (una por cada 5 columnas) #}
                                <div class="mb-leg-summary" style="width:{{ kuik.mb_col_width_px * mbCols }}px; height:{{ _mbLegH }}px;">
                                  {% for _i in mbLegPos %}
                                    {% set _xCenter = (_i is even) ? ((_i / 2) + 0.5) * kuik.mb_col_width_px : ((_i + 1) / 2) * kuik.mb_col_width_px %}
                                    <img class="leg-img" style="position:absolute; left:{{ (_xCenter - 32)|round }}px; top:0; width:55px; height:{{ _mbLegH }}px; object-fit:fill; justify-self:unset;" src="{{ legSrc }}" alt="Pata">
                                  {% endfor %}
                                </div>
                              {% endif %}
                            {% endif %}
                          </div>
                        {% endif %}

                      <div class="cols" id="previewCols">
                        {% for col in groupCols %}
                          {% set isEmpotrado = (col.single is defined and col.single is not empty) %}

                          <div class="col-shell">
                            <div class="col-card">
                              <div class="col-body"
                                {% if isEmpotrado %}
                                  style="height: {{ (singleCap * scale) }}px;"
                                {% elseif type == 'home' and instalacion == 'zocalo' %}
                                  style="height: {{ ((topCap + bottomCap) * scale) }}px;"
                                {% endif %}
                              >

                                {% if isEmpotrado %}

                                  <div class="col-half" style="height: {{ singleCap * scale }}px;">
                                    {% set singleBlocks = col.single.blocks_prepared ?? col.single.blocks ?? [] %}
                                    {% for blk in singleBlocks %}
                                      {% set hh = blk.h|default(blk) %}
                                      {% set btype = blk.type|default('door') %}
                                      {% set socket = blk.socket ?? false %}
                                      {% set usb = blk.usb ?? false %}
                                      {% set methacrylate = blk.methacrylate ?? false %}
                                      {% set plateNumber = blk.plateNumber ?? null %}
                                      {% set doorNumber = blk.doorNumber ?? null %}

                                      <div class="door {{ btype == 'screen' ? 'screen' : '' }} {{ btype == 'mailbox' ? 'mailbox' : '' }} {{ methacrylate ? 'methacrylate' : '' }}"
                                           style="height: {{ hh * scale }}px; --door-skew: {{ min(-10, max(-22, (-25 * hh / 40)))|round(2) }}deg; z-index: {{ 100 - loop.index }};">
                                       <div class="door-leaf">

                                        {% if btype == 'screen' %}
                                          <img src="{{ asset(kuik.img_pantalla) }}" alt="Pantalla">
                                        {% elseif btype == 'mailbox' %}
                                          {% set _elec = blk.electronico ?? false %}
                                          {% set _tarj = blk.tarjetero ?? false %}
                                          {% set _buzonImg = _elec ? (_tarj ? 'assets/buzon_kuik_electronico_con_tarjetero.png' : 'assets/buzon_kuik_electronico_sin_tarjetero.png') : (_tarj ? 'assets/buzon_kuik_mecanico_con_tarjetero.png' : 'assets/buzon_kuik_mecanico_sin_tarjetero.png') %}
                                          <img src="{{ asset(_buzonImg) }}" alt="Buzón">
                                          {% if _elec and plateNumber is not null %}
                                            <div class="num" style="color:#fff;text-shadow:0 0 3px #000;">{{ plateNumber }},{{ doorNumber }}</div>
                                          {% endif %}
                                        {% else %}
                                          <div class="num">
                                            {{ plateNumber }},{{ doorNumber }}
                                          </div>

                                          <div class="size-label">H{{ hh }}</div>

                                          <div class="badges">
                                            {% if socket %}<span class="badge-mini">{{ 'summary.badge.socket'|trans }}</span>{% endif %}
                                            {% if usb %}<span class="badge-mini">{{ 'summary.badge.usb'|trans }}</span>{% endif %}
                                          </div>
                                        {% endif %}
                                       </div>
                                      </div>
                                    {% endfor %}
                                  </div>

                                {% else %}

                                  <div class="col-half" style="height: {{ topCap * scale }}px;">
                                    {% set topBlocks = col.top.blocks_prepared ?? col.top.blocks ?? [] %}
                                    {% for blk in topBlocks %}
                                      {% set hh = blk.h|default(blk) %}
                                      {% set btype = blk.type|default('door') %}
                                      {% set socket = blk.socket ?? false %}
                                      {% set usb = blk.usb ?? false %}
                                      {% set methacrylate = blk.methacrylate ?? false %}
                                      {% set plateNumber = blk.plateNumber ?? null %}
                                      {% set doorNumber = blk.doorNumber ?? null %}

                                      <div class="door {{ btype == 'screen' ? 'screen' : '' }} {{ btype == 'mailbox' ? 'mailbox' : '' }} {{ methacrylate ? 'methacrylate' : '' }}"
                                           style="height: {{ hh * scale }}px; --door-skew: {{ min(-10, max(-22, (-25 * hh / 40)))|round(2) }}deg; z-index: {{ 100 - loop.index }};">
                                       <div class="door-leaf">

                                        {% if btype == 'screen' %}
                                          <img src="{{ asset(kuik.img_pantalla) }}" alt="Pantalla">
                                        {% elseif btype == 'mailbox' %}
                                          {% set _elec = blk.electronico ?? false %}
                                          {% set _tarj = blk.tarjetero ?? false %}
                                          {% set _buzonImg = _elec ? (_tarj ? 'assets/buzon_kuik_electronico_con_tarjetero.png' : 'assets/buzon_kuik_electronico_sin_tarjetero.png') : (_tarj ? 'assets/buzon_kuik_mecanico_con_tarjetero.png' : 'assets/buzon_kuik_mecanico_sin_tarjetero.png') %}
                                          <img src="{{ asset(_buzonImg) }}" alt="Buzón">
                                          {% if _elec and plateNumber is not null %}
                                            <div class="num" style="color:#fff;text-shadow:0 0 3px #000;">{{ plateNumber }},{{ doorNumber }}</div>
                                          {% endif %}
                                        {% else %}
                                          <div class="num">
                                            {{ plateNumber }},{{ doorNumber }}
                                          </div>

                                          <div class="size-label">H{{ hh }}</div>

                                          <div class="badges">
                                            {% if socket %}<span class="badge-mini">{{ 'summary.badge.socket'|trans }}</span>{% endif %}
                                            {% if usb %}<span class="badge-mini">{{ 'summary.badge.usb'|trans }}</span>{% endif %}
                                          </div>
                                        {% endif %}
                                       </div>
                                      </div>
                                    {% endfor %}
                                  </div>

                                  <div class="half-sep"></div>

                                  <div class="col-half" style="height: {{ bottomCap * scale }}px;">
                                    {% set bottomBlocks = col.bottom.blocks_prepared ?? col.bottom.blocks ?? [] %}
                                    {% for blk in bottomBlocks %}
                                      {% set hh = blk.h|default(blk) %}
                                      {% set btype = blk.type|default('door') %}
                                      {% set socket = blk.socket ?? false %}
                                      {% set usb = blk.usb ?? false %}
                                      {% set methacrylate = blk.methacrylate ?? false %}
                                      {% set plateNumber = blk.plateNumber ?? null %}
                                      {% set doorNumber = blk.doorNumber ?? null %}

                                      <div class="door {{ btype == 'screen' ? 'screen' : '' }} {{ btype == 'mailbox' ? 'mailbox' : '' }} {{ methacrylate ? 'methacrylate' : '' }}"
                                           style="height: {{ hh * scale }}px; --door-skew: {{ min(-10, max(-22, (-25 * hh / 40)))|round(2) }}deg; z-index: {{ 100 - loop.index }};">
                                       <div class="door-leaf">

                                        {% if btype == 'screen' %}
                                          <img src="{{ asset(kuik.img_pantalla) }}" alt="Pantalla">
                                        {% elseif btype == 'mailbox' %}
                                          {% set _elec = blk.electronico ?? false %}
                                          {% set _tarj = blk.tarjetero ?? false %}
                                          {% set _buzonImg = _elec ? (_tarj ? 'assets/buzon_kuik_electronico_con_tarjetero.png' : 'assets/buzon_kuik_electronico_sin_tarjetero.png') : (_tarj ? 'assets/buzon_kuik_mecanico_con_tarjetero.png' : 'assets/buzon_kuik_mecanico_sin_tarjetero.png') %}
                                          <img src="{{ asset(_buzonImg) }}" alt="Buzón">
                                          {% if _elec and plateNumber is not null %}
                                            <div class="num" style="color:#fff;text-shadow:0 0 3px #000;">{{ plateNumber }},{{ doorNumber }}</div>
                                          {% endif %}
                                        {% else %}
                                          <div class="num">
                                            {{ plateNumber }},{{ doorNumber }}
                                          </div>

                                          <div class="size-label">H{{ hh }}</div>

                                          <div class="badges">
                                            {% if socket %}<span class="badge-mini">{{ 'summary.badge.socket'|trans }}</span>{% endif %}
                                            {% if usb %}<span class="badge-mini">{{ 'summary.badge.usb'|trans }}</span>{% endif %}
                                          </div>
                                        {% endif %}
                                       </div>
                                      </div>
                                    {% endfor %}
                                  </div>

                                {% endif %}
                              </div>
                            </div>
                          </div>
                        {% endfor %}{# endfor col in groupCols #}
                      </div>{# /cols grid #}

                        {# ── Buzones DERECHA ── #}
                        {% if mbRows > 0 and mbCols > 0 and mbSide == 'right' %}
                          <div class="mb-leg-wrap">
                            <div class="mb-group-block">
                              {% for c in 0..(mbCols - 1) %}
                                <div class="mb-group-col">
                                  {% for r in 0..(mbRows - 1) %}
                                    {% set cellIdx = r * mbCols + c %}
                                    {% set filled = mbCells[cellIdx] ?? true %}
                                    <div class="door mailbox" style="height:{{ mbCellH }}px;{% if not filled %}opacity:0.1;background:#eaeaea;{% endif %} --door-skew:-10deg; z-index:{{ 1000 - (c * 20) - r }};">
                                      <div class="door-leaf">
                                        {% if filled %}<img src="{{ mbImg }}" alt="Buzón">{% endif %}
                                      </div>
                                    </div>
                                  {% endfor %}
                                </div>
                              {% endfor %}
                            </div>
                            {% if isSoporteSuelo %}
                              {% set _mbLegH = (120 + singleCap * (kuik.scale_arm - kuik.scale))|round %}
                              {% if selectedType == 'patas' %}
                                {# Posiciones automáticas según mbCols #}
                                {% set _n = mbCols %}
                                {% if _n == 1 %}{% set _autoCols = [1] %}
                                {% elseif _n == 2 %}{% set _autoCols = [1, 2] %}
                                {% elseif _n == 3 %}{% set _autoCols = [1, 3] %}
                                {% elseif _n == 4 %}{% set _autoCols = [2, 3] %}
                                {% elseif _n == 5 %}{% set _autoCols = [2, 4] %}
                                {% elseif _n == 6 %}{% set _autoCols = [2, 4, 6] %}
                                {% elseif _n == 7 %}{% set _autoCols = [2, 4, 6, 7] %}
                                {% elseif _n == 8 %}{% set _autoCols = [2, 4, 6, 8] %}
                                {% elseif _n == 9 %}{% set _autoCols = [2, 4, 7, 8] %}
                                {% else %}{% set _autoCols = [2, 4, 7, 9] %}
                                {% endif %}
                                <div class="mb-leg-summary" style="width:{{ kuik.mb_col_width_px * mbCols }}px; height:{{ _mbLegH }}px;">
                                  {% for _c in _autoCols %}
                                    {% set _xCenter = (_c - 0.5) * kuik.mb_col_width_px %}
                                    <img class="leg-img" style="position:absolute; left:{{ (_xCenter - 32)|round }}px; top:0; width:55px; height:{{ _mbLegH }}px; object-fit:fill; justify-self:unset;" src="{{ legSrc }}" alt="Pata">
                                  {% endfor %}
                                </div>
                              {% elseif selectedType == 'brazos' and mbLegPos|length > 0 %}
                                {# Posiciones manuales guardadas (una por cada 5 columnas) #}
                                <div class="mb-leg-summary" style="width:{{ kuik.mb_col_width_px * mbCols }}px; height:{{ _mbLegH }}px;">
                                  {% for _i in mbLegPos %}
                                    {% set _xCenter = (_i is even) ? ((_i / 2) + 0.5) * kuik.mb_col_width_px : ((_i + 1) / 2) * kuik.mb_col_width_px %}
                                    <img class="leg-img" style="position:absolute; left:{{ (_xCenter - 32)|round }}px; top:0; width:55px; height:{{ _mbLegH }}px; object-fit:fill; justify-self:unset;" src="{{ legSrc }}" alt="Pata">
                                  {% endfor %}
                                </div>
                              {% endif %}
                            {% endif %}
                          </div>
                        {% endif %}

                      </div>{# /cols-and-mb #}

                      {% if isSoporteSuelo and selectedType == 'brazos' and agrupacionCombinada and mbCols > 0 %}
                        {% set n = totalCols %}
                        {% if n == 1 %}
                          {% set mbLegPositions = [1] %}
                        {% elseif n == 2 %}
                          {% set mbLegPositions = [1, 2] %}
                        {% elseif n == 3 %}
                          {% set mbLegPositions = [1, 3] %}
                        {% elseif n == 4 %}
                          {% set mbLegPositions = [2, 3] %}
                        {% elseif n == 5 %}
                          {% set mbLegPositions = [2, 4] %}
                        {% elseif n == 6 %}
                          {% set mbLegPositions = [2, 4, 6] %}
                        {% elseif n == 7 %}
                          {% set mbLegPositions = [2, 4, 6, 7] %}
                        {% elseif n == 8 %}
                          {% set mbLegPositions = [2, 4, 6, 8] %}
                        {% elseif n == 9 %}
                          {% set mbLegPositions = [2, 4, 7, 8] %}
                        {% else %}
                          {% set mbLegPositions = [2, 4, 7, 9] %}
                        {% endif %}
                        {% if mbSide == 'left' and n > 5 %}
                          {% if n == 6 %}{% set mbLegPositions = [1, 3, 5] %}
                          {% elseif n == 7 %}{% set mbLegPositions = [1, 2, 4, 6] %}
                          {% elseif n == 8 %}{% set mbLegPositions = [1, 3, 5, 7] %}
                          {% elseif n == 9 %}{% set mbLegPositions = [2, 3, 6, 8] %}
                          {% endif %}
                        {% endif %}
                        {% set mbBlockW = mbCols * kuik.mb_col_width_px + 8 %}
                        <div style="display:flex; flex-direction:row; width:100%;">
                          {% if mbSide == 'left' %}
                            <div style="width:{{ mbBlockW }}px; flex-shrink:0;"></div>
                          {% endif %}
                          <div class="legs-under" style="flex:1;">
                            {% for pos in mbLegPositions %}
                              <img class="leg-img"
                                   style="grid-column: {{ pos }};"
                                   src="{{ legSrc }}"
                                   alt="Pata">
                            {% endfor %}
                          </div>
                          {% if mbSide == 'right' %}
                            <div style="width:{{ mbBlockW }}px; flex-shrink:0;"></div>
                          {% endif %}
                        </div>
                      {% endif %}

                      {% set n = groupCols|length %}
                      {% if isSoporteSuelo and (selectedType == 'patas' or (selectedType == 'brazos' and n >= 5)) %}
                        {% if n == 1 %}
                          {% set legPositions = [1] %}
                        {% elseif n == 2 %}
                          {% set legPositions = [1, 2] %}
                        {% elseif n == 3 %}
                          {% set legPositions = [1, 3] %}
                        {% elseif n == 4 %}
                          {% set legPositions = [2, 3] %}
                        {% elseif n == 5 %}
                          {% set legPositions = [2, 4] %}
                        {% elseif n == 6 %}
                          {% set legPositions = [2, 4, 6] %}
                        {% elseif n == 7 %}
                          {% set legPositions = [2, 4, 6, 7] %}
                        {% elseif n == 8 %}
                          {% set legPositions = [2, 4, 6, 8] %}
                        {% elseif n == 9 %}
                          {% set legPositions = [2, 4, 7, 8] %}
                        {% else %}
                          {% set legPositions = [2, 4, 7, 9] %}
                        {% endif %}
                        {% if agrupacionCombinada and mbSide == 'left' and n > 5 %}
                          {% if n == 6 %}{% set legPositions = [1, 3, 5] %}
                          {% elseif n == 7 %}{% set legPositions = [1, 2, 4, 6] %}
                          {% elseif n == 8 %}{% set legPositions = [1, 3, 5, 7] %}
                          {% elseif n == 9 %}{% set legPositions = [2, 3, 6, 8] %}
                          {% endif %}
                        {% endif %}
                        <div class="legs-under">
                          {% for pos in legPositions %}
                            <img class="leg-img"
                                 style="grid-column: {{ pos }};"
                                 src="{{ legSrc }}"
                                 alt="Pata">
                          {% endfor %}
                        </div>
                      {% endif %}

                      {% if colWidthLabel %}
                        {% set mbUnitAnchoMm = mailboxGroup.ancho ?? 0 %}
                        {% set hasMbWidth = mbRows > 0 and mbCols > 0 and mbUnitAnchoMm > 0 %}
                        {% set mbGroupWidthMm = hasMbWidth ? (mbCols * mbUnitAnchoMm)|round : 0 %}
                        {% set mbDimW = mbCols * kuik.mb_col_width_px %}
                        <div class="width-dims-below">
                          {% if totalCols == 1 and not hasMbWidth %}
                            <div class="group-width-total" style="width: calc({{ totalCols }} * {{ kuik.col_width_px }}px);">
                              <div class="dim-row"><span class="arrow">◄</span><span class="line"></span><span class="arrow">►</span></div>
                              <div class="dim-value">{{ (colWidthLabel * totalCols) + groupWidthExtraMm }}</div>
                            </div>
                          {% else %}
                            <div style="display:flex; flex-direction:row;">
                              {% if hasMbWidth and mbSide == 'left' %}
                                <div class="col-dim" style="width:{{ mbDimW }}px; flex-shrink:0;">
                                  <div class="dim-row"><span class="arrow">◄</span><span class="line"></span><span class="arrow">►</span></div>
                                  <div class="dim-value">{{ mbGroupWidthMm }}</div>
                                </div>
                              {% endif %}
                              <div class="width-dims-row" style="--colsN: {{ totalCols }};">
                                {% for col in groupCols %}
                                  <div class="col-dim">
                                    <div class="dim-row"><span class="arrow">◄</span><span class="line"></span><span class="arrow">►</span></div>
                                    <div class="dim-value">{{ colWidthLabel }}</div>
                                  </div>
                                {% endfor %}
                              </div>
                              {% if hasMbWidth and mbSide == 'right' %}
                                <div class="col-dim" style="width:{{ mbDimW }}px; flex-shrink:0;">
                                  <div class="dim-row"><span class="arrow">◄</span><span class="line"></span><span class="arrow">►</span></div>
                                  <div class="dim-value">{{ mbGroupWidthMm }}</div>
                                </div>
                              {% endif %}
                            </div>
                            <div class="group-width-total" style="width: calc({{ totalCols }} * {{ kuik.col_width_px }}px{{ hasMbWidth ? (' + ' ~ mbDimW ~ 'px') : '' }});">
                              <div class="dim-row"><span class="arrow">◄</span><span class="line"></span><span class="arrow">►</span></div>
                              <div class="dim-value">{{ (colWidthLabel * totalCols) + groupWidthExtraMm + mbGroupWidthMm }}</div>
                            </div>
                          {% endif %}
                        </div>
                      {% endif %}

                    </div>
                  </div>
                {% endfor %}
              {% endif %}

            </div>{# /groups-stage #}
          </div>
          </div>

        </div>

        <img id="resultadoIA"
             style="max-width:100%; margin-top:12px; display:none; border:1px solid rgba(15,23,42,.12); border-radius:12px;">

        {% block product_table %}
          <div id="productTableContainer"></div>
        {% endblock %}

        <div style="margin-top:16px; border-top:1px solid rgba(15,23,42,.08); padding-top:16px; display:flex; align-items:center; gap:12px;">
          <label style="font-size:14px; font-weight:700; white-space:nowrap;">{{ 'summary.installation.label'|trans }}</label>
          <input type="number" id="instalacionPrecio" min="0" step="0.01"
            value="{{ p._instalacion_precio ?? '' }}"
            placeholder="0,00"
            style="width:130px; padding:6px 10px; border:1px solid rgba(15,23,42,.15); border-radius:8px; font-size:14px;">
          <span id="instalacionStatus" style="font-size:12px; color:#6b7280; display:none;">{{ 'summary.installation.saved'|trans }}</span>
        </div>
      </div>

      <div class="card">
        <h3>{{ 'summary.config.title'|trans }}</h3>

        <div class="kvs">
          <div class="kv"><div class="k">{{ 'summary.config.type'|trans }}</div><div class="v">{{ type }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.config.background'|trans }}</div><div class="v">{{ bgLabel }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.config.placement'|trans }}</div><div class="v">{{ placementLabel }}</div></div>
          {#<div class="kv"><div class="k">Material</div><div class="v">{{ material }}</div></div>#}
          <div class="kv"><div class="k">{{ 'summary.config.door_color'|trans }}</div><div class="v">{{ doorColorRal }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.config.body_color'|trans }}</div><div class="v">{{ bodyColorRal }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.config.columns'|trans }}</div><div class="v">{{ columnsAll|length }}</div></div>
          {% if isSoporteSuelo and selectedType == 'brazos' %}
            <div class="kv"><div class="k">{{ 'summary.config.arm_height'|trans }}</div><div class="v">1500 mm</div></div>
          {% elseif isSoporteSuelo and selectedType == 'patas' %}
            <div class="kv"><div class="k">{{ 'summary.config.leg_height'|trans }}</div><div class="v">800/900 mm</div></div>
          {% endif %}
          {% if instalacion == 'colgado' %}
            {% set _colgadores = 0 %}
            {% for _grp in groups %}
              {% set _n = _grp|length %}
              {% set _grpColgadores = _n <= 2 ? _n : ((_n + 1) // 2) %}
              {% set _colgadores = _colgadores + _grpColgadores %}
            {% endfor %}
            <div class="kv"><div class="k">{{ 'summary.config.hangers'|trans }}</div><div class="v">{{ _colgadores }}</div></div>
          {% endif %}
          {% if p.control is defined and p.control %}
            <div class="kv"><div class="k">{{ 'summary.config.control'|trans }}</div><div class="v">{{ p.control }}</div></div>
          {% endif %}
          {% set _mbGroup = p.mailboxGroup ?? null %}
          {% if (p.agrupacion_combinada ?? false) and _mbGroup %}
            <div class="kv"><div class="k">{{ 'summary.config.mailboxes_ref'|trans }}</div><div class="v">{{ _mbGroup.reference ?? '—' }}</div></div>
            {% if _mbGroup.descripcion ?? null %}
              <div class="kv"><div class="k">{{ 'summary.config.mailbox_description'|trans }}</div><div class="v">{{ _mbGroup.descripcion }}</div></div>
            {% endif %}
          {% endif %}
        </div>

        <div class="section-sep"></div>

        <h3>{{ 'summary.client.title'|trans }}</h3>

        <div class="kvs">
          <div class="kv"><div class="k">{{ 'summary.client.project'|trans }}</div><div class="v">{{ project.projectName }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.client.client'|trans }}</div><div class="v">{{ project.clientName }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.client.phone'|trans }}</div><div class="v">{{ project.phone ?: '—' }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.client.email'|trans }}</div><div class="v">{{ project.email ?: '—' }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.client.city'|trans }}</div><div class="v">{{ project.city ?: '—' }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.client.address'|trans }}</div><div class="v">{{ project.address ?: '—' }}</div></div>
        </div>

        <div class="section-sep"></div>
        <h3>{{ 'summary.doors_by_size.title'|trans }}</h3>

        {% set doorSizeCounts = {} %}
        {% set mailboxSizeCounts = {} %}
        {% set totalDoors = 0 %}
        {% set totalMailboxes = 0 %}

        {% for col in columnsAll %}
          {% if col.single is defined and col.single is not empty %}

            {% set singleBlocks = col.single.blocks_prepared ?? col.single.blocks ?? [] %}
            {% for blk in singleBlocks %}
              {% set btype = blk.type|default('door') %}
              {% set hh = blk.h|default(blk) %}
              {% set key = 'H' ~ hh %}

              {% if btype == 'mailbox' %}
                {% set mailboxSizeCounts = mailboxSizeCounts|merge({ (key): (mailboxSizeCounts[key]|default(0) + 1) }) %}
                {% set totalMailboxes = totalMailboxes + 1 %}
              {% elseif btype != 'screen' %}
                {% set doorSizeCounts = doorSizeCounts|merge({ (key): (doorSizeCounts[key]|default(0) + 1) }) %}
                {% set totalDoors = totalDoors + 1 %}
              {% endif %}
            {% endfor %}

          {% else %}

            {% set topBlocks = col.top.blocks_prepared ?? col.top.blocks ?? [] %}
            {% for blk in topBlocks %}
              {% set btype = blk.type|default('door') %}
              {% set hh = blk.h|default(blk) %}
              {% set key = 'H' ~ hh %}

              {% if btype == 'mailbox' %}
                {% set mailboxSizeCounts = mailboxSizeCounts|merge({ (key): (mailboxSizeCounts[key]|default(0) + 1) }) %}
                {% set totalMailboxes = totalMailboxes + 1 %}
              {% elseif btype != 'screen' %}
                {% set doorSizeCounts = doorSizeCounts|merge({ (key): (doorSizeCounts[key]|default(0) + 1) }) %}
                {% set totalDoors = totalDoors + 1 %}
              {% endif %}
            {% endfor %}

            {% set bottomBlocks = col.bottom.blocks_prepared ?? col.bottom.blocks ?? [] %}
            {% for blk in bottomBlocks %}
              {% set btype = blk.type|default('door') %}
              {% set hh = blk.h|default(blk) %}
              {% set key = 'H' ~ hh %}

              {% if btype == 'mailbox' %}
                {% set mailboxSizeCounts = mailboxSizeCounts|merge({ (key): (mailboxSizeCounts[key]|default(0) + 1) }) %}
                {% set totalMailboxes = totalMailboxes + 1 %}
              {% elseif btype != 'screen' %}
                {% set doorSizeCounts = doorSizeCounts|merge({ (key): (doorSizeCounts[key]|default(0) + 1) }) %}
                {% set totalDoors = totalDoors + 1 %}
              {% endif %}
            {% endfor %}

          {% endif %}
        {% endfor %}

        {% if totalDoors == 0 and totalMailboxes == 0 %}
          <div class="muted">{{ 'summary.doors_by_size.none'|trans }}</div>
        {% else %}
          <table class="addons-table">
            <thead>
              <tr>
                <th>{{ 'summary.doors_by_size.size'|trans }}</th>
                <th>{{ 'summary.doors_by_size.quantity'|trans }}</th>
              </tr>
            </thead>
            <tbody>
              {% for h in [10,20,30,40,50,60,70,80,90] %}
                {% set k = 'H' ~ h %}
                {% if doorSizeCounts[k]|default(0) > 0 %}
                  <tr>
                    <td><b>{{ k }}</b></td>
                    <td>{{ doorSizeCounts[k] }}</td>
                  </tr>
                {% endif %}
              {% endfor %}

              {% for h in [10,20,30,40,50,60,70,80,90] %}
                {% set k = 'H' ~ h %}
                {% if mailboxSizeCounts[k]|default(0) > 0 %}
                  <tr>
                    <td><b>{{ 'summary.doors_by_size.mailbox'|trans }}</b></td>
                    <td>{{ mailboxSizeCounts[k] }}</td>
                  </tr>
                {% endif %}
              {% endfor %}

              <tr>
                <td><b>{{ 'summary.doors_by_size.total_doors'|trans }}</b></td>
                <td><b>{{ totalDoors }}</b></td>
              </tr>
              <tr>
                <td><b>{{ 'summary.doors_by_size.total_mailboxes'|trans }}</b></td>
                <td><b>{{ totalMailboxes }}</b></td>
              </tr>
            </tbody>
          </table>
        {% endif %}

        <div class="section-sep"></div>
        <h3>{{ 'summary.addons.title'|trans }}</h3>

        {% set totalSocket = 0 %}
        {% set totalUsb = 0 %}
        {% set totalBoth = 0 %}
        {% set totalMethacrylate = 0 %}

        {% for doorNum, sel in addons %}
          {% set socket = (sel is iterable and (sel.socket ?? false)) ? 1 : 0 %}
          {% set usb = (sel is iterable and (sel.usb ?? false)) ? 1 : 0 %}
          {% set methacrylate = (sel is iterable and (sel.methacrylate ?? false)) ? 1 : 0 %}

          {% set totalSocket = totalSocket + socket %}
          {% set totalUsb = totalUsb + usb %}
          {% set totalMethacrylate = totalMethacrylate + methacrylate %}

          {% if socket and usb %}
            {% set totalBoth = totalBoth + 1 %}
          {% endif %}
        {% endfor %}

        <div class="kvs" style="margin-top:10px;">
          <div class="kv">
            <div class="k">{{ 'summary.addons.total_sockets'|trans }}</div>
            <div class="v">{{ totalSocket }}</div>
          </div>
          <div class="kv">
            <div class="k">{{ 'summary.addons.total_usb'|trans }}</div>
            <div class="v">{{ totalUsb }}</div>
          </div>
          <div class="kv">
            <div class="k">{{ 'summary.addons.doors_with_both'|trans }}</div>
            <div class="v">{{ totalBoth }}</div>
          </div>
          <div class="kv">
            <div class="k">{{ 'summary.addons.doors_with_methacrylate'|trans }}</div>
            <div class="v">{{ totalMethacrylate }}</div>
          </div>
        </div>

        <h3 style="margin-top:14px;">{{ 'summary.addons.detail_title'|trans }}</h3>

        {% set anyAddon = false %}
        {% for doorNum, sel in addons %}
          {% set socket = (sel is iterable and (sel.socket ?? false)) ? true : false %}
          {% set usb = (sel is iterable and (sel.usb ?? false)) ? true : false %}
          {% set methacrylate = (sel is iterable and (sel.methacrylate ?? false)) ? true : false %}
          {% if socket or usb or methacrylate %}
            {% set anyAddon = true %}
          {% endif %}
        {% endfor %}

        {% if not anyAddon %}
          <div class="muted">{{ 'summary.addons.none'|trans }}</div>
        {% else %}
          <table class="addons-table">
            <thead>
              <tr>
                <th>{{ 'summary.addons.door'|trans }}</th>
                <th>{{ 'summary.addons.addon'|trans }}</th>
              </tr>
            </thead>
            <tbody>
              {% for doorNum, sel in addons|sort %}
                {% set socket = (sel is iterable and (sel.socket ?? false)) ? true : false %}
                {% set usb = (sel is iterable and (sel.usb ?? false)) ? true : false %}
                {% set methacrylate = (sel is iterable and (sel.methacrylate ?? false)) ? true : false %}

                {% if socket or usb or methacrylate %}
                  {% set labels = [] %}

                  {% if methacrylate %}
                    {% set labels = labels|merge([('summary.addons.methacrylate'|trans)]) %}
                  {% endif %}
                  {% if socket %}
                    {% set labels = labels|merge([('summary.addons.socket'|trans)]) %}
                  {% endif %}
                  {% if usb %}
                    {% set labels = labels|merge(['USB']) %}
                  {% endif %}

                  <tr>
                    <td><b>{{ doorNum }}</b></td>
                    <td>{{ labels|join(' + ') }}</td>
                  </tr>
                {% endif %}
              {% endfor %}
            </tbody>
          </table>
        {% endif %}

      </div>
    </div>
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>

  <script>
    window.LOCKER_3D_DATA = {{ {
      groups: groups3d,
      doorColor: doorColor,
      bodyColor: bodyColor,
      fondoMm: fondoMm ?: 400,
      doorWidthMm: kuik.door_width_mm,
      screenImageUrl: asset(kuik.img_pantalla),
      isSoporteSuelo: isSoporteSuelo,
      bracketType: selectedType,
      mailboxImages: {
        elecTarj:   asset('assets/buzon_kuik_electronico_con_tarjetero.png'),
        elecNoTarj: asset('assets/buzon_kuik_electronico_sin_tarjetero.png'),
        mecTarj:    asset('assets/buzon_kuik_mecanico_con_tarjetero.png'),
        mecNoTarj:  asset('assets/buzon_kuik_mecanico_sin_tarjetero.png')
      },
      isHome: isHome,
      isProfesional: (type == 'profesional'),
      instalacion: instalacion
    }|json_encode|raw }};
  </script>

  <script>
    window.I18N_SUMMARY = {{ {
      generating: 'summary.js.generating'|trans,
      download_pdf: 'summary.js.download_pdf'|trans,
      total: 'summary.js.total'|trans,
      total_with_discount: 'summary.js.total_with_discount'|trans,
      iva_included: 'summary.js.iva_included'|trans,
      iva_excluded: 'summary.js.iva_excluded'|trans,
      non_json_response: 'summary.js.non_json_response'|trans,
      image_generation_error: 'summary.js.image_generation_error'|trans,
      unexpected_error: 'summary.js.unexpected_error'|trans,
      manual_line_description_placeholder: 'config_ajax.manual_line.description_placeholder'|trans
    }|json_encode|raw }};
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const btn3d   = document.getElementById('btnVer3D');
      const modal3d = document.getElementById('modal3d');
      const viewer  = document.getElementById('viewer3d');
      if (!btn3d || !modal3d || !viewer) return;

      let threeLoaded = false;
      let renderer = null, scene = null, camera = null, controls = null, animationId = null;
      const doorPivots = [];
      const clickableMeshes = [];
      // Funciones de actualización por frame que pueda necesitar un
      // escenario concreto (p.ej. coches circulando en el exterior tipo
      // calle). Reciben el tiempo transcurrido (segundos) desde el frame
      // anterior.
      const sceneUpdaters = [];
      const DOOR_OPEN_ANGLE = Math.PI * 0.6; // ~108º

      // Escenario seleccionado en la barra del modal: por defecto, el que
      // corresponda al tipo de la configuración, pero el usuario puede
      // cambiarlo libremente a cualquiera de los tres sin que eso afecte al
      // propio mueble (puertas, pantallas, buzones, patas/brazos).
      const initialLockerData = window.LOCKER_3D_DATA || {};
      let currentScenario = initialLockerData.isHome
        ? 'home'
        : (initialLockerData.isProfesional ? 'profesional' : 'exterior');

      const scenarioBar = document.getElementById('scenarioBar');
      function updateScenarioButtons() {
        if (!scenarioBar) return;
        scenarioBar.querySelectorAll('.scenario-btn').forEach(function (b) {
          b.setAttribute('aria-pressed', b.dataset.scenario === currentScenario ? 'true' : 'false');
        });
      }
      function setScenario(name) {
        if (name === currentScenario) return;
        currentScenario = name;
        updateScenarioButtons();
        if (animationId) { cancelAnimationFrame(animationId); animationId = null; }
        if (renderer) { renderer.dispose(); renderer = null; }
        doorPivots.length = 0;
        clickableMeshes.length = 0;
        sceneUpdaters.length = 0;
        buildScene();
        requestAnimationFrame(resizeRenderer);
      }
      if (scenarioBar) {
        updateScenarioButtons();
        scenarioBar.addEventListener('click', function (e) {
          const btn = e.target.closest('.scenario-btn');
          if (!btn) return;
          ensureThree().then(function () { setScenario(btn.dataset.scenario); });
        });
      }

      function loadScript(src) {
        return new Promise(function (resolve, reject) {
          const s = document.createElement('script');
          s.src = src;
          s.onload = resolve;
          s.onerror = reject;
          document.head.appendChild(s);
        });
      }

      function ensureThree() {
        if (threeLoaded) return Promise.resolve();
        return loadScript('https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js')
          .then(function () {
            return loadScript('https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js');
          })
          .then(function () { threeLoaded = true; });
      }

      // 1 unidad de escena = 1 cm. En el escenario "home" la taquilla se
      // dibuja un 25% más grande (a petición expresa), ya que ahí se veía
      // pequeña al lado del edificio; el resto de escenarios no cambian.
      function mmToUnits(mm) { return mm / 10 * (currentScenario === 'home' ? 1.25 : 1); }

      function buildScene() {
        const data = window.LOCKER_3D_DATA || { groups: [], doorColor: '#3a9efc', bodyColor: '#111', fondoMm: 400, doorWidthMm: 380 };

        scene = new THREE.Scene();
        scene.background = new THREE.Color(0xeef2f7);

        const amb = new THREE.AmbientLight(0xffffff, 0.65);
        scene.add(amb);
        const dir = new THREE.DirectionalLight(0xffffff, 0.7);
        dir.position.set(80, 140, 120);
        scene.add(dir);
        const dir2 = new THREE.DirectionalLight(0xffffff, 0.3);
        dir2.position.set(-80, 60, -100);
        scene.add(dir2);

        const depth = mmToUnits(data.fondoMm || 400);
        const colW  = mmToUnits(data.doorWidthMm || 380);
        const sideW = mmToUnits(25);
        const groupGap = mmToUnits(450);

        const doorMat = new THREE.MeshStandardMaterial({ color: data.doorColor || '#3a9efc', roughness: 0.6, metalness: 0.05 });
        const bodyMat = new THREE.MeshStandardMaterial({ color: data.bodyColor || '#111111', roughness: 0.7, metalness: 0.05 });
        const legMat  = new THREE.MeshStandardMaterial({ color: 0xc7c9cc, roughness: 0.5, metalness: 0.3 });
        const edges   = new THREE.LineBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.25 });

        // Mismas posiciones de patas que usa el dibujo 2D, según el número
        // de columnas de la agrupación.
        function legPositionsFor(n) {
          if (n === 1) return [1];
          if (n === 2) return [1, 2];
          if (n === 3) return [1, 3];
          if (n === 4) return [2, 3];
          if (n === 5) return [2, 4];
          if (n === 6) return [2, 4, 6];
          if (n === 7) return [2, 4, 6, 7];
          if (n === 8) return [2, 4, 6, 8];
          if (n === 9) return [2, 4, 7, 8];
          return [2, 4, 7, 9];
        }

        // Para "pantalla" y "buzón": mismo color de puerta en todas las
        // caras, menos la frontal (+z), donde se pega la foto real. Se
        // compone sobre un lienzo del color de puerta (en vez de usar
        // transparencia 3D, que dejaría ver el interior de la caja en los
        // huecos transparentes del PNG).
        const frontTextureMatsCache = {};
        function makeFrontTextureMats(imageUrl, heightMultiplier) {
          if (!imageUrl) return doorMat;
          const cacheKey = imageUrl + '|' + (heightMultiplier || 1);
          if (frontTextureMatsCache[cacheKey]) return frontTextureMatsCache[cacheKey];

          const frontMat = new THREE.MeshStandardMaterial({ color: data.doorColor || '#3a9efc', roughness: 0.4, metalness: 0.1 });
          const img = new Image();
          img.crossOrigin = 'anonymous';
          img.onload = function () {
            const size = 512;
            const canvas = document.createElement('canvas');
            canvas.width = size;
            canvas.height = size;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = data.doorColor || '#3a9efc';
            ctx.fillRect(0, 0, size, size);
            const scale = Math.min(size / img.width, size / img.height);
            const dw = img.width * scale;
            const dh = img.height * scale * (heightMultiplier || 1);
            ctx.drawImage(img, (size - dw) / 2, (size - dh) / 2, dw, dh);
            const texture = new THREE.CanvasTexture(canvas);
            frontMat.map = texture;
            frontMat.color.set(0xffffff);
            frontMat.needsUpdate = true;
          };
          img.src = imageUrl;

          const mats = [doorMat, doorMat, doorMat, doorMat, frontMat, doorMat];
          frontTextureMatsCache[cacheKey] = mats;
          return mats;
        }

        const screenMats = makeFrontTextureMats(data.screenImageUrl);

        function mailboxImageUrl(blk) {
          const imgs = data.mailboxImages || {};
          if (blk.electronico) return blk.tarjetero ? imgs.elecTarj : imgs.elecNoTarj;
          return blk.tarjetero ? imgs.mecTarj : imgs.mecNoTarj;
        }

        function addBox(w, h, d, mat, x, y, z) {
          const geo = new THREE.BoxGeometry(w, h, d);
          const mesh = new THREE.Mesh(geo, mat);
          mesh.position.set(x, y, z);
          scene.add(mesh);
          const line = new THREE.LineSegments(new THREE.EdgesGeometry(geo), edges);
          line.position.copy(mesh.position);
          scene.add(line);
          return mesh;
        }

        // Caja "hueca": representa una puerta como un compartimento vacío
        // (fondo, techo, suelo y dos lados), sin tapa frontal, para que se
        // vea el interior en vez de un bloque sólido.
        function addOpenBox(w, h, d, mat, x, y, z) {
          const t = Math.max(0.5, Math.min(w, h) * 0.03);
          addBox(w, h, t, mat, x, y, z - d / 2 + t / 2);       // fondo
          addBox(w, t, d, mat, x, y + h / 2 - t / 2, z);       // techo
          addBox(w, t, d, mat, x, y - h / 2 + t / 2, z);       // suelo
          addBox(t, h, d, mat, x - w / 2 + t / 2, y, z);       // lateral izq.
          addBox(t, h, d, mat, x + w / 2 - t / 2, y, z);       // lateral der.
        }

        // Hoja de puerta: una tapa fina delante del hueco, con la bisagra en
        // el borde derecho. Al pulsarla, gira alrededor de esa bisagra como
        // una puerta real. Se añade a "clickableMeshes" para poder detectarla
        // con el raycaster en el click.
        const methacrylateGlassMat = new THREE.MeshStandardMaterial({
          color: 0x8fdfef, roughness: 0.25, metalness: 0.0,
          transparent: true, opacity: 0.55, side: THREE.DoubleSide
        });

        function addDoorLeaf(w, h, mat, x, y, z, methacrylate) {
          const t = mmToUnits(8);
          const pivot = new THREE.Group();
          pivot.position.set(x + w / 2, y, z);

          let mesh;
          if (methacrylate) {
            // Metacrilato: un marco (mismo color/grosor que una puerta
            // normal) con una ventana de cristal translúcido empotrada en
            // el mismo plano (no una capa por delante), ocupando ~80% del
            // ancho y alto. Sigue siendo UNA sola hoja: se abre y cierra
            // por la misma bisagra que las demás puertas.
            const glassW = w * 0.7;
            const glassH = h * 0.7;

            // Marco de UNA sola pieza (un rectángulo exterior con un hueco
            // rectangular interior, extruido), en vez de 4 listones pegados,
            // para que no se vean las uniones entre ellos.
            const frameShape = new THREE.Shape();
            frameShape.moveTo(-w, -h / 2);
            frameShape.lineTo(0, -h / 2);
            frameShape.lineTo(0, h / 2);
            frameShape.lineTo(-w, h / 2);
            frameShape.lineTo(-w, -h / 2);
            const glassHole = new THREE.Path();
            glassHole.moveTo(-w / 2 - glassW / 2, -glassH / 2);
            glassHole.lineTo(-w / 2 + glassW / 2, -glassH / 2);
            glassHole.lineTo(-w / 2 + glassW / 2, glassH / 2);
            glassHole.lineTo(-w / 2 - glassW / 2, glassH / 2);
            glassHole.lineTo(-w / 2 - glassW / 2, -glassH / 2);
            frameShape.holes.push(glassHole);

            const frameGeo = new THREE.ExtrudeGeometry(frameShape, { depth: t, bevelEnabled: false });
            frameGeo.translate(0, 0, -t / 2);
            const frameMesh = new THREE.Mesh(frameGeo, mat);
            pivot.add(frameMesh);
            const frameLine = new THREE.LineSegments(new THREE.EdgesGeometry(frameGeo), edges);
            pivot.add(frameLine);

            const glassGeo = new THREE.BoxGeometry(glassW, glassH, t);
            const glassMesh = new THREE.Mesh(glassGeo, methacrylateGlassMat);
            glassMesh.position.set(-w / 2, 0, 0);
            pivot.add(glassMesh);
            const glassLine = new THREE.LineSegments(new THREE.EdgesGeometry(glassGeo), edges);
            glassLine.position.copy(glassMesh.position);
            pivot.add(glassLine);

            // Toda la hoja (marco + cristal) debe reaccionar al click, no
            // solo un listón estrecho: si no, solo se podría abrir tocando
            // ese borde en vez de cualquier punto de la puerta.
            scene.add(pivot);
            const pivotIndexForDoor = doorPivots.length;
            [frameMesh, glassMesh].forEach(function (clickable) {
              clickable.userData.doorPivotIndex = pivotIndexForDoor;
              clickableMeshes.push(clickable);
            });
            doorPivots.push({ pivot: pivot, open: false });
            return;
          } else {
            const geo = new THREE.BoxGeometry(w, h, t);
            mesh = new THREE.Mesh(geo, mat);
            mesh.position.set(-w / 2, 0, 0);
            const line = new THREE.LineSegments(new THREE.EdgesGeometry(geo), edges);
            line.position.copy(mesh.position);
            pivot.add(mesh);
            pivot.add(line);
          }

          scene.add(pivot);

          mesh.userData.doorPivotIndex = doorPivots.length;
          doorPivots.push({ pivot: pivot, open: false });
          clickableMeshes.push(mesh);
        }

        let cursorX = 0;
        let maxHeight = 0;
        const groups = Array.isArray(data.groups) ? data.groups : [];
        // Rango real (x0,x1) de cada grupo de columnas, para poder dejar un
        // hueco en la pared por cada uno (si es "empotrado") sin rellenar
        // también el espacio/separación entre grupos.
        const lockerGroupRanges = [];

        // Si lleva patas o brazos de soporte a suelo, todo el bloque de la
        // taquilla se eleva esa altura y son las patas las que quedan
        // apoyadas en el suelo (y=0), no la propia taquilla. Si es
        // "colgado" o "empotrado" (atornillada/encastrada en la pared, sin
        // patas ni soporte en el suelo), también debe quedar elevada del
        // suelo, al menos 50cm.
        const legsApply = !!(data.isSoporteSuelo && (data.bracketType === 'patas' || data.bracketType === 'brazos'));
        const legHeight = mmToUnits(700);
        const isColgado = data.instalacion === 'colgado';
        const isEmpotrado = data.instalacion === 'empotrado';
        const baseY = legsApply ? legHeight : ((isColgado || isEmpotrado) ? mmToUnits(500) : 0);

        groups.forEach(function (cols3d) {
          if (!Array.isArray(cols3d) || cols3d.length === 0) return;
          const numCols = cols3d.length;
          const groupWidth = numCols * colW + sideW * 2;
          const groupStartX = cursorX;

          cols3d.forEach(function (doorBlocks, colIdx) {
            const blocks = Array.isArray(doorBlocks) ? doorBlocks : [];
            const colTotalH = blocks.reduce(function (s, b) { return s + mmToUnits(b.h || 125); }, 0);
            let cursorY = colTotalH;
            blocks.forEach(function (blk) {
              // El primer bloque de la lista es el de más arriba en el dibujo
              // 2D, así que aquí se apila también de arriba hacia abajo.
              const h = mmToUnits(blk.h || 125);
              cursorY -= h;
              const cx = groupStartX + sideW + colIdx * colW + colW / 2;
              const cy = cursorY + h / 2 + baseY;
              if (blk.type === 'screen') {
                addOpenBox(colW - 0.4, h - 0.4, depth - 2, doorMat, cx, cy, depth / 2);
                // La pantalla no se abre: se pone a ras de la misma cara
                // exterior que las puertas cerradas, en vez de hundida.
                const screenDepth = mmToUnits(60);
                const frontZ = depth + mmToUnits(4);
                addBox(colW - 0.4, h - 0.4, screenDepth, screenMats, cx, cy, frontZ - screenDepth / 2);
              } else if (blk.type === 'mailbox') {
                // El buzón sí se abre, como una puerta normal, pero con la
                // foto del buzón en la cara exterior de la hoja.
                addOpenBox(colW - 0.4, h - 0.4, depth - 2, doorMat, cx, cy, depth / 2);
                const mailboxMats = makeFrontTextureMats(mailboxImageUrl(blk), 2);
                addDoorLeaf(colW - 0.4, h - 0.4, mailboxMats, cx, cy, depth);
              } else {
                addOpenBox(colW - 0.4, h - 0.4, depth - 2, doorMat, cx, cy, depth / 2);
                addDoorLeaf(colW - 0.4, h - 0.4, doorMat, cx, cy, depth, !!blk.methacrylate);
              }
            });
            if (colTotalH > maxHeight) maxHeight = colTotalH;
          });

          // El tejado se añade POR ENCIMA del bloque de puertas, no comido
          // de su altura, así que los laterales y el fondo tienen que llegar
          // hasta ahí arriba también para que no quede un hueco detrás.
          const totalHeightWithRoof = maxHeight + sideW;

          // Laterales (paneles de cuerpo a izquierda y derecha del grupo)
          addBox(sideW, totalHeightWithRoof, depth, bodyMat, groupStartX + sideW / 2, baseY + totalHeightWithRoof / 2, depth / 2);
          addBox(sideW, totalHeightWithRoof, depth, bodyMat, groupStartX + groupWidth - sideW / 2, baseY + totalHeightWithRoof / 2, depth / 2);

          // Planchas de fondo, tejado y suelo (cierran el mueble por detrás, por arriba y por abajo)
          const panelT = mmToUnits(10);
          addBox(groupWidth, totalHeightWithRoof, panelT, bodyMat, groupStartX + groupWidth / 2, baseY + totalHeightWithRoof / 2, panelT / 2);
          addBox(groupWidth, sideW, depth, bodyMat, groupStartX + groupWidth / 2, baseY + totalHeightWithRoof - sideW / 2, depth / 2);
          addBox(groupWidth, panelT, depth, bodyMat, groupStartX + groupWidth / 2, baseY + panelT / 2, depth / 2);

          // Patas/brazos de soporte a suelo (solo home + soporte_suelo):
          // van desde el suelo (y=0) hasta la base de la taquilla (y=baseY).
          if (legsApply) {
            const legSize = mmToUnits(40) * 1.5 * 1.2;
            const footSize = legSize * 4;
            const footHeight = mmToUnits(15);
            const addLegAt = function (x) {
              addBox(legSize, legHeight, legSize, legMat, x, legHeight / 2, depth / 2);
              // Pie: placa plana donde la pata se apoya realmente en el suelo.
              addBox(footSize, footHeight, footSize, legMat, x, footHeight / 2, depth / 2);
            };
            // Brazo: poste que sube por el lateral del mueble, algo más bajo
            // que el propio mueble (no llega hasta arriba del tejado),
            // separado un poco hacia afuera y unido al lateral con dos
            // puntos de anclaje.
            const armTotalHeight = (baseY + maxHeight) * 0.92;
            const armOuterGap = legSize * 1.6;
            const anchorT = mmToUnits(70);
            const anchorDepth = legSize * 0.9;
            const addArmAt = function (x, lockerEdgeX) {
              addBox(legSize, armTotalHeight, legSize, legMat, x, armTotalHeight / 2, depth / 2);
              addBox(footSize, footHeight, footSize, legMat, x, footHeight / 2, depth / 2);

              // Orejetas de anclaje: unen la cara interior del poste (la que
              // mira al mueble) con el lateral del mueble, a dos alturas.
              const dir = lockerEdgeX > x ? 1 : -1;
              const postInnerFaceX = x + dir * legSize / 2;
              const anchorWidth = Math.abs(lockerEdgeX - postInnerFaceX);
              const anchorCenterX = (postInnerFaceX + lockerEdgeX) / 2;
              [0.68, 0.88].forEach(function (frac) {
                addBox(anchorWidth, anchorT, anchorDepth, legMat, anchorCenterX, armTotalHeight * frac, depth / 2);
              });
            };

            if (data.bracketType === 'patas') {
              legPositionsFor(numCols).forEach(function (pos) {
                addLegAt(groupStartX + sideW + (pos - 1) * colW + colW / 2);
              });
            } else {
              // Brazos: un poste alto en cada extremo del grupo (desplazado
              // hacia afuera) y, si es ancho (5+ columnas), refuerzo
              // intermedio (patas cortas) en las mismas posiciones que usan
              // las patas.
              addArmAt(groupStartX - armOuterGap, groupStartX);
              addArmAt(groupStartX + groupWidth + armOuterGap, groupStartX + groupWidth);
              if (numCols >= 5) {
                legPositionsFor(numCols).forEach(function (pos) {
                  addLegAt(groupStartX + sideW + (pos - 1) * colW + colW / 2);
                });
              }
            }
          }

          lockerGroupRanges.push({ x0: groupStartX, x1: groupStartX + groupWidth });
          cursorX = groupStartX + groupWidth + groupGap;
        });

        const totalWidth = Math.max(cursorX - groupGap, colW);

        // Entorno muy esquemático (solo para "home"): un suelo y una pared
        // de fondo neutros, para dar la idea de un portal/vestíbulo sin
        // modelar un edificio real.
        let officeCameraMaxDistZ = null;
        let officeCameraHalfWidth = null;
        // Distancia mínima de cámara forzada para escenarios cuyo entorno
        // (árboles, farola, banco...) es mucho más ancho que la propia
        // taquilla: sin esto, la cámara se queda pegada al mueble y el
        // escenario alrededor se ve diminuto/cortado.
        let minCameraDist = null;
        // Posición/objetivo de cámara fijos, para escenarios con una
        // composición concreta (p.ej. la calle del edificio) que no
        // encajan bien con el encuadre genérico basado solo en el tamaño
        // de la taquilla.
        let cameraPosOverride = null;
        let cameraTargetOverride = null;

        // Margen alrededor de cada grupo de taquillas para que el hueco
        // también cubra el arco que barren las puertas al abrirse, no solo
        // su silueta cerrada.
        const lockerHoleMarginX = mmToUnits(5);
        const lockerHoleMarginY = mmToUnits(5);

        // Huecos por grupo (con margen). El margen (3cm) puede ser mayor
        // que la mitad de la separación real entre grupos (p.ej. 5cm de
        // "groupGap"), así que un simple recorte a medias dejaría CERO
        // pared entre huecos vecinos (el hueco entre taquillas se vería
        // vacío). Por eso, tras darles el margen completo, se fuerza un
        // mínimo de pared entre huecos consecutivos, encogiéndolos a medias
        // solo lo necesario para dejar sitio a esa franja.
        const lockerMinWallBetween = mmToUnits(20);
        const lockerHoleSegments = lockerGroupRanges.map(function (r) {
          return { x0: r.x0 - lockerHoleMarginX, x1: r.x1 + lockerHoleMarginX };
        });
        for (let i = 0; i < lockerHoleSegments.length - 1; i++) {
          const a = lockerHoleSegments[i], b = lockerHoleSegments[i + 1];
          const shrink = (a.x1 - b.x0 + lockerMinWallBetween) / 2;
          if (shrink > 0) { a.x1 -= shrink; b.x0 += shrink; }
        }

        // Cuando la taquilla es "empotrada", la pared se adelanta hasta casi
        // tocar su cara frontal (ver más abajo), así que si se deja como un
        // plano sólido completo, las puertas al abrirse "atraviesan" la
        // pared en pantalla. Esta función deja un hueco por cada grupo de
        // columnas (con margen), rellenando tanto los bordes como el hueco
        // entre grupos con el resto de la pared.
        // matOrFn: o un material fijo (paredes de color liso, sin textura
        // que alinear), o una función (w, h, worldLeftX, worldBottomY) =>
        // material, para texturas tipo ladrillo/azulejo que necesitan su
        // propio recorte alineado en cada pieza (si no, el patrón "salta"
        // en la unión entre piezas). No se usa addBox aquí a propósito: el
        // contorno negro que añade se veía como un corte visible en las
        // paredes de color liso.
        function addWallWithLockerHoles(matOrFn, x0, x1, y0, y1, z, holes, holeY0, holeY1) {
          const isMatFn = typeof matOrFn === 'function';
          function piece(px0, px1, py0, py1) {
            const w = px1 - px0, h = py1 - py0;
            if (w <= 0 || h <= 0) return;
            const mat = isMatFn ? matOrFn(w, h, px0, py0) : matOrFn;
            const mesh = new THREE.Mesh(new THREE.PlaneGeometry(w, h), mat);
            mesh.position.set((px0 + px1) / 2, (py0 + py1) / 2, z);
            scene.add(mesh);
          }
          holeY0 = Math.max(holeY0, y0); holeY1 = Math.min(holeY1, y1);
          if (holeY0 >= holeY1) {
            // No hay banda intermedia válida (huecos fuera de rango): la
            // pared queda sólida en todo el ancho y alto de la pieza.
            piece(x0, x1, y0, y1);
            return;
          }
          piece(x0, x1, y0, holeY0);
          piece(x0, x1, holeY1, y1);
          const sorted = holes
            .map(function (h) { return { x0: Math.max(h.x0, x0), x1: Math.min(h.x1, x1) }; })
            .filter(function (h) { return h.x1 > h.x0; })
            .sort(function (a, b) { return a.x0 - b.x0; });
          let cursor = x0;
          sorted.forEach(function (h) {
            piece(cursor, h.x0, holeY0, holeY1);
            cursor = Math.max(cursor, h.x1);
          });
          piece(cursor, x1, holeY0, holeY1);
        }

        if (currentScenario === 'home') {
          // Entorno "home": port fiel del archivo de referencia (edificio
          // de 4 plantas + calle con coches, árboles, farolas, jardinera y
          // banco), con sus mismas medidas fijas (en metros, vía "mU").
          // Todo (menos la propia taquilla, que es la real) vive dentro de
          // un único grupo "city" que solo se desplaza en bloque para que
          // el portal quede junto a la taquilla real, sin tener que
          // reescalar ninguna proporción del edificio.
          const mU = function (m) { return m * 100; }; // metros -> unidades (1 unidad = 1cm)
          function makeHomeTex(w, h, draw, rx, ry) {
            const canvas = document.createElement('canvas');
            canvas.width = w; canvas.height = h;
            draw(canvas.getContext('2d'), w, h);
            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(rx, ry);
            return tex;
          }
          function rngHome(seed) {
            return function () { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
          }

          const city = new THREE.Group();
          scene.add(city);

          // Medidas del edificio, fijas (como en el archivo original),
          // ensanchadas solo lo justo si la taquilla no cupiera dentro.
          const totalWidthM = totalWidth / 100;
          const BW = Math.max(18, totalWidthM * 2 + 14);
          const BD = 12;
          const GFm = Math.max(3.6, (baseY + maxHeight) / 100 + 1.0);
          const FHm = 3, NF = 4;
          const G = 0.15; // altura de la acera, como en el archivo original

          // Si es "empotrado", todo el grupo se adelanta en Z hasta casi
          // tapar el fondo de la taquilla, para que parezca encastrada en
          // la pared en vez de pegada delante.
          const homeEmbedShiftZ = isEmpotrado ? Math.max(depth - mmToUnits(50), mmToUnits(10)) : 0;
          // Desplazamiento en X: deja la taquilla real a la derecha del
          // portal (que está en x=0 local, igual que en el archivo
          // original), en vez de a la izquierda, para que solo ocupe esa
          // zona de la fachada.
          const cityOffsetX = -mU(4.0);
          // -mU(G): la acera del archivo original está elevada esos 15cm
          // sobre su "suelo", pero la taquilla real siempre se apoya en
          // y=0 (no conoce esta escena), así que sin este ajuste quedaría
          // hundida en la acera. Bajando todo el grupo esa misma altura,
          // la acera queda a ras del y=0 real.
          city.position.set(cityOffsetX, -mU(G), homeEmbedShiftZ);

          function cbox(w, h, d, m, x, y, z, parent) {
            const mesh = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), m);
            mesh.position.set(x, y, z);
            (parent || city).add(mesh);
            return mesh;
          }

          // --- Texturas (iguales que en el archivo original) ---
          const pavingTex = makeHomeTex(512, 512, function (g, w, h) {
            const r = rngHome(7), tones = ['#e4ddd3', '#d6cec2', '#cbc2b5', '#ebe6de', '#ddd5ca'];
            g.fillStyle = '#f1ede6'; g.fillRect(0, 0, w, h);
            for (let y = 0; y < 16; y++) {
              const off = (y % 2) * 32;
              for (let x = -1; x <= 8; x++) { g.fillStyle = tones[Math.floor(r() * 5)]; g.fillRect(x * 64 + off + 2, y * 32 + 2, 60, 28); }
            }
          }, mU(64) / mU(2), mU(23) / mU(2));
          const stoneTexBase = makeHomeTex(512, 256, function (g, w, h) {
            const r = rngHome(3), tones = ['#e2dacd', '#d6cdbd', '#ebe5da', '#cfc5b4', '#ddd4c5'];
            g.fillStyle = '#f6f4ef'; g.fillRect(0, 0, w, h);
            for (let y = 0; y < 6; y++) {
              const off = (y % 2) * 64;
              for (let x = -1; x <= 4; x++) { g.fillStyle = tones[Math.floor(r() * 5)]; g.fillRect(x * 128 + off + 4, y * 48 + 4, 120, 40); }
            }
          }, 1, 1);
          const asphaltTex = makeHomeTex(256, 256, function (g, w, h) {
            g.fillStyle = '#4b4e54'; g.fillRect(0, 0, w, h);
            const r = rngHome(19);
            for (let i = 0; i < 2600; i++) {
              const v = 60 + Math.floor(r() * 40);
              g.fillStyle = 'rgb(' + v + ',' + (v + 2) + ',' + (v + 6) + ')';
              g.fillRect(r() * w, r() * h, 2, 2);
            }
          }, 20, 3);

          // --- Materiales (mismos colores que el archivo original) ---
          const M = {
