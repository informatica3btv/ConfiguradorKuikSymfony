{% extends 'layout.html.twig' %}

{% set p = payload ?? {} %}
{% if p is not iterable %}{% set p = {} %}{% endif %}

{% set groups = p.groups ?? [] %}
{% if groups is not iterable %}{% set groups = [] %}{% endif %}

{% set columnsFlat = p.columns ?? [] %}
{% if columnsFlat is not iterable %}{% set columnsFlat = [] %}{% endif %}

{% if groups is empty and columnsFlat is not empty %}
  {% set groups = [columnsFlat] %}
{% endif %}

{% set columnsAll = [] %}
{% for g in groups %}
  {% if g is iterable %}
    {% set columnsAll = columnsAll|merge(g) %}
  {% endif %}
{% endfor %}

{% set type = p.type ?? '' %}
{% set instalacion = p.instalacion ?? '' %}

{% set doorColor = p.colorDoor ?? '#3a9efc' %}
{% set doorColorRal = p.colorDoorRal ?? '' %}
{% set bodyColor = p.colorBody ?? '#000' %}
{% set bodyColorRal = p.colorBodyRal ?? '' %}

{% set bg = p.fondo ?? '' %}
{% set placement = p.placement ?? '' %}
{% set material = p.material ?? '' %}
{% set addons = p.addons ?? {} %}

{% set isHome = (type == 'home') %}
{% set isHomeSerie400 = isHome and bg == '400' %}
{% set fondoMm = isHomeSerie400 ? 403 : (kuik.fondo_mm[bg] ?? null) %}
{% set isZocalo = (isHome and instalacion == 'zocalo') %}
{% set isEmpotradoLike = (isHome and (instalacion == 'empotrado' or instalacion == 'soporte_suelo' or instalacion == 'colgado')) %}

{% set topCap = isZocalo ? (p.topCap|default(kuik.default_top_cap)) : kuik.default_top_cap %}
{% set bottomCap = isZocalo ? 70 : kuik.default_bottom_cap %}
{% set singleCap = isEmpotradoLike ? (p.singleCap|default(40)) : kuik.default_single_cap %}

{% set selectedType  = p.bracketType ?? '' %}
{% set selectedColor = p.bracketColor ?? '' %}
{% set isSoporteSuelo = (instalacion == 'soporte_suelo') %}
{% set mbLegPos = p.mbLegPositions ?? [] %}
{% if mbLegPos is not iterable %}{% set mbLegPos = [] %}{% endif %}
{% set mbLegPosSelected = mbLegPos|length > 0 ? mbLegPos[0] : null %}
{# Para patas: posiciones automáticas según mbCols (se calcula al renderizar cada grupo) #}

{% set bgLabel =
  bg == '300'  ? 'Serie 300' :
  bg == '400'  ? 'Serie 400' :
  bg == '500'  ? 'Serie 500' : '—'
%}

{# ========================================================
   Datos para la vista 3D (ver botón "Ver en 3D" más abajo).
   Reconstruye, de forma simplificada, la geometría a partir
   del mismo payload que usa el dibujo 2D: una lista de grupos,
   cada uno con sus columnas, y cada columna con sus puertas
   (altura real en mm de cada una).
   ======================================================== #}
{% set groups3d = [] %}
{% for groupCols in groups %}
  {% if groupCols is not iterable %}{% set groupCols = [] %}{% endif %}
  {% set cols3d = [] %}
  {% for col in groupCols %}
    {% set isColEmpotrado = (col.single is defined and col.single is not empty) %}
    {% if isColEmpotrado %}
      {% set srcBlocks = col.single.blocks_prepared ?? col.single.blocks ?? [] %}
    {% else %}
      {% set srcBlocks = (col.top.blocks_prepared ?? col.top.blocks ?? [])|merge(col.bottom.blocks_prepared ?? col.bottom.blocks ?? []) %}
    {% endif %}
    {% set doorBlocks = [] %}
    {% for blk in srcBlocks %}
      {% set hh = blk.h|default(blk) %}
      {% set hmm = kuik.h_heights_mm[hh] is defined ? kuik.h_heights_mm[hh] : (hh * kuik.h_unit_mm) %}
      {% set btype = blk.type|default('door') %}
      {% set doorBlocks = doorBlocks|merge([{
        'h': hmm,
        'type': btype,
        'electronico': blk.electronico ?? false,
        'tarjetero': blk.tarjetero ?? false
      }]) %}
    {% endfor %}
    {% set cols3d = cols3d|merge([doorBlocks]) %}
  {% endfor %}
  {% set groups3d = groups3d|merge([cols3d]) %}
{% endfor %}

{# Ancho de columna (mm) según la serie de fondo, y alto de la agrupación (125 por cada H10) #}
{% set colWidthLabel = isHomeSerie400 ? 380 : (bg in ['300', '400', '500'] ? bg : null) %}
{% set groupWidthExtraMm = 50 %}
{% set totalHUnits = isEmpotradoLike ? singleCap : (topCap + bottomCap) %}
{% set groupHeightLabel = kuik.h_heights_mm[totalHUnits] is defined ? kuik.h_heights_mm[totalHUnits] : (totalHUnits / 10 * 125)|round %}
{% if isZocalo %}
  {% set groupHeightLabel = groupHeightLabel + 177 %}
{% endif %}
{% set groupHeightPx = totalHUnits * kuik.scale %}

{% set placementLabel =
  placement == 'interior' ? 'Interior' :
  placement == 'exterior' ? 'Exterior' : '—'
%}

{% block page_title %}{{ 'summary.page_title'|trans }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --hscale: {{ kuik.scale }};

      --bg:#f6f9fc;
      --ink:#0b1220;
      --muted:#6b7280;
      --line: rgba(15,23,42,.12);
      --shadow: 0 10px 25px rgba(2,20,60,.10);
      --shadow-sm: 0 6px 14px rgba(2,20,60,.10);

      --kuik-blue-900:#003b73;
      --kuik-blue-600:#0b76d8;
      --kuik-blue-500:#1187e6;
    }

    .page-wrap{
      max-width: 100%;
      margin: 22px auto 50px;
      padding: 0 14px;
    }

    .page-head{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:14px;
      flex-wrap:wrap;
      margin-bottom:14px;
    }

    .page-title{
      margin:0;
      font-size:34px;
      font-weight:900;
      letter-spacing:-0.02em;
    }

    .page-sub{
      margin-top:6px;
      color:var(--muted);
      font-size:15px;
      display:flex;
      align-items:center;
      gap:10px;
      flex-wrap:wrap;
    }

    .grid{
      display:grid;
      grid-template-columns: 1.35fr .75fr;
      gap:14px;
      align-items:start;
    }
    @media (max-width: 980px){
      .grid{ grid-template-columns: 1fr; }
    }

    .card{
      background:#fff;
      border:1px solid var(--line);
      min-width: 0;
      border-radius:16px;
      padding:16px;
      box-shadow: 0 1px 0 rgba(15,23,42,.04);
    }

    .card h3{
      margin:0 0 12px;
      font-size:16px;
      font-weight:900;
      letter-spacing:-0.01em;
    }

    .section-sep{
      height:1px;
      background: rgba(15,23,42,.10);
      margin:14px 0;
    }

    .kvs{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:10px;
    }

    .kv{
      border:1px solid rgba(15,23,42,.10);
      border-radius:14px;
      padding:10px 12px;
      background:#fbfcfe;
    }
    .kv .k{ font-size:12px; color:var(--muted); font-weight:900; }
    .kv .v{ font-size:14px; font-weight:900; margin-top:4px; color:var(--ink); }

    .preview-wrap{
      border:1px solid rgba(15,23,42,.10);
      border-radius:16px;
      padding:12px;
      overflow: visible;
      min-width: 0;
      display:flex;
      align-items:flex-start;
      gap:16px;
    }

    .preview-scroll{
      overflow-x: auto;
      padding-bottom: 8px;
      cursor: grab;
      user-select: none;
      flex: 1 1 auto;
      min-width: 0;
    }

    .preview-scroll.is-dragging{
      cursor: grabbing;
    }

    /* Bisel de profundidad (fondo) integrado en el propio dibujo del mueble.
       Se usa transform:skew (bien soportado por html2canvas) en vez de
       clip-path/filter (mal soportados: se veían planos en la captura del PDF). */
    .depth-top{
      position:absolute;
      top:-30px;
      left:0px;
      width:100%;
      height:25px;
      background: linear-gradient(rgba(255,255,255,.25), rgba(255,255,255,.25)), var(--col-border);
      transform-origin: left bottom;
      transform: skewX(-49deg);
      z-index:1;
    }
    .depth-right{
      position:absolute;
      top:-5px;
      left:100%;
      width:29px;
      height: 101.1%;
      background: linear-gradient(rgba(0,0,0,.2), rgba(0,0,0,.2)), var(--col-border);
      transform-origin: left top;
      transform: skewY(-41deg);
      z-index:1;
    }
    .depth-label{
      position:absolute;
      right:-48px;
      bottom:-4px;
      display:flex;
      flex-direction:column;
      align-items:center;
      transform: rotate(-41deg);
      transform-origin: right center;
      z-index:4;
    }
    .depth-label .dim-row{
      width:50px;
    }
    .depth-label .dim-value{
      white-space:nowrap;
    }

    .preview-stage{
      position: relative;
      overflow: visible;
      display:flex;
      justify-content:flex-start;
      align-items:flex-start;
      padding-bottom: 175px;
      width: max-content;
      min-width: 100%;
    }

    .groups-stage{
      display:flex;
      flex-direction:column;
      gap:155px;
      align-items:center;
      width: max-content;
    }

    .group-label{
      font-weight:900;
      color:#0b1220;
      font-size:14px;
      margin:6px 0 20px;
      text-align:center;
    }

    .cols-and-mb{
      position:relative;
      display:flex;
      flex-direction:row;
      align-items:flex-start;
      gap:0;
    }

    .cols{
      display:grid;
      grid-template-columns: repeat(var(--colsN), 135px);
      justify-content:center;
      align-items:flex-start;
      margin-top:-5px;
    }

    .col-shell{
      width:{{ kuik.col_width_px }}px;
      display:flex;
      flex-direction:column;
      gap:6px;
    }

    .col-card{
      width:{{ kuik.col_width_px }}px;
      border-style:solid;
      border-color: var(--col-border, #000);
      border-left-width:4px;
      border-right-width:4px;
      border-top-width:8px;
      border-bottom-width:8px;
      overflow:visible;
      background:#f7f7f7;
      box-shadow: var(--shadow);
      position: relative;
      z-index: 2;
    }

    /* Grupo de buzones: bloque único con un solo borde exterior */
    .mb-group-block {
      display: flex;
      flex-direction: row;
      border-style: solid;
      border-color: var(--col-border, #000);
      border-left-width: 4px;
      border-right-width: 4px;
      border-top-width: 8px;
      border-bottom-width: 8px;
      overflow: visible;
      //box-shadow: var(--shadow);
      position: relative;
      z-index: 2;
    }
    .mb-group-col {
      width: {{ kuik.mb_col_width_px }}px;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
    }
    .mb-group-col .door.mailbox {
      border: none;
      border-radius: 0;
    }

    .col-body{
      height:calc(180px * var(--hscale));
      background:#eaeaea;
      display:flex;
      flex-direction:column;
    }

    .col-half{
      height:calc(90px * var(--hscale));
      display:flex;
      flex-direction:column;
      overflow:visible;
    }

    .half-sep{
      border-top:2px dashed rgba(0,0,0,.28);
    }

    {% set huecoTintedUrl = tinted_image('assets/hueco6.png', bodyColor) %}
    .door{
      width:100%;
      /* Compartimento vacío que se intuye al abrir la puerta: foto real de
         un hueco (esquina + suelo), ya pre-teñida del color del cuerpo como
         PNG generado una vez por color (ver TintedImageService) — así se ve
         igual en el navegador y en la captura que hace html2canvas para el
         PDF (background-blend-mode no vale ahí, no lo soporta). */
      background: url('{{ huecoTintedUrl ?? asset('assets/hueco6.png') }}') center top / 100% 100% no-repeat, var(--col-border, #22262b);
      border-bottom: 1px solid rgba(0,0,0,.35);
      position:relative;
      box-sizing: border-box;
      cursor:pointer;
      z-index:1;
      perspective: 1400px;
    }

    /* .door = ranura estática (siempre con su tamaño/posición real, así se
       puede pulsar para cerrar aunque la hoja esté girada casi de perfil).
       .door-leaf = la hoja que realmente gira sobre la bisagra. */
    .door-leaf{
      width:100%;
      height:100%;
      display:flex;
      align-items:center;
      justify-content:center;
      position:relative;
      z-index:2;
      box-sizing: border-box;
      border:1px solid rgba(255,255,255,.6);
      background: var(--door-color, #3a9efc);
      transform-style: preserve-3d;
      transform-origin: right center;
      backface-visibility: hidden;
      transition: transform .55s cubic-bezier(.34,1.15,.64,1), box-shadow .55s ease;
      will-change: transform;
    }

    /* Canto/borde de la puerta en el lado que barre al abrirse (el
       contrario a la bisagra): da sensación de grosor real. */
    .door-leaf::before{
      content:"";
      position:absolute;
      top:0; left:0; bottom:0;
      width:6px;
      background: rgba(0,0,0,.32);
      transform: rotateY(90deg) translateX(-3px);
      transform-origin: left center;
      opacity:0;
      transition: opacity .5s ease;
      pointer-events:none;
    }

    .door.is-open .door-leaf{
      /* --door-skew se fija por puerta (inline), proporcional a su propia
         altura, para que el desplazamiento en px nunca se salga de su
         propio hueco (a diferencia de un ángulo fijo, cuyo desplazamiento
         depende del ancho, no de la altura, y desbordaba en puertas cortas) */
      transform: skewY(var(--door-skew, 0deg)) rotateY(64deg) translateZ(14px) translateX(-4px);
      box-shadow: -14px 10px 28px rgba(0,0,0,.5);
      z-index:5;
    }

    .door.is-open .door-leaf::before{ opacity:1; }

    /* Sombra sobre la propia hoja al girar, para que se note que pierde luz */
    .door-leaf::after{
      content:"";
      position:absolute;
      inset:0;
      background:
        linear-gradient(245deg, rgba(0,0,0,.5), rgba(0,0,0,.15) 40%, transparent 70%);
      opacity:0;
      transition: opacity .45s ease .1s;
      pointer-events:none;
    }

    .door.is-open .door-leaf::after{ opacity:1; }

    .door.screen{
      padding:0;
    }

    .door.screen .door-leaf{
      overflow:hidden;
    }

    .door.screen img{
      width:115%;
      height:115%;
      object-fit:contain;
      pointer-events:none;
      user-select:none;
    }

    .door.mailbox{
      padding:0;
    }

    .door.mailbox .door-leaf{
      overflow:hidden;
    }

    .door.mailbox img{
      position:absolute;
      top:0; left:0;
      width:100%;
      height:100%;
      object-fit:fill;
      pointer-events:none;
      user-select:none;
      display:block;
    }

    .door.methacrylate .door-leaf::after{
      content:"";
      position:absolute;
      inset:12px;
      background:rgba(0,0,0,.38);
      border-radius:4px;
      pointer-events:none;
      z-index:1;
    }

    .door .num,
    .door .badges{
      z-index:2;
    }

    .door .num{
      position:absolute;
      left:6px;
      top:4px;
      font-weight:900;
      font-size:12px;
      background: rgba(0,0,0,.65);
      color:#fff;
      border-radius:999px;
      padding:2px 7px;
      line-height:1.2;
    }

    .door .badges{
      position:absolute;
      right:6px;
      bottom:4px;
      display:flex;
      gap:4px;
      flex-wrap:wrap;
    }

    .door .size-label{
      position:relative;
      z-index:2;
      font-weight:900;
      font-size:16px;
      color:#fff;
      text-shadow:0 0 3px rgba(0,0,0,.7);
      pointer-events:none;
      user-select:none;
    }

    .badge-mini{
      font-size:10px;
      font-weight:900;
      background: rgba(255,255,255,.92);
      border:1px solid rgba(0,0,0,.18);
      border-radius:999px;
      padding:1px 5px;
    }

    .addons-table{
      width:100%;
      border-collapse:separate;
      border-spacing:0;
      margin-top:10px;
      border:1px solid rgba(15,23,42,.12);
      border-radius:14px;
      overflow:hidden;
      background:#fff;
    }

    .addons-table th,
    .addons-table td{
      padding:10px 12px;
      border-bottom:1px solid rgba(15,23,42,.08);
      font-size:14px;
      text-align:left;
    }

    .addons-table th{
      background:#fbfcfe;
      font-weight:900;
      color:#334155;
      font-size:12px;
    }

    .addons-table tr:last-child td{
      border-bottom:0;
    }

    .btn-row{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
      margin:14px;
    }

    .btn{
      border:1px solid rgba(15,23,42,.12);
      background:#fff;
      border-radius:12px;
      padding:10px 14px;
      font-weight:900;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      gap:10px;
      text-decoration:none;
      color:#0b1220;
      transition:.15s;
    }

    /* ===== Modal "Ver en 3D" ===== */
    .modal3d{ display:none; position:fixed; inset:0; z-index:1000; }
    .modal3d.is-open{ display:block; }
    .modal3d__backdrop{
      position:absolute; inset:0;
      background:rgba(2,6,23,.6);
    }
    .modal3d__dialog{
      position:absolute; top:4%; left:50%; transform:translateX(-50%);
      width:min(1100px, 94vw);
      height:88vh;
      background:#fff;
      border-radius:16px;
      box-shadow:0 30px 70px rgba(2,6,23,.4);
      display:flex;
      flex-direction:column;
      overflow:hidden;
    }
    .modal3d__head{
      display:flex; align-items:center; justify-content:space-between;
      padding:14px 18px;
      border-bottom:1px solid rgba(15,23,42,.08);
    }
    .modal3d__title{ margin:0; font-size:17px; font-weight:900; }
    .modal3d__close{
      border:0; background:transparent; font-size:22px; line-height:1;
      cursor:pointer; color:#6b7280; padding:4px 8px; border-radius:8px;
    }
    .modal3d__close:hover{ background:rgba(2,6,23,.06); }
    .modal3d__body{
      position:relative;
      flex:1;
      display:flex;
      flex-direction:column;
      min-height:0;
    }
    #viewer3d{
      flex:1;
      min-height:0;
      background:#eef2f7;
      cursor:grab;
    }
    #viewer3d:active{ cursor:grabbing; }
    .modal3d__hint{
      padding:8px 14px;
      font-size:12px;
      color:#6b7280;
      text-align:center;
      border-top:1px solid rgba(15,23,42,.06);
    }

    .btn:hover{
      background: rgba(2,6,23,.03);
    }

    .btn.primary{
      background:#0b76d8;
      border-color:#0b76d8;
      color:#fff;
      box-shadow: 0 10px 18px rgba(11,118,216,.18);
    }

    .btn.primary:hover{
      filter:brightness(.98);
      transform: translateY(-1px);
    }

    .muted{
      color:var(--muted);
      font-size:15px;
    }

    .id-pill{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:6px 10px;
      border-radius:999px;
      background: rgba(11,118,216,.10);
      border:1px solid rgba(11,118,216,.18);
      font-weight:900;
      color:#0b76d8;
    }

    .support-wrap{
      --armW: 55px;
      --armOverlap: 14px;
      --colW: {{ kuik.col_width_px }}px;

      position: relative;
      display: inline-block;
      padding-left:  calc(var(--armW) - var(--armOverlap) + 40px);
      padding-right: calc(var(--armW) - var(--armOverlap));
    }

    .height-dim{
      position:absolute;
      left:0;
      top:20px;
      width:38px;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:6px;
      z-index:3;
      overflow:visible;
    }

    .vdim-line{
      display:flex;
      flex-direction:column;
      align-items:center;
      height:100%;
      flex-shrink:0;
    }

    .vdim-line .varrow{
      font-size:11px;
      line-height:1;
      color:#0b1220;
      flex-shrink:0;
    }

    .vdim-line .vline{
      width:2px;
      flex:1;
      min-height:10px;
      background:#0b1220;
    }

    .group-height-label{
      display:inline-block;
      flex-shrink:0;
      transform: rotate(-90deg);
      font-size:13px;
      font-weight:900;
      color:#0b1220;
      white-space:nowrap;
    }

    .cols-with-total{
      display:flex;
      flex-direction:column;
      align-items:center;
    }

    .col-dim{
      margin-top:4px;
    }

    .dim-row{
      display:flex;
      align-items:center;
      gap:2px;
    }

    .dim-row .arrow{
      font-size:14px;
      line-height:1;
      color:#0b1220;
    }

    .dim-row .line{
      flex:1;
      height:1px;
      background:#0b1220;
    }

    .dim-value{
      text-align:center;
      font-size:11px;
      font-weight:900;
      color:#0b1220;
      margin-top:2px;
    }

    .group-width-total{
      margin:8px auto 0;
    }

    .group-width-total .dim-value{
      font-size:13px;
    }

    .width-dims-below{
      margin-top:10px;
    }

    .width-dims-row{
      width:100%;
      display:grid;
      grid-template-columns: repeat(var(--colsN), var(--colW));
      justify-content:center;
    }

    .arm-img{
      position:absolute;
      top: 55px;
      width: var(--armW);
      height: calc({{ (singleCap * kuik.scale_arm + (singleCap >= 80 ? (singleCap - 70) * 4.5 : 0))|round }}px + 86px);
      object-fit: contain;
      z-index: 3;
      pointer-events:none;
      user-select:none;
    }

    .arm-img.left{
      left: calc(1.95 * var(--armOverlap));
      transform: scaleX(-1);
    }

    .arm-img.right{
      right: calc(-1.75 * var(--armOverlap));
    }

    /* Cuando también hay patas intermedias (5+ columnas), los brazos se dibujan
       más altos que las patas para que se distingan como el soporte principal. */
    .arm-img.reinforced{
      top: 35px;
      height: calc({{ (singleCap * kuik.scale_arm + (singleCap >= 80 ? (singleCap - 70) * 4.5 : 0))|round }}px + 156px);
    }

    .legs-under{
      width:100%;
      display:grid;
      grid-template-columns: repeat(var(--colsN), var(--colW));
      justify-content:center;
      pointer-events:none;
      user-select:none;
      z-index:1;
      //padding: 0 18px;
    }

    .leg-img{
      width: 55px;
      height: {{ (115 + singleCap * (kuik.scale_arm - kuik.scale))|round }}px;
      object-fit:fill;
      justify-self:center;
      flex:0 0 auto;
    }
    .mb-leg-wrap{ position:relative; flex-shrink:0; top:-5px; }
    .mb-leg-summary{
      position:absolute;
      top:100%;
      left:0;
      z-index:5;
      background:transparent;
    }

    .group-roof {
      width: calc(var(--colsN) * 135px);
      height: 22px;
      background: var(--col-border, #000);
      border-radius: 6px 6px 0 0;
      display: block;
      margin: 10px auto -20px;
      position: relative;
      z-index: 3;
      border-bottom: 1px solid white;
    }

    .group-roof + .cols {
      margin-top: 0;
    }
  </style>
{% endblock %}

{% block content %}
  {% set scale = kuik.scale %}

  <div class="page-wrap">

    <div class="page-head">
      <div>
        <h2 class="page-title">{{ 'summary.page_title'|trans }}</h2>
        <div class="page-sub">
          <span class="id-pill">{{ 'summary.config_id'|trans({'%id%': configuration.id}) }}</span>

          {% if configuration.status == 0 %}
            <span class="badge open">{{ 'summary.status.open'|trans }}</span>
          {% elseif configuration.status == 1 %}
            <span class="badge closed">{{ 'summary.status.closed'|trans }}</span>
          {% else %}
            <span class="badge accepted">{{ 'summary.status.accepted'|trans }}</span>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="btn-row">
      <a class="btn" href="{{ path('configuration_project_new') }}">{{ 'summary.btn.new_project'|trans }}</a>
      <a class="btn" href="{{ path('project_configurations', { project_id: project.id }) }}">{{ 'summary.btn.view_project'|trans }}</a>
      {% if app.user.id == project.user.id %}

        {% if project.status == 0 %}
          <a class="btn primary" href="{{ path('configuration_type', { project_id: project.id }) }}">{{ 'summary.btn.new_configuration'|trans }}</a>
        {% endif %}

        {% if configuration.status == 0 %}
          <a class="btn primary" id="btnEditConfig" href="{{ path('configuration_columns', { project_id: project.id, config_id: configuration.id }) }}">{{ 'summary.btn.edit_configuration'|trans }}</a>
        {% endif %}
      {% endif %}

      {% if app.user.id == project.user.id or is_granted('ROLE_ADMIN') %}
        <button class="btn primary" id="btnDescargarPdf"
          data-screenshot-url="{{ path('configuration_screenshot', { id: configuration.id }) }}"
          data-pdf-url="{{ path('configuration_pdf', { id: configuration.id }) }}">
          {{ 'summary.btn.download_pdf'|trans }}
        </button>
      {% endif %}

      {% if is_granted('ROLE_ADMIN') %}
        <button class="btn" id="btnVer3D" type="button">{{ 'summary.btn.view_3d'|trans }}</button>
      {% endif %}
    </div>

    <div class="modal3d" id="modal3d" aria-hidden="true">
      <div class="modal3d__backdrop" data-close3d="1"></div>
      <div class="modal3d__dialog">
        <div class="modal3d__head">
          <h4 class="modal3d__title">{{ 'summary.view3d.title'|trans }}</h4>
          <button type="button" class="modal3d__close" aria-label="{{ 'summary.btn.close'|trans }}" data-close3d="1">×</button>
        </div>
        <div class="modal3d__body">
          <div id="viewer3d"></div>
          <div class="modal3d__hint">{{ 'summary.view3d.hint'|trans }}</div>
        </div>
      </div>
    </div>

    <div class="grid">

      <div class="card">
        <h3>{{ 'summary.preview.title'|trans }}</h3>

        <div class="preview-wrap">

          {% if isSoporteSuelo and selectedType == 'brazos' and selectedColor %}
            {% set armSrc =
              selectedColor == 'blanco' ? asset(kuik.img_brazo_blanco) :
              (selectedColor == 'plata' ? asset(kuik.img_brazo_plata) : asset(kuik.img_brazo_negro))
            %}
          {% endif %}

          {% set legSrc =
            selectedColor == 'blanco' ? asset('assets/pie_blanco.jpg') :
            (selectedColor == 'plata' ? asset('assets/pie_plata.jpg') : asset('assets/pie_negro.jpg'))
          %}

          <div class="preview-scroll">
          <div class="preview-stage" id="previewCapture">
            {% set agrupacionCombinada = p.agrupacion_combinada ?? false %}
            {% set mailboxGroup = p.mailboxGroup ?? null %}
            {% set mbImg = mailboxGroup.imageUrl ?? kuik.img_buzon_btv %}
            {% set mbSide = mailboxGroup.side ?? 'right' %}
            {% set mbRows = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.rows ?? 0) : 0 %}
            {% set mbCols = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.cols ?? 0) : 0 %}
            {% set mbCells = (agrupacionCombinada and mailboxGroup) ? (mailboxGroup.cells ?? []) : [] %}
            {% set mbTotalH = isEmpotradoLike ? (singleCap * scale) : ((topCap + bottomCap) * scale) %}
            {% set mbCellH = 10 * scale %}
            {% set mbBlockH = mbRows * mbCellH + 16 %}
            {% set mbLockerH = mbTotalH + 16 %}
            {% set mbMarginTop = 10 + (mbLockerH - mbBlockH) / 2 %}

            <div class="groups-stage" style="--door-color: {{ doorColor }}; --col-border: {{ bodyColor }};">

              {% if groups is empty %}
                <div class="muted">{{ 'summary.preview.no_columns'|trans }}</div>
              {% else %}
                {% for groupCols in groups %}
                  {% if groupCols is not iterable %}{% set groupCols = [] %}{% endif %}
                  {% set totalCols = groupCols|length %}

                  <div class="group-block">
                    <div class="group-label">{{ 'summary.preview.group_label'|trans({'%index%': loop.index, '%count%': groupCols|length}) }}</div>

                    <div class="support-wrap" style="--colsN: {{ totalCols }};">

                      <div class="height-dim" style="height: {{ groupHeightPx }}px;">
                        <div class="group-height-label">{{ groupHeightLabel }}</div>
                        <div class="vdim-line">
                          <span class="varrow">▲</span>
                          <span class="vline"></span>
                          <span class="varrow">▼</span>
                        </div>
                      </div>

                      {% if isSoporteSuelo and selectedType == 'brazos' and selectedColor %}
                        {% set armReinforced = totalCols >= 5 %}
                        <img class="arm-img left {% if armReinforced %}reinforced{% endif %}" src="{{ armSrc }}" alt="Brazo izquierdo">
                        <img class="arm-img right {% if armReinforced %}reinforced{% endif %}" src="{{ armSrc }}" alt="Brazo derecho">
                      {% endif %}

                      <div class="cols-and-mb" style="{% if fondoMm %}margin-top:18px;{% endif %}">

                        {% if fondoMm %}
                          <div class="depth-top"></div>
                          <div class="depth-right" style="height: {{ groupHeightPx + 12 }}px;"></div>
                          <div class="depth-label">
                            <div class="dim-row"><span class="arrow">◄</span><span class="line"></span><span class="arrow">►</span></div>
                            <div class="dim-value">{{ fondoMm }}</div>
                          </div>
                        {% endif %}

                        {# ── Buzones IZQUIERDA ── #}
                        {% if mbRows > 0 and mbCols > 0 and mbSide == 'left' %}
                          <div class="mb-leg-wrap">
                            <div class="mb-group-block">
                              {% for c in 0..(mbCols - 1) %}
                                <div class="mb-group-col">
                                  {% for r in 0..(mbRows - 1) %}
                                    {% set cellIdx = r * mbCols + c %}
                                    {% set filled = mbCells[cellIdx] ?? true %}
                                    <div class="door mailbox" style="height:{{ mbCellH }}px;{% if not filled %}opacity:0.1;background:#eaeaea;{% endif %} --door-skew:-10deg; z-index:{{ 1000 - (c * 20) - r }};">
                                      <div class="door-leaf">
                                        {% if filled %}<img src="{{ mbImg }}" alt="Buzón">{% endif %}
                                      </div>
                                    </div>
                                  {% endfor %}
                                </div>
                              {% endfor %}
                            </div>
                            {% if isSoporteSuelo %}
                              {% set _mbLegH = (115 + singleCap * (kuik.scale_arm - kuik.scale))|round %}
                              {% if selectedType == 'patas' %}
                                {# Posiciones automáticas según mbCols #}
                                {% set _n = mbCols %}
                                {% if _n == 1 %}{% set _autoCols = [1] %}
                                {% elseif _n == 2 %}{% set _autoCols = [1, 2] %}
                                {% elseif _n == 3 %}{% set _autoCols = [1, 3] %}
                                {% elseif _n == 4 %}{% set _autoCols = [2, 3] %}
                                {% elseif _n == 5 %}{% set _autoCols = [2, 4] %}
                                {% elseif _n == 6 %}{% set _autoCols = [2, 4, 6] %}
                                {% elseif _n == 7 %}{% set _autoCols = [2, 4, 6, 7] %}
                                {% elseif _n == 8 %}{% set _autoCols = [2, 4, 6, 8] %}
                                {% elseif _n == 9 %}{% set _autoCols = [2, 4, 7, 8] %}
                                {% else %}{% set _autoCols = [2, 4, 7, 9] %}
                                {% endif %}
                                <div class="mb-leg-summary" style="width:{{ kuik.mb_col_width_px * mbCols }}px; height:{{ _mbLegH }}px;">
                                  {% for _c in _autoCols %}
                                    {% set _xCenter = (_c - 0.5) * kuik.mb_col_width_px %}
                                    <img class="leg-img" style="position:absolute; left:{{ (_xCenter - 32)|round }}px; top:0; width:55px; height:{{ _mbLegH }}px; object-fit:fill; justify-self:unset;" src="{{ legSrc }}" alt="Pata">
                                  {% endfor %}
                                </div>
                              {% elseif selectedType == 'brazos' and mbLegPos|length > 0 %}
                                {# Posiciones manuales guardadas (una por cada 5 columnas) #}
                                <div class="mb-leg-summary" style="width:{{ kuik.mb_col_width_px * mbCols }}px; height:{{ _mbLegH }}px;">
                                  {% for _i in mbLegPos %}
                                    {% set _xCenter = (_i is even) ? ((_i / 2) + 0.5) * kuik.mb_col_width_px : ((_i + 1) / 2) * kuik.mb_col_width_px %}
                                    <img class="leg-img" style="position:absolute; left:{{ (_xCenter - 32)|round }}px; top:0; width:55px; height:{{ _mbLegH }}px; object-fit:fill; justify-self:unset;" src="{{ legSrc }}" alt="Pata">
                                  {% endfor %}
                                </div>
                              {% endif %}
                            {% endif %}
                          </div>
                        {% endif %}

                      <div class="cols" id="previewCols">
                        {% for col in groupCols %}
                          {% set isEmpotrado = (col.single is defined and col.single is not empty) %}

                          <div class="col-shell">
                            <div class="col-card">
                              <div class="col-body"
                                {% if isEmpotrado %}
                                  style="height: {{ (singleCap * scale) }}px;"
                                {% elseif type == 'home' and instalacion == 'zocalo' %}
                                  style="height: {{ ((topCap + bottomCap) * scale) }}px;"
                                {% endif %}
                              >

                                {% if isEmpotrado %}

                                  <div class="col-half" style="height: {{ singleCap * scale }}px;">
                                    {% set singleBlocks = col.single.blocks_prepared ?? col.single.blocks ?? [] %}
                                    {% for blk in singleBlocks %}
                                      {% set hh = blk.h|default(blk) %}
                                      {% set btype = blk.type|default('door') %}
                                      {% set socket = blk.socket ?? false %}
                                      {% set usb = blk.usb ?? false %}
                                      {% set methacrylate = blk.methacrylate ?? false %}
                                      {% set plateNumber = blk.plateNumber ?? null %}
                                      {% set doorNumber = blk.doorNumber ?? null %}

                                      <div class="door {{ btype == 'screen' ? 'screen' : '' }} {{ btype == 'mailbox' ? 'mailbox' : '' }} {{ methacrylate ? 'methacrylate' : '' }}"
                                           style="height: {{ hh * scale }}px; --door-skew: {{ min(-10, max(-22, (-25 * hh / 40)))|round(2) }}deg; z-index: {{ 100 - loop.index }};">
                                       <div class="door-leaf">

                                        {% if btype == 'screen' %}
                                          <img src="{{ asset(kuik.img_pantalla) }}" alt="Pantalla">
                                        {% elseif btype == 'mailbox' %}
                                          {% set _elec = blk.electronico ?? false %}
                                          {% set _tarj = blk.tarjetero ?? false %}
                                          {% set _buzonImg = _elec ? (_tarj ? 'assets/buzon_kuik_electronico_con_tarjetero.png' : 'assets/buzon_kuik_electronico_sin_tarjetero.png') : (_tarj ? 'assets/buzon_kuik_mecanico_con_tarjetero.png' : 'assets/buzon_kuik_mecanico_sin_tarjetero.png') %}
                                          <img src="{{ asset(_buzonImg) }}" alt="Buzón">
                                          {% if _elec and plateNumber is not null %}
                                            <div class="num" style="color:#fff;text-shadow:0 0 3px #000;">{{ plateNumber }},{{ doorNumber }}</div>
                                          {% endif %}
                                        {% else %}
                                          <div class="num">
                                            {{ plateNumber }},{{ doorNumber }}
                                          </div>

                                          <div class="size-label">H{{ hh }}</div>

                                          <div class="badges">
                                            {% if socket %}<span class="badge-mini">{{ 'summary.badge.socket'|trans }}</span>{% endif %}
                                            {% if usb %}<span class="badge-mini">{{ 'summary.badge.usb'|trans }}</span>{% endif %}
                                          </div>
                                        {% endif %}
                                       </div>
                                      </div>
                                    {% endfor %}
                                  </div>

                                {% else %}

                                  <div class="col-half" style="height: {{ topCap * scale }}px;">
                                    {% set topBlocks = col.top.blocks_prepared ?? col.top.blocks ?? [] %}
                                    {% for blk in topBlocks %}
                                      {% set hh = blk.h|default(blk) %}
                                      {% set btype = blk.type|default('door') %}
                                      {% set socket = blk.socket ?? false %}
                                      {% set usb = blk.usb ?? false %}
                                      {% set methacrylate = blk.methacrylate ?? false %}
                                      {% set plateNumber = blk.plateNumber ?? null %}
                                      {% set doorNumber = blk.doorNumber ?? null %}

                                      <div class="door {{ btype == 'screen' ? 'screen' : '' }} {{ btype == 'mailbox' ? 'mailbox' : '' }} {{ methacrylate ? 'methacrylate' : '' }}"
                                           style="height: {{ hh * scale }}px; --door-skew: {{ min(-10, max(-22, (-25 * hh / 40)))|round(2) }}deg; z-index: {{ 100 - loop.index }};">
                                       <div class="door-leaf">

                                        {% if btype == 'screen' %}
                                          <img src="{{ asset(kuik.img_pantalla) }}" alt="Pantalla">
                                        {% elseif btype == 'mailbox' %}
                                          {% set _elec = blk.electronico ?? false %}
                                          {% set _tarj = blk.tarjetero ?? false %}
                                          {% set _buzonImg = _elec ? (_tarj ? 'assets/buzon_kuik_electronico_con_tarjetero.png' : 'assets/buzon_kuik_electronico_sin_tarjetero.png') : (_tarj ? 'assets/buzon_kuik_mecanico_con_tarjetero.png' : 'assets/buzon_kuik_mecanico_sin_tarjetero.png') %}
                                          <img src="{{ asset(_buzonImg) }}" alt="Buzón">
                                          {% if _elec and plateNumber is not null %}
                                            <div class="num" style="color:#fff;text-shadow:0 0 3px #000;">{{ plateNumber }},{{ doorNumber }}</div>
                                          {% endif %}
                                        {% else %}
                                          <div class="num">
                                            {{ plateNumber }},{{ doorNumber }}
                                          </div>

                                          <div class="size-label">H{{ hh }}</div>

                                          <div class="badges">
                                            {% if socket %}<span class="badge-mini">{{ 'summary.badge.socket'|trans }}</span>{% endif %}
                                            {% if usb %}<span class="badge-mini">{{ 'summary.badge.usb'|trans }}</span>{% endif %}
                                          </div>
                                        {% endif %}
                                       </div>
                                      </div>
                                    {% endfor %}
                                  </div>

                                  <div class="half-sep"></div>

                                  <div class="col-half" style="height: {{ bottomCap * scale }}px;">
                                    {% set bottomBlocks = col.bottom.blocks_prepared ?? col.bottom.blocks ?? [] %}
                                    {% for blk in bottomBlocks %}
                                      {% set hh = blk.h|default(blk) %}
                                      {% set btype = blk.type|default('door') %}
                                      {% set socket = blk.socket ?? false %}
                                      {% set usb = blk.usb ?? false %}
                                      {% set methacrylate = blk.methacrylate ?? false %}
                                      {% set plateNumber = blk.plateNumber ?? null %}
                                      {% set doorNumber = blk.doorNumber ?? null %}

                                      <div class="door {{ btype == 'screen' ? 'screen' : '' }} {{ btype == 'mailbox' ? 'mailbox' : '' }} {{ methacrylate ? 'methacrylate' : '' }}"
                                           style="height: {{ hh * scale }}px; --door-skew: {{ min(-10, max(-22, (-25 * hh / 40)))|round(2) }}deg; z-index: {{ 100 - loop.index }};">
                                       <div class="door-leaf">

                                        {% if btype == 'screen' %}
                                          <img src="{{ asset(kuik.img_pantalla) }}" alt="Pantalla">
                                        {% elseif btype == 'mailbox' %}
                                          {% set _elec = blk.electronico ?? false %}
                                          {% set _tarj = blk.tarjetero ?? false %}
                                          {% set _buzonImg = _elec ? (_tarj ? 'assets/buzon_kuik_electronico_con_tarjetero.png' : 'assets/buzon_kuik_electronico_sin_tarjetero.png') : (_tarj ? 'assets/buzon_kuik_mecanico_con_tarjetero.png' : 'assets/buzon_kuik_mecanico_sin_tarjetero.png') %}
                                          <img src="{{ asset(_buzonImg) }}" alt="Buzón">
                                          {% if _elec and plateNumber is not null %}
                                            <div class="num" style="color:#fff;text-shadow:0 0 3px #000;">{{ plateNumber }},{{ doorNumber }}</div>
                                          {% endif %}
                                        {% else %}
                                          <div class="num">
                                            {{ plateNumber }},{{ doorNumber }}
                                          </div>

                                          <div class="size-label">H{{ hh }}</div>

                                          <div class="badges">
                                            {% if socket %}<span class="badge-mini">{{ 'summary.badge.socket'|trans }}</span>{% endif %}
                                            {% if usb %}<span class="badge-mini">{{ 'summary.badge.usb'|trans }}</span>{% endif %}
                                          </div>
                                        {% endif %}
                                       </div>
                                      </div>
                                    {% endfor %}
                                  </div>

                                {% endif %}
                              </div>
                            </div>
                          </div>
                        {% endfor %}{# endfor col in groupCols #}
                      </div>{# /cols grid #}

                        {# ── Buzones DERECHA ── #}
                        {% if mbRows > 0 and mbCols > 0 and mbSide == 'right' %}
                          <div class="mb-leg-wrap">
                            <div class="mb-group-block">
                              {% for c in 0..(mbCols - 1) %}
                                <div class="mb-group-col">
                                  {% for r in 0..(mbRows - 1) %}
                                    {% set cellIdx = r * mbCols + c %}
                                    {% set filled = mbCells[cellIdx] ?? true %}
                                    <div class="door mailbox" style="height:{{ mbCellH }}px;{% if not filled %}opacity:0.1;background:#eaeaea;{% endif %} --door-skew:-10deg; z-index:{{ 1000 - (c * 20) - r }};">
                                      <div class="door-leaf">
                                        {% if filled %}<img src="{{ mbImg }}" alt="Buzón">{% endif %}
                                      </div>
                                    </div>
                                  {% endfor %}
                                </div>
                              {% endfor %}
                            </div>
                            {% if isSoporteSuelo %}
                              {% set _mbLegH = (120 + singleCap * (kuik.scale_arm - kuik.scale))|round %}
                              {% if selectedType == 'patas' %}
                                {# Posiciones automáticas según mbCols #}
                                {% set _n = mbCols %}
                                {% if _n == 1 %}{% set _autoCols = [1] %}
                                {% elseif _n == 2 %}{% set _autoCols = [1, 2] %}
                                {% elseif _n == 3 %}{% set _autoCols = [1, 3] %}
                                {% elseif _n == 4 %}{% set _autoCols = [2, 3] %}
                                {% elseif _n == 5 %}{% set _autoCols = [2, 4] %}
                                {% elseif _n == 6 %}{% set _autoCols = [2, 4, 6] %}
                                {% elseif _n == 7 %}{% set _autoCols = [2, 4, 6, 7] %}
                                {% elseif _n == 8 %}{% set _autoCols = [2, 4, 6, 8] %}
                                {% elseif _n == 9 %}{% set _autoCols = [2, 4, 7, 8] %}
                                {% else %}{% set _autoCols = [2, 4, 7, 9] %}
                                {% endif %}
                                <div class="mb-leg-summary" style="width:{{ kuik.mb_col_width_px * mbCols }}px; height:{{ _mbLegH }}px;">
                                  {% for _c in _autoCols %}
                                    {% set _xCenter = (_c - 0.5) * kuik.mb_col_width_px %}
                                    <img class="leg-img" style="position:absolute; left:{{ (_xCenter - 32)|round }}px; top:0; width:55px; height:{{ _mbLegH }}px; object-fit:fill; justify-self:unset;" src="{{ legSrc }}" alt="Pata">
                                  {% endfor %}
                                </div>
                              {% elseif selectedType == 'brazos' and mbLegPos|length > 0 %}
                                {# Posiciones manuales guardadas (una por cada 5 columnas) #}
                                <div class="mb-leg-summary" style="width:{{ kuik.mb_col_width_px * mbCols }}px; height:{{ _mbLegH }}px;">
                                  {% for _i in mbLegPos %}
                                    {% set _xCenter = (_i is even) ? ((_i / 2) + 0.5) * kuik.mb_col_width_px : ((_i + 1) / 2) * kuik.mb_col_width_px %}
                                    <img class="leg-img" style="position:absolute; left:{{ (_xCenter - 32)|round }}px; top:0; width:55px; height:{{ _mbLegH }}px; object-fit:fill; justify-self:unset;" src="{{ legSrc }}" alt="Pata">
                                  {% endfor %}
                                </div>
                              {% endif %}
                            {% endif %}
                          </div>
                        {% endif %}

                      </div>{# /cols-and-mb #}

                      {% if isSoporteSuelo and selectedType == 'brazos' and agrupacionCombinada and mbCols > 0 %}
                        {% set n = totalCols %}
                        {% if n == 1 %}
                          {% set mbLegPositions = [1] %}
                        {% elseif n == 2 %}
                          {% set mbLegPositions = [1, 2] %}
                        {% elseif n == 3 %}
                          {% set mbLegPositions = [1, 3] %}
                        {% elseif n == 4 %}
                          {% set mbLegPositions = [2, 3] %}
                        {% elseif n == 5 %}
                          {% set mbLegPositions = [2, 4] %}
                        {% elseif n == 6 %}
                          {% set mbLegPositions = [2, 4, 6] %}
                        {% elseif n == 7 %}
                          {% set mbLegPositions = [2, 4, 6, 7] %}
                        {% elseif n == 8 %}
                          {% set mbLegPositions = [2, 4, 6, 8] %}
                        {% elseif n == 9 %}
                          {% set mbLegPositions = [2, 4, 7, 8] %}
                        {% else %}
                          {% set mbLegPositions = [2, 4, 7, 9] %}
                        {% endif %}
                        {% if mbSide == 'left' and n > 5 %}
                          {% if n == 6 %}{% set mbLegPositions = [1, 3, 5] %}
                          {% elseif n == 7 %}{% set mbLegPositions = [1, 2, 4, 6] %}
                          {% elseif n == 8 %}{% set mbLegPositions = [1, 3, 5, 7] %}
                          {% elseif n == 9 %}{% set mbLegPositions = [2, 3, 6, 8] %}
                          {% endif %}
                        {% endif %}
                        {% set mbBlockW = mbCols * kuik.mb_col_width_px + 8 %}
                        <div style="display:flex; flex-direction:row; width:100%;">
                          {% if mbSide == 'left' %}
                            <div style="width:{{ mbBlockW }}px; flex-shrink:0;"></div>
                          {% endif %}
                          <div class="legs-under" style="flex:1;">
                            {% for pos in mbLegPositions %}
                              <img class="leg-img"
                                   style="grid-column: {{ pos }};"
                                   src="{{ legSrc }}"
                                   alt="Pata">
                            {% endfor %}
                          </div>
                          {% if mbSide == 'right' %}
                            <div style="width:{{ mbBlockW }}px; flex-shrink:0;"></div>
                          {% endif %}
                        </div>
                      {% endif %}

                      {% set n = groupCols|length %}
                      {% if isSoporteSuelo and (selectedType == 'patas' or (selectedType == 'brazos' and n >= 5)) %}
                        {% if n == 1 %}
                          {% set legPositions = [1] %}
                        {% elseif n == 2 %}
                          {% set legPositions = [1, 2] %}
                        {% elseif n == 3 %}
                          {% set legPositions = [1, 3] %}
                        {% elseif n == 4 %}
                          {% set legPositions = [2, 3] %}
                        {% elseif n == 5 %}
                          {% set legPositions = [2, 4] %}
                        {% elseif n == 6 %}
                          {% set legPositions = [2, 4, 6] %}
                        {% elseif n == 7 %}
                          {% set legPositions = [2, 4, 6, 7] %}
                        {% elseif n == 8 %}
                          {% set legPositions = [2, 4, 6, 8] %}
                        {% elseif n == 9 %}
                          {% set legPositions = [2, 4, 7, 8] %}
                        {% else %}
                          {% set legPositions = [2, 4, 7, 9] %}
                        {% endif %}
                        {% if agrupacionCombinada and mbSide == 'left' and n > 5 %}
                          {% if n == 6 %}{% set legPositions = [1, 3, 5] %}
                          {% elseif n == 7 %}{% set legPositions = [1, 2, 4, 6] %}
                          {% elseif n == 8 %}{% set legPositions = [1, 3, 5, 7] %}
                          {% elseif n == 9 %}{% set legPositions = [2, 3, 6, 8] %}
                          {% endif %}
                        {% endif %}
                        <div class="legs-under">
                          {% for pos in legPositions %}
                            <img class="leg-img"
                                 style="grid-column: {{ pos }};"
                                 src="{{ legSrc }}"
                                 alt="Pata">
                          {% endfor %}
                        </div>
                      {% endif %}

                      {% if colWidthLabel %}
                        {% set mbUnitAnchoMm = mailboxGroup.ancho ?? 0 %}
                        {% set hasMbWidth = mbRows > 0 and mbCols > 0 and mbUnitAnchoMm > 0 %}
                        {% set mbGroupWidthMm = hasMbWidth ? (mbCols * mbUnitAnchoMm)|round : 0 %}
                        {% set mbDimW = mbCols * kuik.mb_col_width_px %}
                        <div class="width-dims-below">
                          {% if totalCols == 1 and not hasMbWidth %}
                            <div class="group-width-total" style="width: calc({{ totalCols }} * {{ kuik.col_width_px }}px);">
                              <div class="dim-row"><span class="arrow">◄</span><span class="line"></span><span class="arrow">►</span></div>
                              <div class="dim-value">{{ (colWidthLabel * totalCols) + groupWidthExtraMm }}</div>
                            </div>
                          {% else %}
                            <div style="display:flex; flex-direction:row;">
                              {% if hasMbWidth and mbSide == 'left' %}
                                <div class="col-dim" style="width:{{ mbDimW }}px; flex-shrink:0;">
                                  <div class="dim-row"><span class="arrow">◄</span><span class="line"></span><span class="arrow">►</span></div>
                                  <div class="dim-value">{{ mbGroupWidthMm }}</div>
                                </div>
                              {% endif %}
                              <div class="width-dims-row" style="--colsN: {{ totalCols }};">
                                {% for col in groupCols %}
                                  <div class="col-dim">
                                    <div class="dim-row"><span class="arrow">◄</span><span class="line"></span><span class="arrow">►</span></div>
                                    <div class="dim-value">{{ colWidthLabel }}</div>
                                  </div>
                                {% endfor %}
                              </div>
                              {% if hasMbWidth and mbSide == 'right' %}
                                <div class="col-dim" style="width:{{ mbDimW }}px; flex-shrink:0;">
                                  <div class="dim-row"><span class="arrow">◄</span><span class="line"></span><span class="arrow">►</span></div>
                                  <div class="dim-value">{{ mbGroupWidthMm }}</div>
                                </div>
                              {% endif %}
                            </div>
                            <div class="group-width-total" style="width: calc({{ totalCols }} * {{ kuik.col_width_px }}px{{ hasMbWidth ? (' + ' ~ mbDimW ~ 'px') : '' }});">
                              <div class="dim-row"><span class="arrow">◄</span><span class="line"></span><span class="arrow">►</span></div>
                              <div class="dim-value">{{ (colWidthLabel * totalCols) + groupWidthExtraMm + mbGroupWidthMm }}</div>
                            </div>
                          {% endif %}
                        </div>
                      {% endif %}

                    </div>
                  </div>
                {% endfor %}
              {% endif %}

            </div>{# /groups-stage #}
          </div>
          </div>

        </div>

        <img id="resultadoIA"
             style="max-width:100%; margin-top:12px; display:none; border:1px solid rgba(15,23,42,.12); border-radius:12px;">

        {% block product_table %}
          <div id="productTableContainer"></div>
        {% endblock %}

        <div style="margin-top:16px; border-top:1px solid rgba(15,23,42,.08); padding-top:16px; display:flex; align-items:center; gap:12px;">
          <label style="font-size:14px; font-weight:700; white-space:nowrap;">{{ 'summary.installation.label'|trans }}</label>
          <input type="number" id="instalacionPrecio" min="0" step="0.01"
            value="{{ p._instalacion_precio ?? '' }}"
            placeholder="0,00"
            style="width:130px; padding:6px 10px; border:1px solid rgba(15,23,42,.15); border-radius:8px; font-size:14px;">
          <span id="instalacionStatus" style="font-size:12px; color:#6b7280; display:none;">{{ 'summary.installation.saved'|trans }}</span>
        </div>
      </div>

      <div class="card">
        <h3>{{ 'summary.config.title'|trans }}</h3>

        <div class="kvs">
          <div class="kv"><div class="k">{{ 'summary.config.type'|trans }}</div><div class="v">{{ type }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.config.background'|trans }}</div><div class="v">{{ bgLabel }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.config.placement'|trans }}</div><div class="v">{{ placementLabel }}</div></div>
          {#<div class="kv"><div class="k">Material</div><div class="v">{{ material }}</div></div>#}
          <div class="kv"><div class="k">{{ 'summary.config.door_color'|trans }}</div><div class="v">{{ doorColorRal }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.config.body_color'|trans }}</div><div class="v">{{ bodyColorRal }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.config.columns'|trans }}</div><div class="v">{{ columnsAll|length }}</div></div>
          {% if isSoporteSuelo and selectedType == 'brazos' %}
            <div class="kv"><div class="k">{{ 'summary.config.arm_height'|trans }}</div><div class="v">1500 mm</div></div>
          {% elseif isSoporteSuelo and selectedType == 'patas' %}
            <div class="kv"><div class="k">{{ 'summary.config.leg_height'|trans }}</div><div class="v">800/900 mm</div></div>
          {% endif %}
          {% if instalacion == 'colgado' %}
            {% set _colgadores = 0 %}
            {% for _grp in groups %}
              {% set _n = _grp|length %}
              {% set _grpColgadores = _n <= 2 ? _n : ((_n + 1) // 2) %}
              {% set _colgadores = _colgadores + _grpColgadores %}
            {% endfor %}
            <div class="kv"><div class="k">{{ 'summary.config.hangers'|trans }}</div><div class="v">{{ _colgadores }}</div></div>
          {% endif %}
          {% if p.control is defined and p.control %}
            <div class="kv"><div class="k">{{ 'summary.config.control'|trans }}</div><div class="v">{{ p.control }}</div></div>
          {% endif %}
          {% set _mbGroup = p.mailboxGroup ?? null %}
          {% if (p.agrupacion_combinada ?? false) and _mbGroup %}
            <div class="kv"><div class="k">{{ 'summary.config.mailboxes_ref'|trans }}</div><div class="v">{{ _mbGroup.reference ?? '—' }}</div></div>
            {% if _mbGroup.descripcion ?? null %}
              <div class="kv"><div class="k">{{ 'summary.config.mailbox_description'|trans }}</div><div class="v">{{ _mbGroup.descripcion }}</div></div>
            {% endif %}
          {% endif %}
        </div>

        <div class="section-sep"></div>

        <h3>{{ 'summary.client.title'|trans }}</h3>

        <div class="kvs">
          <div class="kv"><div class="k">{{ 'summary.client.project'|trans }}</div><div class="v">{{ project.projectName }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.client.client'|trans }}</div><div class="v">{{ project.clientName }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.client.phone'|trans }}</div><div class="v">{{ project.phone ?: '—' }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.client.email'|trans }}</div><div class="v">{{ project.email ?: '—' }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.client.city'|trans }}</div><div class="v">{{ project.city ?: '—' }}</div></div>
          <div class="kv"><div class="k">{{ 'summary.client.address'|trans }}</div><div class="v">{{ project.address ?: '—' }}</div></div>
        </div>

        <div class="section-sep"></div>
        <h3>{{ 'summary.doors_by_size.title'|trans }}</h3>

        {% set doorSizeCounts = {} %}
        {% set mailboxSizeCounts = {} %}
        {% set totalDoors = 0 %}
        {% set totalMailboxes = 0 %}

        {% for col in columnsAll %}
          {% if col.single is defined and col.single is not empty %}

            {% set singleBlocks = col.single.blocks_prepared ?? col.single.blocks ?? [] %}
            {% for blk in singleBlocks %}
              {% set btype = blk.type|default('door') %}
              {% set hh = blk.h|default(blk) %}
              {% set key = 'H' ~ hh %}

              {% if btype == 'mailbox' %}
                {% set mailboxSizeCounts = mailboxSizeCounts|merge({ (key): (mailboxSizeCounts[key]|default(0) + 1) }) %}
                {% set totalMailboxes = totalMailboxes + 1 %}
              {% elseif btype != 'screen' %}
                {% set doorSizeCounts = doorSizeCounts|merge({ (key): (doorSizeCounts[key]|default(0) + 1) }) %}
                {% set totalDoors = totalDoors + 1 %}
              {% endif %}
            {% endfor %}

          {% else %}

            {% set topBlocks = col.top.blocks_prepared ?? col.top.blocks ?? [] %}
            {% for blk in topBlocks %}
              {% set btype = blk.type|default('door') %}
              {% set hh = blk.h|default(blk) %}
              {% set key = 'H' ~ hh %}

              {% if btype == 'mailbox' %}
                {% set mailboxSizeCounts = mailboxSizeCounts|merge({ (key): (mailboxSizeCounts[key]|default(0) + 1) }) %}
                {% set totalMailboxes = totalMailboxes + 1 %}
              {% elseif btype != 'screen' %}
                {% set doorSizeCounts = doorSizeCounts|merge({ (key): (doorSizeCounts[key]|default(0) + 1) }) %}
                {% set totalDoors = totalDoors + 1 %}
              {% endif %}
            {% endfor %}

            {% set bottomBlocks = col.bottom.blocks_prepared ?? col.bottom.blocks ?? [] %}
            {% for blk in bottomBlocks %}
              {% set btype = blk.type|default('door') %}
              {% set hh = blk.h|default(blk) %}
              {% set key = 'H' ~ hh %}

              {% if btype == 'mailbox' %}
                {% set mailboxSizeCounts = mailboxSizeCounts|merge({ (key): (mailboxSizeCounts[key]|default(0) + 1) }) %}
                {% set totalMailboxes = totalMailboxes + 1 %}
              {% elseif btype != 'screen' %}
                {% set doorSizeCounts = doorSizeCounts|merge({ (key): (doorSizeCounts[key]|default(0) + 1) }) %}
                {% set totalDoors = totalDoors + 1 %}
              {% endif %}
            {% endfor %}

          {% endif %}
        {% endfor %}

        {% if totalDoors == 0 and totalMailboxes == 0 %}
          <div class="muted">{{ 'summary.doors_by_size.none'|trans }}</div>
        {% else %}
          <table class="addons-table">
            <thead>
              <tr>
                <th>{{ 'summary.doors_by_size.size'|trans }}</th>
                <th>{{ 'summary.doors_by_size.quantity'|trans }}</th>
              </tr>
            </thead>
            <tbody>
              {% for h in [10,20,30,40,50,60,70,80,90] %}
                {% set k = 'H' ~ h %}
                {% if doorSizeCounts[k]|default(0) > 0 %}
                  <tr>
                    <td><b>{{ k }}</b></td>
                    <td>{{ doorSizeCounts[k] }}</td>
                  </tr>
                {% endif %}
              {% endfor %}

              {% for h in [10,20,30,40,50,60,70,80,90] %}
                {% set k = 'H' ~ h %}
                {% if mailboxSizeCounts[k]|default(0) > 0 %}
                  <tr>
                    <td><b>{{ 'summary.doors_by_size.mailbox'|trans }}</b></td>
                    <td>{{ mailboxSizeCounts[k] }}</td>
                  </tr>
                {% endif %}
              {% endfor %}

              <tr>
                <td><b>{{ 'summary.doors_by_size.total_doors'|trans }}</b></td>
                <td><b>{{ totalDoors }}</b></td>
              </tr>
              <tr>
                <td><b>{{ 'summary.doors_by_size.total_mailboxes'|trans }}</b></td>
                <td><b>{{ totalMailboxes }}</b></td>
              </tr>
            </tbody>
          </table>
        {% endif %}

        <div class="section-sep"></div>
        <h3>{{ 'summary.addons.title'|trans }}</h3>

        {% set totalSocket = 0 %}
        {% set totalUsb = 0 %}
        {% set totalBoth = 0 %}
        {% set totalMethacrylate = 0 %}

        {% for doorNum, sel in addons %}
          {% set socket = (sel is iterable and (sel.socket ?? false)) ? 1 : 0 %}
          {% set usb = (sel is iterable and (sel.usb ?? false)) ? 1 : 0 %}
          {% set methacrylate = (sel is iterable and (sel.methacrylate ?? false)) ? 1 : 0 %}

          {% set totalSocket = totalSocket + socket %}
          {% set totalUsb = totalUsb + usb %}
          {% set totalMethacrylate = totalMethacrylate + methacrylate %}

          {% if socket and usb %}
            {% set totalBoth = totalBoth + 1 %}
          {% endif %}
        {% endfor %}

        <div class="kvs" style="margin-top:10px;">
          <div class="kv">
            <div class="k">{{ 'summary.addons.total_sockets'|trans }}</div>
            <div class="v">{{ totalSocket }}</div>
          </div>
          <div class="kv">
            <div class="k">{{ 'summary.addons.total_usb'|trans }}</div>
            <div class="v">{{ totalUsb }}</div>
          </div>
          <div class="kv">
            <div class="k">{{ 'summary.addons.doors_with_both'|trans }}</div>
            <div class="v">{{ totalBoth }}</div>
          </div>
          <div class="kv">
            <div class="k">{{ 'summary.addons.doors_with_methacrylate'|trans }}</div>
            <div class="v">{{ totalMethacrylate }}</div>
          </div>
        </div>

        <h3 style="margin-top:14px;">{{ 'summary.addons.detail_title'|trans }}</h3>

        {% set anyAddon = false %}
        {% for doorNum, sel in addons %}
          {% set socket = (sel is iterable and (sel.socket ?? false)) ? true : false %}
          {% set usb = (sel is iterable and (sel.usb ?? false)) ? true : false %}
          {% set methacrylate = (sel is iterable and (sel.methacrylate ?? false)) ? true : false %}
          {% if socket or usb or methacrylate %}
            {% set anyAddon = true %}
          {% endif %}
        {% endfor %}

        {% if not anyAddon %}
          <div class="muted">{{ 'summary.addons.none'|trans }}</div>
        {% else %}
          <table class="addons-table">
            <thead>
              <tr>
                <th>{{ 'summary.addons.door'|trans }}</th>
                <th>{{ 'summary.addons.addon'|trans }}</th>
              </tr>
            </thead>
            <tbody>
              {% for doorNum, sel in addons|sort %}
                {% set socket = (sel is iterable and (sel.socket ?? false)) ? true : false %}
                {% set usb = (sel is iterable and (sel.usb ?? false)) ? true : false %}
                {% set methacrylate = (sel is iterable and (sel.methacrylate ?? false)) ? true : false %}

                {% if socket or usb or methacrylate %}
                  {% set labels = [] %}

                  {% if methacrylate %}
                    {% set labels = labels|merge([('summary.addons.methacrylate'|trans)]) %}
                  {% endif %}
                  {% if socket %}
                    {% set labels = labels|merge([('summary.addons.socket'|trans)]) %}
                  {% endif %}
                  {% if usb %}
                    {% set labels = labels|merge(['USB']) %}
                  {% endif %}

                  <tr>
                    <td><b>{{ doorNum }}</b></td>
                    <td>{{ labels|join(' + ') }}</td>
                  </tr>
                {% endif %}
              {% endfor %}
            </tbody>
          </table>
        {% endif %}

      </div>
    </div>
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>

  <script>
    window.LOCKER_3D_DATA = {{ {
      groups: groups3d,
      doorColor: doorColor,
      bodyColor: bodyColor,
      fondoMm: fondoMm ?: 400,
      doorWidthMm: kuik.door_width_mm,
      screenImageUrl: asset(kuik.img_pantalla),
      isSoporteSuelo: isSoporteSuelo,
      bracketType: selectedType,
      mailboxImages: {
        elecTarj:   asset('assets/buzon_kuik_electronico_con_tarjetero.png'),
        elecNoTarj: asset('assets/buzon_kuik_electronico_sin_tarjetero.png'),
        mecTarj:    asset('assets/buzon_kuik_mecanico_con_tarjetero.png'),
        mecNoTarj:  asset('assets/buzon_kuik_mecanico_sin_tarjetero.png')
      },
      isHome: isHome
    }|json_encode|raw }};
  </script>

  <script>
    window.I18N_SUMMARY = {{ {
      generating: 'summary.js.generating'|trans,
      download_pdf: 'summary.js.download_pdf'|trans,
      total: 'summary.js.total'|trans,
      total_with_discount: 'summary.js.total_with_discount'|trans,
      iva_included: 'summary.js.iva_included'|trans,
      iva_excluded: 'summary.js.iva_excluded'|trans,
      non_json_response: 'summary.js.non_json_response'|trans,
      image_generation_error: 'summary.js.image_generation_error'|trans,
      unexpected_error: 'summary.js.unexpected_error'|trans,
      manual_line_description_placeholder: 'config_ajax.manual_line.description_placeholder'|trans
    }|json_encode|raw }};
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const btn3d   = document.getElementById('btnVer3D');
      const modal3d = document.getElementById('modal3d');
      const viewer  = document.getElementById('viewer3d');
      if (!btn3d || !modal3d || !viewer) return;

      let threeLoaded = false;
      let renderer = null, scene = null, camera = null, controls = null, animationId = null;
      const doorPivots = [];
      const clickableMeshes = [];
      const DOOR_OPEN_ANGLE = Math.PI * 0.6; // ~108º

      function loadScript(src) {
        return new Promise(function (resolve, reject) {
          const s = document.createElement('script');
          s.src = src;
          s.onload = resolve;
          s.onerror = reject;
          document.head.appendChild(s);
        });
      }

      function ensureThree() {
        if (threeLoaded) return Promise.resolve();
        return loadScript('https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js')
          .then(function () {
            return loadScript('https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js');
          })
          .then(function () { threeLoaded = true; });
      }

      function mmToUnits(mm) { return mm / 10; } // 1 unidad de escena = 1 cm

      function buildScene() {
        const data = window.LOCKER_3D_DATA || { groups: [], doorColor: '#3a9efc', bodyColor: '#111', fondoMm: 400, doorWidthMm: 380 };

        scene = new THREE.Scene();
        scene.background = new THREE.Color(0xeef2f7);

        const amb = new THREE.AmbientLight(0xffffff, 0.65);
        scene.add(amb);
        const dir = new THREE.DirectionalLight(0xffffff, 0.7);
        dir.position.set(80, 140, 120);
        scene.add(dir);
        const dir2 = new THREE.DirectionalLight(0xffffff, 0.3);
        dir2.position.set(-80, 60, -100);
        scene.add(dir2);

        const depth = mmToUnits(data.fondoMm || 400);
        const colW  = mmToUnits(data.doorWidthMm || 380);
        const sideW = mmToUnits(25);
        const groupGap = mmToUnits(50);

        const doorMat = new THREE.MeshStandardMaterial({ color: data.doorColor || '#3a9efc', roughness: 0.6, metalness: 0.05 });
        const bodyMat = new THREE.MeshStandardMaterial({ color: data.bodyColor || '#111111', roughness: 0.7, metalness: 0.05 });
        const legMat  = new THREE.MeshStandardMaterial({ color: 0xc7c9cc, roughness: 0.5, metalness: 0.3 });
        const edges   = new THREE.LineBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.25 });

        // Mismas posiciones de patas que usa el dibujo 2D, según el número
        // de columnas de la agrupación.
        function legPositionsFor(n) {
          if (n === 1) return [1];
          if (n === 2) return [1, 2];
          if (n === 3) return [1, 3];
          if (n === 4) return [2, 3];
          if (n === 5) return [2, 4];
          if (n === 6) return [2, 4, 6];
          if (n === 7) return [2, 4, 6, 7];
          if (n === 8) return [2, 4, 6, 8];
          if (n === 9) return [2, 4, 7, 8];
          return [2, 4, 7, 9];
        }

        // Para "pantalla" y "buzón": mismo color de puerta en todas las
        // caras, menos la frontal (+z), donde se pega la foto real. Se
        // compone sobre un lienzo del color de puerta (en vez de usar
        // transparencia 3D, que dejaría ver el interior de la caja en los
        // huecos transparentes del PNG).
        const frontTextureMatsCache = {};
        function makeFrontTextureMats(imageUrl, heightMultiplier) {
          if (!imageUrl) return doorMat;
          const cacheKey = imageUrl + '|' + (heightMultiplier || 1);
          if (frontTextureMatsCache[cacheKey]) return frontTextureMatsCache[cacheKey];

          const frontMat = new THREE.MeshStandardMaterial({ color: data.doorColor || '#3a9efc', roughness: 0.4, metalness: 0.1 });
          const img = new Image();
          img.crossOrigin = 'anonymous';
          img.onload = function () {
            const size = 512;
            const canvas = document.createElement('canvas');
            canvas.width = size;
            canvas.height = size;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = data.doorColor || '#3a9efc';
            ctx.fillRect(0, 0, size, size);
            const scale = Math.min(size / img.width, size / img.height);
            const dw = img.width * scale;
            const dh = img.height * scale * (heightMultiplier || 1);
            ctx.drawImage(img, (size - dw) / 2, (size - dh) / 2, dw, dh);
            const texture = new THREE.CanvasTexture(canvas);
            frontMat.map = texture;
            frontMat.color.set(0xffffff);
            frontMat.needsUpdate = true;
          };
          img.src = imageUrl;

          const mats = [doorMat, doorMat, doorMat, doorMat, frontMat, doorMat];
          frontTextureMatsCache[cacheKey] = mats;
          return mats;
        }

        const screenMats = makeFrontTextureMats(data.screenImageUrl);

        function mailboxImageUrl(blk) {
          const imgs = data.mailboxImages || {};
          if (blk.electronico) return blk.tarjetero ? imgs.elecTarj : imgs.elecNoTarj;
          return blk.tarjetero ? imgs.mecTarj : imgs.mecNoTarj;
        }

        function addBox(w, h, d, mat, x, y, z) {
          const geo = new THREE.BoxGeometry(w, h, d);
          const mesh = new THREE.Mesh(geo, mat);
          mesh.position.set(x, y, z);
          scene.add(mesh);
          const line = new THREE.LineSegments(new THREE.EdgesGeometry(geo), edges);
          line.position.copy(mesh.position);
          scene.add(line);
          return mesh;
        }

        // Caja "hueca": representa una puerta como un compartimento vacío
        // (fondo, techo, suelo y dos lados), sin tapa frontal, para que se
        // vea el interior en vez de un bloque sólido.
        function addOpenBox(w, h, d, mat, x, y, z) {
          const t = Math.max(0.5, Math.min(w, h) * 0.03);
          addBox(w, h, t, mat, x, y, z - d / 2 + t / 2);       // fondo
          addBox(w, t, d, mat, x, y + h / 2 - t / 2, z);       // techo
          addBox(w, t, d, mat, x, y - h / 2 + t / 2, z);       // suelo
          addBox(t, h, d, mat, x - w / 2 + t / 2, y, z);       // lateral izq.
          addBox(t, h, d, mat, x + w / 2 - t / 2, y, z);       // lateral der.
        }

        // Hoja de puerta: una tapa fina delante del hueco, con la bisagra en
        // el borde derecho. Al pulsarla, gira alrededor de esa bisagra como
        // una puerta real. Se añade a "clickableMeshes" para poder detectarla
        // con el raycaster en el click.
        function addDoorLeaf(w, h, mat, x, y, z) {
          const t = mmToUnits(8);
          const geo = new THREE.BoxGeometry(w, h, t);
          const mesh = new THREE.Mesh(geo, mat);
          mesh.position.set(-w / 2, 0, 0);
          const line = new THREE.LineSegments(new THREE.EdgesGeometry(geo), edges);
          line.position.copy(mesh.position);

          const pivot = new THREE.Group();
          pivot.position.set(x + w / 2, y, z);
          pivot.add(mesh);
          pivot.add(line);
          scene.add(pivot);

          mesh.userData.doorPivotIndex = doorPivots.length;
          doorPivots.push({ pivot: pivot, open: false });
          clickableMeshes.push(mesh);
        }

        let cursorX = 0;
        let maxHeight = 0;
        const groups = Array.isArray(data.groups) ? data.groups : [];

        // Si lleva patas o brazos de soporte a suelo, todo el bloque de la
        // taquilla se eleva esa altura y son las patas las que quedan
        // apoyadas en el suelo (y=0), no la propia taquilla.
        const legsApply = !!(data.isSoporteSuelo && (data.bracketType === 'patas' || data.bracketType === 'brazos'));
        const legHeight = mmToUnits(700);
        const baseY = legsApply ? legHeight : 0;

        groups.forEach(function (cols3d) {
          if (!Array.isArray(cols3d) || cols3d.length === 0) return;
          const numCols = cols3d.length;
          const groupWidth = numCols * colW + sideW * 2;
          const groupStartX = cursorX;

          cols3d.forEach(function (doorBlocks, colIdx) {
            const blocks = Array.isArray(doorBlocks) ? doorBlocks : [];
            const colTotalH = blocks.reduce(function (s, b) { return s + mmToUnits(b.h || 125); }, 0);
            let cursorY = colTotalH;
            blocks.forEach(function (blk) {
              // El primer bloque de la lista es el de más arriba en el dibujo
              // 2D, así que aquí se apila también de arriba hacia abajo.
              const h = mmToUnits(blk.h || 125);
              cursorY -= h;
              const cx = groupStartX + sideW + colIdx * colW + colW / 2;
              const cy = cursorY + h / 2 + baseY;
              if (blk.type === 'screen') {
                addOpenBox(colW - 0.4, h - 0.4, depth - 2, doorMat, cx, cy, depth / 2);
                // La pantalla no se abre: se pone a ras de la misma cara
                // exterior que las puertas cerradas, en vez de hundida.
                const screenDepth = mmToUnits(60);
                const frontZ = depth + mmToUnits(4);
                addBox(colW - 0.4, h - 0.4, screenDepth, screenMats, cx, cy, frontZ - screenDepth / 2);
              } else if (blk.type === 'mailbox') {
                // El buzón sí se abre, como una puerta normal, pero con la
                // foto del buzón en la cara exterior de la hoja.
                addOpenBox(colW - 0.4, h - 0.4, depth - 2, doorMat, cx, cy, depth / 2);
                const mailboxMats = makeFrontTextureMats(mailboxImageUrl(blk), 2);
                addDoorLeaf(colW - 0.4, h - 0.4, mailboxMats, cx, cy, depth);
              } else {
                addOpenBox(colW - 0.4, h - 0.4, depth - 2, doorMat, cx, cy, depth / 2);
                addDoorLeaf(colW - 0.4, h - 0.4, doorMat, cx, cy, depth);
              }
            });
            if (colTotalH > maxHeight) maxHeight = colTotalH;
          });

          // El tejado se añade POR ENCIMA del bloque de puertas, no comido
          // de su altura, así que los laterales y el fondo tienen que llegar
          // hasta ahí arriba también para que no quede un hueco detrás.
          const totalHeightWithRoof = maxHeight + sideW;

          // Laterales (paneles de cuerpo a izquierda y derecha del grupo)
          addBox(sideW, totalHeightWithRoof, depth, bodyMat, groupStartX + sideW / 2, baseY + totalHeightWithRoof / 2, depth / 2);
          addBox(sideW, totalHeightWithRoof, depth, bodyMat, groupStartX + groupWidth - sideW / 2, baseY + totalHeightWithRoof / 2, depth / 2);

          // Planchas de fondo, tejado y suelo (cierran el mueble por detrás, por arriba y por abajo)
          const panelT = mmToUnits(10);
          addBox(groupWidth, totalHeightWithRoof, panelT, bodyMat, groupStartX + groupWidth / 2, baseY + totalHeightWithRoof / 2, panelT / 2);
          addBox(groupWidth, sideW, depth, bodyMat, groupStartX + groupWidth / 2, baseY + totalHeightWithRoof - sideW / 2, depth / 2);
          addBox(groupWidth, panelT, depth, bodyMat, groupStartX + groupWidth / 2, baseY + panelT / 2, depth / 2);

          // Patas/brazos de soporte a suelo (solo home + soporte_suelo):
          // van desde el suelo (y=0) hasta la base de la taquilla (y=baseY).
          if (legsApply) {
            const legSize = mmToUnits(40) * 1.5 * 1.2;
            const footSize = legSize * 4;
            const footHeight = mmToUnits(15);
            const addLegAt = function (x) {
              addBox(legSize, legHeight, legSize, legMat, x, legHeight / 2, depth / 2);
              // Pie: placa plana donde la pata se apoya realmente en el suelo.
              addBox(footSize, footHeight, footSize, legMat, x, footHeight / 2, depth / 2);
            };
            // Brazo: poste que sube por el lateral del mueble, algo más bajo
            // que el propio mueble (no llega hasta arriba del tejado),
            // separado un poco hacia afuera y unido al lateral con dos
            // puntos de anclaje.
            const armTotalHeight = (baseY + maxHeight) * 0.92;
            const armOuterGap = legSize * 1.6;
            const anchorT = mmToUnits(70);
            const anchorDepth = legSize * 0.9;
            const addArmAt = function (x, lockerEdgeX) {
              addBox(legSize, armTotalHeight, legSize, legMat, x, armTotalHeight / 2, depth / 2);
              addBox(footSize, footHeight, footSize, legMat, x, footHeight / 2, depth / 2);

              // Orejetas de anclaje: unen la cara interior del poste (la que
              // mira al mueble) con el lateral del mueble, a dos alturas.
              const dir = lockerEdgeX > x ? 1 : -1;
              const postInnerFaceX = x + dir * legSize / 2;
              const anchorWidth = Math.abs(lockerEdgeX - postInnerFaceX);
              const anchorCenterX = (postInnerFaceX + lockerEdgeX) / 2;
              [0.68, 0.88].forEach(function (frac) {
                addBox(anchorWidth, anchorT, anchorDepth, legMat, anchorCenterX, armTotalHeight * frac, depth / 2);
              });
            };

            if (data.bracketType === 'patas') {
              legPositionsFor(numCols).forEach(function (pos) {
                addLegAt(groupStartX + sideW + (pos - 1) * colW + colW / 2);
              });
            } else {
              // Brazos: un poste alto en cada extremo del grupo (desplazado
              // hacia afuera) y, si es ancho (5+ columnas), refuerzo
              // intermedio (patas cortas) en las mismas posiciones que usan
              // las patas.
              addArmAt(groupStartX - armOuterGap, groupStartX);
              addArmAt(groupStartX + groupWidth + armOuterGap, groupStartX + groupWidth);
              if (numCols >= 5) {
                legPositionsFor(numCols).forEach(function (pos) {
                  addLegAt(groupStartX + sideW + (pos - 1) * colW + colW / 2);
                });
              }
            }
          }

          cursorX = groupStartX + groupWidth + groupGap;
        });

        const totalWidth = Math.max(cursorX - groupGap, colW);

        // Entorno muy esquemático (solo para "home"): un suelo y una pared
        // de fondo neutros, para dar la idea de un portal/vestíbulo sin
        // modelar un edificio real.
        if (data.isHome) {
          // Textura de ladrillos: un pequeño lienzo con 2 filas de ladrillos
          // (la segunda desplazada media pieza, como un muro real) que luego
          // se repite muchas veces por toda la fachada.
          function makeBrickTexture() {
            const brickW = 96, brickH = 24, mortar = 8;
            const canvas = document.createElement('canvas');
            canvas.width = brickW * 2;
            canvas.height = brickH * 2;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#9aa0a6';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#b97a52';
            for (let row = 0; row < 2; row++) {
              const offset = (row % 2 === 0) ? 0 : brickW / 2;
              for (let col = -1; col < 3; col++) {
                ctx.fillRect(col * brickW + offset + mortar / 2, row * brickH + mortar / 2, brickW - mortar, brickH - mortar);
              }
            }
            const texture = new THREE.CanvasTexture(canvas);
            texture.wrapS = THREE.RepeatWrapping;
            texture.wrapT = THREE.RepeatWrapping;
            return texture;
          }

          const floorMat = new THREE.MeshStandardMaterial({ color: 0x7d8186, roughness: 0.9 });
          const brickTexture = makeBrickTexture();
          const margin = Math.max(totalWidth, baseY + maxHeight) * 3;

          const buildingWidth = (totalWidth + margin) * 2 * 0.8;
          const buildingHeight = (baseY + maxHeight + sideW) * 3 * 3 * 0.8 * 0.8;
          const buildingDepth  = margin * 1.5;

          const floorT = mmToUnits(20);
          const floorWidth = buildingWidth * 3 * 0.7;
          const floor = new THREE.Mesh(new THREE.BoxGeometry(floorWidth, floorT, depth + margin * 3), floorMat);
          floor.position.set(totalWidth / 2, -floorT / 2, depth / 2);
          scene.add(floor);

          // El tamaño del "ladrillo" en la escena es fijo, así que la
          // repetición de la textura depende del tamaño real de cada pieza
          // (si no, se vería o gigante o microscópica/apretada según el
          // ancho). Cada pieza del edificio (dos laterales + la de arriba)
          // tiene un ancho distinto, así que cada una necesita su propia
          // textura clonada con su propio repetido, no se puede compartir.
          // El lienzo representa 2 ladrillos de ancho x 2 filas de alto
          // (ladrillo real ≈ 25 x 6,5 cm), para calcular cuántas veces repetir.
          const brickTileWidthMm  = 500;
          const brickTileHeightMm = 130;
          // worldLeftX/worldBottomY: esquina inferior izquierda real de la
          // pieza, para que el patrón de ladrillos de las 3 piezas quede en
          // fase (misma "rejilla"), en vez de que cada una empiece a contar
          // filas/columnas desde su propio cero.
          function makeBuildingMat(pieceWidth, pieceHeight, worldLeftX, worldBottomY) {
            const tex = brickTexture.clone();
            tex.needsUpdate = true;
            const tileW = mmToUnits(brickTileWidthMm);
            const tileH = mmToUnits(brickTileHeightMm);
            tex.repeat.set(pieceWidth / tileW, pieceHeight / tileH);
            tex.offset.set(
              ((worldLeftX || 0) / tileW) % 1,
              ((worldBottomY || 0) / tileH) % 1
            );
            return new THREE.MeshStandardMaterial({ map: tex, roughness: 0.95 });
          }

          // Se desplaza el edificio hacia la derecha para que la taquilla
          // quede situada hacia la izquierda de la fachada, no centrada.
          const buildingOffsetX = buildingWidth * 0.22;
          const doorCenterX = totalWidth / 2 + buildingOffsetX;
          const doorFrontZ  = mmToUnits(5); // justo delante de la fachada, sin solaparse
          const doorHeight  = mmToUnits(2100);
          const doorWidth   = mmToUnits(1600);
          const frameT      = mmToUnits(70);
          const mullionT    = mmToUnits(50);

          // Hueco de "pasillo" detrás de la puerta: en vez de un bloque
          // macizo de ladrillo, el edificio se construye en 3 piezas (dos
          // laterales + una superior) dejando vacía la zona de la puerta,
          // con un fondo propio más cerca para que se vea un pasillo y no
          // ladrillo pegado al cristal.
          const corridorWidth  = doorWidth + frameT * 2;
          const corridorHeight = doorHeight + frameT;
          const corridorDepth  = Math.min(buildingDepth * 0.5, mmToUnits(3500));

          const sideWidth = (buildingWidth - corridorWidth) / 2;
          const leftPieceLeftX = doorCenterX - corridorWidth / 2 - sideWidth;
          const leftPiece = new THREE.Mesh(
            new THREE.BoxGeometry(sideWidth, buildingHeight, buildingDepth),
            makeBuildingMat(sideWidth, buildingHeight, leftPieceLeftX, 0)
          );
          leftPiece.position.set(leftPieceLeftX + sideWidth / 2, buildingHeight / 2, -buildingDepth / 2);
          scene.add(leftPiece);

          const rightPieceLeftX = doorCenterX + corridorWidth / 2;
          const rightPiece = new THREE.Mesh(
            new THREE.BoxGeometry(sideWidth, buildingHeight, buildingDepth),
            makeBuildingMat(sideWidth, buildingHeight, rightPieceLeftX, 0)
          );
          rightPiece.position.set(rightPieceLeftX + sideWidth / 2, buildingHeight / 2, -buildingDepth / 2);
          scene.add(rightPiece);

          const topPiece = new THREE.Mesh(
            new THREE.BoxGeometry(corridorWidth, buildingHeight - corridorHeight, buildingDepth),
            makeBuildingMat(corridorWidth, buildingHeight - corridorHeight, doorCenterX - corridorWidth / 2, corridorHeight)
          );
          topPiece.position.set(doorCenterX, corridorHeight + (buildingHeight - corridorHeight) / 2, -buildingDepth / 2);
          scene.add(topPiece);

          // Interior del pasillo: paredes laterales y fondo, en un tono
          // neutro (no ladrillo), para que se note que es un espacio hueco.
          const corridorMat = new THREE.MeshStandardMaterial({ color: 0xe8e5de, roughness: 0.9 });
          const corridorWallT = mmToUnits(15);
          scene.add(new THREE.Mesh(new THREE.BoxGeometry(corridorWallT, corridorHeight, corridorDepth), corridorMat)
            .translateX(doorCenterX - corridorWidth / 2 + corridorWallT / 2).translateY(corridorHeight / 2).translateZ(-corridorDepth / 2));
          scene.add(new THREE.Mesh(new THREE.BoxGeometry(corridorWallT, corridorHeight, corridorDepth), corridorMat)
            .translateX(doorCenterX + corridorWidth / 2 - corridorWallT / 2).translateY(corridorHeight / 2).translateZ(-corridorDepth / 2));
          scene.add(new THREE.Mesh(new THREE.BoxGeometry(corridorWidth, corridorWallT, corridorDepth), corridorMat)
            .translateX(doorCenterX).translateY(corridorHeight - corridorWallT / 2).translateZ(-corridorDepth / 2));
          scene.add(new THREE.Mesh(new THREE.BoxGeometry(corridorWidth, mmToUnits(10), corridorDepth), corridorMat)
            .translateX(doorCenterX).translateY(mmToUnits(5)).translateZ(-corridorDepth / 2));
          // Fondo del pasillo, que lo cierra para que no se vea un hueco infinito.
          scene.add(new THREE.Mesh(new THREE.BoxGeometry(corridorWidth, corridorHeight, corridorWallT), corridorMat)
            .translateX(doorCenterX).translateY(corridorHeight / 2).translateZ(-corridorDepth + corridorWallT / 2));

          const frameMat = new THREE.MeshStandardMaterial({ color: 0x2b2b2b, roughness: 0.4, metalness: 0.4 });
          const glassMat = new THREE.MeshStandardMaterial({
            color: 0xbfe3f0, roughness: 0.1, metalness: 0.1,
            transparent: true, opacity: 0.18
          });

          // Marco exterior (arriba, abajo, izquierda, derecha)
          const outerW = doorWidth + frameT * 2;
          const outerH = doorHeight + frameT;
          scene.add(new THREE.Mesh(new THREE.BoxGeometry(outerW, frameT, frameT), frameMat).translateX(doorCenterX).translateY(doorHeight + frameT / 2).translateZ(doorFrontZ));
          scene.add(new THREE.Mesh(new THREE.BoxGeometry(frameT, outerH, frameT), frameMat).translateX(doorCenterX - outerW / 2 + frameT / 2).translateY(outerH / 2).translateZ(doorFrontZ));
          scene.add(new THREE.Mesh(new THREE.BoxGeometry(frameT, outerH, frameT), frameMat).translateX(doorCenterX + outerW / 2 - frameT / 2).translateY(outerH / 2).translateZ(doorFrontZ));
          // Montante central entre las dos hojas
          scene.add(new THREE.Mesh(new THREE.BoxGeometry(mullionT, doorHeight, frameT), frameMat).translateX(doorCenterX).translateY(doorHeight / 2).translateZ(doorFrontZ));

          // Las dos hojas de cristal
          const leafWidth = (doorWidth - mullionT) / 2;
          [-1, 1].forEach(function (side) {
            const leafX = doorCenterX + side * (mullionT / 2 + leafWidth / 2);
            scene.add(new THREE.Mesh(new THREE.BoxGeometry(leafWidth, doorHeight, mmToUnits(10)), glassMat).translateX(leafX).translateY(doorHeight / 2).translateZ(doorFrontZ));
          });

          // Ventanas en cuadrícula sobre la fachada (piezas laterales de
          // ladrillo), por encima del hueco de la taquilla/puerta.
          const winWidth  = mmToUnits(900);
          const winHeight = mmToUnits(1200);
          const winFrameT = mmToUnits(15); // marco fino, pegado a la pared
          const winZ      = mmToUnits(3);
          const rowSpacing = mmToUnits(2800);
          const sideMargin = mmToUnits(350);
          const windowBackingMat = new THREE.MeshStandardMaterial({ color: 0x3a3f47, roughness: 0.85 });

          function addWindow(cx, cy) {
            // Capas en Z sin solaparse: marco (fino, pegado a la pared) →
            // panel claro → cristal transparente, cada una por delante de la
            // anterior, para que el cristal realmente se vea translúcido en
            // vez de quedar escondido dentro del marco.
            const frameZ   = winZ;
            const backingZ = winZ + winFrameT;
            const glassZ   = backingZ + mmToUnits(8);

            scene.add(new THREE.Mesh(
              new THREE.BoxGeometry(winWidth + winFrameT * 2, winHeight + winFrameT * 2, winFrameT),
              frameMat
            ).translateX(cx).translateY(cy).translateZ(frameZ));
            // Panel claro detrás del cristal: igual que el pasillo claro
            // detrás de la puerta, para que el cristal transparente se vea
            // "iluminado" en vez de oscuro contra el ladrillo.
            scene.add(new THREE.Mesh(
              new THREE.BoxGeometry(winWidth, winHeight, mmToUnits(5)),
              windowBackingMat
            ).translateX(cx).translateY(cy).translateZ(backingZ));
            scene.add(new THREE.Mesh(
              new THREE.BoxGeometry(winWidth, winHeight, mmToUnits(10)),
              glassMat
            ).translateX(cx).translateY(cy).translateZ(glassZ));
          }

          function addWindowGrid(pieceLeftX, pieceWidth) {
            const usableWidth = pieceWidth - sideMargin * 2;
            // 2 ventanas por fila, usando todo el ancho disponible (pegadas
            // a los márgenes) para que la del centro quede lo más cerca
            // posible del hueco de la puerta, sin tanto vacío en medio.
            const leftX  = pieceLeftX + sideMargin + winWidth / 2;
            const rightX = pieceLeftX + pieceWidth - sideMargin - winWidth / 2;

            const firstRowY = Math.max(doorHeight, baseY + maxHeight) + rowSpacing * 0.6;
            for (let wy = firstRowY; wy + winHeight / 2 < buildingHeight - sideMargin; wy += rowSpacing) {
              addWindow(leftX, wy);
              addWindow(rightX, wy);
            }
          }

          addWindowGrid(leftPieceLeftX, sideWidth);
          addWindowGrid(rightPieceLeftX, sideWidth);
        }

        const sceneTotalHeight = baseY + maxHeight;

        camera = new THREE.PerspectiveCamera(45, 1, 1, 5000);
        const dist = Math.max(totalWidth, sceneTotalHeight, depth) * 1.8 + 50;
        camera.position.set(totalWidth / 2 + dist * 0.6, sceneTotalHeight * 0.7 + dist * 0.35, dist * 0.9);

        renderer = new THREE.WebGLRenderer({ antialias: true });
        viewer.innerHTML = '';
        viewer.appendChild(renderer.domElement);

        controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.target.set(totalWidth / 2, sceneTotalHeight / 2, 0);
        controls.enableDamping = true;
        controls.dampingFactor = 0.08;
        controls.update();

        resizeRenderer();
        setupDoorClicks();
        startAnimation();
      }

      function setupDoorClicks() {
        const raycaster = new THREE.Raycaster();
        const pointer = new THREE.Vector2();
        let downX = 0, downY = 0;

        renderer.domElement.addEventListener('pointerdown', function (e) {
          downX = e.clientX;
          downY = e.clientY;
        });

        renderer.domElement.addEventListener('pointerup', function (e) {
          // Si hubo arrastre (rotar/paneo con OrbitControls), no se considera un clic.
          if (Math.abs(e.clientX - downX) > 4 || Math.abs(e.clientY - downY) > 4) return;

          const rect = renderer.domElement.getBoundingClientRect();
          pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
          pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

          raycaster.setFromCamera(pointer, camera);
          const hits = raycaster.intersectObjects(clickableMeshes, false);
          if (hits.length === 0) return;

          const idx = hits[0].object.userData.doorPivotIndex;
          const entry = doorPivots[idx];
          if (entry) entry.open = !entry.open;
        });
      }

      function startAnimation() {
        if (animationId) cancelAnimationFrame(animationId);
        function animate() {
          animationId = requestAnimationFrame(animate);
          controls.update();
          doorPivots.forEach(function (entry) {
            const target = entry.open ? DOOR_OPEN_ANGLE : 0;
            entry.pivot.rotation.y += (target - entry.pivot.rotation.y) * 0.18;
          });
          renderer.render(scene, camera);
        }
        animate();
      }

      function resizeRenderer() {
        if (!renderer || !camera || !viewer) return;
        const w = viewer.clientWidth || 1;
        const h = viewer.clientHeight || 1;
        renderer.setPixelRatio(window.devicePixelRatio || 1);
        renderer.setSize(w, h);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      }

      function openModal() {
        modal3d.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        modal3d.setAttribute('aria-hidden', 'false');

        ensureThree().then(function () {
          if (!renderer) {
            buildScene();
          } else {
            startAnimation();
          }
          requestAnimationFrame(resizeRenderer);
        }).catch(function (err) {
          console.error('No se pudo cargar el visor 3D:', err);
          viewer.innerHTML = '<div style="padding:24px;color:#dc2626;">No se pudo cargar el visor 3D. Revisa la consola del navegador para más detalles.</div>';
        });
      }

      function closeModal() {
        modal3d.classList.remove('is-open');
        document.body.style.overflow = '';
        modal3d.setAttribute('aria-hidden', 'true');
        if (animationId) { cancelAnimationFrame(animationId); animationId = null; }
      }

      btn3d.addEventListener('click', openModal);
      modal3d.addEventListener('click', function (e) {
        if (e.target.closest('[data-close3d="1"]')) closeModal();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal3d.classList.contains('is-open')) closeModal();
      });
      window.addEventListener('resize', function () {
        if (modal3d.classList.contains('is-open')) resizeRenderer();
      });
    });
  </script>

  <script>
    window.addEventListener('DOMContentLoaded', function () {
      // Drag-to-scroll on preview
      var scroll = document.querySelector('.preview-scroll');
      var dragMoved = 0;
      if (scroll) {
        var isDragging = false, startX, scrollLeft;

        scroll.addEventListener('mousedown', function (e) {
          isDragging = true;
          dragMoved = 0;
          scroll.classList.add('is-dragging');
          startX    = e.pageX - scroll.getBoundingClientRect().left;
          scrollLeft = scroll.scrollLeft;
          e.preventDefault();
        });

        document.addEventListener('mouseup', function () {
          isDragging = false;
          scroll.classList.remove('is-dragging');
        });

        document.addEventListener('mousemove', function (e) {
          if (!isDragging) return;
          var x    = e.pageX - scroll.getBoundingClientRect().left;
          var walk = (x - startX) * 1.2;
          dragMoved = Math.max(dragMoved, Math.abs(walk));
          scroll.scrollLeft = scrollLeft - walk;
        });
      }

      // Puertas "clicables": al pulsar una puerta se abre girando sobre una
      // bisagra (rotateY con perspectiva en .col-body), como una puerta real.
      // Se ignora el click si viene de arrastrar el scroll de la vista previa.
      var previewCaptureEl = document.getElementById('previewCapture');
      if (previewCaptureEl) {
        previewCaptureEl.addEventListener('click', function (e) {
          if (dragMoved > 6) return;
          var doorEl = e.target.closest('.door');
          if (!doorEl || !previewCaptureEl.contains(doorEl)) return;
          doorEl.classList.toggle('is-open');
        });
      }

      // En móvil, en vez de scroll horizontal, escalamos el dibujo para que
      // quepa entero en pantalla; si el usuario quiere ver detalle (puertas,
      // cotas) hace zoom táctil, no hace falta desplazarse por los lados.
      var MOBILE_BREAKPOINT = 768;
      var stage = document.getElementById('previewCapture');

      function fitPreviewToMobile() {
        if (!scroll || !stage) return;

        if (window.innerWidth > MOBILE_BREAKPOINT) {
          stage.style.transform = '';
          stage.style.transformOrigin = '';
          scroll.style.height = '';
          return;
        }

        stage.style.transform = 'none';
        var naturalWidth  = stage.scrollWidth;
        var naturalHeight = stage.scrollHeight;
        var availWidth    = scroll.clientWidth;
        var scale = availWidth > 0 && naturalWidth > 0 ? Math.min(1, availWidth / naturalWidth) : 1;

        stage.style.transformOrigin = 'top left';
        stage.style.transform = 'scale(' + scale + ')';
        scroll.style.height = (naturalHeight * scale) + 'px';
      }

      fitPreviewToMobile();
      window.addEventListener('resize', fitPreviewToMobile);
      window.addEventListener('orientationchange', fitPreviewToMobile);
    });

    const _saveUrl   = '{{ path('configuration_instalacion', { id: configuration.id }) }}';
    const _tableUrl  = '{{ path('configuration_product_table', { id: configuration.id }) }}';
    const _tableContainer = () => document.getElementById('productTableContainer');

    async function saveAndReloadFromIva() {
      const precioEl    = document.getElementById('instalacionPrecio');
      const ivaEl       = document.getElementById('ivaCheck');
      const discountEl  = document.getElementById('discountPct');
      const precio      = parseFloat(precioEl?.value) || 0;
      const iva         = ivaEl ? ivaEl.checked : false;
      const descuento   = discountEl ? (parseFloat(discountEl.value) || 0) : 0;
      await fetch(_saveUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ precio, iva, descuento })
      });
      const c = _tableContainer();
      if (c) {
        const html = await fetch(_tableUrl + '?_=' + Date.now()).then(r => r.text());
        c.innerHTML = html;
        bindIvaCheck();
        initProductTable();
      }
    }

    function bindIvaCheck() {}

    document.addEventListener('change', function (e) {
      console.log('change event', e.target?.id);
      if (e.target && e.target.id === 'ivaCheck') {
        saveAndReloadFromIva();
      }
    });
    console.log('IVA listener registered');

    function initProductTable() {
      const table = document.getElementById('productTable');
      if (!table) return;
      const ivaCheck    = document.getElementById('ivaCheck');
      const discountInp = document.getElementById('discountPct');
      if (!discountInp) return;

      function fmt(n) {
        return n.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
      }

      function recalc() {
        const subtotal      = parseFloat(table.dataset.subtotal) || 0;
        const pct           = Math.min(100, Math.max(0, parseFloat(discountInp.value) || 0));
        const iva           = ivaCheck ? ivaCheck.checked : false;
        const discount      = subtotal * pct / 100;
        const subtotalAfter = subtotal - discount;
        const total         = iva ? subtotalAfter * 1.21 : subtotalAfter;

        const rSub  = document.getElementById('rowSubtotal');
        const rDisc = document.getElementById('rowDiscount');
        const rIva  = document.getElementById('rowIva');

        if (rSub) {
          rSub.style.display = (iva || pct > 0) ? '' : 'none';
          document.getElementById('cellSubtotal').textContent = fmt(subtotal);
        }

        if (rDisc) {
          rDisc.style.display = pct > 0 ? '' : 'none';
          document.getElementById('discountPctLabel').textContent = pct % 1 === 0 ? pct : pct.toFixed(1);
          document.getElementById('cellDiscount').textContent = '−' + fmt(discount);
        }

        if (rIva) {
          rIva.style.display = iva ? '' : 'none';
          document.getElementById('cellIva').textContent = fmt(subtotalAfter * 0.21);
        }

        const lbl = document.getElementById('cellTotalLabel');
        if (lbl) lbl.textContent = (pct > 0 ? window.I18N_SUMMARY.total_with_discount : window.I18N_SUMMARY.total) + (iva ? window.I18N_SUMMARY.iva_included : window.I18N_SUMMARY.iva_excluded);
        document.getElementById('cellTotal').textContent = fmt(total);
      }

      let _discountTimer = null;
      discountInp.addEventListener('input', function() {
        recalc();
        clearTimeout(_discountTimer);
        _discountTimer = setTimeout(function() {
          if (typeof window.saveInstalacion === 'function') window.saveInstalacion();
        }, 800);
      });
      discountInp.addEventListener('change', function() {
        if (typeof window.saveInstalacion === 'function') window.saveInstalacion();
      });
      if (ivaCheck) ivaCheck.addEventListener('change', recalc);

      // ===== Líneas manuales (añadir a mano, sin producto asociado) =====
      const baseSubtotal = parseFloat(table.dataset.baseSubtotal) || 0;
      const linesUrl = '{{ path('configuration_manual_lines', { id: configuration.id }) }}';

      function collectManualLines() {
        return Array.from(table.querySelectorAll('.manual-line-row')).map(function (row) {
          return {
            descripcion: row.querySelector('.manual-line-desc').value,
            uds:         parseFloat(row.querySelector('.manual-line-uds').value) || 0,
            precio:      parseFloat(row.querySelector('.manual-line-precio').value) || 0
          };
        });
      }

      function recalcManualLines() {
        let manualTotal = 0;
        table.querySelectorAll('.manual-line-row').forEach(function (row) {
          const uds    = parseFloat(row.querySelector('.manual-line-uds').value) || 0;
          const precio = parseFloat(row.querySelector('.manual-line-precio').value) || 0;
          const lineTotal = uds * precio;
          manualTotal += lineTotal;
          row.querySelector('.manual-line-total').textContent = fmt(lineTotal);
        });
        table.dataset.subtotal = baseSubtotal + manualTotal;
        recalc();
      }

      function saveManualLines() {
        fetch(linesUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ lines: collectManualLines() })
        });
      }

      let _manualLinesTimer = null;
      function scheduleSaveManualLines() {
        clearTimeout(_manualLinesTimer);
        _manualLinesTimer = setTimeout(saveManualLines, 800);
      }

      table.addEventListener('input', function (e) {
        if (!e.target.classList.contains('manual-line-desc')
            && !e.target.classList.contains('manual-line-uds')
            && !e.target.classList.contains('manual-line-precio')) return;
        recalcManualLines();
        scheduleSaveManualLines();
      });

      table.addEventListener('click', function (e) {
        const delBtn = e.target.closest('.manual-line-delete');
        if (delBtn) {
          delBtn.closest('.manual-line-row').remove();
          recalcManualLines();
          saveManualLines();
        }
      });

      const btnAddManualLine = document.getElementById('btnAddManualLine');
      if (btnAddManualLine) {
        btnAddManualLine.addEventListener('click', function () {
          const tbody = table.querySelector('tbody');
          const addRow = document.getElementById('rowAddManualLine');
          const tr = document.createElement('tr');
          tr.className = 'manual-line-row';
          tr.innerHTML =
            '<td colspan="3" style="padding:6px 12px; border-bottom:1px solid rgba(15,23,42,.08);">' +
              '<input type="text" class="manual-line-desc" placeholder="' + window.I18N_SUMMARY.manual_line_description_placeholder + '" ' +
                'style="width:100%; border:1px solid rgba(15,23,42,.15); border-radius:6px; padding:5px 8px; font-size:13px;">' +
            '</td>' +
            '<td style="padding:6px 12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">' +
              '<input type="number" class="manual-line-uds" min="0" step="1" value="1" ' +
                'style="width:64px; text-align:right; border:1px solid rgba(15,23,42,.15); border-radius:6px; padding:5px 8px; font-size:13px;">' +
            '</td>' +
            '<td style="padding:6px 12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08);">' +
              '<input type="number" class="manual-line-precio" min="0" step="0.01" value="0" ' +
                'style="width:90px; text-align:right; border:1px solid rgba(15,23,42,.15); border-radius:6px; padding:5px 8px; font-size:13px;">' +
            '</td>' +
            '<td style="padding:6px 12px; text-align:right; border-bottom:1px solid rgba(15,23,42,.08); white-space:nowrap;">' +
              '<span class="manual-line-total" style="font-weight:900;">0,00 €</span>' +
              '<button type="button" class="manual-line-delete" style="margin-left:8px; border:0; background:transparent; color:#ef4444; cursor:pointer; font-weight:900; font-size:15px; line-height:1;">×</button>' +
            '</td>';
          tbody.insertBefore(tr, addRow);
          tr.querySelector('.manual-line-desc').focus();
          saveManualLines();
        });
      }

      recalc();
    }

    // Load product reference table via AJAX
    function loadProductTable() {
      const _productContainer = document.getElementById('productTableContainer');
      if (_productContainer) {
        fetch('{{ path('configuration_product_table', { id: configuration.id }) }}?_=' + Date.now())
          .then(function (r) { return r.text(); })
          .then(function (html) { _productContainer.innerHTML = html; initProductTable(); })
          .catch(function (e) { console.error('Error cargando referencias de producto:', e); });
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadProductTable);
    } else {
      loadProductTable();
    }

    window.addEventListener('DOMContentLoaded', function () {
      const btn = document.getElementById('btnIA');
      const status = document.getElementById('iaStatus');
      const node = document.getElementById('previewCapture');

      if (!btn || !status || !node) return;

      btn.addEventListener('click', async function () {
        status.style.display = 'inline';
        status.textContent = window.I18N_SUMMARY.generating;
        btn.disabled = true;

        try {
          const canvas = await html2canvas(node, { backgroundColor: '#ffffff', scale: 1 });
          const dataUrl = canvas.toDataURL('image/png');

          const prompt =
            `Genera un render realista del armario/taquillas basado en el esquema adjunto.
            - Color puertas: {{ doorColor|e('js') }}
            - Color cuerpo/bordes: {{ bodyColor|e('js') }}
            - Fondo: {{ bgLabel|e('js') }}
            - Ubicación: {{ placementLabel|e('js') }}
            - Material: {{ material|e('js') }}
            - Instalación: {{ instalacion|e('js') }}
            - Soporte: {{ selectedType|e('js') }} {{ selectedColor|e('js') }}
            Respeta el número de puertas y proporciones del esquema.`;

          const form = new FormData();
          form.append('prompt', prompt);
          form.append('preview_base64', dataUrl);

          const res = await fetch('{{ path("api_generar_imagen") }}', {
            method: 'POST',
            body: form
          });

          const text = await res.text();
          let json = null;

          try {
            json = JSON.parse(text);
          } catch (e) {
            console.error('Respuesta NO JSON del servidor:', text);
            alert(window.I18N_SUMMARY.non_json_response);
            return;
          }

          if (!res.ok) {
            alert(json.error || window.I18N_SUMMARY.image_generation_error);
            return;
          }

          const img = document.getElementById('resultadoIA');
          img.src = 'data:' + json.mime + ';base64,' + json.image_base64;
          img.style.display = 'block';

        } catch (e) {
          console.error(e);
          alert(window.I18N_SUMMARY.unexpected_error);
        } finally {
          status.style.display = 'none';
          btn.disabled = false;
        }
      });
    });
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const precioInput  = document.getElementById('instalacionPrecio');
      const statusEl     = document.getElementById('instalacionStatus');
      const saveUrl      = '{{ path('configuration_instalacion', { id: configuration.id }) }}';
      const tableUrl     = '{{ path('configuration_product_table', { id: configuration.id }) }}';
      const productContainer = document.getElementById('productTableContainer');

      function getIvaChecked() {
        const chk = document.getElementById('ivaCheck');
        return chk ? chk.checked : false;
      }

      async function saveInstalacion() {
        const precio     = parseFloat(precioInput?.value) || 0;
        const iva        = getIvaChecked();
        const discountEl = document.getElementById('discountPct');
        const descuento  = discountEl ? (parseFloat(discountEl.value) || 0) : 0;
        await fetch(saveUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ precio, iva, descuento })
        });
        if (statusEl) { statusEl.style.display = 'inline'; setTimeout(() => { statusEl.style.display = 'none'; }, 2000); }
      }

      async function saveAndReloadTable() {
        await saveInstalacion();
        if (productContainer) {
          const html = await fetch(tableUrl).then(r => r.text());
          productContainer.innerHTML = html;
          bindIvaCheck();
          initProductTable();
        }
      }

      window.saveAndReloadTable = saveAndReloadTable;
      window.saveInstalacion    = saveInstalacion;

      if (precioInput) {
        precioInput.addEventListener('change', saveAndReloadTable);
        precioInput.addEventListener('blur', saveAndReloadTable);
        let _debounceTimer = null;
        precioInput.addEventListener('input', function () {
          clearTimeout(_debounceTimer);
          _debounceTimer = setTimeout(saveAndReloadTable, 800);
        });
      }
    });

    document.addEventListener('DOMContentLoaded', function () {
      const btnPdf = document.getElementById('btnDescargarPdf');
      if (!btnPdf) return;

      btnPdf.addEventListener('click', async function () {
        const screenshotUrl = btnPdf.dataset.screenshotUrl;
        const pdfUrl        = btnPdf.dataset.pdfUrl;

        btnPdf.disabled = true;
        btnPdf.textContent = window.I18N_SUMMARY.generating;

        // Descargar el PDF cierra la configuración en el servidor: ocultamos
        // ya el botón de editar para que no se pueda modificar sin recargar
        // (el DOM no se refresca solo porque la descarga no navega la página).
        const btnEdit = document.getElementById('btnEditConfig');
        if (btnEdit) btnEdit.style.display = 'none';

        // Si el croquis está escalado (vista móvil), lo restauramos a tamaño
        // real para que la captura del PDF salga a resolución completa.
        const previewStageEl = document.getElementById('previewCapture');
        const prevStageTransform = previewStageEl ? previewStageEl.style.transform : '';
        if (previewStageEl) previewStageEl.style.transform = 'none';

        try {
          const groups = document.querySelectorAll('#previewCapture .group-block');
          if (groups.length > 0) {
            const hidden = [...document.querySelectorAll('#previewCapture .num, #previewCapture .badges')];
            hidden.forEach(el => el.style.visibility = 'hidden');

            const proxyBase = '/api/image-proxy?url=';
            const externalImgs = [...document.querySelectorAll('#previewCapture img')].filter(
              img => /^https?:\/\//.test(img.src)
            );
            const originalSrcs = externalImgs.map(img => img.src);
            externalImgs.forEach(img => { img.src = proxyBase + encodeURIComponent(img.src); });
            await Promise.all(externalImgs.map(img => img.complete ? Promise.resolve() : new Promise(r => { img.onload = r; img.onerror = r; })));

            const screenshots = [];
            for (const group of groups) {
              const prevPadding = group.style.padding;
              // top y right ampliados para no recortar el bisel de profundidad (fondo)
              group.style.padding = '42px 110px 100px 70px';
              const canvas = await html2canvas(group, {
                backgroundColor: '#ffffff',
                scale: Math.max(window.devicePixelRatio || 1, 3),
              });
              group.style.padding = prevPadding;
              screenshots.push(canvas.toDataURL('image/png'));
            }

            externalImgs.forEach((img, i) => { img.src = originalSrcs[i]; });

            hidden.forEach(el => el.style.visibility = '');

            await fetch(screenshotUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ screenshots })
            });
          }
        } catch (e) {
          console.warn('Screenshot failed, continuing without it:', e);
        } finally {
          if (previewStageEl) previewStageEl.style.transform = prevStageTransform;
        }

        window.location.href = pdfUrl;
        setTimeout(() => {
          btnPdf.disabled = false;
          btnPdf.textContent = window.I18N_SUMMARY.download_pdf;
        }, 2000);
      });
    });
  </script>
{% endblock %}