{% extends 'layout.html.twig' %}

{% block page_title %}Complementos{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --hscale: 4.16px;
    }

    .page-layout{
      max-width: 1700px;
      margin: 18px auto;
      padding: 0 14px;
      display:grid;
      grid-template-columns: 260px 1fr;
      gap:18px;
      align-items:start;
    }

    @media (max-width: 980px){
      .page-layout{
        grid-template-columns: 1fr;
      }
    }

    .side-tools{
      position:sticky;
      top:20px;
      background:#fff;
      border:1px solid rgba(15,23,42,.12);
      border-radius:16px;
      padding:14px;
    }

    @media (max-width: 980px){
      .side-tools{
        position:static;
      }
    }

    .side-tools h3{
      margin:0 0 8px;
      font-size:18px;
    }

    .side-tools .help{
      color:#6b7280;
      font-size:14px;
      line-height:1.45;
      margin-bottom:14px;
    }

    .mode-buttons{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .mode-btn{
      width:100%;
      text-align:left;
      border:1px solid rgba(15,23,42,.12);
      background:#fff;
      border-radius:12px;
      padding:12px 14px;
      font-weight:900;
      cursor:pointer;
      transition:.15s ease;
    }

    .mode-btn:hover{
      background: rgba(2,6,23,.03);
    }

    .mode-btn.active{
      background:#0b76d8;
      border-color:#0b76d8;
      color:#fff;
      box-shadow: 0 8px 18px rgba(11,118,216,.18);
    }

    .side-note{
      margin-top:14px;
      font-size:13px;
      color:#6b7280;
      line-height:1.4;
    }

    .preview-wrap{
      background:#fff;
      border:1px solid rgba(15,23,42,.12);
      border-radius:16px;
      padding:14px;
      min-width: 0;
      overflow: hidden;
    }

    .cols-scroll{
      overflow-x: auto;
      margin-top:12px;
      padding-bottom: 8px;
    }

    .cols{
      display:flex;
      gap:12px;
      flex-wrap:nowrap;
      width:max-content;
      min-width:100%;
    }

    .col-shell{
      width:170px;
      display:flex;
      flex-direction:column;
      gap:6px;
    }

    .col-topbar{
      padding:6px 8px;
      border-radius:8px;
      background:#003b73;
      color:#fff;
      font-weight:900;
    }

    .col-card{
      width:170px;
      border-style:solid;
      border-color: var(--col-border, #000);
      border-left-width:4px;
      border-right-width:4px;
      border-top-width:8px;
      border-bottom-width:8px;
      border-radius:8px;
      overflow:hidden;
      background:#f7f7f7;
    }

    .col-body{
      height:calc(180 * var(--hscale));
      background:#eaeaea;
      display:flex;
      flex-direction:column;
    }

    .col-half{
      height:calc(90 * var(--hscale));
      display:flex;
      flex-direction:column;
      overflow:hidden;
    }

    .half-sep{
      border-top:2px dashed rgba(0,0,0,.35);
    }

    .door{
      width:100%;
      border:1px solid rgba(44,62,80,.9);
      background: var(--door-color, #3a9efc);
      position:relative;
      cursor:pointer;
      user-select:none;
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:hidden;
      transition:.12s ease;
    }

    .door:hover{
      filter:brightness(.98);
    }

    .door.screen{
      cursor:default;
    }

    .door.screen img{
      width:100%;
      height:100%;
      object-fit:contain;
      pointer-events:none;
      user-select:none;
    }

    .door.methacrylate::after{
      content:"";
      position:absolute;
      inset:14px;
      background:rgba(0,0,0,.28);
      border-radius:4px;
      pointer-events:none;
    }

    .door .num{
      position:absolute;
      left:6px;
      top:4px;
      font-weight:900;
      font-size:12px;
      background: rgba(0,0,0,.65);
      color:#fff;
      border-radius:999px;
      padding:2px 7px;
      line-height:1.2;
      z-index:3;
    }

    .door .badges{
      position:absolute;
      right:6px;
      top:4px;
      display:flex;
      gap:4px;
      flex-wrap:wrap;
      justify-content:flex-end;
      max-width:70%;
      z-index:3;
    }

    .badge{
      font-size:11px;
      font-weight:900;
      background: rgba(255,255,255,.9);
      border:1px solid rgba(0,0,0,.25);
      border-radius:999px;
      padding:1px 6px;
    }

    .door.selected{
      outline:3px solid rgba(17,135,230,.35);
      outline-offset:-2px;
    }

    .btn{
      border:1px solid rgba(15,23,42,.12);
      background:#fff;
      border-radius:999px;
      padding:10px 14px;
      font-weight:900;
      cursor:pointer;
    }

    .btn.primary{
      background:#0b76d8;
      border-color:#0b76d8;
      color:#fff;
    }

    .btn.danger{
      background:#e74c3c;
      border-color:#e74c3c;
      color:#fff;
    }

    .bottom-actions{
      margin-top:14px;
      display:flex;
      gap:10px;
      align-items:center;
      flex-wrap:wrap;
    }
  </style>
{% endblock %}

{% block content %}
  {% set doorColor = payload.colorDoor ?? '#3a9efc' %}
  {% set bodyColor = payload.colorBody ?? '#000' %}
  {% set scale = 4.16 %}

  <div class="page-layout">

    <aside class="side-tools">
      <h3>Complementos</h3>
      <div class="help">
        Selecciona una opción y luego haz click en la puerta que quieras modificar.
      </div>

      <div class="mode-buttons" id="modeButtons">
        <button type="button" class="mode-btn active" data-mode="socket">Enchufe</button>
        <button type="button" class="mode-btn" data-mode="usb">USB</button>
        <button type="button" class="mode-btn" data-mode="both">Ambos</button>
        <button type="button" class="mode-btn" data-mode="methacrylate">Metacrilato</button>
        <button type="button" class="mode-btn" data-mode="none">Ninguno</button>
      </div>

      <div class="side-note">
        La opción seleccionada se aplicará directamente al pulsar sobre una puerta.
      </div>
    </aside>

    <div class="preview-wrap">
      <h2 style="margin:0;">Selecciona complementos por puerta</h2>
      <div style="opacity:.75; margin-top:6px;">
        Haz click en una puerta para aplicar la opción activa.
      </div>

      {% if columns is empty %}
        <div style="margin-top:12px; color:#c0392b; font-weight:900;">
          No hay columnas en esta configuración.
        </div>
      {% else %}
        {% set doorIndex = 0 %}
        {% set payloadGroups = payload.groups ?? [] %}
        {% if payloadGroups is empty %}
          {% set payloadGroups = [columns] %}
        {% endif %}

        {% for groupCols in payloadGroups %}
          {% if payloadGroups|length > 1 %}
            <div style="font-weight:900; font-size:13px; color:#334155; margin-top:14px; margin-bottom:4px;">
              Agrupación {{ loop.index }} ({{ groupCols|length }} columnas)
            </div>
          {% endif %}

          <div class="cols-scroll">
            <div class="cols"
                 style="--door-color: {{ doorColor }}; --col-border: {{ bodyColor }};">

              {% for col in groupCols %}
                <div class="col-shell">
                  <div class="col-topbar">Columna {{ loop.index }}</div>

                  <div class="col-card">
                    <div class="col-body">

                      <div class="col-half">
                        {% for blk in col.top.blocks %}
                          {% set hh = blk.h|default(blk) %}
                          {% set type = blk.type|default('door') %}

                          {% if type != 'screen' %}
                            {% set doorIndex = doorIndex + 1 %}
                          {% endif %}

                          <div class="door {{ type == 'screen' ? 'screen' : '' }}"
                               style="height: {{ hh * scale }}px;"
                               {% if type != 'screen' %}
                                 data-door="{{ doorIndex }}"
                                 data-col="{{ loop.parent.loop.index }}"
                                 data-half="top"
                               {% endif %}>
                            {% if type == 'screen' %}
                              <img src="{{ asset('assets/pantalla.png') }}" alt="Pantalla">
                            {% else %}
                              <div class="num">{{ doorIndex }}</div>
                              <div class="badges" data-badges></div>
                            {% endif %}
                          </div>
                        {% endfor %}
                      </div>

                      <div class="half-sep"></div>

                      <div class="col-half">
                        {% for blk in col.bottom.blocks %}
                          {% set hh = blk.h|default(blk) %}
                          {% set type = blk.type|default('door') %}

                          {% if type != 'screen' %}
                            {% set doorIndex = doorIndex + 1 %}
                          {% endif %}

                          <div class="door {{ type == 'screen' ? 'screen' : '' }}"
                               style="height: {{ hh * scale }}px;"
                               {% if type != 'screen' %}
                                 data-door="{{ doorIndex }}"
                                 data-col="{{ loop.parent.loop.index }}"
                                 data-half="bottom"
                               {% endif %}>
                            {% if type == 'screen' %}
                              <img src="{{ asset('assets/pantalla.png') }}" alt="Pantalla">
                            {% else %}
                              <div class="num">{{ doorIndex }}</div>
                              <div class="badges" data-badges></div>
                            {% endif %}
                          </div>
                        {% endfor %}
                      </div>

                    </div>
                  </div>
                </div>
              {% endfor %}

            </div>
          </div>
        {% endfor %}
      {% endif %}

      <form method="post"
            action="{{ path('configuration_addons_next', { id: configuration.id }) }}"
            id="addonsForm"
            class="bottom-actions">
        <input type="hidden" name="_token" value="{{ csrf_token('addons_next') }}">
        <input type="hidden" name="configuration_id" value="{{ configuration.id }}">
        <input type="hidden" name="addons_payload" id="addons_payload" value="{}">

        <a class="btn" style="text-decoration:none; color:#000"
           href="{{ path('configuration_columns', {
              config_id: configuration.id,
              type: payload.type|default('')
           }) }}">
          Volver atrás
        </a>

        <button type="submit" class="btn primary">Siguiente</button>
        <button type="button" id="clearAll" class="btn danger">Borrar todo</button>
      </form>
    </div>

  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}

  <script>
    window.PRELOADED_ADDONS = {{ (payload.addons ?? {})|json_encode|raw }};
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const addons = (window.PRELOADED_ADDONS && typeof window.PRELOADED_ADDONS === 'object')
        ? window.PRELOADED_ADDONS
        : {};

      const payloadInput = document.getElementById('addons_payload');
      const clearAllBtn = document.getElementById('clearAll');
      const modeButtons = document.querySelectorAll('.mode-btn');

      let currentMode = 'socket';

      function normalizeDoorData(data) {
        return {
          socket: !!data?.socket,
          usb: !!data?.usb,
          methacrylate: !!data?.methacrylate
        };
      }

      function setActiveMode(mode){
        currentMode = mode;

        modeButtons.forEach(btn => {
          btn.classList.toggle('active', btn.getAttribute('data-mode') === mode);
        });
      }

      function setSelection(doorNum, mode){
        if (!doorNum) return;

        const current = normalizeDoorData(addons[doorNum] || {});

        if (mode === 'none'){
          delete addons[doorNum];
        } else if (mode === 'socket'){
          addons[doorNum] = {
            ...current,
            socket: true,
            usb: false
          };
        } else if (mode === 'usb'){
          addons[doorNum] = {
            ...current,
            socket: false,
            usb: true
          };
        } else if (mode === 'both'){
          addons[doorNum] = {
            ...current,
            socket: true,
            usb: true
          };
        } else if (mode === 'methacrylate'){
          addons[doorNum] = {
            ...current,
            methacrylate: !current.methacrylate
          };

          if (!addons[doorNum].socket && !addons[doorNum].usb && !addons[doorNum].methacrylate) {
            delete addons[doorNum];
          }
        }

        payloadInput.value = JSON.stringify(addons);
        paintDoorState(doorNum);
      }

      function paintDoorState(doorNum){
        const doorEl = document.querySelector(`.door[data-door="${doorNum}"]`);
        if (!doorEl) return;

        const badgesWrap = doorEl.querySelector('[data-badges]');
        if (!badgesWrap) return;

        badgesWrap.innerHTML = '';
        doorEl.classList.remove('methacrylate');

        const sel = normalizeDoorData(addons[doorNum]);
        if (!sel.socket && !sel.usb && !sel.methacrylate) return;

        if (sel.methacrylate){
          doorEl.classList.add('methacrylate');
        }

        if (sel.socket){
          const b = document.createElement('div');
          b.className = 'badge';
          b.textContent = 'ENCH';
          badgesWrap.appendChild(b);
        }

        if (sel.usb){
          const b = document.createElement('div');
          b.className = 'badge';
          b.textContent = 'USB';
          badgesWrap.appendChild(b);
        }
      }

      payloadInput.value = JSON.stringify(addons);
      Object.keys(addons).forEach(paintDoorState);

      modeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          setActiveMode(btn.getAttribute('data-mode'));
        });
      });

      document.querySelectorAll('.door[data-door]').forEach(door => {
        door.addEventListener('click', () => {
          const doorNum = door.getAttribute('data-door');

          document.querySelectorAll('.door.selected').forEach(el => el.classList.remove('selected'));
          door.classList.add('selected');

          setSelection(doorNum, currentMode);
        });
      });

      clearAllBtn.addEventListener('click', () => {
        for (const k of Object.keys(addons)) delete addons[k];
        payloadInput.value = JSON.stringify(addons);

        document.querySelectorAll('[data-badges]').forEach(el => el.innerHTML = '');
        document.querySelectorAll('.door').forEach(el => {
          el.classList.remove('selected', 'methacrylate');
        });
      });
    });
  </script>
{% endblock %}