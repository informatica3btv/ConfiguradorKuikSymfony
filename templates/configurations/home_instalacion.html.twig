{% extends 'layout.html.twig' %}

{% block page_title %}Instalación (Home){% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    body{
      font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background:#f6f9fc;
      color:#0b1220;
    }
    .config-form{
      max-width: 980px;
      margin: 28px auto 60px;
      padding: 10px 10px 30px;
      font-size: 16px;
    }
    .option-row{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:12px;
    }
    .option-card{
      padding:18px;
      border-radius:18px;
      border:1px solid rgba(15,23,42,.12);
      background:#fff;
      cursor:pointer;
      transition:.15s;
      appearance:none;
      -webkit-appearance:none;
      text-align:center;
    }
    .option-card:hover{
      transform:translateY(-1px);
      box-shadow: 0 6px 14px rgba(2,20,60,.10);
    }
    .option-card.selected{
      border-color:#1187e6;
      box-shadow:0 0 0 4px rgba(17,135,230,.15);
    }
    .option-title{
      font-weight:800;
      font-size:16px;
    }
    .primary-btn{
      padding:14px 24px;
      border-radius:999px;
      border:0;
      background:linear-gradient(135deg,#0b76d8,#1187e6);
      color:#fff;
      font-weight:800;
      cursor:pointer;
      box-shadow:0 10px 20px rgba(17,135,230,.25);
      transition:.15s;
    }
    .primary-btn:hover{ transform:translateY(-1px); }
    .warn{ color:#c0392b; font-weight:800; }
  </style>
{% endblock %}

{% block content %}
<form method="get"
      action="{{ path('configuration_columns') }}"
      id="instalacionForm"
      class="config-form">

  <input type="hidden" name="config_id" value="{{ configuration.id }}">
  <input type="hidden" name="project_id" value="{{ project.id }}">


  {# 👇 IMPORTANTE: mantener el tipo seleccionado en la pantalla anterior #}
  <input type="hidden" name="type" value="home">

  {# 👇 lo que eliges aquí #}
  <input type="hidden" name="instalacion" id="instalacion" value="">
  <input type="hidden" name="agrupacion_combinada" id="agrupacion_combinada" value="">

  <div style="margin:16px 0;">
    <h3 style="margin-bottom: 8px; font-size:24px;">Selecciona tipo de instalación</h3>

    <div class="option-row" data-group="instalacion">
      {% for opt in options %}
        <button type="button" class="option-card" data-value="{{ opt.value }}">
          <div class="option-title">{{ opt.name }}</div>
        </button>
      {% endfor %}
    </div>
  </div>

  <div id="agrupacion-section" style="margin:24px 0 0;display:none;">
    <h3 style="margin-bottom: 8px; font-size:24px;">¿Es agrupación combinada?</h3>
    <p style="color:#6b7280;font-size:14px;margin-bottom:12px;">Indica si esta instalación combina distintos tipos de columnas.</p>

    <div class="option-row" data-group="agrupacion" style="grid-template-columns:repeat(2,1fr);max-width:400px;">
      <button type="button" class="option-card" data-value="1">
        <div class="option-title">Sí</div>
      </button>
      <button type="button" class="option-card" data-value="0">
        <div class="option-title">No</div>
      </button>
    </div>
  </div>

  <div style="margin-top:18px; display:flex; gap:10px; align-items:center;">
    <button type="submit" class="primary-btn">Siguiente</button>
    <div id="instalacionError" class="warn"></div>
  </div>
</form>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    document.addEventListener('DOMContentLoaded', () => {
    const hidden = document.getElementById('instalacion');
    const hiddenAgrupacion = document.getElementById('agrupacion_combinada');
    const err = document.getElementById('instalacionError');

    const agrupacionSection = document.getElementById('agrupacion-section');
    const agrupacionApplies = ['empotrado', 'soporte_suelo'];

    document.querySelectorAll('.option-row[data-group="instalacion"] .option-card').forEach(btn => {
        btn.addEventListener('click', () => {
        document.querySelectorAll('.option-row[data-group="instalacion"] .option-card')
            .forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        hidden.value = btn.getAttribute('data-value');
        err.textContent = '';

        // Mostrar/ocultar agrupación combinada
        if (agrupacionApplies.includes(hidden.value)) {
            agrupacionSection.style.display = '';
        } else {
            agrupacionSection.style.display = 'none';
            // Limpiar selección previa
            document.querySelectorAll('.option-row[data-group="agrupacion"] .option-card')
            .forEach(b => b.classList.remove('selected'));
            hiddenAgrupacion.value = '';
        }
        });
    });

    document.querySelectorAll('.option-row[data-group="agrupacion"] .option-card').forEach(btn => {
        btn.addEventListener('click', () => {
        document.querySelectorAll('.option-row[data-group="agrupacion"] .option-card')
            .forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        hiddenAgrupacion.value = btn.getAttribute('data-value');
        err.textContent = '';
        });
    });

    document.getElementById('instalacionForm').addEventListener('submit', (e) => {
        if (!hidden.value) {
        e.preventDefault();
        err.textContent = 'Selecciona un tipo de instalación para continuar.';
        return;
        }
        if (agrupacionApplies.includes(hidden.value) && hiddenAgrupacion.value === '') {
        e.preventDefault();
        err.textContent = 'Indica si es agrupación combinada para continuar.';
        }
    });
    });
    </script>
{% endblock %}
