{% extends 'layout.html.twig' %}
{% block page_title %}Administración · Idiomas{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --bg:#f6f9fc; --ink:#0b1220; --muted:#6b7280; --line: rgba(15,23,42,.12);
      --card:#fff; --shadow: 0 10px 25px rgba(2,20,60,.08); --shadow-sm: 0 6px 14px rgba(2,20,60,.08);
      --blue:#0b76d8;
      --danger:#ef4444;
    }

    .admin-wrap{ max-width:900px; margin:26px auto 70px; padding:0 14px; }
    .admin-title{ font-size:34px; font-weight:900; letter-spacing:-.02em; margin:0; }

    .admin-card{
      margin-top:16px;
      background:var(--card);
      border:1px solid var(--line);
      border-radius:16px;
      padding:16px;
      box-shadow: var(--shadow);
    }

    .toolbar{
      display:flex;
      gap:10px;
      align-items:center;
      justify-content:space-between;
      flex-wrap:wrap;
    }

    .btn{
      border:1px solid rgba(15,23,42,.12);
      background:#fff;
      border-radius:14px;
      padding:10px 14px;
      font-weight:900;
      cursor:pointer;
      display:inline-flex;
      gap:10px;
      align-items:center;
      text-decoration:none;
      color:#0b1220;
    }
    .btn.primary{ background:var(--blue); border-color:var(--blue); color:#fff; }

    .lang-list{ margin-top:14px; display:flex; flex-direction:column; gap:10px; }
    .lang-card{
      background:#fff;
      border:1px solid rgba(15,23,42,.10);
      border-radius:16px;
      padding:14px;
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
      box-shadow: var(--shadow-sm);
    }
    .lang-name{ font-weight:900; margin:0; }
    .lang-meta{ margin-top:4px; color:var(--muted); font-size:13px; }
    .badge{
      display:inline-flex; align-items:center;
      padding:4px 10px; border-radius:999px;
      font-size:12px; font-weight:900;
      background: rgba(11,118,216,.10); color:var(--blue);
      margin-right:6px;
    }
    .badge.inactive{ background: rgba(107,114,128,.12); color:var(--muted); }

    .trash-btn{
      width:40px; height:40px;
      border-radius:14px;
      border:1px solid rgba(239,68,68,.25);
      background: rgba(239,68,68,.10);
      color: var(--danger);
      display:flex; align-items:center; justify-content:center;
      cursor:pointer;
    }
    .trash-btn:hover{ background: rgba(239,68,68,.16); }
    .trash-form{ margin:0; }
  </style>
{% endblock %}

{% block content %}
<div class="admin-wrap">
  <div>
    <div class="admin-title">Idiomas</div>
  </div>

  <div class="admin-card">
    <div class="toolbar">
      <div style="font-weight:900; font-size:22px;">Idiomas disponibles</div>
      <a class="btn primary" href="{{ path('admin_languages_new') }}">+ Añadir idioma</a>
    </div>

    <div class="lang-list">
      {% for l in languages %}
        <div class="lang-card">
          <div style="display:flex; align-items:center; gap:12px;">
            <div style="width:34px; height:34px; text-align:center; display:flex; align-items:center; justify-content:center; font-size:24px;">
              {% if l.flagUrl %}
                <img src="{{ l.flagUrl }}" alt="{{ l.name }}" style="width:32px; height:32px; object-fit:cover; border-radius:6px;">
              {% else %}
                🌐
              {% endif %}
            </div>
            <div>
              <div class="lang-name">{{ l.name }} <span style="opacity:.6;">({{ l.code }})</span></div>
              <div class="lang-meta">
                {% if l.default %}<span class="badge">Por defecto</span>{% endif %}
                <span class="badge {{ l.active ? '' : 'inactive' }}">{{ l.active ? 'Activo' : 'Inactivo' }}</span>
              </div>
            </div>
          </div>

          <div style="display:flex; gap:10px; align-items:center;">
            <a class="btn" href="{{ path('admin_languages_edit', {id: l.id}) }}">Editar</a>

            {% if not l.default %}
              <form class="trash-form" method="post" action="{{ path('admin_languages_delete', {id: l.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_language_' ~ l.id) }}">
                <button class="trash-btn" type="submit" onclick="return confirm('¿Eliminar idioma?')" aria-label="Eliminar">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4 7h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M10 11v6M14 11v6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M6 7l1 14h10l1-14" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M9 7V4h6v3" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                  </svg>
                </button>
              </form>
            {% endif %}
          </div>
        </div>
      {% else %}
        <div style="opacity:.75;">No hay idiomas configurados.</div>
      {% endfor %}
    </div>

    <div style="margin-top:16px;">
      <a class="btn" href="{{ path('admin_dashboard') }}">← Volver</a>
    </div>
  </div>
</div>
{% endblock %}
