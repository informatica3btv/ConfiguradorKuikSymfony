{% extends 'layout.html.twig' %}

{% block page_title %}Importar referencias{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .import-wrap { max-width: 700px; margin: 32px auto 70px; padding: 0 14px; }
    .import-title { font-size: 32px; font-weight: 900; margin: 0 0 6px; }
    .import-sub { color: #6b7280; font-size: 15px; margin-bottom: 28px; }

    .import-card {
      background: #fff;
      border: 1px solid rgba(15,23,42,.12);
      border-radius: 18px;
      padding: 32px;
      box-shadow: 0 10px 30px rgba(2,20,60,.08);
    }

    .drop-zone {
      border: 2px dashed rgba(11,118,216,.35);
      border-radius: 14px;
      padding: 40px 20px;
      text-align: center;
      cursor: pointer;
      transition: .15s;
      background: rgba(11,118,216,.03);
    }
    .drop-zone:hover, .drop-zone.drag-over {
      border-color: #0b76d8;
      background: rgba(11,118,216,.07);
    }
    .drop-zone svg { color: #0b76d8; margin-bottom: 12px; }
    .drop-zone p { margin: 0; color: #6b7280; font-size: 15px; }
    .drop-zone strong { color: #0b1220; }
    .file-name { margin-top: 10px; font-size: 14px; color: #0b76d8; font-weight: 600; }

    .btn-import {
      display: block;
      width: 100%;
      margin-top: 20px;
      padding: 14px;
      background: #0b76d8;
      color: #fff;
      border: none;
      border-radius: 12px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: .15s;
    }
    .btn-import:hover { background: #0960b0; }
    .btn-import:disabled { background: #9ca3af; cursor: not-allowed; }
    .tipo-label-active { border-color: #0b76d8 !important; background: rgba(11,118,216,.07); }

    .format-info {
      margin-top: 28px;
      border-top: 1px solid rgba(15,23,42,.08);
      padding-top: 22px;
    }
    .format-info h3 { font-size: 15px; font-weight: 700; margin: 0 0 14px; }
    .sheet-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 16px; }
    .sheet-table th { background: #f6f9fc; padding: 7px 10px; text-align: left; font-weight: 700; border: 1px solid rgba(15,23,42,.10); }
    .sheet-table td { padding: 6px 10px; border: 1px solid rgba(15,23,42,.08); color: #374151; }
    .sheet-label { font-size: 12px; font-weight: 700; color: #0b76d8; background: rgba(11,118,216,.08); border-radius: 6px; padding: 2px 8px; margin-bottom: 6px; display: inline-block; }

    .flash-success    { background: #d1fae5; color: #065f46; border-radius: 10px; padding: 12px 16px; margin-bottom: 20px; font-weight: 600; }
    .flash-error      { background: #fee2e2; color: #991b1b; border-radius: 10px; padding: 12px 16px; margin-bottom: 20px; font-weight: 600; }
    .flash-duplicates { background: #fef3c7; color: #92400e; border-radius: 10px; padding: 12px 16px; margin-bottom: 20px; font-size: 14px; }
  </style>
{% endblock %}

{% block content %}
<div class="import-wrap">

  <a href="{{ path('admin_dashboard') }}" style="display:inline-flex;align-items:center;gap:6px;color:#6b7280;font-size:14px;text-decoration:none;margin-bottom:18px;">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M5 12l7-7M5 12l7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Volver al panel
  </a>

  <div class="import-title">Importar referencias</div>
  <div class="import-sub">Sube un Excel con las hojas <strong>door</strong>, <strong>side</strong>, <strong>roof</strong>, <strong>columna</strong>, <strong>mailbox</strong>, <strong>control</strong>, <strong>bandeja</strong> y/o <strong>envolvente</strong>. Las filas existentes se actualizarán, las nuevas se crearán.</div>

  {% for msg in app.flashes('success') %}
    <div class="flash-success">{{ msg }}</div>
  {% endfor %}
  {% for msg in app.flashes('error') %}
    <div class="flash-error">{{ msg }}</div>
  {% endfor %}
  {% for msg in app.flashes('duplicates') %}
    <div class="flash-duplicates">
      <strong>Las siguientes referencias ya existen y no se han importado:</strong>
      <ul style="margin:8px 0 0;padding-left:18px;">
        {% for item in msg|split('||') %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endfor %}

  <div class="import-card">
    <form method="post" action="{{ path('admin_import_upload') }}" enctype="multipart/form-data" id="importForm">
      <input type="hidden" name="_token" value="{{ csrf_token('import_excel') }}">

      <div style="margin-bottom:18px;">
        <label style="display:block;font-size:13px;font-weight:700;color:#374151;margin-bottom:8px;">Tipo de configuración</label>
        <div style="display:flex;gap:10px;">
          <label style="display:flex;align-items:center;gap:7px;font-size:14px;cursor:pointer;padding:9px 16px;border:2px solid rgba(15,23,42,.15);border-radius:10px;font-weight:600;transition:.15s;" id="lbl-tipo-home">
            <input type="radio" name="tipo_override" value="home" style="accent-color:#0b76d8;">
            Home
          </label>
          <label style="display:flex;align-items:center;gap:7px;font-size:14px;cursor:pointer;padding:9px 16px;border:2px solid rgba(15,23,42,.15);border-radius:10px;font-weight:600;transition:.15s;" id="lbl-tipo-pro">
            <input type="radio" name="tipo_override" value="profesional" style="accent-color:#0b76d8;">
            Profesional
          </label>
        </div>
        <p style="margin:8px 0 0;font-size:12px;color:#6b7280;">Selecciona el tipo que se asignará a todas las referencias importadas. Si el Excel ya incluye una columna <code>tipo</code>, esta selección la sobreescribe.</p>
      </div>

      <div class="drop-zone" id="dropZone">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M12 3v13M8 7l4-4 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <p><strong>Haz clic para seleccionar</strong> o arrastra el archivo aquí</p>
        <p style="margin-top:6px;font-size:13px;">.xlsx, .xls, .ods</p>
        <div class="file-name" id="fileName"></div>
        <input type="file" name="excel_file" id="excelFile" accept=".xlsx,.xls,.ods" style="display:none;">
      </div>

      <button type="submit" class="btn-import" id="btnImport" disabled>Importar</button>
    </form>

    <div class="format-info">
      <h3>Formato esperado del Excel</h3>

      <div class="sheet-label">Hoja: door</div>
      <table class="sheet-table">
        <tr><th>A</th><th>B</th><th>C</th><th>D</th><th>E</th></tr>
        <tr><td>reference</td><td>serie</td><td>place</td><td>size</td><td>methacrylate (0/1)</td></tr>
        <tr><td>05828</td><td>300</td><td>interior</td><td>300</td><td>0</td></tr>
      </table>

      <div class="sheet-label">Hoja: side</div>
      <table class="sheet-table">
        <tr><th>A</th><th>B</th><th>C</th><th>D (Home)</th></tr>
        <tr><td>reference</td><td>serie</td><td>place</td><td>altura</td></tr>
        <tr><td>05900</td><td>300</td><td>interior</td><td>40</td></tr>
      </table>
      <p style="font-size:12px;color:#6b7280;margin:0 0 14px;">La columna <strong>altura</strong> solo aplica para tipo <strong>Home</strong>; déjala vacía para Profesional.</p>

      <div class="sheet-label">Hoja: roof</div>
      <table class="sheet-table">
        <tr><th>A</th><th>B</th><th>C</th><th>D</th></tr>
        <tr><td>reference</td><td>serie</td><td>place</td><td>columns</td></tr>
        <tr><td>06100</td><td>300</td><td>exterior</td><td>2</td></tr>
      </table>

      <div class="sheet-label">Hoja: columna</div>
      <table class="sheet-table">
        <tr><th>A</th><th>B</th><th>C</th><th>D (Home)</th></tr>
        <tr><td>reference</td><td>serie</td><td>place</td><td>altura</td></tr>
        <tr><td>06200</td><td>400</td><td>interior</td><td>40</td></tr>
      </table>
      <p style="font-size:12px;color:#6b7280;margin:0 0 14px;">La columna <strong>altura</strong> solo aplica para tipo <strong>Home</strong>; déjala vacía para Profesional.</p>

      <div class="sheet-label">Hoja: mailbox</div>
      <table class="sheet-table">
        <tr><th>A</th><th>B</th><th>C</th><th>D</th></tr>
        <tr><td>reference</td><td>alto</td><td>ancho</td><td>fondo</td></tr>
        <tr><td>06500</td><td>400</td><td>300</td><td>300</td></tr>
      </table>

      <div class="sheet-label">Hoja: control</div>
      <table class="sheet-table">
        <tr><th>A</th><th>B</th><th>C</th></tr>
        <tr><td>reference</td><td>place</td><td>descripcion</td></tr>
        <tr><td>20100</td><td>interior</td><td>Kuik Collet sin pago</td></tr>
      </table>
      <p style="font-size:12px;color:#6b7280;margin:0 0 14px;">Valores válidos — <strong>place</strong>: <code>interior</code>, <code>exterior</code></p>

      <div class="sheet-label">Hoja: bandeja</div>
      <table class="sheet-table">
        <tr><th>A</th><th>B</th></tr>
        <tr><td>reference</td><td>serie</td></tr>
        <tr><td>11000</td><td>300</td></tr>
      </table>

      <div class="sheet-label">Hoja: envolvente</div>
      <table class="sheet-table">
        <tr><th>A</th><th>B</th><th>C</th><th>D</th></tr>
        <tr><td>reference</td><td>tipo</td><td>rango</td><td>descripcion</td></tr>
        <tr><td>10364</td><td>buzon</td><td>grande</td><td>Acero Inoxidable Brillo</td></tr>
      </table>
      <p style="font-size:12px;color:#6b7280;margin:0 0 14px;">Valores válidos — <strong>tipo</strong>: <code>buzon</code>, <code>taquilla</code> · <strong>rango</strong>: <code>pequeño</code>, <code>grande</code></p>

      <p style="font-size:13px;color:#6b7280;margin-top:8px;">La primera fila de cada hoja es la cabecera y se ignora. Solo se procesan las hojas presentes en el archivo.</p>
    </div>
  </div>

</div>

<script>
  const dropZone  = document.getElementById('dropZone');
  const fileInput = document.getElementById('excelFile');
  const fileName  = document.getElementById('fileName');
  const btnImport = document.getElementById('btnImport');

  function checkReady() {
    const tipoSelected = document.querySelector('input[name="tipo_override"]:checked');
    btnImport.disabled = !(fileInput.files.length && tipoSelected);
  }

  document.querySelectorAll('input[name="tipo_override"]').forEach(radio => {
    radio.addEventListener('change', () => {
      document.getElementById('lbl-tipo-home').classList.toggle('tipo-label-active', radio.value === 'home' && radio.checked);
      document.getElementById('lbl-tipo-pro').classList.toggle('tipo-label-active', radio.value === 'profesional' && radio.checked);
      checkReady();
    });
  });

  dropZone.addEventListener('click', () => fileInput.click());

  fileInput.addEventListener('change', () => {
    if (fileInput.files.length) {
      fileName.textContent = fileInput.files[0].name;
      checkReady();
    }
  });

  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
  dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('drag-over');
    const files = e.dataTransfer.files;
    if (files.length) {
      fileInput.files = files;
      fileName.textContent = files[0].name;
      checkReady();
    }
  });
</script>
{% endblock %}
