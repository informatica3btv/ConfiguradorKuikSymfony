<script>
  let globalTipo = 'all';
  let activeTabName = '{{ activeTab }}';

  function setGlobalTipo(tipo, btn) {
    globalTipo = tipo;
    document.querySelectorAll('.btn-tipo').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    filterTable(activeTabName);
  }

  function switchTab(name, btn) {
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('tab-' + name).classList.add('active');
    btn.classList.add('active');
    activeTabName = name;
    filterTable(name);
  }

  function updateCount(type) {
    const checked = document.querySelectorAll('.check-' + type + ':checked').length;
    const total   = document.querySelectorAll('.check-' + type).length;
    document.getElementById('count-' + type).textContent = checked > 0 ? checked + ' seleccionado(s)' : '';
    document.getElementById('bulkBtn-' + type).classList.toggle('visible', checked > 0);
    const master = document.getElementById('checkAll-' + type);
    master.indeterminate = checked > 0 && checked < total;
    master.checked = total > 0 && checked === total;
  }

  function toggleAll(type, master) {
    document.querySelectorAll('.check-' + type).forEach(cb => cb.checked = master.checked);
    updateCount(type);
  }

  function confirmBulk(type) {
    const checked = document.querySelectorAll('.check-' + type + ':checked').length;
    if (checked === 0) return false;
    return confirm('¿Eliminar ' + checked + ' referencia(s) seleccionada(s)?');
  }

  const filterConfig = {
    door:    [['f-door-ref',1],['f-door-serie',2],['f-door-place',3],['f-door-size',4],['f-door-meth',5]],
    side:    [['f-side-ref',1],['f-side-serie',2],['f-side-place',3]],
    roof:    [['f-roof-ref',1],['f-roof-serie',2],['f-roof-place',3],['f-roof-cols',4]],
    columna: [['f-columna-ref',1],['f-columna-serie',2],['f-columna-place',3]],
    mailbox:    [['f-mailbox-ref',1],['f-mailbox-alto',2],['f-mailbox-ancho',3],['f-mailbox-fondo',4],['f-mailbox-desc',5]],
    envolvente: [['f-envolvente-ref',1],['f-envolvente-tipo',2],['f-envolvente-rango',3],['f-envolvente-desc',4]],
    control:    [['f-control-ref',1],['f-control-place',2],['f-control-desc',3]],
    bandeja:    [['f-bandeja-ref',1],['f-bandeja-serie',2]],
    brazo:      [['f-brazo-ref',1],['f-brazo-altura',2]],
    pata:       [['f-pata-ref',1],['f-pata-cols',2]],
  };

  function filterTable(type) {
    const table   = document.getElementById('table-' + type);
    const filters = filterConfig[type];
    if (!table) return;

    const rows    = table.querySelectorAll('tbody tr');
    let   visible = 0;

    rows.forEach(row => {
      const cells = row.querySelectorAll('td');
      const rowTipo = row.dataset.tipo || '';
      const tipoOk = globalTipo === 'all' || rowTipo === globalTipo;
      const show  = tipoOk && filters.every(([id, colIdx]) => {
        const val = document.getElementById(id).value.trim().toLowerCase();
        if (!val) return true;
        const cell = cells[colIdx];
        return cell && cell.textContent.trim().toLowerCase().includes(val);
      });
      row.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    const fc = document.getElementById('fc-' + type);
    if (fc) fc.textContent = visible + ' / ' + rows.length;
  }

  function toggleSideAltura() {
    const val = document.getElementById('side-tipo-select').value;
    document.getElementById('side-altura-wrap').style.display = val === 'home' ? 'block' : 'none';
  }

  function toggleColumnaAltura() {
    const val = document.getElementById('columna-tipo-select').value;
    document.getElementById('columna-altura-wrap').style.display = val === 'home' ? 'block' : 'none';
  }

  function openModal(type) {
    document.getElementById('modal-' + type).classList.add('open');
    const first = document.querySelector('#modal-' + type + ' input[type="text"]');
    if (first) first.focus();
  }

  function closeModal(type) {
    document.getElementById('modal-' + type).classList.remove('open');
  }

  document.querySelectorAll('.modal-overlay').forEach(overlay => {
    overlay.addEventListener('click', e => {
      if (e.target === overlay) overlay.classList.remove('open');
    });
  });

  const baseUrl = '/admin/references';

  function setVal(id, val) { const el = document.getElementById(id); if (el) el.value = val ?? ''; }
  function setChk(id, val) { const el = document.getElementById(id); if (el) el.checked = val === '1'; }
  function setSel(id, val) { const el = document.getElementById(id); if (el) el.value = val ?? ''; }

  function openEditModal(type, d) {
    const form = document.getElementById('form-edit-' + type);
    form.action = baseUrl + '/' + type + '/' + d.id + '/edit';

    if (type === 'door') {
      setVal('edit-door-reference', d.reference);
      setVal('edit-door-serie', d.serie);
      setVal('edit-door-place', d.place);
      setVal('edit-door-size', d.size);
      setSel('edit-door-methacrylate', d.methacrylate);
      setSel('edit-door-acero', d.acero);
      setSel('edit-door-tipo', d.tipoVal);
    } else if (type === 'side') {
      setVal('edit-side-reference', d.reference);
      setVal('edit-side-serie', d.serie);
      setVal('edit-side-place', d.place);
      setSel('edit-side-tipo', d.tipoVal);
      setVal('edit-side-altura', d.altura);
      document.getElementById('edit-side-altura-wrap').style.display = d.tipoVal === 'home' ? 'block' : 'none';
    } else if (type === 'roof') {
      setVal('edit-roof-reference', d.reference);
      setVal('edit-roof-serie', d.serie);
      setVal('edit-roof-place', d.place);
      setVal('edit-roof-columns', d.columns);
      setSel('edit-roof-tipo', d.tipoVal);
    } else if (type === 'columna') {
      setVal('edit-columna-reference', d.reference);
      setVal('edit-columna-serie', d.serie);
      setVal('edit-columna-place', d.place);
      setSel('edit-columna-tipo', d.tipoVal);
      setVal('edit-columna-altura', d.altura);
      document.getElementById('edit-columna-altura-wrap').style.display = d.tipoVal === 'home' ? 'block' : 'none';
    } else if (type === 'mailbox') {
      setVal('edit-mailbox-reference', d.reference);
      setVal('edit-mailbox-alto', d.alto);
      setVal('edit-mailbox-ancho', d.ancho);
      setVal('edit-mailbox-fondo', d.fondo);
      setVal('edit-mailbox-descripcion', d.descripcion);
      setSel('edit-mailbox-tipo', d.tipoVal);
      setChk('edit-mailbox-agrupacion', d.agrupacion);
      setChk('edit-mailbox-electronico', d.electronico);
      setChk('edit-mailbox-tarjetero', d.tarjetero);
      setChk('edit-mailbox-acero', d.acero);
      setVal('edit-mailbox-image-url', d.imageUrl);
    } else if (type === 'envolvente') {
      setVal('edit-envolvente-reference', d.reference);
      setSel('edit-envolvente-tipo', d.tipoEnv);
      setSel('edit-envolvente-rango', d.rango);
      setVal('edit-envolvente-descripcion', d.descripcion);
      setSel('edit-envolvente-tipoconfig', d.tipoVal);
    } else if (type === 'control') {
      setVal('edit-control-reference', d.reference);
      setSel('edit-control-place', d.place);
      setVal('edit-control-descripcion', d.descripcion);
      setSel('edit-control-tipo', d.tipoVal);
      setChk('edit-control-acero', d.acero);
    } else if (type === 'bandeja') {
      setVal('edit-bandeja-reference', d.reference);
      setVal('edit-bandeja-serie', d.serie);
      setSel('edit-bandeja-tipo', d.tipoVal);
    } else if (type === 'brazo') {
      setVal('edit-brazo-reference', d.reference);
      setVal('edit-brazo-altura', d.altura);
      setVal('edit-brazo-descripcion', d.descripcion);
      setSel('edit-brazo-tipo', d.tipoVal);
    } else if (type === 'pata') {
      setVal('edit-pata-reference', d.reference);
      setVal('edit-pata-num-columnas', d.numColumnas);
      setVal('edit-pata-descripcion', d.descripcion);
      setSel('edit-pata-tipo', d.tipoVal);
    }

    document.getElementById('modal-edit-' + type).classList.add('open');
  }
</script>
{% endblock %}
