            <input type="text" placeholder="Referencia"   oninput="filterTable('pata')" id="f-pata-ref">
            <input type="text" placeholder="Nº columnas"  oninput="filterTable('pata')" id="f-pata-cols">
            <span class="filter-count" id="fc-pata"></span>
          </div>
        {% endif %}
        {% if patas is empty %}
          <div class="empty-msg">No hay patas registradas.</div>
        {% else %}
          <table class="ref-table" id="table-pata">
            <thead><tr><th></th><th>Referencia</th><th>Nº columnas</th><th>Descripción</th><th>Tipo</th><th></th></tr></thead>
            <tbody>
              {% for pata in patas %}
                <tr data-tipo="{{ pata.tipo ?? '' }}"
                    data-id="{{ pata.id }}"
                    data-reference="{{ pata.reference|e('html_attr') }}"
                    data-num-columnas="{{ pata.numColumnas ?? '' }}"
                    data-descripcion="{{ pata.descripcion|e('html_attr') }}"
                    data-tipo-val="{{ pata.tipo ?? '' }}">
                  <td><input type="checkbox" name="ids[]" value="{{ pata.id }}" class="row-check check-pata" onchange="updateCount('pata')"></td>
                  <td><strong>{{ pata.reference }}</strong></td>
                  <td>{{ pata.numColumnas ?? '—' }}</td>
                  <td>{{ pata.descripcion ?? '—' }}</td>
                  <td>{% if pata.tipo == 'home' %}<span class="badge badge-home">Home</span>{% elseif pata.tipo == 'profesional' %}<span class="badge badge-pro">Profesional</span>{% else %}<span class="badge badge-ambos">Ambos</span>{% endif %}</td>
                  <td>
                    <button type="button" class="btn-edit" onclick="openEditModal('pata', this.closest('tr').dataset)">Editar</button>
                    <button type="submit" form="del-pata-{{ pata.id }}" class="btn-delete"
                            onclick="return confirm('¿Eliminar esta pata?')">Eliminar</button>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% endif %}
      </form>
    </div>
  </div>

</div>


